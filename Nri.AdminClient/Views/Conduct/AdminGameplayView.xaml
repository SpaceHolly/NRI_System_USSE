<UserControl x:Class="Nri.AdminClient.Views.Conduct.AdminGameplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nri.AdminClient.ViewModels"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminGameplayViewModel}"
             AutomationProperties.AutomationId="AdminGameplay_Root">
    <patterns:NriOperationalWorkspaceHost AutomationProperties.AutomationId="AdminGameplay_OperationalHost">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="Игровой цикл" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBox DockPanel.Dock="Left" Width="180" Margin="16,0,8,0" Text="{Binding CampaignId, UpdateSourceTrigger=PropertyChanged}"/>
            <Button DockPanel.Dock="Left" Content="Обновить" Command="{Binding RefreshCommand}" Padding="12,6"
                    AutomationProperties.AutomationId="AdminGameplay_Refresh"/>
            <Button DockPanel.Dock="Left" Content="Применить выбранное" Command="{Binding ResolveSelectedCommand}" Margin="8,0,0,0" Padding="12,6"
                    AutomationProperties.AutomationId="AdminGameplay_ApplyQuestReward"/>
            <Button DockPanel.Dock="Left" Content="Применить восстановление" Command="{Binding ResolveSelectedCommand}" Margin="8,0,0,0" Padding="12,6"
                    AutomationProperties.AutomationId="AdminGameplay_ApplyRestRecovery"/>
            <Button DockPanel.Dock="Left" Content="Закрыть цель вручную" Command="{Binding RefreshCommand}" Margin="8,0,0,0" Padding="12,6"
                    AutomationProperties.AutomationId="AdminGameplay_ManualObjectiveComplete"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Очередь решений GM" Grid.Column="0" Grid.RowSpan="2" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminGameplay_ResolutionQueue">
                <ListBox ItemsSource="{Binding QueueItems}" SelectedItem="{Binding SelectedQueueItem}" DisplayMemberPath="Display"/>
            </GroupBox>

            <GroupBox Header="Задачи" Grid.Column="1" Grid.Row="0" Margin="0,0,8,8" AutomationProperties.AutomationId="AdminGameplay_QuestSummary">
                <ListBox ItemsSource="{Binding QuestSummary}" DisplayMemberPath="Display"/>
            </GroupBox>

            <GroupBox Header="Покупки" Grid.Column="2" Grid.Row="0" Margin="0,0,0,8" AutomationProperties.AutomationId="AdminGameplay_PurchaseRequests">
                <ListBox ItemsSource="{Binding PurchaseRequests}" DisplayMemberPath="Display"/>
            </GroupBox>

            <TabControl Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
                <TabItem Header="Продажи" AutomationProperties.AutomationId="AdminGameplay_SaleRequests">
                    <ListBox ItemsSource="{Binding SaleRequests}" DisplayMemberPath="Display"/>
                </TabItem>
                <TabItem Header="Персонал" AutomationProperties.AutomationId="AdminGameplay_PersonnelRequests">
                    <ListBox ItemsSource="{Binding PersonnelRequests}" DisplayMemberPath="Display"/>
                </TabItem>
                <TabItem Header="Награды" AutomationProperties.AutomationId="AdminGameplay_RewardGrants">
                    <ListBox ItemsSource="{Binding RewardGrants}" DisplayMemberPath="Display"/>
                </TabItem>
                <TabItem Header="Отдых" AutomationProperties.AutomationId="AdminGameplay_RestStatus">
                    <ListBox ItemsSource="{Binding RestStatus}" DisplayMemberPath="Display"/>
                </TabItem>
                <TabItem Header="Межсессионные действия" AutomationProperties.AutomationId="AdminGameplay_DowntimeActions">
                    <ListBox ItemsSource="{Binding DowntimeActions}" DisplayMemberPath="Display"/>
                </TabItem>
                <TabItem Header="Аудит" AutomationProperties.AutomationId="AdminGameplay_Audit">
                    <ListBox ItemsSource="{Binding AuditRows}"/>
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="AdminGameplay_Status"/>
    </Grid>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
