<UserControl x:Class="Nri.AdminClient.Views.Conduct.AdminLiveActorStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             AutomationProperties.AutomationId="AdminLiveState_Root">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Обновить группу" Command="{Binding RefreshAdminLiveStateCommand}" AutomationProperties.AutomationId="AdminLiveState_Refresh"/><StackPanel><TextBlock Text="Состояния участников" Style="{StaticResource NriPageTitleTextStyle}"/><TextBlock Text="Ресурсы, эффекты и готовность активной группы." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Активная группа" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Grid.Row="1" Text="{Binding AdminLiveScopeSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" AutomationProperties.AutomationId="AdminLiveState_Scope"/><DataGrid Grid.Row="2" ItemsSource="{Binding AdminLiveActors}" SelectedItem="{Binding SelectedAdminLiveActor}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" AutomationProperties.AutomationId="AdminLiveState_PartyBoard"><DataGrid.Columns><DataGridTextColumn Header="Участник" Binding="{Binding Name}" Width="1.25*"/><DataGridTextColumn Header="Тип" Binding="{Binding SubjectTypeLabel}" Width="100"/><DataGridTextColumn Header="Состояние" Binding="{Binding LifeState}" Width="95"/><DataGridTextColumn Header="Готовность" Binding="{Binding Readiness}" Width="1.2*"/><DataGridTextColumn Header="Ресурсы" Binding="{Binding ResourceSummary}" Width="1.7*"/></DataGrid.Columns></DataGrid></Grid></Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="1.15*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Ресурсы выбранного участника" Style="{StaticResource SectionTitleTextStyle}"/><ListBox Grid.Row="1" ItemsSource="{Binding AdminLiveResources}" SelectedItem="{Binding SelectedAdminLiveResource}" Margin="0,10,0,8" AutomationProperties.AutomationId="AdminLiveState_Resources"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Summary}" Margin="12,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Изменение" Foreground="{StaticResource TextSecondaryBrush}"/><TextBox Text="{Binding AdminLiveAdjustmentValue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminLiveState_AdjustmentValue"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Причина *" Foreground="{StaticResource TextSecondaryBrush}"/><TextBox Text="{Binding AdminLiveAdjustmentReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminLiveState_AdjustmentReason"/></StackPanel><Button Grid.Column="2" Margin="0,18,0,0" Content="Применить" Command="{Binding AdjustAdminLiveResourceCommand}" AutomationProperties.AutomationId="AdminLiveState_AdjustResource"/><TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding AdminLiveAdjustmentValidation}" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"/></Grid></Grid></Border>
                <TabControl Grid.Row="1">
                    <TabItem Header="История" AutomationProperties.AutomationId="AdminLiveState_HistoryTab"><Border Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="История изменений" Style="{StaticResource SectionTitleTextStyle}"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="AdminLiveState_History"><ItemsControl ItemsSource="{Binding AdminLiveHistory}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="0,0,0,1" Padding="0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Text}" FontWeight="SemiBold"/><TextBlock Text="{Binding Change}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border></TabItem>
                    <TabItem Header="Эффекты" AutomationProperties.AutomationId="AdminLiveState_EffectsTab"><Border Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Эффекты" Style="{StaticResource SectionTitleTextStyle}"/><ListBox Grid.Row="1" ItemsSource="{Binding AdminLiveEffects}" SelectedItem="{Binding SelectedAdminLiveEffect}" Margin="0,10,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></TabItem>
                    <TabItem Header="Предпросмотр" AutomationProperties.AutomationId="AdminLiveState_PreviewTab"><Border Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Предпросмотр для игрока" Style="{StaticResource SectionTitleTextStyle}"/><Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding PreviewAdminLiveStateCommand}" AutomationProperties.AutomationId="AdminLiveState_PlayerPreview"/></DockPanel><StackPanel Grid.Row="1" Margin="0,8,0,8"><TextBlock Text="{Binding AdminLivePreviewSubject}" FontSize="17" FontWeight="SemiBold" AutomationProperties.AutomationId="AdminLiveState_PreviewSubject"/><TextBlock Text="{Binding AdminLivePreviewLifeState}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/><TextBlock Text="{Binding AdminLivePreviewSummary}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Ресурсы" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding AdminLivePreviewResources}" AutomationProperties.AutomationId="AdminLiveState_PreviewResources"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding PreviewSummary}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Видимые эффекты" FontWeight="SemiBold" Margin="0,10,0,0"/><ItemsControl ItemsSource="{Binding AdminLivePreviewEffects}" AutomationProperties.AutomationId="AdminLiveState_PreviewEffects"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Готовность действий" FontWeight="SemiBold" Margin="0,10,0,0"/><ItemsControl ItemsSource="{Binding AdminLivePreviewActions}" AutomationProperties.AutomationId="AdminLiveState_PreviewActions"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}"/><TextBlock Grid.Column="1" Text="{Binding Detail}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Активное оружие и боеприпасы" FontWeight="SemiBold" Margin="0,10,0,0"/><ItemsControl ItemsSource="{Binding AdminLivePreviewWeapons}" AutomationProperties.AutomationId="AdminLiveState_PreviewWeapons"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid></Border></TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding AdminLiveStateStatus}" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,8,0,0" AutomationProperties.AutomationId="AdminLiveState_Status"/>
    </Grid>
</UserControl>
