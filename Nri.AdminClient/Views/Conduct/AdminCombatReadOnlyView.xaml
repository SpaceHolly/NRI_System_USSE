<UserControl x:Class="Nri.AdminClient.Views.Conduct.AdminCombatReadOnlyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:AutomationProperties="clr-namespace:System.Windows.Automation;assembly=UIAutomationTypes"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="AdminCombatTracker_Route">
    <patterns:NriOperationalWorkspaceHost AutomationProperties.AutomationId="AdminCombatTracker_OperationalHost">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Трекер боя" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="Раунд длится 5 секунд. Инициатива, действия и результаты рассчитываются сервером."
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentRoundText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"
                                   AutomationProperties.AutomationId="AdminCombatTracker_RoundNumber"/>
                        <TextBlock Text="{Binding CurrentTurnText}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   AutomationProperties.AutomationId="AdminCombatTracker_CurrentTurn"/>
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="AdminCombatTracker_Refresh"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Инициатива" Style="{StaticResource SectionTitleTextStyle}"/>
                        <ComboBox Grid.Row="1" Margin="0,8,0,8"
                                  ItemsSource="{Binding Combats}" SelectedItem="{Binding SelectedCombat, Mode=TwoWay}"
                                  DisplayMemberPath="Summary" AutomationProperties.AutomationId="AdminCombatTracker_CombatList"/>
                        <ListBox Grid.Row="2" ItemsSource="{Binding InitiativeOrder}" SelectedItem="{Binding SelectedParticipant, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="AdminCombatTracker_InitiativeList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#253A5A" Padding="5" CornerRadius="3">
                                            <TextBlock Text="{Binding InitiativeSummary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontWeight="Bold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TurnStatus}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <WrapPanel>
                                <Button Content="Инициатива d20" Command="{Binding RollInitiativeCommand}" AutomationProperties.AutomationId="AdminCombatTracker_RollInitiative"/>
                                <Button Content="Начать" Margin="6,0,0,0" Command="{Binding StartCombatCommand}" AutomationProperties.AutomationId="AdminCombatTracker_StartCombat"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Следующий" Command="{Binding NextTurnCommand}" Style="{StaticResource GhostButtonStyle}" AutomationProperties.AutomationId="AdminCombatTracker_NextTurn"/>
                                <Button Content="Пропустить" Margin="6,0,0,0" Command="{Binding SkipTurnCommand}" Style="{StaticResource GhostButtonStyle}" AutomationProperties.AutomationId="AdminCombatTracker_SkipTurn"/>
                                <Button Content="Завершить" Margin="6,0,0,0" Command="{Binding EndCombatCommand}" Style="{StaticResource GhostButtonStyle}" AutomationProperties.AutomationId="AdminCombatTracker_EndCombat"/>
                            </WrapPanel>
                            <Expander Header="Новый бой" Margin="0,8,0,0">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBox Text="{Binding NewCombatName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminCombatTracker_NewCombatName"/>
                                    <Button Content="Создать" Margin="0,6,0,0" Command="{Binding CreateCombatCommand}" AutomationProperties.AutomationId="AdminCombatTracker_CreateCombat"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="2.2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Поле боя" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="{Binding ActiveSceneMapText}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="Обновить карту" Command="{Binding RefreshCombatMapCommand}"
                                        Style="{StaticResource GhostButtonStyle}" AutomationProperties.AutomationId="AdminCombatMap_Refresh"/>
                            </DockPanel>
                            <Border Grid.Row="1" Margin="0,8,0,0" Background="#0B1424" BorderBrush="#263A57" BorderThickness="1" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Canvas Width="{Binding CombatMapCanvasWidth}" Height="{Binding CombatMapCanvasHeight}"
                                            Background="#0B1424" AutomationProperties.AutomationId="AdminCombatMap_Canvas">
                                        <ItemsControl Width="{Binding CombatMapCanvasWidth}" Height="{Binding CombatMapCanvasHeight}" IsHitTestVisible="False" ItemsSource="{Binding CombatMapGridLines}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#233A5A" StrokeThickness="1"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl Width="{Binding CombatMapCanvasWidth}" Height="{Binding CombatMapCanvasHeight}" IsHitTestVisible="False" ItemsSource="{Binding CombatMapTilePatches}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelX}"/><Setter Property="Canvas.Top" Value="{Binding PixelY}"/></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate><DataTemplate><Rectangle Width="{Binding PixelWidth}" Height="{Binding PixelHeight}" Fill="{Binding FillBrush}" Stroke="{Binding StrokeBrush}" Opacity="{Binding Opacity}"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl Width="{Binding CombatMapCanvasWidth}" Height="{Binding CombatMapCanvasHeight}" IsHitTestVisible="False" ItemsSource="{Binding CombatMapAssetInstances}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelX}"/><Setter Property="Canvas.Top" Value="{Binding PixelY}"/></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate><DataTemplate><Border Width="{Binding PixelWidth}" Height="{Binding PixelHeight}" Background="{Binding FillBrush}" BorderBrush="{Binding StrokeBrush}" BorderThickness="1" CornerRadius="2"><TextBlock Text="{Binding AssetGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl Width="{Binding CombatMapCanvasWidth}" Height="{Binding CombatMapCanvasHeight}" IsHitTestVisible="False" ItemsSource="{Binding CombatMapOverlayTokens}" AutomationProperties.AutomationId="AdminCombatMap_RenderedTokenLayer">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelLeft}"/><Setter Property="Canvas.Top" Value="{Binding PixelTop}"/><Setter Property="Panel.ZIndex" Value="10"/></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Ellipse Width="{Binding PixelDiameter}" Height="{Binding PixelDiameter}" Fill="#2563EB" Stroke="#D8EAFE" StrokeThickness="2"/>
                                                        <TextBlock Text="{Binding CanvasLabel}" Margin="20,-3,0,0" Padding="4,2" Foreground="#F8FAFC" Background="#D90F172A" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Grid.Row="2" Text="{Binding CombatMapStatusText}" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="AdminCombatMap_Status"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Журнал боя" Style="{StaticResource SectionTitleTextStyle}"/>
                            <ListBox Grid.Row="1" Margin="0,6,0,0" ItemsSource="{Binding CombatLog}" DisplayMemberPath="DisplayText" AutomationProperties.AutomationId="AdminCombatTracker_Log"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Выбранный участник" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="{Binding SelectedParticipantSummary}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminCombatTracker_SelectedParticipant"/>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="Разрешение атаки" FontWeight="Bold"/>
                            <TextBlock Text="Цель" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,2"/>
                            <ComboBox ItemsSource="{Binding Participants}" SelectedItem="{Binding SelectedAttackTarget, Mode=TwoWay}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="AdminCombatTracker_AttackTarget"/>
                            <TextBlock Text="Экипированное оружие" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,2"/>
                            <ComboBox ItemsSource="{Binding AttackWeaponOptions}" SelectedItem="{Binding SelectedAttackWeapon, Mode=TwoWay}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="AdminCombatTracker_AttackWeapon"/>
                            <TextBlock Text="Навык" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,2"/>
                            <ComboBox ItemsSource="{Binding AttackSkillOptions}" SelectedItem="{Binding SelectedAttackSkill, Mode=TwoWay}" DisplayMemberPath="Summary" AutomationProperties.AutomationId="AdminCombatTracker_AttackSkill"/>
                            <TextBlock Text="Зона защиты" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,2"/>
                            <ComboBox ItemsSource="{Binding AttackFacingOptions}" SelectedItem="{Binding SelectedAttackFacing, Mode=TwoWay}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="AdminCombatTracker_AttackFacing"/>
                            <Button Content="Разрешить атаку" Margin="0,8,0,0" Command="{Binding ExecuteAttackCommand}" AutomationProperties.AutomationId="AdminCombatTracker_ExecuteAttack"/>
                            <Border Background="#101A2C" BorderBrush="#263A57" BorderThickness="1" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Последний результат" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding AttackResolutionText}" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminCombatTracker_AttackResult"/>
                                </StackPanel>
                            </Border>
                            <Separator Margin="0,10"/>
                            <Expander Header="Сравнение латных доспехов" AutomationProperties.AutomationId="AdminCombatTracker_ArmorComparison">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="Без подготовки" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding Participants}" SelectedItem="{Binding SelectedArmorUntrained, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="AdminCombatTracker_ArmorUntrained"/>
                                    <TextBlock Text="С подготовкой" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                    <ComboBox ItemsSource="{Binding Participants}" SelectedItem="{Binding SelectedArmorTrained, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="AdminCombatTracker_ArmorTrained"/>
                                    <Button Content="Сравнить" Margin="0,8,0,0" Command="{Binding ComparePlateArmorCommand}"
                                            AutomationProperties.AutomationId="AdminCombatTracker_CompareArmor"/>
                                    <Border Background="#101A2C" BorderBrush="#263A57" BorderThickness="1" Padding="8" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding ArmorComparisonText}" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="AdminCombatTracker_ArmorComparisonResult"/>
                                    </Border>
                                </StackPanel>
                            </Expander>
                            <Separator Margin="0,10"/>
                            <Expander Header="Состав боя" AutomationProperties.AutomationId="AdminCombatTracker_ParticipantEditor">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="Имя участника" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding NewParticipantName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminCombatTracker_NewParticipantName"/>
                                    <TextBlock Text="Сторона" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                    <TextBox Text="{Binding NewParticipantTeam, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminCombatTracker_NewParticipantTeam"/>
                                    <Button Content="Добавить участника" Margin="0,8,0,0" Command="{Binding AddParticipantCommand}" AutomationProperties.AutomationId="AdminCombatTracker_AddParticipant"/>
                                    <Button Content="Удалить выбранного" Margin="0,6,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RemoveParticipantCommand}" AutomationProperties.AutomationId="AdminCombatTracker_RemoveParticipant"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Связь с токеном карты" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminCombatMap_TokenLinkEditor">
                                <StackPanel Margin="0,6,0,0">
                                    <ComboBox ItemsSource="{Binding CombatMapJoinableTokens}" SelectedItem="{Binding SelectedCombatMapToken, Mode=TwoWay}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="AdminCombatMap_JoinableTokenList"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="Привязать" Command="{Binding LinkSelectedOverlayTokenCommand}" AutomationProperties.AutomationId="AdminCombatMap_LinkParticipantToken"/>
                                        <Button Content="Отвязать" Margin="6,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding UnlinkSelectedOverlayTokenCommand}" AutomationProperties.AutomationId="AdminCombatMap_UnlinkParticipantToken"/>
                                    </WrapPanel>
                                    <TextBlock Text="Координаты берутся из токена карты и не дублируются в участнике боя." Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF87171" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LastRefreshText}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
