                                                    <ComboBox Width="125" Margin="6,0,0,0" ItemsSource="{Binding LocationToolOptions}" SelectedItem="{Binding ShapeKind}"/>
                                                    <ComboBox Width="130" Margin="6,0,0,0" ItemsSource="{Binding LocationVisibilityOptions}"
                                                              DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding ShapeVisibility}"
                                                              AutomationProperties.AutomationId="AdminLocationMapEditor_ShapeVisibilitySelector"/>
                                                </WrapPanel>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <TextBox Width="64" Text="{Binding ShapeX, UpdateSourceTrigger=PropertyChanged}" ToolTip="X"
                                                             AutomationProperties.AutomationId="AdminLocationMapEditor_ShapeX"/>
                                                    <TextBox Width="64" Margin="6,0,0,0" Text="{Binding ShapeY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Y"
                                                             AutomationProperties.AutomationId="AdminLocationMapEditor_ShapeY"/>
                                                    <TextBox Width="64" Margin="6,0,0,0" Text="{Binding ShapeWidth, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ширина"
                                                             AutomationProperties.AutomationId="AdminLocationMapEditor_ShapeWidth"/>
                                                    <TextBox Width="64" Margin="6,0,0,0" Text="{Binding ShapeHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="Высота"
                                                             AutomationProperties.AutomationId="AdminLocationMapEditor_ShapeHeight"/>
                                                    <TextBox Width="64" Margin="6,0,0,0" Text="{Binding ShapeRadius, UpdateSourceTrigger=PropertyChanged}" ToolTip="Радиус"/>
                                                </WrapPanel>
                                                <TextBox Margin="0,6,0,0" Text="{Binding ShapePoints, UpdateSourceTrigger=PropertyChanged}" ToolTip="Точки x,y;x,y"
                                                         AutomationProperties.AutomationId="AdminLocationMapEditor_ShapePoints"/>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <TextBox Width="100" Text="{Binding ShapeRenderMode, UpdateSourceTrigger=PropertyChanged}" ToolTip="Режим отображения"/>
                                                    <TextBox Width="110" Margin="6,0,0,0" Text="{Binding ShapeAssetKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ресурс оформления"/>
                                                    <TextBox Width="110" Margin="6,0,0,0" Text="{Binding ShapeVisualStyleKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="Стиль оформления"/>
                                                    <TextBox Width="76" Margin="6,0,0,0" Text="{Binding ShapeZIndex, UpdateSourceTrigger=PropertyChanged}" ToolTip="Порядок наложения"/>
                                                </WrapPanel>
                                                <TextBox Margin="0,6,0,0" Text="{Binding ShapeDescriptionPlayer, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="44" ToolTip="Описание игрокам"/>
                                                <TextBox Margin="0,6,0,0" Text="{Binding ShapeDescriptionGm, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="44" ToolTip="GM notes"/>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <CheckBox Content="Блокирует движение" IsChecked="{Binding ShapeBlocksMovement}"/>
                                                    <CheckBox Content="Блокирует обзор" Margin="8,0,0,0" IsChecked="{Binding ShapeBlocksVision}"/>
                                                    <CheckBox Content="Укрытие" Margin="8,0,0,0" IsChecked="{Binding ShapeProvidesCover}"/>
                                                    <CheckBox Content="Интерактивно" Margin="8,0,0,0" IsChecked="{Binding ShapeIsInteractable}"/>
                                                </WrapPanel>
                                                <Expander Header="Дополнительная привязка" Margin="0,6,0,0" IsExpanded="False">
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <ComboBox Width="150" ItemsSource="{Binding LocationLinkedEntityTypeOptions}" SelectedItem="{Binding ShapeLinkedEntityType}"
                                                                  ToolTip="Тип объекта, связанного с элементом карты"/>
                                                        <TextBox Width="170" Margin="6,0,0,0" Text="{Binding ShapeLinkedEntityId, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Технический идентификатор; используйте только для диагностики"/>
                                                    </WrapPanel>
                                                </Expander>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Content="Добавить объект" Command="{Binding AddShapeCommand}" IsEnabled="{Binding CanWorkWithLocationEditor}"
                                                            AutomationProperties.AutomationId="AdminLocationMapEditor_AddShape"/>
                                                    <Button Content="Переместить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding MoveShapeCommand}" IsEnabled="{Binding CanWorkWithLocationEditor}"/>
                                                    <Button Content="Размер" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ResizeShapeCommand}" IsEnabled="{Binding CanWorkWithLocationEditor}"/>
                                                    <Button Content="Сохранить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding SaveShapeCommand}" IsEnabled="{Binding CanWorkWithLocationEditor}"
                                                            AutomationProperties.AutomationId="AdminLocationMapEditor_SaveShape"/>
                                                    <Button Content="Дублировать" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding DuplicateShapeCommand}" IsEnabled="{Binding CanWorkWithLocationEditor}"
                                                            AutomationProperties.AutomationId="AdminLocationMapEditor_DuplicateShape"/>
                                                    <Button Content="Архивировать" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ArchiveShapeCommand}" IsEnabled="{Binding CanWorkWithLocationEditor}"
                                                            AutomationProperties.AutomationId="AdminLocationMapEditor_ArchiveShape"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="Добавить маркер" Command="{Binding AddMarkerCommand}" IsEnabled="{Binding CanWorkWithMarkers}" AutomationProperties.AutomationId="AdminSceneMap_AddMarker"/>
                        <Button Content="Переместить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding MoveMarkerCommand}" IsEnabled="{Binding CanWorkWithMarkers}"/>
                        <Button Content="Сохранить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding SaveMarkerCommand}" IsEnabled="{Binding CanWorkWithMarkers}" AutomationProperties.AutomationId="AdminSceneMap_SaveMarker"/>
                        <Button Content="Архивировать" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RemoveMarkerCommand}" IsEnabled="{Binding CanWorkWithMarkers}" AutomationProperties.AutomationId="AdminSceneMap_ArchiveMarker"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="AdminMapEditor_Status" AutomationProperties.Name="Состояние редактора карты"/>
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" Foreground="#F59E0B" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#F87171" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding CanvasCoordinateHints}" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminLocationMapEditor_CoordinatesText">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
