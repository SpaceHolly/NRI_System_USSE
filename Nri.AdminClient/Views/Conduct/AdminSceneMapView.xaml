<UserControl x:Class="Nri.AdminClient.Views.Conduct.AdminSceneMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.AdminClient.ViewModels"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="AdminLocationMapEditor_Route">
    <patterns:NriOperationalWorkspaceHost AutomationProperties.AutomationId="AdminSceneMap_OperationalHost">
    <Grid Margin="8" AutomationProperties.AutomationId="AdminSceneMap_Route">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Карта сцены" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="AdminSceneMap_Route"/>
                <TextBox Grid.Column="1"
                         Visibility="Collapsed"
                         Margin="8,0,0,0"
                         Text="{Binding CampaignId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Кампания (технический контекст)"/>
                <TextBox Grid.Column="2"
                         Visibility="Collapsed"
                         Margin="8,0,0,0"
                         Text="{Binding RuleSetId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Система правил (технический контекст)"/>
                <WrapPanel Grid.Column="3" Margin="8,0,0,0">
                    <Button Content="Обновить" Command="{Binding RefreshMapsCommand}" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="AdminSceneMap_RefreshMaps"/>
                    <Button Content="Создать карту" Margin="8,0,0,0" Command="{Binding CreateMapCommand}" IsEnabled="{Binding CanCreateMap}"
                            AutomationProperties.AutomationId="AdminLocationMapEditor_CreateMap"/>
                    <Button Content="Настройки карты" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding SaveMapSettingsCommand}" IsEnabled="{Binding CanWorkWithSelectedMap}"/>
                    <Button Content="Архивировать" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ArchiveMapCommand}" IsEnabled="{Binding CanWorkWithSelectedMap}"/>
                    <Button Content="Сделать активной" Margin="8,0,0,0" Command="{Binding SetActiveMapCommand}" IsEnabled="{Binding CanManageActiveMap}"
                            AutomationProperties.AutomationId="AdminLocationMapEditor_SetSessionActive"/>
                    <Button Content="Снять активную" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearActiveMapCommand}" IsEnabled="{Binding IsSceneSessionLinkEnabled}"/>
                    <Button Content="Обновить активную" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshActiveMapCommand}" IsEnabled="{Binding IsSceneSessionLinkEnabled}"/>
                    <TextBlock Text="{Binding ActiveMapSummary}" Margin="10,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </WrapPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastRefreshText}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CanvasScaleLabel}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="3.2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="AdminLocationMapEditor_MapSelector">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Карты сцены кампании" Style="{StaticResource SectionTitleTextStyle}"/>
                    <ListBox Grid.Row="1"
                             Margin="0,8,0,8"
                             ItemsSource="{Binding Maps}"
                             SelectedItem="{Binding SelectedMap, Mode=TwoWay}"
                             DisplayMemberPath="Label"
                             AutomationProperties.AutomationId="AdminSceneMap_MapSelector">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding SelectedMapSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <Button Content="Открыть выбранную карту"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding LoadSelectedMapCommand}"
                                IsEnabled="{Binding CanWorkWithSelectedMap}"
                                AutomationProperties.AutomationId="AdminSceneMap_OpenSelectedMap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Рабочая область (базовый viewer)" Style="{StaticResource SectionTitleTextStyle}"/>
                    <StackPanel Grid.Row="1" Margin="0,6,0,8">
                        <WrapPanel>
                            <TextBlock Text="{Binding SelectedMapSummary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                            <CheckBox Content="Сетка" IsChecked="{Binding ShowGrid}" IsEnabled="{Binding CanWorkWithSelectedMap}"
                                      AutomationProperties.AutomationId="MapViewport_GridToggle" AutomationProperties.Name="Показать сетку карты"/>
                            <CheckBox Content="Координаты" Margin="8,0,0,0" IsChecked="{Binding ShowCoordinates}" IsEnabled="{Binding CanWorkWithSelectedMap}"/>
                            <Button Content="+" Margin="8,0,0,0" Command="{Binding ZoomInCommand}" IsEnabled="{Binding CanZoomIn}" AutomationProperties.AutomationId="MapViewport_ZoomIn" AutomationProperties.Name="Увеличить карту"/>
                            <Button Content="?" Margin="6,0,0,0" Command="{Binding ZoomOutCommand}" IsEnabled="{Binding CanZoomOut}" AutomationProperties.AutomationId="MapViewport_ZoomOut" AutomationProperties.Name="Уменьшить карту"/>
                            <Button Content="По размеру карты" Margin="6,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding FitToMapCommand}" AutomationProperties.AutomationId="MapViewport_Fit" AutomationProperties.Name="Показать карту целиком"/>
                            <Button Content="100%" Margin="6,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding SetOneHundredPercentCommand}" AutomationProperties.Name="Масштаб сто процентов"/>
                            <Button Content="Сбросить вид" Margin="6,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ResetViewCommand}" AutomationProperties.AutomationId="MapViewport_Reset" AutomationProperties.Name="Сбросить положение карты"/>
                            <TextBlock Text="{Binding ZoomIndicator}" Margin="10,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.AutomationId="MapViewport_ZoomIndicator" AutomationProperties.Name="Текущий масштаб карты"/>
                            <TextBlock Text="{Binding CoordinateIndicator}" Margin="10,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.AutomationId="MapViewport_CoordinateIndicator" AutomationProperties.Name="Координаты курсора на карте"/>
                            <TextBlock Text="{Binding GridStepLabel}" Margin="10,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <CheckBox Content="Токены" Margin="12,2,0,0" IsChecked="{Binding ShowTokenLayer}"
                                      AutomationProperties.AutomationId="AdminSceneMap_TokenLayerToggle"/>
                            <CheckBox Content="GM-only" Margin="8,2,0,0" IsChecked="{Binding ShowGmOnlyLayer}"
                                      AutomationProperties.AutomationId="AdminSceneMap_GmOnlyLayerToggle"/>
                            <CheckBox Content="Скрытые" Margin="8,2,0,0" IsChecked="{Binding ShowHiddenLayer}"
                                      AutomationProperties.AutomationId="AdminSceneMap_HiddenLayerToggle"/>
                        </WrapPanel>
                        <Expander Header="Предпросмотр как игрок" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminSceneMap_PlayerPreviewPanel">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Тестовый персонаж" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding PlayerPreviewCharacterOptions}"
                                              SelectedItem="{Binding SelectedPlayerPreviewCharacterOption, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              TextSearch.TextPath="DisplayName"
                                              IsTextSearchEnabled="True"
                                              Width="280"
                                              Height="34"
                                              MaxDropDownHeight="320"
                                              HorizontalAlignment="Left"
                                              ToolTip="Персонаж для безопасного предпросмотра"
                                              AutomationProperties.Name="Персонаж для безопасного предпросмотра"
                                              AutomationProperties.AutomationId="AdminSceneMap_PlayerPreviewCharacter"/>
                                    <Button Content="Загрузить безопасный вид" Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Command="{Binding LoadPlayerPreviewCommand}"
                                            AutomationProperties.AutomationId="AdminSceneMap_LoadServerPlayerPreview"/>
                                    <TextBlock Text="{Binding PlayerPreviewSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="260" Height="140" Margin="12,0" Background="#111827" BorderBrush="#475569" BorderThickness="1" CornerRadius="4">
                                    <Canvas Width="260" Height="140" ClipToBounds="True" AutomationProperties.AutomationId="AdminSceneMap_ServerPlayerPreviewCanvas">
                                        <ItemsControl ItemsSource="{Binding PlayerPreviewObjects}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding PixelX}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding PixelY}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AdminPlayerMapPreviewObjectUiItem0204}">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Fill}" Stroke="#F8FAFC" StrokeThickness="1"
                                                             ToolTip="{Binding DisplayName}"
                                                             AutomationProperties.Name="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Проекция сформирована сервером" FontWeight="SemiBold"/>
                                    <TextBlock Text="Внутри этого поля нет инструментов редактирования и GM-данных." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <ItemsControl ItemsSource="{Binding PlayerPreviewObjects}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AdminPlayerMapPreviewObjectUiItem0204}">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                           AutomationProperties.Name="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Expander>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Туман:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding FogSummary}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                            <ComboBox Width="95" SelectedValue="{Binding FogBrushMode}" SelectedValuePath="Tag" IsEnabled="{Binding CanWorkWithFog}">
                                <ComboBoxItem Content="Раскрыть" Tag="reveal"/>
                                <ComboBoxItem Content="Скрыть" Tag="hide"/>
                            </ComboBox>
                            <ComboBox Width="90" Margin="6,0,0,0" SelectedValue="{Binding FogBrushShape}" SelectedValuePath="Tag" IsEnabled="{Binding CanWorkWithFog}">
                                <ComboBoxItem Content="Клетка" Tag="cell"/>
                                <ComboBoxItem Content="Прямоуг." Tag="rectangle"/>
                                <ComboBoxItem Content="Круг" Tag="circle"/>
                            </ComboBox>
                            <TextBox Width="56" Margin="6,0,0,0" Text="{Binding FogBrushWidthMeters, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ширина кисти (м)"/>
                            <TextBox Width="56" Margin="6,0,0,0" Text="{Binding FogBrushHeightMeters, UpdateSourceTrigger=PropertyChanged}" ToolTip="Высота кисти (м)"/>
                            <TextBox Width="56" Margin="6,0,0,0" Text="{Binding FogBrushRadiusMeters, UpdateSourceTrigger=PropertyChanged}" ToolTip="Радиус кисти (м)"/>
                            <Button Content="Применить кисть" Margin="8,0,0,0" Command="{Binding PaintFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                            <Button Content="Скрыть всё" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding HideAllFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                            <Button Content="Раскрыть всё" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RevealAllFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                            <Button Content="Очистить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                            <Button Content="Сбросить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ResetFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                            <Button Content="Обновить туман" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Row="2" BorderThickness="1" BorderBrush="#334155" Background="#0F172A" CornerRadius="4">
                        <controls:NriAutomationAnchor x:Name="MapViewportHost" ClipToBounds="True" SizeChanged="MapViewportHost_OnSizeChanged"
                                                      AutomationProperties.AutomationId="AdminSceneMap_Viewport" AutomationProperties.Name="Область навигации по карте сцены">
                            <Canvas x:Name="MapCanvas" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="#111827" ClipToBounds="True"
                                    PreviewMouseLeftButtonDown="MapCanvas_OnPreviewMouseLeftButtonDown"
                                    MouseLeftButtonDown="MapCanvas_OnMouseLeftButtonDown" MouseDown="MapCanvas_OnMouseDown" MouseUp="MapCanvas_OnMouseUp"
                                    MouseMove="MapCanvas_OnMouseMove" MouseWheel="MapCanvas_OnMouseWheel" MouseLeave="MapCanvas_OnMouseLeave"
                                    AutomationProperties.AutomationId="AdminMapEditor_Viewport" AutomationProperties.Name="Полотно редактора карты">
                                <TextBlock Canvas.Left="8" Canvas.Top="28"
                                           Text="Полотно карты"
                                           Foreground="#94A3B8"
                                           Background="#4C0F172A"
                                           Padding="4,2"
                                           Panel.ZIndex="901"
                                           AutomationProperties.AutomationId="AdminSceneMap_Canvas"/>
                                <TextBlock Canvas.Left="8" Canvas.Top="52"
                                           Text="Tile layer"
                                           Foreground="#CBD5E1"
                                           Background="#4C0F172A"
                                           Padding="4,2"
                                           Panel.ZIndex="902"
                                           AutomationProperties.AutomationId="AdminLocationMapEditor_TileLayer"/>
                                <TextBlock Canvas.Left="8" Canvas.Top="76"
                                           Text="Asset layer"
                                           Foreground="#CBD5E1"
                                           Background="#4C0F172A"
                                           Padding="4,2"
                                           Panel.ZIndex="902"
                                           AutomationProperties.AutomationId="AdminLocationMapEditor_AssetInstanceLayer"/>
                                <ItemsControl ItemsSource="{Binding GridLines}" Opacity="{Binding GridOpacity}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MapGridLineUiItem}">
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#4E789E" StrokeThickness="{Binding Thickness}" Opacity="{Binding Opacity}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding VisibleTilePatches}"
                                              AutomationProperties.AutomationId="AdminLocationMapEditor_TileLayer">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PixelX}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding PixelY}"/>
                                            <Setter Property="Panel.ZIndex" Value="{Binding VisualZIndex}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SceneMapTilePatchUiItem}">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Tag="{Binding}" Click="TilePatchCanvasButton_OnClick"
                                                    AutomationProperties.Name="{Binding Label}">
                                                <Grid Width="{Binding PixelWidth}" Height="{Binding PixelHeight}">
                                                    <Rectangle Fill="{Binding FillBrush}"
                                                               Stroke="{Binding StrokeBrush}"
                                                               StrokeThickness="0.7"
                                                               Opacity="{Binding Opacity}"/>
                                                    <Border BorderBrush="#FDE68A" BorderThickness="0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding FogOverlays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MapFogOverlayUiItem}">
                                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#7F111827"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding VisibleLocationShapes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PixelX}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding PixelY}"/>
                                            <Setter Property="Panel.ZIndex" Value="{Binding VisualZIndex}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SceneMapShapeUiItem}">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Tag="{Binding}" Click="ShapeCanvasButton_OnClick"
                                                    AutomationProperties.Name="{Binding DisplayName}">
                                                <Grid Width="{Binding PixelWidth}" Height="{Binding PixelHeight}" ClipToBounds="False">
                                                    <Border Visibility="{Binding SchematicVisibility}"
                                                            Background="{Binding SchematicFillBrush}"
                                                            BorderBrush="#CBD5E1"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Opacity="{Binding Opacity}">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#F8FAFC" FontSize="11" TextWrapping="Wrap" Margin="4" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                    <Grid Visibility="{Binding MapVisualVisibility}">
                                                        <Border Visibility="{Binding AreaVisibility}"
                                                                Background="{Binding VisualFillBrush}"
                                                                BorderBrush="{Binding VisualStrokeBrush}"
                                                                BorderThickness="{Binding EffectiveStrokeThickness}"
                                                                CornerRadius="5"
                                                                Opacity="{Binding EffectiveVisualOpacity}"/>
                                                        <Path Visibility="{Binding PathVisibility}"
                                                              Data="{Binding PathGeometry}"
                                                              Stroke="{Binding VisualStrokeBrush}"
                                                              StrokeThickness="{Binding EffectiveStrokeThickness}"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Opacity="{Binding EffectiveVisualOpacity}"/>
                                                        <Border BorderBrush="#F8FAFC" BorderThickness="0" Background="Transparent">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3">
                                                                <TextBlock Text="{Binding AssetGlyph}" Foreground="{Binding AssetGlyphBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding VisualLabel}" Foreground="#F8FAFC" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <Border BorderBrush="#FDE68A" BorderThickness="0" CornerRadius="5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding VisibleAssetInstances}"
                                              AutomationProperties.AutomationId="AdminLocationMapEditor_AssetInstanceLayer">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PixelX}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding PixelY}"/>
                                            <Setter Property="Panel.ZIndex" Value="{Binding VisualZIndex}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SceneMapAssetInstanceUiItem}">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Tag="{Binding}" Click="AssetInstanceCanvasButton_OnClick"
                                                    AutomationProperties.Name="{Binding DisplayName}">
                                                <Grid Width="{Binding PixelWidth}" Height="{Binding PixelHeight}" ClipToBounds="False">
                                                    <Border Background="{Binding FillBrush}"
                                                            BorderBrush="{Binding StrokeBrush}"
                                                            BorderThickness="1.2"
                                                            CornerRadius="3"/>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2">
                                                        <TextBlock Text="{Binding AssetGlyph}" Foreground="{Binding GlyphBrush}" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#F8FAFC" FontSize="9" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border BorderBrush="#FDE68A" BorderThickness="0" CornerRadius="3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Canvas.Left="{Binding PlacementGhostX}" Canvas.Top="{Binding PlacementGhostY}"
                                        Width="{Binding PlacementGhostWidth}" Height="{Binding PlacementGhostHeight}"
                                        Visibility="{Binding PlacementGhostVisibility}" Background="#3347A36B" BorderBrush="#86EFAC"
                                        BorderThickness="2" CornerRadius="3" IsHitTestVisible="False" Panel.ZIndex="880">
                                    <TextBlock Text="{Binding PlacementGhostLabel}" Foreground="#F0FDF4" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Markers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PixelX}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding PixelY}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SceneMarkerUiItem}">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Tag="{Binding}" Click="MarkerCanvasButton_OnClick"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <Ellipse Width="12" Height="12" Stroke="#93C5FD" StrokeThickness="1">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#3B82F6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Fill" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
