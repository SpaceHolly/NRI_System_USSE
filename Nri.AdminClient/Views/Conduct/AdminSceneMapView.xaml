<UserControl x:Class="Nri.AdminClient.Views.Conduct.AdminSceneMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.AdminClient.ViewModels">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Карта сцены" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Margin="8,0,0,0"
                         Text="{Binding CampaignId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="CampaignId"/>
                <TextBox Grid.Column="2"
                         Margin="8,0,0,0"
                         Text="{Binding RuleSetId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="RuleSetId"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Обновить" Command="{Binding RefreshMapsCommand}" IsEnabled="{Binding CanLoadMaps}"/>
                    <Button Content="Создать карту" Margin="8,0,0,0" Command="{Binding CreateMapCommand}" IsEnabled="{Binding CanCreateMap}"/>
                    <Button Content="Настройки карты" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding SaveMapSettingsCommand}" IsEnabled="{Binding CanWorkWithSelectedMap}"/>
                    <Button Content="Архивировать" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ArchiveMapCommand}" IsEnabled="{Binding CanWorkWithSelectedMap}"/>
                    <Button Content="Сделать активной" Margin="8,0,0,0" Command="{Binding SetActiveMapCommand}" IsEnabled="{Binding CanManageActiveMap}"/>
                    <Button Content="Снять активную" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearActiveMapCommand}" IsEnabled="{Binding IsSceneSessionLinkEnabled}"/>
                    <Button Content="Обновить активную" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshActiveMapCommand}" IsEnabled="{Binding IsSceneSessionLinkEnabled}"/>
                    <TextBlock Text="{Binding ActiveMapSummary}" Margin="10,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastRefreshText}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CanvasScaleLabel}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="2.3*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Карты сцены кампании" Style="{StaticResource SectionTitleTextStyle}"/>
                    <ListBox Grid.Row="1"
                             Margin="0,8,0,8"
                             ItemsSource="{Binding Maps}"
                             SelectedItem="{Binding SelectedMap, Mode=TwoWay}"
                             DisplayMemberPath="Label"/>
                    <TextBlock Grid.Row="2" Text="{Binding SelectedMapSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Рабочая область (базовый viewer)" Style="{StaticResource SectionTitleTextStyle}"/>
                    <StackPanel Grid.Row="1" Margin="0,6,0,8">
                        <WrapPanel>
                            <TextBlock Text="{Binding SelectedMapSummary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                            <CheckBox Content="Сетка" IsChecked="{Binding ShowGrid}" IsEnabled="{Binding CanWorkWithSelectedMap}"/>
                            <CheckBox Content="Координаты" Margin="8,0,0,0" IsChecked="{Binding ShowCoordinates}" IsEnabled="{Binding CanWorkWithSelectedMap}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Туман:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding FogSummary}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                            <ComboBox Width="95" SelectedValue="{Binding FogBrushMode}" SelectedValuePath="Tag" IsEnabled="{Binding CanWorkWithFog}">
                                <ComboBoxItem Content="Раскрыть" Tag="reveal"/>
                                <ComboBoxItem Content="Скрыть" Tag="hide"/>
                            </ComboBox>
                            <ComboBox Width="90" Margin="6,0,0,0" SelectedValue="{Binding FogBrushShape}" SelectedValuePath="Tag" IsEnabled="{Binding CanWorkWithFog}">
                                <ComboBoxItem Content="Клетка" Tag="cell"/>
                                <ComboBoxItem Content="Прямоуг." Tag="rectangle"/>
                                <ComboBoxItem Content="Круг" Tag="circle"/>
                            </ComboBox>
                            <TextBox Width="56" Margin="6,0,0,0" Text="{Binding FogBrushWidthMeters, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ширина кисти (м)"/>
                            <TextBox Width="56" Margin="6,0,0,0" Text="{Binding FogBrushHeightMeters, UpdateSourceTrigger=PropertyChanged}" ToolTip="Высота кисти (м)"/>
                            <TextBox Width="56" Margin="6,0,0,0" Text="{Binding FogBrushRadiusMeters, UpdateSourceTrigger=PropertyChanged}" ToolTip="Радиус кисти (м)"/>
                            <Button Content="Применить кисть" Margin="8,0,0,0" Command="{Binding PaintFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                            <Button Content="Скрыть всё" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding HideAllFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                            <Button Content="Раскрыть всё" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RevealAllFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                            <Button Content="Очистить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                            <Button Content="Сбросить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ResetFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                            <Button Content="Обновить туман" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshFogCommand}" IsEnabled="{Binding CanWorkWithFog}"/>
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Row="2" BorderThickness="1" BorderBrush="#334155" Background="#0F172A" CornerRadius="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="#111827" MouseLeftButtonDown="MapCanvas_OnMouseLeftButtonDown">
                                <ItemsControl ItemsSource="{Binding GridLines}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MapGridLineUiItem}">
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#233A5A" StrokeThickness="1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding FogOverlays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MapFogOverlayUiItem}">
                                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#7F111827"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Markers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PixelX}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding PixelY}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SceneMarkerUiItem}">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Tag="{Binding}" Click="MarkerCanvasButton_OnClick">
                                                <Grid>
                                                    <Ellipse Width="12" Height="12" Stroke="#93C5FD" StrokeThickness="1">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#3B82F6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Fill" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Margin="10,-4,0,0" Text="{Binding Name}" FontSize="11" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Маркеры" Style="{StaticResource SectionTitleTextStyle}"/>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Markers}" SelectedItem="{Binding SelectedMarker, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Маркер" Binding="{Binding Name}" Width="1.2*"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding MarkerTypeDisplay}" Width="1*"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="0.7*"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="0.7*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedMarkerSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedMarkerBindingText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBox Width="130" Text="{Binding MarkerName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название"/>
                                    <TextBox Width="110" Margin="6,0,0,0" Text="{Binding MarkerType, UpdateSourceTrigger=PropertyChanged}" ToolTip="Тип"/>
                                    <TextBox Width="72" Margin="6,0,0,0" Text="{Binding MarkerX, UpdateSourceTrigger=PropertyChanged}" ToolTip="X"/>
                                    <TextBox Width="72" Margin="6,0,0,0" Text="{Binding MarkerY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Y"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBox Width="130" Text="{Binding MarkerIconKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="IconKey"/>
                                    <TextBox Width="120" Margin="6,0,0,0" Text="{Binding MarkerColorKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="ColorKey"/>
                                    <CheckBox Content="Виден игрокам" Margin="8,4,0,0" IsChecked="{Binding MarkerPlayerVisible}"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBox Width="130" Text="{Binding MarkerLinkedEntityType, UpdateSourceTrigger=PropertyChanged}" ToolTip="LinkedEntityType"/>
                                    <TextBox Width="170" Margin="6,0,0,0" Text="{Binding MarkerLinkedEntityId, UpdateSourceTrigger=PropertyChanged}" ToolTip="LinkedEntityId"/>
                                </WrapPanel>
                                <TextBox Margin="0,6,0,0" Text="{Binding MarkerCardTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="CardTitle"/>
                                <TextBox Margin="0,6,0,0" Text="{Binding MarkerCardDescription, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="58" ToolTip="CardDescription"/>
                                <TextBox Margin="0,6,0,0" Text="{Binding MarkerPublicNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="44" ToolTip="PublicNotes"/>
                                <TextBox Margin="0,6,0,0" Text="{Binding MarkerGmNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="44" ToolTip="GMNotes"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="Добавить маркер" Command="{Binding AddMarkerCommand}" IsEnabled="{Binding CanWorkWithMarkers}"/>
                        <Button Content="Переместить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding MoveMarkerCommand}" IsEnabled="{Binding CanWorkWithMarkers}"/>
                        <Button Content="Сохранить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding SaveMarkerCommand}" IsEnabled="{Binding CanWorkWithMarkers}"/>
                        <Button Content="Удалить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RemoveMarkerCommand}" IsEnabled="{Binding CanWorkWithMarkers}"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" Foreground="#F59E0B" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#F87171" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding CanvasCoordinateHints}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
