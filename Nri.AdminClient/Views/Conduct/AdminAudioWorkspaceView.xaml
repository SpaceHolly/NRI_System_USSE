<UserControl x:Class="Nri.AdminClient.Views.Conduct.AdminAudioWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="AdminAudio_Route">
    <patterns:NriOperationalWorkspaceHost AutomationProperties.AutomationId="AdminAudio_OperationalHost">
        <patterns:NriOperationalWorkspaceHost.Header>
            <DockPanel Margin="8,8,8,12">
                <StackPanel>
                    <TextBlock Text="Музыка сессии" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="{Binding AudioStateText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="AdminAudio_CurrentState_Text"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Content="Обновить" Command="{Binding AudioRefreshCommand}" IsEnabled="{Binding CanControlAudio}"/>
                    <Button Style="{StaticResource GhostButtonStyle}" Content="Синхронизировать" Command="{Binding AudioResyncCommand}" IsEnabled="{Binding CanControlAudio}"/>
                </WrapPanel>
            </DockPanel>
        </patterns:NriOperationalWorkspaceHost.Header>
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Треки" Style="{StaticResource SectionTitleTextStyle}"/>
                        <ComboBox DockPanel.Dock="Right"
                                  Width="160"
                                  ItemsSource="{Binding AudioCategoryOptions}"
                                  SelectedItem="{Binding AudioCategoryInput, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.AutomationId="AdminAudio_CategoryFilter"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AudioTrackRows}"
                              SelectedItem="{Binding SelectedAudioTrackRow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              AutomationProperties.AutomationId="AdminAudio_TrackList">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*"/>
                            <DataGridTextColumn Header="Видимость" Binding="{Binding State}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Extra}" Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Управление воспроизведением" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="{Binding AudioSelectedTrackTitle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               AutomationProperties.AutomationId="AdminAudio_SelectedTrack_Title"/>
                    <TextBlock Text="{Binding AudioCurrentTrackTitle, StringFormat=Сейчас: {0}}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding AudioCurrentCategory, StringFormat=Категория: {0}}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AudioPlaybackStateText, StringFormat=Состояние: {0}}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Режим повтора" Margin="0,12,0,2"/>
                    <ComboBox ItemsSource="{Binding AudioLoopModeOptions}"
                              SelectedItem="{Binding AudioLoopModeInput, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.AutomationId="AdminAudio_LoopMode"/>
                    <TextBlock Text="Плавное переключение, сек." Margin="0,8,0,2"/>
                    <TextBox Text="{Binding AudioFadeSecondsInput, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AdminAudio_FadeSeconds"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Воспроизвести" Command="{Binding AudioSelectTrackCommand}" IsEnabled="{Binding CanControlAudio}"/>
                        <Button Content="Пауза" Command="{Binding AudioPauseCommand}" IsEnabled="{Binding CanControlAudio}"/>
                        <Button Content="Стоп" Command="{Binding AudioStopCommand}" IsEnabled="{Binding CanControlAudio}"/>
                        <Button Content="Следующий" Command="{Binding AudioNextTrackCommand}" IsEnabled="{Binding CanControlAudio}"/>
                    </WrapPanel>
                    <Button Content="Сохранить режим"
                            Command="{Binding AudioSetModeCommand}"
                            IsEnabled="{Binding CanControlAudio}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"/>
                    <Expander Header="Технические сведения" Margin="0,14,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Идентификатор выбранного трека" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox AutomationProperties.AutomationId="AdminAudio_Advanced_SelectedTrackId"
                                     Text="{Binding AudioSelectedTrackId, Mode=OneWay}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>
        <patterns:NriOperationalWorkspaceHost.Status>
            <TextBlock Text="{Binding AudioStatusText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="8,0,8,8"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="AdminAudio_StatusText"/>
        </patterns:NriOperationalWorkspaceHost.Status>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
