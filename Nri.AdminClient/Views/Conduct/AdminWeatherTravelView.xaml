<UserControl x:Class="Nri.AdminClient.Views.Conduct.AdminWeatherTravelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" AutomationProperties.AutomationId="AdminWeatherTravel_Root">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <WrapPanel DockPanel.Dock="Right"><Button Content="Подготовить Северный путь" Command="{Binding EnsureAdminWeatherFixture0217Command}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminWeatherTravel_EnsureFixture"/><Button Content="Обновить" Command="{Binding RefreshAdminWeather0217Command}" AutomationProperties.AutomationId="AdminWeatherTravel_Refresh"/></WrapPanel>
            <StackPanel><TextBlock Text="Погода и путешествия" Style="{StaticResource NriPageTitleTextStyle}"/><TextBlock Text="Истинная погода, наблюдения игроков и воздействие на группу." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding AdminWeather0217Context}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,12,0"/></StackPanel>
        </DockPanel>
        <TabControl Grid.Row="1" AutomationProperties.AutomationId="AdminWeatherTravel_Tabs">
            <TabItem Header="Погода" AutomationProperties.AutomationId="AdminWeatherTravel_WeatherTab">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="Истинное состояние" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="{Binding AdminWeather0217Scope}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/><TextBlock Text="{Binding AdminWeather0217Pattern}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="{Binding AdminWeather0217TrueState}" TextWrapping="Wrap" FontSize="16" Margin="0,10,0,0" AutomationProperties.AutomationId="AdminWeather_TrueStateMps"/><TextBlock Text="{Binding AdminWeather0217BWindVector}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" AutomationProperties.AutomationId="AdminWeather_WindVector"/><TextBlock Text="{Binding AdminWeather0217WorldTime}" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock Text="{Binding AdminWeather0217Transition}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding AdminWeather0217Source}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/><WrapPanel Margin="0,18,0,0"><Button Content="Зафиксировать" Command="{Binding LockAdminWeather0217Command}" Margin="0,0,8,0"/><Button Content="Возобновить переходы" Command="{Binding UnlockAdminWeather0217Command}"/></WrapPanel></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel><TextBlock Text="Предпросмотр наблюдения" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="Без приборов" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="{Binding AdminWeather0217PlayerPreview}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminWeatherTravel_PlayerPreview"/><Separator Margin="0,16,0,12"/><TextBlock Text="С приборами" FontWeight="SemiBold"/><TextBlock Text="{Binding AdminWeather0217BMeasurementPreview}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminWeather_MeasurementPreview"/><TextBlock Text="Скрытые расписания и внутренние коэффициенты игроку не передаются." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Воздействие" AutomationProperties.AutomationId="AdminWeatherTravel_ExposureTab">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="Воздействие на группу" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="Одна истинная погода, разные физиологические профили." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,12"/></StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding AdminEnvironmentImpactRows0217B}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AutomationProperties.AutomationId="AdminWeather_PartyImpact">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Участник" Binding="{Binding ActorName}" Width="155"/>
                                    <DataGridTextColumn Header="Переносимость" Binding="{Binding Tolerance}" Width="190"/>
                                    <DataGridTextColumn Header="Состояние" Binding="{Binding ThermalState}" Width="150"/>
                                    <DataGridTextColumn Header="Интенсивность воздействия" Binding="{Binding ExposureRateDisplay}" Width="165"/>
                                    <DataGridTextColumn Header="Защита" Binding="{Binding Protection}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2"><TextBlock Text="{Binding AdminWeather0217Outdoor}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding AdminWeather0217Sheltered}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="Укрытие и экипировка меняют воздействие, но не истинную погоду." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/></StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Решения мастера" Style="{StaticResource SectionTitleTextStyle}"/><ListBox Grid.Row="1" ItemsSource="{Binding AdminWeatherQueue0217}" SelectedItem="{Binding SelectedAdminWeatherQueue0217}" Margin="0,10,0,10"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="Подтвердить воздействие" Command="{Binding ApproveAdminExposure0217Command}"/></Grid></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Путешествие" AutomationProperties.AutomationId="AdminWeatherTravel_TravelTab">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{Binding AdminWeather0217TravelTitle}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding AdminWeather0217TravelSummary}" Margin="0,8,0,0"/></StackPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding AdminWeatherTravelSegments0217}" Margin="0,14,0,8"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Route}" FontWeight="SemiBold"/><TextBlock Text="{Binding DistanceAndTerrain}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding WeatherAndSpeed}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Duration}" Foreground="{StaticResource AccentBrush}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Grid.Row="2"><TextBlock Text="{Binding AdminWeather0217NextDecision}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><WrapPanel Margin="0,12,0,0"><Button Content="Начать путь" Command="{Binding StartAdminTravel0217Command}" Margin="0,0,8,0"/><Button Content="Завершить текущий участок" Command="{Binding CompleteAdminTravelSegment0217Command}"/></WrapPanel></StackPanel></Grid></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="Правила пути" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="Скорость режима × местность × погода × нагрузка" FontSize="17" Margin="0,12,0,0"/><TextBlock Text="Запасы читаются из инвентаря группы; отдельное хранилище не создаётся." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border></Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding AdminWeather0217Status}" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,8,0,0"/>
    </Grid>
</UserControl>
