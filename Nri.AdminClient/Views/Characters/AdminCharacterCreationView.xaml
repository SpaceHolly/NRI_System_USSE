<UserControl x:Class="Nri.AdminClient.Views.Characters.AdminCharacterCreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf">
    <Grid Margin="8" AutomationProperties.AutomationId="AdminCharacterCreation_Route">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:NriPageHeader Grid.Row="0" Title="Создание персонажей" Subtitle="Заявки игроков, прямое создание GM и серверный предпросмотр Character v2." StatusText="{Binding Status}" AutomationProperties.AutomationId="AdminCharacterCreation_Header">
            <controls:NriPageHeader.PrimaryAction><Button Content="Обновить" Command="{Binding LoadCommand}" AutomationProperties.AutomationId="AdminCharacterCreation_Refresh"/></controls:NriPageHeader.PrimaryAction>
            <controls:NriPageHeader.SecondaryActions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Правила кампании" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="230" ItemsSource="{Binding Policies}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Policy}" AutomationProperties.AutomationId="AdminCharacterCreation_Policy"/>
                    <Button Content="Сохранить правила" Command="{Binding SavePolicyCommand}" Style="{StaticResource GhostButtonStyle}" AutomationProperties.AutomationId="AdminCharacterCreation_PolicySave"/>
                </StackPanel>
            </controls:NriPageHeader.SecondaryActions>
        </controls:NriPageHeader>

        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Ожидают решения" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="Заявки на создание из этой кампании." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="Прямое создание GM" Command="{Binding NewDirectCommand}" AutomationProperties.AutomationId="AdminCharacterCreation_NewDirect"/>
                        <Expander Header="Изменить структуру существующего" Margin="0,8,0,0"
                                  AutomationProperties.AutomationId="AdminCharacterCreation_StructuralSection">
                            <StackPanel Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding ExistingCharacters}" SelectedItem="{Binding SelectedStructuralCharacter}" DisplayMemberPath="Name" AutomationProperties.AutomationId="AdminCharacterCreation_StructuralCharacter"/>
                                <Button Content="Открыть структуру" Command="{Binding LoadStructuralCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminCharacterCreation_StructuralOpen"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Начальное развитие" Margin="0,8,0,0"
                                  AutomationProperties.AutomationId="AdminInitialDevelopment_Policy">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Правила стартового пакета" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding InitialDevelopmentClassRule}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding InitialDevelopmentMagicRule}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding InitialDevelopmentSessionRule}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Сбросить стартовый пакет" FontWeight="SemiBold"/>
                                <TextBlock Text="Используется выбранный выше персонаж. Сброс возможен только до последующих приобретений развития."
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <TextBox Text="{Binding InitialDevelopmentResetReason, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"
                                         ToolTip="Обязательная причина сброса" AutomationProperties.AutomationId="AdminInitialDevelopment_ResetReason"/>
                                <Button Content="Сбросить начальное развитие" Command="{Binding ResetInitialDevelopmentCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,7,0,0"
                                        AutomationProperties.AutomationId="AdminInitialDevelopment_Reset"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding PendingDrafts}" SelectedItem="{Binding SelectedPending}" DisplayMemberPath="Summary" AutomationProperties.AutomationId="AdminCharacterCreation_PendingList">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="AdminCharacterCreation_FormScroll">
                    <StackPanel>
                        <TextBlock Text="Карточка создания" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="Поля со звёздочкой обязательны. Все расчёты выполняет сервер." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                        <TextBlock Text="Владелец *"/>
                        <ComboBox ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}" DisplayMemberPath="Summary" AutomationProperties.AutomationId="AdminCharacterCreation_Owner"/>
                        <TextBlock Text="Имя *" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.AutomationId="AdminCharacterCreation_Name"/>
                        <TextBlock Text="Предыстория" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding Backstory, UpdateSourceTrigger=PropertyChanged}" MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminCharacterCreation_Backstory"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Линия первого родителя *"/><ComboBox ItemsSource="{Binding ParentOrigins}" SelectedItem="{Binding Parent1}" DisplayMemberPath="Name" AutomationProperties.AutomationId="AdminCharacterCreation_Parent1"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Линия второго родителя *"/><ComboBox ItemsSource="{Binding ParentOrigins}" SelectedItem="{Binding Parent2}" DisplayMemberPath="Name" AutomationProperties.AutomationId="AdminCharacterCreation_Parent2"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Подтип" Margin="0,8,0,0"/>
                        <ComboBox ItemsSource="{Binding AvailableSubtypes}" SelectedItem="{Binding Subtype}" DisplayMemberPath="Name" AutomationProperties.AutomationId="AdminCharacterCreation_Subtype"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Рост, см *"/><TextBox Text="{Binding HeightCm, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminCharacterCreation_Height"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Возраст *"/><TextBox Text="{Binding AgeYears, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminCharacterCreation_Age"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Характеристики" Style="{StaticResource SectionTitleTextStyle}" Margin="0,14,0,6"/>
                        <ItemsControl ItemsSource="{Binding Attributes}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.AttributeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Allocated}"/><TextBlock Grid.Column="2" Text="{Binding Effective, StringFormat=Итого: {0}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Expander Header="Подхарактеристики" Margin="0,10,0,0"><ItemsControl ItemsSource="{Binding SubAttributes}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.AttributeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Allocated}"/><TextBlock Grid.Column="2" Text="{Binding Effective, StringFormat=Итого: {0}}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              AutomationProperties.AutomationId="AdminCharacterCreation_PreviewScroll">
                    <StackPanel AutomationProperties.AutomationId="AdminCharacterCreation_PlayerPreview">
                        <TextBlock Text="Предпросмотр" Style="{StaticResource SectionTitleTextStyle}"/>
                        <controls:NriStatusBadge Text="{Binding ResolvedOrigin}" StatusKind="Info" Margin="0,6,0,8" AutomationProperties.AutomationId="AdminCharacterCreation_ResolvedOrigin"/>
                        <TextBlock Text="{Binding OriginDescription}" TextWrapping="Wrap"/>
                        <TextBlock Text="Сильные стороны" FontWeight="SemiBold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding StrongSides}"/>
                        <TextBlock Text="Слабые стороны" FontWeight="SemiBold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding WeakSides}"/>
                        <TextBlock Text="Особенности" FontWeight="SemiBold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding Traits}"/>
                        <TextBlock Text="Языки" FontWeight="SemiBold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding Languages}"/>
                        <Border Style="{StaticResource SubtleCardStyle}" Margin="0,12,0,0"><TextBlock Text="{Binding Validation}" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminCharacterCreation_Validation"/></Border>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Сохранить черновик" Command="{Binding SaveDirectCommand}" AutomationProperties.AutomationId="AdminCharacterCreation_Save"/>
                            <Button Content="Проверить" Command="{Binding PreviewCommand}" Style="{StaticResource GhostButtonStyle}" AutomationProperties.AutomationId="AdminCharacterCreation_Preview"/>
                            <Button Content="Создать персонажа" Command="{Binding FinalizeDirectCommand}" AutomationProperties.AutomationId="AdminCharacterCreation_FinalizeDirect"/>
                        </WrapPanel>
                        <Expander Header="Применить структурное изменение" IsExpanded="{Binding IsStructuralMode, Mode=OneWay}" Margin="0,12,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Причина изменения *"/>
                                <TextBox Text="{Binding StructuralReason, UpdateSourceTrigger=PropertyChanged}" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminCharacterEdit_StructuralReason"/>
                                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminCharacterEdit_ImpactPreview">
                                    <StackPanel>
                                        <TextBlock Text="Оценка последствий" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StructuralImpactSummary}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                        <ItemsControl ItemsSource="{Binding StructuralImpactItems}">
                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Button Content="Применить структуру" Command="{Binding ApplyStructuralCommand}" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminCharacterCreation_StructuralApply"/>
                            </StackPanel>
                        </Expander>
                        <Separator Margin="0,14"/>
                        <TextBlock Text="Решение по заявке" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBox Text="{Binding ReturnComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Комментарий игроку при возврате" AutomationProperties.AutomationId="AdminCharacterCreation_ReturnComment"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Одобрить" Command="{Binding ApproveCommand}" AutomationProperties.AutomationId="AdminCharacterCreation_Approve"/>
                            <Button Content="Вернуть на доработку" Command="{Binding ReturnCommand}" Style="{StaticResource GhostButtonStyle}" AutomationProperties.AutomationId="AdminCharacterCreation_Return"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <controls:NriToastHost Grid.Row="2" Message="{Binding Status}" IsOpen="True" AutomationProperties.AutomationId="AdminCharacterCreation_Status"/>
    </Grid>
</UserControl>
