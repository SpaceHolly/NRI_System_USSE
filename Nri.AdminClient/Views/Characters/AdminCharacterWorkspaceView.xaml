<UserControl x:Class="Nri.AdminClient.Views.Characters.AdminCharacterWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:characters="clr-namespace:Nri.AdminClient.Views.Characters">
                        <Grid Margin="8" IsEnabled="{Binding ArePrivilegedSectionsEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="Персонажи" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock Text="Карточки персонажей и редактор профиля персонажа." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        <TextBox Text="{Binding CharactersSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по имени, ID или владельцу" Margin="0,0,0,8"/>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <WrapPanel>
                                            <Button AutomationProperties.AutomationId="AdminCharacterEditor_Open_Button" Content="Открыть" Command="{Binding OpenCharacterCommand}" IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                            <Button AutomationProperties.AutomationId="AdminCharacterEditor_Refresh_Button" Style="{StaticResource GhostButtonStyle}" Content="Обновить" Command="{Binding RefreshSelectedCharacterCommand}" IsEnabled="{Binding CanOpenSelectedCharacter}"/>
                                        </WrapPanel>
                                            <TextBlock Text="Выберите персонажа, чтобы открыть редактор профиля." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding FilteredCharacters}"
                                              AutomationProperties.AutomationId="AdminCharacters_List"
                                              AutomationProperties.Name="Список персонажей"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedCharacterId, UpdateSourceTrigger=PropertyChanged}"
                                              AutoGenerateColumns="False"
                                              MinHeight="420"
                                              HorizontalScrollBarVisibility="Auto"
                                              ColumnWidth="SizeToHeader"
                                              MinColumnWidth="120">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="160"/>
                                            <DataGridTextColumn Header="Детали" Binding="{Binding Extra}" Width="220"/>
                                            <DataGridTextColumn Header="Технический ID" Binding="{Binding Id}" Width="220"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <ScrollViewer Grid.Column="1" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <DockPanel LastChildFill="True">
                                                        <Border DockPanel.Dock="Top"
                                    Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,8"
                                    AutomationProperties.AutomationId="AdminCharacterEditor_OwnerGroupStatus_Section"
                                    AutomationProperties.Name="Владелец, группа и статус">
                                <StackPanel>
                                    <TextBlock Text="Владелец, группа и статус" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="{Binding OwnershipSummary}"
                                               AutomationProperties.AutomationId="AdminCharacterEditor_OwnerGroupStatus_Summary"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,4,0,8"
                                               TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Владелец" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox AutomationProperties.AutomationId="AdminCharacterEditor_OwnerUserId"
                                                     Text="{Binding OwnershipOwnerUserId, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Управляет" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                            <TextBox AutomationProperties.AutomationId="AdminCharacterEditor_ControlledByUserId"
                                                     Text="{Binding OwnershipControlledByUserId, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Причина" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                            <TextBox AutomationProperties.AutomationId="AdminCharacterEditor_Archive_Reason"
                                                     Text="{Binding OwnershipReason, UpdateSourceTrigger=PropertyChanged}"/>
                                            <CheckBox AutomationProperties.AutomationId="AdminCharacterEditor_OwnerVisible"
                                                      Content="Видно игрокам"
                                                      IsChecked="{Binding OwnershipIsPlayerVisible, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="0,6,0,0"/>
                                            <Button AutomationProperties.AutomationId="AdminCharacterEditor_OwnerSave_Button"
                                                    Content="Сохранить владельца"
                                                    Command="{Binding OwnershipSaveOwnerCommand}"
                                                    IsEnabled="{Binding CanManageSelectedCharacter}"
                                                    Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Группа" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox AutomationProperties.AutomationId="AdminCharacterEditor_GroupId"
                                                     Text="{Binding OwnershipGroupId, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="{Binding OwnershipGroupName, StringFormat=Текущая: {0}, TargetNullValue=Текущая: —}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"/>
                                            <Button AutomationProperties.AutomationId="AdminCharacterEditor_GroupAssign_Button"
                                                    Content="Назначить группу"
                                                    Command="{Binding OwnershipAssignGroupCommand}"
                                                    IsEnabled="{Binding CanManageSelectedCharacter}"
                                                    Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Тип персонажа" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox AutomationProperties.AutomationId="AdminCharacterEditor_CharacterKind"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding OwnershipKind, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="Персонаж игрока" Tag="player_character"/>
                                                <ComboBoxItem Content="NPC" Tag="npc"/>
                                                <ComboBoxItem Content="Компаньон" Tag="companion"/>
                                                <ComboBoxItem Content="Другое" Tag="custom"/>
                                            </ComboBox>
                                            <TextBlock Text="Статус" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                            <ComboBox AutomationProperties.AutomationId="AdminCharacterEditor_Status"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding OwnershipStatus, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="Активен" Tag="active"/>
                                                <ComboBoxItem Content="Неактивен" Tag="inactive"/>
                                                <ComboBoxItem Content="В архиве" Tag="archived"/>
                                            </ComboBox>
                                            <CheckBox AutomationProperties.AutomationId="AdminCharacterEditor_IsActive"
                                                      Content="Активен"
                                                      IsChecked="{Binding OwnershipIsActive, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="0,6,0,0"/>
                                            <CheckBox AutomationProperties.AutomationId="AdminCharacterEditor_IsArchived"
                                                      Content="В архиве"
                                                      IsChecked="{Binding OwnershipIsArchived, UpdateSourceTrigger=PropertyChanged}"/>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button AutomationProperties.AutomationId="AdminCharacterEditor_StatusSave_Button"
                                                        Content="Сохранить статус"
                                                        Command="{Binding OwnershipSaveKindStatusCommand}"
                                                        IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                                <Button AutomationProperties.AutomationId="AdminCharacterEditor_Main_Archive_Button"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Content="В архив"
                                                        Command="{Binding OwnershipArchiveCommand}"
                                                        IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                                <Button AutomationProperties.AutomationId="AdminCharacterEditor_Main_Unarchive_Button"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Content="Вернуть"
                                                        Command="{Binding OwnershipUnarchiveCommand}"
                                                        IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding OwnershipMessage}"
                                               AutomationProperties.AutomationId="AdminCharacterEditor_OwnerGroupStatus_Message"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OwnershipMessage}"
                                               AutomationProperties.AutomationId="AdminCharacterEditor_Archive_Status"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                                                        <Border DockPanel.Dock="Top"
                                    Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,8"
                                    AutomationProperties.AutomationId="AdminCharacterEditor_Attributes_Table_Body"
                                    AutomationProperties.Name="Character v2 attributes editor">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Характеристики" Style="{StaticResource SectionTitleTextStyle}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="Запись в профиль Character v2" Foreground="{StaticResource MutedTextBrush}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="&#1060;&#1080;&#1085;&#1072;&#1085;&#1089;&#1099; &#1080; &#1052;&#1054;"
                                                   Style="{StaticResource SectionTitleTextStyle}"
                                                   DockPanel.Dock="Left"/>
                                        <TextBlock Text="Кошелёк RuleSet"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding CurrencyEditorRows}"
                                                  Margin="0,6,0,0"
                                                  AutomationProperties.AutomationId="AdminCharacterEditor_Currencies_Table">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SubtleCardStyle}"
                                                        Width="240"
                                                        Margin="0,0,8,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="78"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding RangeText}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBox Grid.Column="1"
                                                                 Height="28"
                                                                 AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                 AutomationProperties.Name="{Binding DisplayName}"
                                                                 IsEnabled="{Binding IsEditableByGM}"
                                                                 Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Content="&#1057;&#1086;&#1093;&#1088;&#1072;&#1085;&#1080;&#1090;&#1100; &#1074;&#1072;&#1083;&#1102;&#1090;&#1099;"
                                                AutomationProperties.AutomationId="AdminCharacterEditor_SaveCurrencies_Button"
                                                Command="{Binding SaveMoneyCommand}"
                                                IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Content="&#1057;&#1086;&#1093;&#1088;&#1072;&#1085;&#1080;&#1090;&#1100; &#1052;&#1054;"
                                                AutomationProperties.AutomationId="AdminCharacterEditor_SaveXpCoins_Button"
                                                Command="{Binding SaveXpCoinsCommand}"
                                                IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                        <TextBlock Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="AdminCharacterEditor_SaveCurrencies_Status"
                                                   Text="{Binding CharacterMoneySaveStatus}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </WrapPanel>
                                    <Separator Margin="0,10,0,6"/>
                                    <ItemsControl ItemsSource="{Binding AttributeEditorRows}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        <TextBox Grid.Column="1"
                                                                 Height="30"
                                                                 Focusable="True"
                                                                 AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                 AutomationProperties.Name="{Binding DisplayName}"
                                                                 IsEnabled="{Binding IsEditableByGM}"
                                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Grid.Column="2" Margin="10,0,0,0" Text="{Binding RangeText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding SubAttributes}" Margin="18,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2,0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               FontSize="12"
                                                                               Text="{Binding DisplayName}"
                                                                               VerticalAlignment="Center"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                    <TextBox Grid.Column="1"
                                                                             Height="26"
                                                                             FontSize="12"
                                                                             AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                             AutomationProperties.Name="{Binding DisplayName}"
                                                                             IsEnabled="{Binding IsEditableByGM}"
                                                                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Margin="8,0,0,0"
                                                                               FontSize="11"
                                                                               Text="{Binding RangeText}"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3"
                                                                               Margin="8,0,0,0"
                                                                               FontSize="11"
                                                                               Text="{Binding VisibilityText}"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Сохранить"
                                                AutomationProperties.AutomationId="AdminCharacterEditor_SaveAttributes_Button_Body"
                                                Command="{Binding SaveStatsCommand}"
                                                IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                        <TextBlock Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="AdminCharacterEditor_SaveAttributes_Status_Body"
                                                   Text="{Binding CharacterStatsSaveStatus}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TabControl SelectedIndex="1">
                                <TabItem Header="Карточка" AutomationProperties.AutomationId="AdminCharacterEditor_Card_Tab">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Карточка персонажа" Style="{StaticResource TitleTextStyle}"/>
                                                    <TextBlock Text="Сводка Character v2: профиль, характеристики, финансы и player-safe предпросмотр." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <characters:CharacterCardView DataContext="{Binding CharacterCard}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="Профиль GM"
                                         AutomationProperties.AutomationId="AdminCharacterEditor_Profile_Tab"
                                         AutomationProperties.Name="Профиль GM">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Профиль GM" Style="{StaticResource SectionTitleTextStyle}"/>
                                                    <TextBlock Text="Редактирование Character v2: имя, раса, возраст, описание, предыстория, видимость и заметки GM." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                    <TextBlock Text="{Binding SelectedCharacterSummary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource SubtleCardStyle}" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Основные данные" Style="{StaticResource TitleTextStyle}"/>
                                                        <TextBlock Text="Имя" Margin="0,6,0,0"/>
                                                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="Раса" Margin="0,6,0,0"/>
                                                        <TextBox Text="{Binding EditRace, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="Рост / возраст" Margin="0,6,0,0"/>
                                                        <WrapPanel>
                                                            <TextBox Width="140" Text="{Binding EditHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="Рост"/>
                                                            <TextBox Width="100" Margin="8,0,0,0" Text="{Binding EditAge, UpdateSourceTrigger=PropertyChanged}" ToolTip="Возраст"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="Описание" Margin="0,6,0,0"/>
                                                        <TextBox Height="70" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="Предыстория / Backstory" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminCharacterEditor_Biography_Tab"/>
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <Button AutomationProperties.AutomationId="AdminCharacterEditor_SaveBiography_Button"
                                                                    HorizontalAlignment="Left"
                                                                 Content="Сохранить"
                                                                    Command="{Binding SaveBiographyCommand}"
                                                                    IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                                            <TextBlock AutomationProperties.AutomationId="AdminCharacterEditor_SaveBiography_Status"
                                                                       Margin="10,4,0,0"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       Text="{Binding BiographySaveStatus}"/>
                                                        </WrapPanel>
                                                        <TextBox AutomationProperties.AutomationId="AdminCharacterEditor_Backstory_Text"
                                                                 AutomationProperties.Name="Предыстория"
                                                                 Height="130"
                                                                 Margin="0,8,0,0"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 AcceptsTab="True"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 Text="{Binding EditBackstory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Сохранить основные данные" Command="{Binding SaveBasicInfoCommand}" IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1" Style="{StaticResource SubtleCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Видимость для игрока" Style="{StaticResource TitleTextStyle}"/>
                                                        <CheckBox Content="Скрыть описание" IsChecked="{Binding VisHideDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <CheckBox Content="Скрыть предысторию" IsChecked="{Binding VisHideBackstory, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <CheckBox Content="Скрыть характеристики" IsChecked="{Binding VisHideStats, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <CheckBox Content="Скрыть репутацию" IsChecked="{Binding VisHideReputation, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <Button Content="Загрузить" Command="{Binding VisibilityLoadCommand}" IsEnabled="{Binding CanManageCharacterVisibility}"/>
                                                            <Button Style="{StaticResource GhostButtonStyle}" Content="Сохранить" Command="{Binding VisibilitySaveCommand}" IsEnabled="{Binding CanManageCharacterVisibility}"/>
                                                        </WrapPanel>
                                                        <Separator Margin="0,10,0,8"/>
                                                        <TextBlock Text="GM-заметка" Style="{StaticResource TitleTextStyle}"/>
                                                        <TextBox Text="{Binding NoteTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Заголовок заметки"/>
                                                        <TextBox Height="70" Margin="0,6,0,0" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Текст заметки"/>
                                                        <WrapPanel Margin="0,6,0,0">
                                                            <ComboBox Width="180" SelectedValuePath="Tag" SelectedValue="{Binding NoteVisibility, UpdateSourceTrigger=PropertyChanged}">
                                                                <ComboBoxItem Content="Личное" Tag="Private"/>
                                                                <ComboBoxItem Content="Модератор" Tag="Moderator"/>
                                                                <ComboBoxItem Content="Публичное" Tag="Public"/>
                                                            </ComboBox>
                                                            <Button Content="Создать" Command="{Binding NotesCreateCommand}" IsEnabled="{Binding CanCreateNote}"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Border Style="{StaticResource CardStyle}"
                                                    Margin="0,8,0,0">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="&#1060;&#1080;&#1085;&#1072;&#1085;&#1089;&#1099; &#1080; &#1086;&#1087;&#1099;&#1090;" Style="{StaticResource SectionTitleTextStyle}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="Кошелёк Character v2" Foreground="{StaticResource MutedTextBrush}" DockPanel.Dock="Right"/>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding CurrencyEditorRows}"
                                                                  Margin="0,8,0,0"
                                                                  AutomationProperties.AutomationId="AdminCharacterEditor_Currencies_Table">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3,0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding VisibilityText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                                    </StackPanel>
                                                                    <TextBox Grid.Column="1"
                                                                             Height="30"
                                                                             AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                             AutomationProperties.Name="{Binding DisplayName}"
                                                                             IsEnabled="{Binding IsEditableByGM}"
                                                                             Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Margin="8,0,0,0"
                                                                               Text="{Binding RangeText}"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Button Content="&#1057;&#1086;&#1093;&#1088;&#1072;&#1085;&#1080;&#1090;&#1100; &#1074;&#1072;&#1083;&#1102;&#1090;&#1099;"
                                                                AutomationProperties.AutomationId="AdminCharacterEditor_SaveCurrencies_Button"
                                                                Command="{Binding SaveMoneyCommand}"
                                                                IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                                Content="&#1057;&#1086;&#1093;&#1088;&#1072;&#1085;&#1080;&#1090;&#1100; &#1052;&#1054;"
                                                                AutomationProperties.AutomationId="AdminCharacterEditor_SaveXpCoins_Button"
                                                                Command="{Binding SaveXpCoinsCommand}"
                                                                IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                                        <TextBlock Margin="12,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   AutomationProperties.AutomationId="AdminCharacterEditor_SaveCurrencies_Status"
                                                                   Text="{Binding CharacterMoneySaveStatus}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                                                                        <Border Style="{StaticResource CardStyle}"
                                                    Margin="0,8,0,0"
                                                    AutomationProperties.AutomationId="AdminCharacterEditor_Attributes_Table_Inline"
                                                    AutomationProperties.Name="Характеристики Character v2">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="Состояние и защиты" Style="{StaticResource SectionTitleTextStyle}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="RuleSet: состояние и защиты" Foreground="{StaticResource MutedTextBrush}" DockPanel.Dock="Right"/>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding VitalsEditorRows}"
                                                                  Margin="0,8,0,0"
                                                                  AutomationProperties.AutomationId="AdminCharacterEditor_Vitals_Table"
                                                                  AutomationProperties.Name="Состояние и защиты">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,3,0,5">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
