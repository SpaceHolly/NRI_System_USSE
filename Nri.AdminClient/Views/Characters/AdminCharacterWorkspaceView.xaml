                                                                <TextBox Margin="0,6,0,0" Text="{Binding CompanionOwnerCharacterIdInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="ID персонажа-владельца"/>
                                                                <TextBox Margin="0,6,0,0" Text="{Binding CompanionOwnerDisplayNameInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Владелец"/>
                                                                <TextBox AutomationProperties.AutomationId="AdminCharacterEditor_Companion_StatusField" Margin="0,6,0,0" Text="{Binding CompanionStatusInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Статус"/>
                                                                <TextBlock AutomationProperties.AutomationId="AdminCharacterEditor_Companion_Status" Text="{Binding CompanionStatusInput, StringFormat=Статус: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                                <TextBox Margin="0,6,0,0" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding CompanionDescriptionInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Описание"/>
                                                                <TextBox Margin="0,6,0,0" Height="55" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding CompanionNotesInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Заметки"/>
                                                                <TextBlock Text="{Binding CompanionOwnCollectionsPreview}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                                <WrapPanel Margin="0,6,0,0">
                                                                    <CheckBox AutomationProperties.AutomationId="AdminCharacterEditor_Companion_Visible" Content="Видно игрокам" IsChecked="{Binding CompanionIsPlayerVisibleInput, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <CheckBox Margin="12,0,0,0" Content="Архив" IsChecked="{Binding CompanionIsArchivedInput, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </WrapPanel>
                                                                <WrapPanel Margin="0,8,0,0">
                                                                    <Button AutomationProperties.AutomationId="AdminCharacterEditor_Companion_Add_Button" Content="Добавить" Command="{Binding CompanionAddCommand}" IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                                                    <Button AutomationProperties.AutomationId="AdminCharacterEditor_Companion_Update_Button" Style="{StaticResource GhostButtonStyle}" Content="Сохранить" Command="{Binding CompanionUpdateCommand}" IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                                                    <Button AutomationProperties.AutomationId="AdminCharacterEditor_Companion_Remove_Button" Style="{StaticResource GhostButtonStyle}" Content="Удалить" Command="{Binding CompanionRemoveCommand}" IsEnabled="{Binding CanManageSelectedCharacter}"/>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </TabItem>
                                            </TabControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="Предпросмотр игрока" AutomationProperties.AutomationId="AdminCharacterEditor_PlayerPreview_Tab">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Player Preview" Style="{StaticResource TitleTextStyle}"/>
                                                    <TextBlock Text="Предпросмотр для игрока без заметок GM, сырого payload и ServerOnlyData." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                    <Button HorizontalAlignment="Left" Content="Открыть player-safe вид" Command="{Binding CharacterCard.SwitchToPlayerPreviewModeCommand}"/>
                                                </StackPanel>
                                            </Border>
                                            <characters:CharacterCardView DataContext="{Binding CharacterCard}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                            </DockPanel>
                            </ScrollViewer>
                        </Grid>
</UserControl>

