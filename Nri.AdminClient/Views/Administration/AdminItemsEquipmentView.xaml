<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminItemsEquipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.AdminClient.ViewModels"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             DataContext="{Binding ItemsEquipmentCatalog}"
             Background="{StaticResource NriApplicationBackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             AutomationProperties.AutomationId="AdminEquipmentDefinitions_Route">
    <patterns:NriOperationalWorkspaceHost Margin="10">
        <patterns:NriOperationalWorkspaceHost.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:NriPageHeader Breadcrumbs="Администрирование"
                                        Title="Снаряжение и ресурсы"
                                        Subtitle="Ресурсы, предметы, типы урона, оружие, боеприпасы, броня и щиты."
                                        StatusText="{Binding StatusMessage}"
                                        AutomationProperties.AutomationId="AdminEquipmentDefinitions_Header"/>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Обновить"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="AdminEquipmentDefinitions_Refresh"/>
                    <Button Content="Новая запись"
                            Command="{Binding NewCommand}"
                            Margin="8,0,0,0"
                            AutomationProperties.AutomationId="AdminEquipmentDefinitions_New"/>
                </WrapPanel>
            </Grid>
        </patterns:NriOperationalWorkspaceHost.Header>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Семейство справочника" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Families}"
                                  SelectedItem="{Binding SelectedFamily, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,5,0,0"
                                  AutomationProperties.AutomationId="AdminEquipmentDefinitions_Family"/>
                        <TextBlock Text="{Binding SelectedFamilyDescription}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,10"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по названию, категории и тегам."
                                 AutomationProperties.Name="Поиск по названию, категории и тегам"
                                 AutomationProperties.AutomationId="AdminEquipmentDefinitions_Search"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding ArchiveFilters}"
                                      SelectedItem="{Binding SelectedArchiveFilter}"
                                      AutomationProperties.Name="Фильтр по архиву"
                                      AutomationProperties.AutomationId="AdminEquipmentDefinitions_ArchiveFilter"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VisibilityFilters}"
                                      SelectedItem="{Binding SelectedVisibilityFilter}"
                                      Margin="6,0,0,0"
                                      AutomationProperties.Name="Фильтр по видимости"
                                      AutomationProperties.AutomationId="AdminEquipmentDefinitions_VisibilityFilter"/>
                        </Grid>
                        <Button Content="Применить фильтры"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,6,0,10"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="AdminEquipmentDefinitions_ApplyFilters"/>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Definitions}"
                             SelectedItem="{Binding SelectedDefinition, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             AutomationProperties.AutomationId="AdminEquipmentDefinitions_List">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EquipmentDefinitionListItemVm}">
                                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CategoryDisplay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding VisibilityDisplay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{StaticResource WarningBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TabControl AutomationProperties.AutomationId="AdminEquipmentDefinitions_EditorTabs">
                        <TabItem Header="Редактор">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          AutomationProperties.AutomationId="AdminEquipmentDefinitions_EditScroll">
                                <StackPanel Margin="4,6,12,12">
                                    <TextBlock Text="{Binding Editor.FamilyDisplay}"
                                               Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="Поля со звёздочкой обязательны. Внутренние идентификаторы создаются сервером."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Название *" Margin="0,12,0,4"/>
                                    <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="AdminEquipmentDefinitions_Name"/>
                                    <TextBlock Text="Категория / тип *" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding Editor.ProfileCategory, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Человекочитаемая группа для поиска и фильтрации."
                                             AutomationProperties.AutomationId="AdminEquipmentDefinitions_Category"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Набор правил"/>
                                            <ComboBox SelectedValuePath="Tag"
                                                      SelectedValue="{Binding Editor.RuleSetId, Mode=TwoWay}"
                                                      AutomationProperties.AutomationId="AdminEquipmentDefinitions_RuleSet">
                                                <ComboBoxItem Content="Fantasy NRI" Tag="fantasy_nri_default"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Видимость"/>
                                            <ComboBox SelectedValuePath="Tag"
                                                      SelectedValue="{Binding Editor.VisibilityRule, Mode=TwoWay}"
                                                      AutomationProperties.AutomationId="AdminEquipmentDefinitions_Visibility">
                                                <ComboBoxItem Content="Видно игрокам" Tag="public"/>
                                                <ComboBoxItem Content="Только GM" Tag="gm_only"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Теги" Margin="0,8,0,4"/>
                                    <controls:NriTagEditor Text="{Binding Editor.TagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="Добавьте тег"
                                                           AccessibleName="Теги определения"
                                                           AutomationProperties.AutomationId="AdminEquipmentDefinitions_Tags"/>
                                    <TextBlock Text="Описание для игроков" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding Editor.PublicDescription, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                             AutomationProperties.AutomationId="AdminEquipmentDefinitions_PublicDescription"/>
                                    <TextBlock Text="Правовой статус" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding Editor.Legality, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Публичное правило доступности, лицензирования или ограничения. Внутреннее обоснование хранится только в заметках GM."/>

                                    <Border Style="{StaticResource SubtleCardStyle}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Профиль определения" Style="{StaticResource TitleTextStyle}"/>

                                            <StackPanel Visibility="{Binding Editor.IsResource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Единица измерения *"/><TextBox Text="{Binding Editor.Unit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminEquipment_Resource_Unit"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Физическое состояние"/><TextBox Text="{Binding Editor.PhysicalState, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Редкость"/><TextBox Text="{Binding Editor.Rarity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Масса единицы"/><controls:NriDecimalField Value="{Binding Editor.MassPerUnit}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Объём единицы"/><controls:NriDecimalField Value="{Binding Editor.VolumePerUnit}"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Базовая ценность"/><controls:NriDecimalField Value="{Binding Editor.BaseValue}"/></StackPanel>
                                                </Grid>
                                                <CheckBox Content="Поддерживает качество" IsChecked="{Binding Editor.SupportsQuality}" Margin="0,8,0,0"/>
                                                <TextBlock Text="Требования к хранению" Margin="0,8,0,4"/>
                                                <TextBox Text="{Binding Editor.StorageRequirements, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding Editor.IsItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Масса"/><controls:NriDecimalField Value="{Binding Editor.Mass}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Размер"/><TextBox Text="{Binding Editor.Size, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Прочность"/><controls:NriIntegerField Value="{Binding Editor.Durability}"/></StackPanel>
                                                </Grid>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <CheckBox Content="Складывается в стек" IsChecked="{Binding Editor.Stackable}"/>
                                                    <TextBlock Text="Максимум в стеке" Margin="14,4,6,0"/>
                                                    <controls:NriIntegerField Width="90" Value="{Binding Editor.MaxStack}"/>
                                                </WrapPanel>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Качество"/><TextBox Text="{Binding Editor.Quality, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Редкость"/><TextBox Text="{Binding Editor.Rarity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Базовая ценность"/><controls:NriDecimalField Value="{Binding Editor.BaseValue}"/></StackPanel>
                                                </Grid>
                                                <TextBlock Text="Совместимые зоны тела" Margin="0,8,0,4"/>
                                                <ListBox ItemsSource="{Binding Editor.BodyCompatibilityOptions}" MaxHeight="130">
                                                    <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/></DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding Editor.IsDamageType, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Классификация"/>
                                                <TextBox Text="{Binding Editor.Classification, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Теги сопротивления"/><TextBox Text="{Binding Editor.ResistanceTags, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Теги уязвимости"/><TextBox Text="{Binding Editor.VulnerabilityTags, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Теги иммунитета"/><TextBox Text="{Binding Editor.ImmunityTags, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding Editor.IsWeapon, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.AutomationId="AdminEquipment_Weapon_Profile">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Масштаб"/><TextBox Text="{Binding Editor.Scale, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Дальность"/><TextBox Text="{Binding Editor.Range, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Перезарядка"/><TextBox Text="{Binding Editor.ReloadRules, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                </Grid>
                                                <TextBlock Text="Природа оружия" Margin="0,8,0,4"/>
                                                <TextBox Text="{Binding Editor.WeaponNatures, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: дальнобойное, энергетическое, магическое."/>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Обязательные навыки"/>
                                                        <ListBox ItemsSource="{Binding Editor.RequiredSkillOptions}" MaxHeight="120">
                                                            <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/></DataTemplate></ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Обязательные характеристики"/>
                                                        <ListBox ItemsSource="{Binding Editor.RequiredAttributeOptions}" MaxHeight="120">
                                                            <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/></DataTemplate></ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                        <TextBlock Text="Требования к телу / росту"/>
                                                        <ListBox ItemsSource="{Binding Editor.BodyRequirementOptions}" MaxHeight="120">
                                                            <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/></DataTemplate></ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="Совместимые боеприпасы" Margin="0,10,0,4"/>
                                                <ListBox ItemsSource="{Binding Editor.AmmoOptions}" MaxHeight="130" AutomationProperties.AutomationId="AdminEquipment_Weapon_AmmoPicker">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected}">
                                                                <StackPanel><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <DockPanel Margin="0,12,0,4">
                                                    <TextBlock Text="Профили атаки" Style="{StaticResource TitleTextStyle}"/>
                                                    <Button DockPanel.Dock="Right" Content="Добавить профиль" Command="{Binding AddAttackProfileCommand}" AutomationProperties.AutomationId="AdminEquipment_Weapon_AddAttackProfile"/>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Editor.AttackProfiles}" AutomationProperties.AutomationId="AdminEquipment_Weapon_AttackProfiles">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:EquipmentAttackProfileVm}">
                                                            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="240" ToolTip="Название профиля атаки"/>
                                                                        <Button DockPanel.Dock="Right" Content="Удалить"
                                                                                Command="{Binding DataContext.RemoveAttackProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" Style="{StaticResource GhostButtonStyle}"/>
                                                                    </DockPanel>
                                                                    <Grid Margin="0,8,0,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                        <StackPanel><TextBlock Text="Навык *"/><ComboBox ItemsSource="{Binding SkillOptions}" SelectedItem="{Binding SelectedSkill}" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Подхарактеристика"/><ComboBox ItemsSource="{Binding SubAttributeOptions}" SelectedItem="{Binding SelectedSubAttribute}" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                                                                        <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Тип урона *"/><ComboBox ItemsSource="{Binding DamageTypeOptions}" SelectedItem="{Binding SelectedDamageType}" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,8,0,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                        <StackPanel><TextBlock Text="Тип атаки"/><TextBox Text="{Binding AttackType, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Стоимость действия"/><controls:NriIntegerField Value="{Binding ActionCost}"/></StackPanel>
                                                                        <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Тип проверки"/><TextBox Text="{Binding AttackRollType, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                        <StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Область"/><TextBox Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,8,0,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                        <StackPanel><TextBlock Text="Формула урона *"/><TextBox Text="{Binding DamageExpression, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Точность"/><controls:NriIntegerField Value="{Binding AccuracyModifier}"/></StackPanel>
                                                                        <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Дальность"/><TextBox Text="{Binding Range, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                        <StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Расход боеприпасов"/><controls:NriIntegerField Value="{Binding AmmoCost}"/></StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,8,0,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                        <StackPanel><TextBlock Text="Физическое пробитие"/><controls:NriIntegerField Value="{Binding PhysicalPenetration}"/></StackPanel>
                                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Пробитие брони"/><controls:NriIntegerField Value="{Binding ArmorPenetration}"/></StackPanel>
                                                                        <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Магическое пробитие"/><controls:NriIntegerField Value="{Binding MagicPenetration}"/></StackPanel>
                                                                        <StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Моральное пробитие"/><controls:NriIntegerField Value="{Binding MoralePenetration}"/></StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,8,0,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                        <StackPanel><TextBlock Text="Режим огня"/><TextBox Text="{Binding FireMode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Стоимость перезарядки"/><controls:NriIntegerField Value="{Binding ReloadCost}"/></StackPanel>
                                                                    </Grid>
                                                                    <WrapPanel Margin="0,8,0,0">
                                                                        <CheckBox Content="Реакция" IsChecked="{Binding CanReact}"/>
                                                                        <CheckBox Content="Ответный огонь" IsChecked="{Binding CanReturnFire}" Margin="12,0,0,0"/>
                                                                        <CheckBox Content="Парирование" IsChecked="{Binding CanParry}" Margin="12,0,0,0"/>
                                                                        <CheckBox Content="Блок" IsChecked="{Binding CanBlock}" Margin="12,0,0,0"/>
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding Editor.IsAmmo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.AutomationId="AdminEquipment_Ammo_Profile">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Калибр"/><TextBox Text="{Binding Editor.Caliber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Модель расхода"/><TextBox Text="{Binding Editor.ConsumptionModel, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Модель заряда"/><TextBox Text="{Binding Editor.ChargeModel, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Теги совместимости"/><TextBox Text="{Binding Editor.CompatibilityTags, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Требуемые режимы огня"/><TextBox Text="{Binding Editor.RequiredFireModes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                </Grid>
                                                <TextBlock Text="Разрешённые виды оружия" Margin="0,10,0,4"/>
                                                <ListBox ItemsSource="{Binding Editor.AllowedWeaponOptions}" MaxHeight="130" AutomationProperties.AutomationId="AdminEquipment_Ammo_WeaponPicker">
                                                    <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/></DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="Запрещённые виды оружия" Margin="0,8,0,4"/>
                                                <ListBox ItemsSource="{Binding Editor.ForbiddenWeaponOptions}" MaxHeight="110">
                                                    <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/></DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Добавляемые типы урона"/>
                                                        <ListBox ItemsSource="{Binding Editor.DamageAdditionOptions}" MaxHeight="110">
                                                            <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/></DataTemplate></ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Заменяющие типы урона"/>
                                                        <ListBox ItemsSource="{Binding Editor.DamageReplacementOptions}" MaxHeight="110">
                                                            <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/></DataTemplate></ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Физ. пробитие"/><controls:NriIntegerField Value="{Binding Editor.PhysicalPenetrationModifier}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Пробитие брони"/><controls:NriIntegerField Value="{Binding Editor.ArmorPenetrationModifier}"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Маг. пробитие"/><controls:NriIntegerField Value="{Binding Editor.MagicPenetrationModifier}"/></StackPanel>
                                                    <StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Моральное пробитие"/><controls:NriIntegerField Value="{Binding Editor.MoralePenetrationModifier}"/></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Качество"/><TextBox Text="{Binding Editor.Quality, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Осечки и отказы"/><TextBox Text="{Binding Editor.FailureMetadata, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/></StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding Editor.IsArmor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.AutomationId="AdminEquipment_Armor_Profile">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Расчётный размер"/><TextBox Text="{Binding Editor.DesignedSize, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Физическая защита"/><controls:NriIntegerField Value="{Binding Editor.PhysicalDefense}"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Магическая защита"/><controls:NriIntegerField Value="{Binding Editor.MagicalDefense}"/></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Штраф скрытности"/><controls:NriIntegerField Value="{Binding Editor.StealthPenalty}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Шум"/><controls:NriIntegerField Value="{Binding Editor.Noise}"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Требование силы"/><controls:NriIntegerField Value="{Binding Editor.StrengthRequirement}"/></StackPanel>
                                                    <StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Прочность"/><controls:NriIntegerField Value="{Binding Editor.Durability}"/></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Особые сопротивления"/><TextBox Text="{Binding Editor.SpecialResistanceTags, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Скрываемость"/><TextBox Text="{Binding Editor.Concealability, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                </Grid>
                                                <TextBlock Text="Защищаемые зоны" Margin="0,10,0,4"/>
                                                <ListBox ItemsSource="{Binding Editor.ProtectedBodyZoneOptions}" MaxHeight="130">
                                                    <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/></DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="Совместимость с телом" Margin="0,8,0,4"/>
                                                <ListBox ItemsSource="{Binding Editor.BodyCompatibilityOptions}" MaxHeight="110">
                                                    <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/></DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                                <CheckBox Content="Щит имеет собственные профили атаки"
                                                          IsChecked="{Binding Editor.HasShieldProfile}"
                                                          Margin="0,10,0,0"/>
                                                <StackPanel Visibility="{Binding Editor.HasShieldProfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button Content="Добавить профиль щита"
                                                            Command="{Binding AddShieldProfileCommand}"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,8,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding Editor.ShieldAttackProfiles}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:EquipmentAttackProfileVm}">
                                                                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,8">
                                                                    <StackPanel>
                                                                        <DockPanel>
                                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="240"/>
                                                                            <Button DockPanel.Dock="Right" Content="Удалить"
                                                                                    Command="{Binding DataContext.RemoveShieldProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}" Style="{StaticResource GhostButtonStyle}"/>
                                                                        </DockPanel>
                                                                        <Grid Margin="0,8,0,0">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <StackPanel><TextBlock Text="Навык *"/><ComboBox ItemsSource="{Binding SkillOptions}" SelectedItem="{Binding SelectedSkill}" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Тип урона *"/><ComboBox ItemsSource="{Binding DamageTypeOptions}" SelectedItem="{Binding SelectedDamageType}" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                                                                            <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Формула урона *"/><TextBox Text="{Binding DamageExpression, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                        </Grid>
                                                                        <Grid Margin="0,8,0,0">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <StackPanel><TextBlock Text="Тип атаки"/><TextBox Text="{Binding AttackType, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Стоимость действия"/><controls:NriIntegerField Value="{Binding ActionCost}"/></StackPanel>
                                                                            <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Точность"/><controls:NriIntegerField Value="{Binding AccuracyModifier}"/></StackPanel>
                                                                            <StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Дальность"/><TextBox Text="{Binding Range, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                        </Grid>
                                                                        <Grid Margin="0,8,0,0">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <StackPanel><TextBlock Text="Подхарактеристика"/><ComboBox ItemsSource="{Binding SubAttributeOptions}" SelectedItem="{Binding SelectedSubAttribute}" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Тип проверки"/><TextBox Text="{Binding AttackRollType, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                            <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Область"/><TextBox Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                            <StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Режим атаки"/><TextBox Text="{Binding FireMode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                                        </Grid>
                                                                        <Grid Margin="0,8,0,0">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <StackPanel><TextBlock Text="Физ. пробитие"/><controls:NriIntegerField Value="{Binding PhysicalPenetration}"/></StackPanel>
                                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Пробитие брони"/><controls:NriIntegerField Value="{Binding ArmorPenetration}"/></StackPanel>
                                                                            <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Маг. пробитие"/><controls:NriIntegerField Value="{Binding MagicPenetration}"/></StackPanel>
                                                                            <StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Моральное пробитие"/><controls:NriIntegerField Value="{Binding MoralePenetration}"/></StackPanel>
                                                                        </Grid>
                                                                        <WrapPanel Margin="0,8,0,0">
                                                                            <CheckBox Content="Реакция" IsChecked="{Binding CanReact}"/>
                                                                            <CheckBox Content="Ответный огонь" IsChecked="{Binding CanReturnFire}" Margin="12,0,0,0"/>
                                                                            <CheckBox Content="Парирование" IsChecked="{Binding CanParry}" Margin="12,0,0,0"/>
                                                                            <CheckBox Content="Блок" IsChecked="{Binding CanBlock}" Margin="12,0,0,0"/>
                                                                            <TextBlock Text="Перезарядка" Margin="14,4,6,0"/>
                                                                            <controls:NriIntegerField Width="80" Value="{Binding ReloadCost}"/>
                                                                            <TextBlock Text="Расход" Margin="14,4,6,0"/>
                                                                            <controls:NriIntegerField Width="80" Value="{Binding AmmoCost}"/>
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="Заметки GM и технические сведения" IsExpanded="False" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Заметки GM"/>
                                            <TextBox Text="{Binding Editor.GMDescription, UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                                     AutomationProperties.AutomationId="AdminEquipmentDefinitions_GMDescription"/>
                                            <TextBlock Text="Внутренние поля и server-only данные не показываются в обычном редакторе."
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Что увидит игрок"
                                 AutomationProperties.AutomationId="AdminEquipmentDefinitions_PlayerPreviewTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Player-safe preview" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="Здесь нет заметок GM, server-only полей и внутренних ссылок."
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <Button Content="Обновить предпросмотр"
                                            Command="{Binding PreviewCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,14"
                                            AutomationProperties.AutomationId="AdminEquipmentDefinitions_PreviewRefresh"/>
                                    <Border Style="{StaticResource SubtleCardStyle}"
                                            AutomationProperties.AutomationId="AdminEquipmentDefinitions_PlayerPreview">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Editor.PlayerPreviewTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Editor.PlayerPreviewDescription}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding Editor.PlayerPreviewFacts}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ValidationSummary}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="AdminEquipmentDefinitions_Validation"/>
                            <TextBlock Text="{Binding ReferenceWarning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Editor.UnsavedSummary}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <Button Content="Клонировать" Command="{Binding CloneCommand}" Style="{StaticResource GhostButtonStyle}"
                                    AutomationProperties.AutomationId="AdminEquipmentDefinitions_Clone"/>
                            <Button Content="В архив" Command="{Binding ArchiveCommand}" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"
                                    IsEnabled="{Binding CanArchive}" AutomationProperties.AutomationId="AdminEquipmentDefinitions_Archive"/>
                            <Button Content="Восстановить" Command="{Binding RestoreCommand}" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"
                                    IsEnabled="{Binding CanRestore}" AutomationProperties.AutomationId="AdminEquipmentDefinitions_Restore"/>
                            <Button Content="Сохранить" Command="{Binding SaveCommand}" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanSaveDraft}" AutomationProperties.AutomationId="AdminEquipmentDefinitions_Save"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <patterns:NriOperationalWorkspaceHost.Status>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="AdminEquipmentDefinitions_Error"/>
        </patterns:NriOperationalWorkspaceHost.Status>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
