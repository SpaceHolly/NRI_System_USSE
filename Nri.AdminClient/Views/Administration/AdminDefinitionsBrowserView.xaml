<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminDefinitionsBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Справочники" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="Просмотр справочников: категории, поиск, подробности и проверка стартового набора. Импорт, редактирование и сохранение отключены."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ValidationSummary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding WarningMessage}" Foreground="#FFF59E0B" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF87171" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="560" Margin="16,0,0,0">
                    <WrapPanel>
                        <ComboBox Width="190" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}"/>
                        <Button Content="Загрузить стартовый набор" Command="{Binding LoadFromDryRunPackCommand}" IsEnabled="{Binding CanRefresh}" Margin="8,0,0,0"/>
                        <Button Content="Проверить набор" Style="{StaticResource GhostButtonStyle}" Command="{Binding RunPackDryRunCommand}" IsEnabled="{Binding CanRefresh}"/>
                    </WrapPanel>
                    <TextBox Text="{Binding PackPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" ToolTip="Путь к стартовому набору справочников"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по названию, категории и тегам"/>
                        <Button Content="Найти" Style="{StaticResource GhostButtonStyle}" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
                        <Button Content="Очистить" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearSearchCommand}"/>
                        <TextBlock Text="{Binding LastLoadedText, StringFormat=Последняя загрузка: {0}}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Категории" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{Binding FilterSummary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategoryItem}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,6" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Group}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Справочники" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="{Binding SelectedCategoryTitle, StringFormat=Фильтр: {0}}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FilterSummary}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredDefinitions}"
                              SelectedItem="{Binding SelectedDefinitionItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinColumnWidth="90"
                              ColumnWidth="SizeToHeader"
                              HorizontalScrollBarVisibility="Auto"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="190"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding CategoryLabel}" Width="150"/>
                            <DataGridTextColumn Header="Профиль правил" Binding="{Binding RuleSetDisplayName}" Width="190"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" Width="130"/>
                            <DataGridTextColumn Header="Публичные теги" Binding="{Binding PublicTags}" Width="220"/>
                            <DataGridTextColumn Header="Проверка" Binding="{Binding ValidationWarningText}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Подробности справочника" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{Binding SelectedDefinition.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding SelectedDefinition.CategoryLabel, StringFormat=Категория: {0}}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding SelectedDefinition.VisibilityLabel, StringFormat=Доступ: {0}}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding SelectedDefinition.StatusLabel, StringFormat=Статус: {0}}"/>
                        </WrapPanel>
                        <TextBlock Text="Профиль правил задаётся настройками записи." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedDefinition.Tags, StringFormat=Публичные теги: {0}}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>

                        <Separator Margin="0,12,0,12"/>
                        <TextBlock Text="Описание" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="{Binding SelectedDefinition.PublicDescription}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedDefinition.GMDescription, StringFormat=Заметки мастера: {0}}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>

                        <Separator Margin="0,12,0,12"/>
                        <TextBlock Text="Игровые сведения" Style="{StaticResource TitleTextStyle}"/>
                        <DataGrid ItemsSource="{Binding SelectedDefinition.PreviewRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="90"
                                  Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Свойство" Binding="{Binding DisplayKey}" Width="150"/>
                                <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Separator Margin="0,12,0,12"/>
                        <Expander Header="Технические сведения" Margin="0,12,0,0">
                        <StackPanel>
                        <TextBlock Text="Дополнительные сведения" Style="{StaticResource TitleTextStyle}"/>
                        <DataGrid ItemsSource="{Binding SelectedDefinition.ExtraDataRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="180"
                                  Margin="0,6,0,0">
                            <DataGrid.Columns>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding DisplayKey}" Width="160"/>
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SubtleCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Проверка набора" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="{Binding ValidationSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <DataGrid ItemsSource="{Binding ValidationFiles}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="140" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип" Binding="{Binding CategoryLabel}" Width="130"/>
                            <DataGridTextColumn Header="Файл" Binding="{Binding Path}" Width="180"/>
                            <DataGridTextColumn Header="Записей" Binding="{Binding DefinitionCount}" Width="70"/>
                            <DataGridTextColumn Header="Ошибок" Binding="{Binding Errors}" Width="65"/>
                            <DataGridTextColumn Header="Предупреждений" Binding="{Binding Warnings}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SubtleCardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ошибки" Style="{StaticResource TitleTextStyle}"/>
                        <ListBox ItemsSource="{Binding ValidationErrors}" MaxHeight="160" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Предупреждения" Style="{StaticResource TitleTextStyle}"/>
                        <ListBox ItemsSource="{Binding ValidationWarnings}" MaxHeight="160" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SubtleCardStyle}">
                <StackPanel>
                        <TextBlock Text="Редактор справочников" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="Изменение записей доступно в разделе редактирования. Импорт здесь отключён." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Сохранить" IsEnabled="False"/>
                        <Button Content="Удалить" IsEnabled="False" Style="{StaticResource GhostButtonStyle}"/>
                        <Button Content="Импортировать" IsEnabled="False" Style="{StaticResource GhostButtonStyle}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
