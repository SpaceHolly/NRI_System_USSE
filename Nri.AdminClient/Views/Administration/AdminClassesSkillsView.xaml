                                        Padding="12"
                                        Margin="0,16,0,0"
                                        AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Inspector">
                                    <StackPanel>
                                        <TextBlock Text="Представление узла" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="Название" Margin="0,10,0,3"/>
                                        <TextBox Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Name"/>
                                        <TextBlock Text="Описание для игрока" Margin="0,9,0,3"/>
                                        <TextBox Text="{Binding NodeDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                                                 AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Description"/>
                                        <TextBlock Text="Роль в развитии" Margin="0,9,0,3"/>
                                        <ComboBox SelectedValue="{Binding NodeRole, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag"
                                                  AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_SemanticKind">
                                            <ComboBoxItem Content="Основа" Tag="root"/>
                                            <ComboBoxItem Content="Направление" Tag="direction"/>
                                            <ComboBoxItem Content="Путь" Tag="main_branch_level"/>
                                            <ComboBoxItem Content="Специализация" Tag="specialization"/>
                                            <ComboBoxItem Content="Смешанный путь" Tag="mixed_path"/>
                                            <ComboBoxItem Content="Ключевая ступень" Tag="milestone"/>
                                        </ComboBox>
                                        <TextBlock Text="Направление" Margin="0,9,0,3"/>
                                        <ComboBox ItemsSource="{Binding DevelopmentLayoutCanonicalDirections}"
                                                  SelectedValue="{Binding NodeDirectionCode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="DirectionId" DisplayMemberPath="FullDisplayName"
                                                  AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Sector"/>
                                        <TextBlock Text="Родительский путь" Margin="0,9,0,3"/>
                                        <controls:NriReferencePicker Options="{Binding ClassTreeItems}"
                                                                      SelectedId="{Binding RequirementSourceNodeId, UpdateSourceTrigger=PropertyChanged}"
                                                                      DisplayName="{Binding RequirementSourceDisplayName}"
                                                                      AutomationIdPrefix="AdminDevelopmentPresentationEditor_ParentPath"/>
                                        <TextBlock Text="{Binding DevelopmentPresentationReferenceWarning}"
                                                   Visibility="{Binding DevelopmentPresentationReferenceWarningVisibility}"
                                                   Foreground="#FFFFC75A" TextWrapping="Wrap" Margin="0,5,0,0"
                                                   AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_ReferenceWarning"/>
                                        <TextBlock Text="Профиль развития" Margin="0,9,0,3"/>
                                        <ComboBox ItemsSource="{Binding DevelopmentLayoutHexagons}"
                                                  SelectedValue="{Binding NodeHexagonId, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="HexagonId" DisplayMemberPath="DisplayName"
                                                  AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_ProgressionTrack"/>
                                        <UniformGrid Columns="2" Margin="0,9,0,0">
                                            <StackPanel Margin="0,0,5,0">
                                                <TextBlock Text="Порядок"/>
                                                <controls:NriIntegerField Text="{Binding NodeSortOrder, UpdateSourceTrigger=PropertyChanged}" Minimum="0"
                                                                          AccessibleName="Порядок узла"/>
                                            </StackPanel>
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="Ступень / веха"/>
                                                <controls:NriIntegerField Text="{Binding NodeRing, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="20"
                                                                          AccessibleName="Ступень пути или номер вехи"
                                                                          AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_MilestoneTier"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="Видимость" Margin="0,9,0,3"/>
                                        <ComboBox SelectedValue="{Binding NodeVisibilityRule, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag"
                                                  AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Visibility">
                                            <ComboBoxItem Content="Видно игрокам" Tag="visible_by_default"/>
                                            <ComboBoxItem Content="Скрыто до решения GM" Tag="hidden_until_gm_reveal"/>
                                            <ComboBoxItem Content="Только GM" Tag="gm_only"/>
                                        </ComboBox>
                                        <UniformGrid Columns="2" Margin="0,9,0,0">
                                            <StackPanel Margin="0,0,5,0">
                                                <TextBlock Text="Значок"/>
                                                <TextBlock Text="{Binding DevelopmentPresentationIconText}" FontWeight="SemiBold" Margin="0,4,0,0"
                                                           AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Icon"/>
                                            </StackPanel>
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="Статус для игрока"/>
                                                <TextBlock Text="{Binding DevelopmentPresentationPlayerStatusText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"
                                                           AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_PlayerDisplayStatus"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="{Binding DevelopmentLayoutValidationSummary}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Validation"/>
                                        <Expander Header="Техническое" IsExpanded="False" Margin="0,6,0,0"
                                                  AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_TechnicalSection">
                                            <TextBlock Text="Служебные параметры доступны только в полном графе и закрыты в обычном режиме."
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                                <Border Grid.Row="1" Visibility="{Binding DevelopmentLayoutPresentationEditorVisibility}"
                                        Background="{StaticResource NriSecondarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0"
                                        AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_PinnedActions">
                                    <WrapPanel>
                                        <Button Content="Сохранить" Command="{Binding SaveDevelopmentNodeCommand}"
                                                AutomationProperties.Name="Сохранить представление узла"
                                                AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Save" Margin="0,0,6,6"/>
                                        <Button Content="Проверить" Command="{Binding ValidateDevelopmentHexagonLayoutCommand}"
                                                AutomationProperties.Name="Проверить представление"
                                                AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Validate" Margin="0,0,6,6"/>
                                        <RadioButton Content="Предпросмотр" IsChecked="{Binding DevelopmentLayoutProductPreviewSelected, Mode=TwoWay}"
                                                     GroupName="DevelopmentProductMode" Padding="8,6"
                                                     AutomationProperties.Name="Открыть предпросмотр для игрока"
                                                     AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_PlayerPreview" Margin="0,0,6,6"/>
                                        <Button Content="Создать похожий" Command="{Binding CloneDevelopmentNodeCommand}"
                                                AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Clone" Margin="0,0,6,6"/>
                                        <Button Content="Архивировать" Command="{Binding ArchiveDevelopmentNodeCommand}"
                                                AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Archive" Margin="0,0,6,6"/>
                                        <Button Content="Вернуть" Command="{Binding RestoreDevelopmentNodeCommand}"
                                                AutomationProperties.AutomationId="AdminDevelopmentPresentationEditor_Restore" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding DevelopmentLayoutTechnicalEditorVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="#FF2F4265"
                                BorderThickness="1"
                                Background="#FF101827"
                                Padding="10"
                                CornerRadius="6">
                            <Grid>
                            <ScrollViewer x:Name="AdminDevelopmentLayoutScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="620"
                                          AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_Canvas">
                                <Grid Width="{Binding DevelopmentLayoutWorkspaceWidth}"
                                      Height="{Binding DevelopmentLayoutWorkspaceHeight}">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding DevelopmentLayoutZoom}" ScaleY="{Binding DevelopmentLayoutZoom}"/>
                                    </Grid.LayoutTransform>
                                    <Grid.RenderTransform>
                                        <TranslateTransform X="{Binding DevelopmentLayoutViewportTranslateX}"
                                                            Y="{Binding DevelopmentLayoutViewportTranslateY}"/>
                                    </Grid.RenderTransform>
                                    <Rectangle Width="{Binding DevelopmentLayoutWorkspaceWidth}"
                                               Height="{Binding DevelopmentLayoutWorkspaceHeight}"
                                               IsHitTestVisible="False"
                                               Opacity="{Binding DevelopmentLayoutGridOpacity}">
                                        <Rectangle.Fill>
                                            <DrawingBrush TileMode="Tile"
                                                          Viewport="0,0,50,50"
                                                          ViewportUnits="Absolute">
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing Brush="Transparent">
                                                        <GeometryDrawing.Pen>
                                                            <Pen Brush="#334A6FA8" Thickness="1"/>
                                                        </GeometryDrawing.Pen>
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <LineGeometry StartPoint="0,0" EndPoint="50,0"/>
                                                                <LineGeometry StartPoint="0,0" EndPoint="0,50"/>
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <ItemsControl ItemsSource="{Binding DevelopmentLayoutCanonicalLanes}"
                                                  Width="{Binding DevelopmentLayoutWorkspaceWidth}"
                                                  Height="{Binding DevelopmentLayoutWorkspaceHeight}"
                                                  Visibility="{Binding DevelopmentLayoutCanonicalLayerVisibility}"
                                                  IsHitTestVisible="False"
                                                  AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_CanonicalLaneLayer">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Background="Transparent" ClipToBounds="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="{Binding X1}"
                                                      Y1="{Binding Y1}"
                                                      X2="{Binding X2}"
                                                      Y2="{Binding Y2}"
                                                      Stroke="{Binding StrokeBrush}"
                                                      StrokeThickness="{Binding StrokeThickness}"
                                                      Opacity="{Binding Opacity}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding DevelopmentLayoutLinks}"
                                                  IsHitTestVisible="False"
                                                  AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_LinkLayer">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Background="Transparent" ClipToBounds="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas>
                                                    <Path Data="{Binding PathData}"
                                                          StrokeThickness="{Binding VisualStrokeThickness}"
                                                          Stroke="{Binding VisualStrokeBrush}"
                                                          Opacity="{Binding VisualOpacity}"
                                                          Fill="Transparent"/>
                                                    <Polygon Points="{Binding ArrowPoints}"
                                                             Fill="{Binding VisualStrokeBrush}"
                                                             Opacity="{Binding VisualOpacity}"/>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl x:Name="DevelopmentLayoutCanvasItems"
                                              Width="{Binding DevelopmentLayoutWorkspaceWidth}"
                                              Height="{Binding DevelopmentLayoutWorkspaceHeight}"
                                              ItemsSource="{Binding DevelopmentLayoutNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="Transparent" ClipToBounds="True"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="{x:Type ContentPresenter}">
                                            <Setter Property="Canvas.Left" Value="{Binding PositionX}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding PositionY}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="{Binding NodeWidth}"
                                             Height="{Binding NodeHeight}"
                                             Opacity="{Binding VisualOpacity}"
                                             Visibility="{Binding VisualVisibility}"
                                             Tag="{Binding}"
                                                    PreviewMouseLeftButtonDown="DevelopmentLayoutNode_MouseLeftButtonDown"
                                                     PreviewMouseMove="DevelopmentLayoutNode_MouseMove"
                                                     PreviewMouseLeftButtonUp="DevelopmentLayoutNode_MouseLeftButtonUp"
                                                     AutomationProperties.AutomationId="{Binding AutomationId}"
                                                     AutomationProperties.Name="{Binding DisplayTitle}">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButtonStyle}">
                                                        <Setter Property="Background" Value="#FF1D3153"/>
                                                        <Setter Property="BorderBrush" Value="#FF4A6FA8"/>
                                                        <Setter Property="Foreground" Value="#FFE7F0FF"/>
                                                        <Setter Property="Padding" Value="6"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#FF214C45"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                <Setter Property="Background" Value="#FF3C2535"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFocusNeighbor}" Value="True">
                                                                <Setter Property="Background" Value="#FF263A5F"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                                <Setter Property="Background" Value="#FF4B1F2C"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel ToolTip="{Binding LinkedDefinitionText}">
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="34"/>
                                                    <WrapPanel Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding DisplayTypeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding DisplayState}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,6,0"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding DisplayCostText}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding VisibilityText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding ValidationBadgeText}" Foreground="{StaticResource WarningBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding DevelopmentLayoutCanonicalDirections}"
                                                  Width="{Binding DevelopmentLayoutWorkspaceWidth}"
                                                  Height="{Binding DevelopmentLayoutWorkspaceHeight}"
                                                  Visibility="{Binding DevelopmentLayoutCanonicalLayerVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Background="Transparent" ClipToBounds="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="{x:Type ContentPresenter}">
                                                <Setter Property="Canvas.Left" Value="{Binding AnchorX}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding AnchorY}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="{Binding AnchorWidth}"
                                                        Height="{Binding AnchorHeight}"
                                                        Opacity="{Binding VisualOpacity}"
                                                        Padding="0"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Focusable="False"
                                                        IsHitTestVisible="False"
                                                        AutomationProperties.AutomationId="{Binding AdminAnchorAutomationId}"
                                                        AutomationProperties.Name="{Binding FullDisplayName}">
                                                    <Grid>
                                                        <Polygon Points="{Binding AnchorHexPoints}"
                                                                 Fill="#DD1B3556"
                                                                 Stroke="#FF9ED8FF"
                                                                 StrokeThickness="2.4"/>
                                                        <StackPanel VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="10,0">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#FFEAF6FF"
                                                                       TextAlignment="Center"/>
                                                            <TextBlock Text="{Binding AtmosphericName}"
                                                                       Visibility="{Binding DataContext.DevelopmentLayoutDirectionLabelsVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="11"
                                                                       TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding DevelopmentLayoutCanonicalRoots}"
                                                  Width="{Binding DevelopmentLayoutWorkspaceWidth}"
                                                  Height="{Binding DevelopmentLayoutWorkspaceHeight}"
                                                  Visibility="{Binding DevelopmentLayoutCanonicalLayerVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Background="Transparent" ClipToBounds="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="{x:Type ContentPresenter}">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="{Binding Width}"
                                                        Height="{Binding Height}"
                                                        Padding="0"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Focusable="False"
                                                        IsHitTestVisible="False"
                                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                                        AutomationProperties.Name="{Binding Label}">
                                                    <Grid>
                                                        <Polygon Points="{Binding HexPoints}"
                                                                 Fill="#EE214C45"
                                                                 Stroke="{StaticResource SuccessBrush}"
                                                                 StrokeThickness="4"/>
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FFFFFFFF"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Margin="22,0"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource CardStyle}"
                                Background="{StaticResource PanelAltBrush}"
                                Margin="8,0,0,0"
                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_SelectedNodePanel">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Выбранный узел" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding SelectedDevelopmentLayoutNodeSummary}"
                                               AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_SelectedNodeSummary"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,10"/>
                                    <Border Background="#FF142033"
                                            BorderBrush="#FF2F4265"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8"
                                            Margin="0,0,0,10"
                                            AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ChangedObjectsList_Container">
                                        <StackPanel>
                                            <TextBlock Text="Изменённые объекты"
                                                       AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ChangedObjectsList"
                                                       FontWeight="Bold"/>
                                            <ItemsControl ItemsSource="{Binding DevelopmentLayoutChangedObjects}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FF142033"
                                            BorderBrush="#FF2F4265"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8"
                                            Margin="0,0,0,10"
                                            AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ValidationPanel_Container">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding DevelopmentLayoutValidationSummary}"
                                                           AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ValidationPanel"
                                                           FontWeight="Bold"/>
                                                <Button Content="Фокус"
                                                        DockPanel.Dock="Right"
                                                        Command="{Binding FocusDevelopmentHexagonValidationAffectedCommand}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ValidationFocusAffected"/>
                                            </DockPanel>
                                            <TextBlock Text="Ошибки"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       Margin="0,6,0,0"
                                                       AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ValidationErrors"/>
                                            <ItemsControl ItemsSource="{Binding DevelopmentLayoutValidationErrors}"
                                                          AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ValidationErrors_List">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" Margin="0,3,0,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Предупреждения"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       Margin="0,6,0,0"
                                                       AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ValidationWarnings"/>
                                            <ItemsControl ItemsSource="{Binding DevelopmentLayoutValidationWarnings}"
                                                          AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ValidationWarnings_List">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" Margin="0,3,0,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Название"/>
                                    <TextBox Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_NodeName"/>
                                    <TextBlock Text="Описание" Margin="0,8,0,0"/>
                                    <TextBox Text="{Binding NodeDescription, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             Height="70"
                                             TextWrapping="Wrap"
                                             AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_NodeDescription"/>
                                    <TextBlock Text="Тип" Margin="0,8,0,0"/>
                                    <ComboBox SelectedValue="{Binding NodeType, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag"
                                              IsEditable="False"
                                              AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_NodeType">
                                        <ComboBoxItem Tag="class" Content="Класс"/>
                                        <ComboBoxItem Tag="skill" Content="Навык"/>
                                        <ComboBoxItem Tag="passive" Content="Пассивное развитие"/>
                                        <ComboBoxItem Tag="magic" Content="Магия"/>
                                        <ComboBoxItem Tag="custom" Content="Другое"/>
                                    </ComboBox>
                                    <TextBlock Text="Видимость" Margin="0,8,0,0"/>
                                    <ComboBox SelectedValue="{Binding NodeVisibilityRule, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag"
                                              IsEditable="False"
                                              AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_NodeVisibility">
                                        <ComboBoxItem Tag="visible_by_default" Content="Видно игрокам"/>
                                        <ComboBoxItem Tag="hidden_until_gm_reveal" Content="Скрыто до раскрытия GM"/>
                                        <ComboBoxItem Tag="gm_only" Content="Только GM"/>
                                        <ComboBoxItem Tag="public" Content="Открыто"/>
                                    </ComboBox>
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Стоимость"/>
                                            <controls:NriIntegerField Text="{Binding NodeCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_NodeCostAmount"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Валюта"/>
                                        <controls:NriReferencePicker Options="{Binding CurrencyDefinitionRows}"
                                                                      SelectedId="{Binding NodeCurrencyId, UpdateSourceTrigger=PropertyChanged}"
                                                                      DisplayName="{Binding NodeCurrencyDisplayName}"
                                                                      AutomationIdPrefix="AdminDevelopmentHexagonEditor_NodeCostCurrency"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="Привязка к справочнику" Margin="0,8,0,0"/>
                                    <ComboBox SelectedValuePath="Tag"
                                              SelectedValue="{Binding NodeLinkedDefinitionKind, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_LinkedDefinitionSelector">
                                        <ComboBoxItem Content="Класс" Tag="class"/>
                                        <ComboBoxItem Content="Навык" Tag="skill"/>
                                        <ComboBoxItem Content="Фракция" Tag="faction"/>
                                        <ComboBoxItem Content="Локация" Tag="location"/>
                                        <ComboBoxItem Content="Другое" Tag="custom"/>
                                    </ComboBox>
                                    <controls:NriReferencePicker Options="{Binding ClassDefinitionRows}"
                                                                  SelectedId="{Binding NodeLinkedDefinitionId, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayName="{Binding SelectedClassDefinition.Name, TargetNullValue=Связь не выбрана}"
                                                                  AutomationIdPrefix="AdminClasses_LinkedDefinition"
                                                                  Margin="0,4,0,0"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <CheckBox Content="Видно игрокам"
                                                  IsChecked="{Binding NodeIsPlayerVisible, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,8,4"/>
                                        <CheckBox Content="Скрыто GM"
                                                  IsChecked="{Binding NodeIsHidden, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,8,4"/>
                                        <CheckBox Content="Архив"
                                                  IsChecked="{Binding NodeIsArchived, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,8,4"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Создать"
                                                Command="{Binding CreateDevelopmentNodeCommand}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_CreateNode"
                                                Margin="0,0,6,6"/>
                                        <Button Content="Сохранить"
                                                Command="{Binding SaveDevelopmentNodeCommand}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_SaveNode"
                                                Margin="0,0,6,6"/>
                                        <Button Content="Отменить"
                                                Command="{Binding CancelDevelopmentNodeEditCommand}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_CancelNodeEdit"
                                                Margin="0,0,6,6"/>
                                        <Button Content="Архивировать"
                                                Command="{Binding ArchiveDevelopmentNodeCommand}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ArchiveNode"
                                                Margin="0,0,6,6"/>
                                        <Button Content="Вернуть"
                                                Command="{Binding RestoreDevelopmentNodeCommand}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_RestoreNode"
                                                Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <Separator Margin="0,10,0,10"/>
                                    <TextBlock Text="Требования / связи" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedDevelopmentLayoutLinkSummary}"
                                               AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_SelectedLinkPanel"
                                               TextWrapping="Wrap"/>
                                    <CheckBox Content="Режим связи"
                                              IsChecked="{Binding DevelopmentLinkModeEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_LinkModeToggle"
                                              Margin="0,6,0,6"/>
                                    <TextBlock Text="Источник требования"/>
                                    <controls:NriReferencePicker Options="{Binding ClassTreeItems}"
                                                                  SelectedId="{Binding RequirementSourceNodeId, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayName="{Binding SelectedClassNode.Name, TargetNullValue=Узел не выбран}"
                                                                  AutomationIdPrefix="AdminClasses_RequirementSource"/>
                                    <TextBlock Text="Целевой узел" Margin="0,6,0,0"/>
                                    <controls:NriReferencePicker Options="{Binding ClassTreeItems}"
                                                                  SelectedId="{Binding RequirementTargetNodeId, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayName="{Binding SelectedClassNode.Name, TargetNullValue=Узел не выбран}"
                                                                  AutomationIdPrefix="AdminClasses_RequirementTarget"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Добавить связь"
                                                Command="{Binding AddRequirementLinkCommand}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_AddRequirementLink"
                                                Margin="0,0,6,6"/>
                                        <Button Content="Удалить связь"
                                                Command="{Binding RemoveRequirementLinkCommand}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_RemoveRequirementLink"
                                                Margin="0,0,6,6"/>
                                        <Button Content="Проверить граф"
                                                Command="{Binding ValidateDevelopmentGraphCommand}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ValidateGraph"
                                                Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <TextBlock Text="Выбор дерева"
                                               FontWeight="Bold"
                                               Margin="0,8,0,4"/>
                                    <WrapPanel>
                                        <Button Content="Основной"
                                                Command="{Binding SelectDevelopmentLayoutHexagonCommand}"
                                                CommandParameter="main_development_hexagon"
                                                Tag="main_development_hexagon"
                                                Click="SelectDevelopmentHexagonButton_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_StatusSelectTree_main_development_hexagon"
                                                Margin="0,0,6,6"/>
                                        <Button Content="Магия"
                                                Command="{Binding SelectDevelopmentLayoutHexagonCommand}"
                                                CommandParameter="magic_development_hexagon"
                                                Tag="magic_development_hexagon"
                                                Click="SelectDevelopmentHexagonButton_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_StatusSelectTree_magic_development_hexagon"
                                                Margin="0,0,6,6"/>
                                        <Button Content="Большое"
                                                Command="{Binding SelectDevelopmentLayoutHexagonCommand}"
                                                CommandParameter="large_development_hexagon_0154"
                                                Tag="large_development_hexagon_0154"
                                                Click="SelectDevelopmentHexagonButton_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_StatusSelectTree_large_development_hexagon_0154"
                                                Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding DevelopmentLayoutTreeModeOverlayText}"
                                               AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_StatusTreeModeOverlay"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding DevelopmentLayoutStatusText}"
                                               AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_StatusText"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding NodeLayoutSaveStatus}"
                                               AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_Archive_Status"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Margin="0,10,0,0" Visibility="{Binding AdminDefinitionsWorkspaceVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Узлы шестиугольника развития" Style="{StaticResource TitleTextStyle}"/>
                            <TextBlock Text="GM видит узлы и может открывать или отзывать развитие. Игрок получает только уже разблокированные узлы." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <WrapPanel>
                                <Button Content="Загрузить шестиугольник" Command="{Binding DataContext.LoadClassTreeCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.AutomationId="AdminClasses_Hexagon_Load_Button"/>
                                <Button Content="Разблокировать узел" Command="{Binding DataContext.AcquireClassNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.AutomationId="AdminClassHex_UnlockNode_Button"/>
                                <Button Content="Заблокировать узел" Command="{Binding DataContext.RevokeClassNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.AutomationId="AdminClassHex_RevokeNode_Button"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Покупка" Tag="dev_hex_purchase_node_01446" Click="SelectNodeButton_Click" AutomationProperties.AutomationId="AdminClasses_Node_Select_dev_hex_purchase_node_01446"/>
                                <Button Content="Класс" Tag="dev_hex_class_node_01446" Click="SelectNodeButton_Click" AutomationProperties.AutomationId="AdminClasses_Node_Select_dev_hex_class_node_01446"/>
                                <Button Content="Заблокирован" Tag="dev_locked_node_01446" Click="SelectNodeButton_Click" AutomationProperties.AutomationId="AdminClasses_Node_Select_dev_locked_node_01446"/>
                                <Button Content="Скрытый" Tag="dev_hidden_node_01446" Click="SelectNodeButton_Click" AutomationProperties.AutomationId="AdminClasses_Node_Select_dev_hidden_node_01446"/>
                                <Button Content="Корень магии" Tag="magic_awakened" Click="SelectNodeButton_Click" AutomationProperties.AutomationId="AdminClasses_Node_Select_magic_awakened"/>
                                <Button Content="Маг маны" Tag="dev_mana_mage_01448" Click="SelectNodeButton_Click" AutomationProperties.AutomationId="AdminClasses_Node_Select_dev_mana_mage_01448"/>
                                <Button Content="Маг заклинаний" Tag="dev_spell_mage_01448" Click="SelectNodeButton_Click" AutomationProperties.AutomationId="AdminClasses_Node_Select_dev_spell_mage_01448"/>
                                <Button Content="Огонь" Tag="dev_magic_fire_element_01448" Click="SelectNodeButton_Click" AutomationProperties.AutomationId="AdminClasses_Node_Select_dev_magic_fire_element_01448"/>
                            </WrapPanel>
                            <controls:NriReferencePicker x:Name="SelectedClassNodePicker"
                                     Options="{Binding ClassTreeItems}"
                                     SelectedId="{Binding SelectedClassNodeId, UpdateSourceTrigger=PropertyChanged}"
                                     DisplayName="{Binding SelectedClassNode.Name, TargetNullValue=Узел не выбран}"
                                     AutomationIdPrefix="AdminClasses_SelectedNode"
                                     Margin="0,8,0,0"
                                     />
                            <Button Content="Загрузить выбранный узел"
                                    Click="SelectNodeByInputButton_Click"
                                    AutomationProperties.AutomationId="AdminClasses_Node_LoadSelected_Button"
                                    Margin="0,6,0,0"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding ClassTreeItems}"
                                  AutomationProperties.AutomationId="AdminClasses_Hexagon_Nodes_Table"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  MinHeight="260"
                                  IsReadOnly="True"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Выбор" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Открыть"
                                                    Tag="{Binding Id}"
                                                    Click="SelectNodeButton_Click"
                                                    AutomationProperties.AutomationId="{Binding Id, StringFormat=AdminClasses_Node_Select_{0}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="110"/>
                                <DataGridTextColumn Header="Детали" Binding="{Binding Extra}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Редактор раскладки" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="Изменения сохраняются в source-of-truth определений и после refresh доступны PlayerClient." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <Button Content="Сохранить раскладку"
                                HorizontalAlignment="Left"
                                Click="SaveLayoutButton_Click"
                                IsEnabled="{Binding CanSaveClassDraft}"
                                AutomationProperties.AutomationId="AdminClasses_Node_SaveLayout_Top_Button"
                                Margin="0,0,0,8"/>
                                <Expander Header="Технические сведения" AutomationProperties.AutomationId="AdminClasses_Node_Technical" IsExpanded="False" Margin="0,0,0,8">
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="Шестиугольник"/>
                                            <TextBox AutomationProperties.AutomationId="AdminClasses_Node_Advanced_HexagonId" Text="{Binding NodeHexagonId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="Тип шестиугольника"/>
                                            <TextBox AutomationProperties.AutomationId="AdminClasses_Node_HexagonType" Text="{Binding NodeHexagonType, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </Expander>
                                <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Тип узла"/>
                                <TextBlock AutomationProperties.AutomationId="AdminClasses_Node_NodeType_Summary" Text="{Binding NodeType, StringFormat=Тип узла: {0}}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Роль узла"/>
                                <ComboBox AutomationProperties.AutomationId="AdminClasses_Node_NodeRole" SelectedValuePath="Tag" SelectedValue="{Binding NodeRole, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Основная ветвь" Tag="main_branch_level"/><ComboBoxItem Content="Поддержка" Tag="support"/><ComboBoxItem Content="Магия" Tag="magic"/></ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Позиция X"/>
                                <controls:NriIntegerField AutomationProperties.AutomationId="AdminClasses_Node_PositionX" Text="{Binding NodePositionX, UpdateSourceTrigger=PropertyChanged}" AccessibleName="Позиция X"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Позиция Y"/>
                                <controls:NriIntegerField AutomationProperties.AutomationId="AdminClasses_Node_PositionY" Text="{Binding NodePositionY, UpdateSourceTrigger=PropertyChanged}" AccessibleName="Позиция Y"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Кольцо"/>
                                <controls:NriIntegerField AutomationProperties.AutomationId="AdminClasses_Node_Ring" Text="{Binding NodeRing, UpdateSourceTrigger=PropertyChanged}" Minimum="0" AccessibleName="Кольцо"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Сектор"/>
                                <controls:NriIntegerField AutomationProperties.AutomationId="AdminClasses_Node_Sector" Text="{Binding NodeSector, UpdateSourceTrigger=PropertyChanged}" Minimum="0" AccessibleName="Сектор"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Порядок"/>
                                <controls:NriIntegerField AutomationProperties.AutomationId="AdminClasses_Node_SortOrder" Text="{Binding NodeSortOrder, UpdateSourceTrigger=PropertyChanged}" Minimum="0" AccessibleName="Порядок"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Стоимость"/>
                                <TextBlock AutomationProperties.AutomationId="AdminClasses_Node_Cost_Summary"
                                           Text="{Binding NodeCost, StringFormat=Стоимость: {0}}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </UniformGrid>
                        <Expander Header="Техническое направление и валюта" AutomationProperties.AutomationId="AdminClasses_Node_TechnicalFields" IsExpanded="False" Margin="0,0,0,8">
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Направление"/>
                                    <ComboBox AutomationProperties.AutomationId="AdminClasses_Node_DirectionCode" SelectedValuePath="Tag" SelectedValue="{Binding NodeDirectionCode, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Сила — Натиск" Tag="strength"/><ComboBoxItem Content="Ловкость — Манёвр" Tag="dexterity"/><ComboBoxItem Content="Выносливость — Стойкость" Tag="constitution"/><ComboBoxItem Content="Интеллект — Разум" Tag="intelligence"/><ComboBoxItem Content="Мудрость — Путь" Tag="wisdom"/><ComboBoxItem Content="Харизма — Влияние" Tag="charisma"/></ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Ветка"/>
                                    <TextBox AutomationProperties.AutomationId="AdminClasses_Node_BranchCode" Text="{Binding NodeBranchCode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Валюта"/>
                                    <TextBlock AutomationProperties.AutomationId="AdminClasses_Node_CurrencyId_Summary" Text="{Binding NodeCurrencyId, StringFormat=Идентификатор валюты: {0}}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </UniformGrid>
                        </Expander>
                        <TextBlock Text="Требования"/>
                            <controls:NriMultiReferencePicker AutomationIdPrefix="AdminClasses_Node_RequiredNodes"
                                                              Options="{Binding ClassTreeItems}"
                                      SelectedReferences="{Binding NodeRequiredNodeReferences}"
                                                              IsMultiple="True"
                                                          Margin="0,4,0,8"
                                                          ToolTip="Выберите необходимые узлы по названию"/>
                        <TextBlock Text="Связанный класс"/>
                        <controls:NriReferencePicker AutomationIdPrefix="AdminClasses_Node_LinkedClassId"
                                                     Options="{Binding ClassDefinitionRows}"
                                                     SelectedId="{Binding NodeLinkedClassId, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,4,0,8"/>
                        <TextBlock Text="Основная магическая группа"/>
                        <controls:NriReferencePicker AutomationIdPrefix="AdminClasses_Node_PrimaryMagicGroupId"
                                                     Options="{Binding ClassDefinitionRows}"
                                                     SelectedId="{Binding NodePrimaryMagicGroupId, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,4,0,8"/>
                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox Content="Первичный магический класс" AutomationProperties.AutomationId="AdminClasses_Node_IsPrimaryMagicClass" IsChecked="{Binding NodeIsPrimaryMagicClass}" Margin="0,0,16,0"/>
                            <TextBlock AutomationProperties.AutomationId="AdminClasses_Node_IsPlayerVisible_Summary" Text="{Binding NodeIsPlayerVisible, StringFormat=Видно игроку: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                            <TextBlock AutomationProperties.AutomationId="AdminClasses_Node_IsHidden_Summary" Text="{Binding NodeIsHidden, StringFormat=Скрыт: {0}}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Сохранить раскладку"
                                    Click="SaveLayoutButton_Click"
                                    IsEnabled="{Binding CanSaveClassDraft}"
                                    AutomationProperties.AutomationId="AdminClasses_Node_SaveLayout_Button"/>
                            <Button Content="Завершить узел"
                                    Command="{Binding CompleteClassNodeCommand}"
                                    AutomationProperties.AutomationId="AdminClasses_Node_Complete_Button"
                                    Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding NodeLayoutSaveStatus}"
                                       AutomationProperties.AutomationId="AdminClasses_Node_SaveLayout_Status"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </WrapPanel>
                        <TextBlock AutomationProperties.AutomationId="AdminClasses_Unsaved_Status"
                                   Text="{Binding ClassNodeLayoutUnsavedSummary}"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding NodeLayoutVersion, StringFormat=LayoutVersion: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding NodeLayoutUpdatedAt, StringFormat=Обновлено: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,12"/>

                        <Expander Header="Техническое назначение класса" AutomationProperties.AutomationId="AdminClasses_Assignment_Technical" IsExpanded="False" Margin="0,12,0,8">
                        <StackPanel>
                        <TextBlock Text="Назначение класса через Hexagon" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="Класс назначается только вместе с узлом. Если класс не привязан к узлу, сервер сообщит, что запись не найдена." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="ID персонажа"/>
                                 <controls:NriReferencePicker AutomationIdPrefix="AdminClasses_Node_CharacterId"
                                                               Options="{Binding Characters}"
                                                               SelectedId="{Binding SelectedCharacterId, UpdateSourceTrigger=PropertyChanged}"
                                                               DisplayName="{Binding SelectedCharacter.Name, TargetNullValue=Персонаж не выбран}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Код класса"/>
                                 <controls:NriReferencePicker AutomationIdPrefix="AdminClassHex_AssignClassCode"
                                                               Options="{Binding ClassDefinitionRows}"
                                                               SelectedId="{Binding AssignClassCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Узел"/>
                                 <controls:NriReferencePicker AutomationIdPrefix="AdminClassHex_AssignNodeId"
                                                               Options="{Binding ClassTreeItems}"
                                                               SelectedId="{Binding AssignClassNodeId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="90" Margin="0,0,8,0">
                                <TextBlock Text="Уровень"/>
                                <controls:NriIntegerField AutomationProperties.AutomationId="AdminClassHex_AssignClass_Level"
                                                          Text="{Binding AssignClassLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="1"/>
                            </StackPanel>
                            <Button Content="Назначить класс" Command="{Binding AssignCharacterClassCommand}" AutomationProperties.AutomationId="AdminClassHex_AssignClass_Button" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        </StackPanel>
                        </Expander>
                        <TextBlock Text="Классы персонажа" Style="{StaticResource TitleTextStyle}" Margin="0,16,0,8"/>
                        <DataGrid ItemsSource="{Binding CharacterClassRows}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" MinHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="130"/>
                                <DataGridTextColumn Header="Шестиугольник" Binding="{Binding Extra}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
