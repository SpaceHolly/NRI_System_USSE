<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminClassesSkillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
    <UserControl.Resources>
        <HierarchicalDataTemplate x:Key="RequirementExpressionNodeTemplate0219" ItemsSource="{Binding Children}">
            <Border BorderBrush="{StaticResource BorderBrushTheme}" BorderThickness="1" Padding="8" Margin="0,4,0,0" CornerRadius="4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" SelectedValuePath="Tag" SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="Логика группы требований">
                            <ComboBoxItem Content="Требуется всё" Tag="all_of"/>
                            <ComboBoxItem Content="Требуется одно из" Tag="any_of"/>
                            <ComboBoxItem Content="Минимум N условий" Tag="at_least"/>
                            <ComboBoxItem Content="Отдельное условие" Tag="leaf"/>
                        </ComboBox>
                        <TextBlock Grid.Column="1" Text="{Binding OperatorLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
                        <Button Grid.Column="2" Content="Удалить" Command="{Binding RemoveCommand}" Style="{StaticResource GhostButtonStyle}"/>
                    </Grid>
                    <StackPanel Visibility="{Binding IsAtLeast, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Text="Сколько условий нужно выполнить"/>
                        <controls:NriIntegerField Text="{Binding RequiredCount, UpdateSourceTrigger=PropertyChanged}" Minimum="1" AccessibleName="Минимальное число условий" Width="120" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Grid Visibility="{Binding IsLeaf, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Тип условия"/>
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding LeafType, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="Узел развития" Tag="development_node"/><ComboBoxItem Content="Путь развития" Tag="development_path"/>
                                <ComboBoxItem Content="Ранг навыка" Tag="skill_rank"/><ComboBoxItem Content="Уровень мастерства" Tag="mastery_band"/>
                                <ComboBoxItem Content="Характеристика" Tag="attribute"/><ComboBoxItem Content="Подхарактеристика" Tag="subattribute"/>
                                <ComboBoxItem Content="Техника" Tag="technique"/><ComboBoxItem Content="Тег снаряжения" Tag="equipment_tag"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Объект требования"/>
                            <controls:NriReferencePicker Options="{Binding DataContext.RequirementReferenceOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         SelectedId="{Binding TargetId, UpdateSourceTrigger=PropertyChanged}"
                                                         DisplayName="{Binding PublicLabel, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationIdPrefix="AdminRequirementExpression_Reference"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Минимальное значение"/>
                            <controls:NriIntegerField Text="{Binding MinimumValue, UpdateSourceTrigger=PropertyChanged}" Minimum="0" AccessibleName="Порог требования"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Visibility="{Binding IsGroup, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <Button Content="Добавить условие" Command="{Binding AddConditionCommand}" Style="{StaticResource GhostButtonStyle}"/>
                        <Button Content="Добавить вложенную группу" Command="{Binding AddGroupCommand}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <controls:NriRouteStateHost Grid.Row="1" State="{Binding ClassesRouteState, Mode=OneWay}" ActiveStates="loading,error,permission" Panel.ZIndex="10" AutomationProperties.AutomationId="AdminClasses_StateHost">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <controls:NriRouteStatePresenter State="{Binding ClassesRouteState}" VisibleFor="loading"><controls:NriLoadingOverlay IsLoading="True" ProgressText="Загрузка классов и навыков…" AutomationProperties.AutomationId="AdminClasses_Loading"/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding ClassesRouteState}" VisibleFor="empty"><controls:NriEmptyState AutomationProperties.AutomationId="AdminClasses_EmptyState" Title="Записей пока нет" Message="Создайте класс или навык."/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding ClassesRouteState}" VisibleFor="no-results"><controls:NriEmptyState AutomationProperties.AutomationId="AdminClasses_NoResults" Title="Ничего не найдено" Message="Измените запрос поиска."/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding ClassesRouteState}" VisibleFor="no-selection"><TextBlock Text="Выберите класс или навык." AutomationProperties.AutomationId="AdminClasses_NoSelection"/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding ClassesRouteState}" VisibleFor="permission"><controls:NriPermissionState AutomationProperties.AutomationId="AdminClasses_Permission" Explanation="{Binding SectionAccessHint}"/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding ClassesRouteState}" VisibleFor="error"><TextBlock AutomationProperties.AutomationId="AdminClasses_Error" Text="{Binding LastErrorMessage}" TextWrapping="Wrap"/></controls:NriRouteStatePresenter>
            </StackPanel>
        </controls:NriRouteStateHost>
        <controls:NriPageHeader Grid.Row="0"
                                Title="Классы и навыки"
                                Subtitle="Работа с определениями классов, навыков и шестиугольником развития."
                                StatusText="{Binding ContentReadinessSummary}"
                                AutomationProperties.AutomationId="AdminClasses_Header"
                                Margin="8,8,8,0">
            <controls:NriPageHeader.PrimaryAction>
                <Button Content="Обновить классы" Command="{Binding RefreshDefinitionClassesCommand}" IsEnabled="{Binding ArePrivilegedSectionsEnabled}" AutomationProperties.AutomationId="AdminClasses_Refresh"/>
            </controls:NriPageHeader.PrimaryAction>
            <controls:NriPageHeader.SecondaryActions>
                <WrapPanel>
                    <RadioButton Content="Развитие" IsChecked="{Binding AdminDevelopmentWorkspaceSelected, Mode=TwoWay}"
                                 GroupName="AdminClassesSkillsWorkspace" Margin="0,0,10,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="Рабочая область развития"
                                 AutomationProperties.AutomationId="AdminClassesSkills_DevelopmentWorkspaceMode"/>
                    <RadioButton Content="Справочники" IsChecked="{Binding AdminDefinitionsWorkspaceSelected, Mode=TwoWay}"
                                 GroupName="AdminClassesSkillsWorkspace" Margin="0,0,12,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="Справочники классов и навыков"
                                 AutomationProperties.AutomationId="AdminClassesSkills_DefinitionsWorkspaceMode"/>
                    <controls:NriStatusBadge Text="{Binding ClassUnsavedSummary}"
                                             StatusKind="Warning"
                                             Visibility="{Binding HasClassUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.AutomationId="AdminClasses_Unsaved"/>
                    <controls:NriStatusBadge Text="{Binding ClassValidationSummary}"
                                             StatusKind="Danger"
                                             Margin="6,0,0,0"
                                             Visibility="{Binding HasClassValidationIssues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.AutomationId="AdminClasses_Validation"/>
                    <controls:NriToastHost Message="{Binding OperationStatusMessage}"
                                           IsOpen="{Binding HasOperationStatusMessage}"
                                           Margin="6,0,0,0"
                                           AutomationProperties.AutomationId="AdminClasses_Success"/>
                </WrapPanel>
            </controls:NriPageHeader.SecondaryActions>
        </controls:NriPageHeader>
        <Border Grid.Row="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="28,10,0,0"
                Padding="10,6"
                Background="#EE142033"
                BorderBrush="#FF4A6FA8"
                BorderThickness="1"
                CornerRadius="4"
                Panel.ZIndex="20">
            <TextBlock Text="{Binding DevelopmentLayoutViewModeText}"
                       AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_CanvasModeBadge"
                       Foreground="{StaticResource TextBrush}"
                       FontWeight="SemiBold"/>
        </Border>
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="AdminClassesSkills_ContentScroll">
        <StackPanel Margin="8">
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding AdminDefinitionsWorkspaceVisibility}">
                <StackPanel>
                    <TextBlock Text="Классы / навыки" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="Классы доступны игроку только через разблокированные узлы шестиугольника развития. Глобальный список классов для PlayerClient не используется."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Обновить классы" Command="{Binding RefreshDefinitionClassesCommand}"/>
                        <Button Content="Новый класс" Command="{Binding NewClassDefinitionCommand}"/>
                        <Button Content="Открыть" Command="{Binding OpenSelectedClassDefinitionCommand}"/>
                        <Button Content="Сохранить класс" Command="{Binding SaveClassDefinitionCommand}" IsEnabled="{Binding CanSaveClassDraft}" AutomationProperties.AutomationId="AdminClassHex_SaveClass_Button"/>
                        <Button Content="Архивировать" Command="{Binding ArchiveClassDefinitionCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,10,0,0" Visibility="{Binding AdminDefinitionsWorkspaceVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Справочник классов" Style="{StaticResource TitleTextStyle}"/>
                            <TextBox Margin="0,8,0,8" Text="{Binding ClassSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding FilteredClassDefinitionRows}"
                                  SelectedValue="{Binding SelectedClassDefinitionCode, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Id"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  MinHeight="260"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding State}" Width="90"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Extra}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Определение класса" Style="{StaticResource TitleTextStyle}"/>
                        <Expander Header="Технические идентификаторы" AutomationProperties.AutomationId="AdminClassHex_DefinitionTechnical" IsExpanded="False" Margin="0,8,0,0">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="ClassId / Code"/>
                                    <TextBox AutomationProperties.AutomationId="AdminClassHex_ClassCode" Text="{Binding EditClassCode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Требуемый шестиугольник"/>
                                    <TextBox AutomationProperties.AutomationId="AdminClassHex_Advanced_RequiredHexagonId" Text="{Binding EditClassRequiredHexagonId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Требуемый узел"/>
                                    <TextBox AutomationProperties.AutomationId="AdminClassHex_Advanced_RequiredNodeId" Text="{Binding EditClassRequiredNodeId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                </StackPanel>
                            </UniformGrid>
                        </Expander>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Название"/>
                                <TextBox Text="{Binding EditClassName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Профиль шестиугольника"/>
                                <controls:NriReferencePicker Options="{Binding DevelopmentLayoutHexagons}"


                                          SelectedId="{Binding EditClassRequiredHexagonId, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.AutomationId="AdminClassHex_RequiredHexagonPicker"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Требуемый узел"/>
                                <controls:NriReferencePicker Options="{Binding ClassTreeItems}"
                                                              SelectedId="{Binding EditClassRequiredNodeId, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayName="{Binding SelectedClassNode.Name, TargetNullValue=Узел не выбран}"
                                                              AutomationIdPrefix="AdminClassHex_RequiredNodePicker"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Правило видимости"/>
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding EditClassVisibilityRule, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Видно по умолчанию" Tag="visible_by_default"/><ComboBoxItem Content="После открытия" Tag="after_unlock"/><ComboBoxItem Content="Только GM" Tag="gm_only"/></ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Порядок"/>
                                <controls:NriIntegerField Text="{Binding EditClassSortOrder, UpdateSourceTrigger=PropertyChanged}" Minimum="0" AccessibleName="Порядок"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Описание"/>
                        <TextBox Text="{Binding EditClassDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" TextWrapping="Wrap"/>
                        <TextBlock Text="Связанное определение класса" Margin="0,8,0,0"/>
                        <controls:NriReferencePicker Options="{Binding ClassDefinitionRows}"
                                                      SelectedId="{Binding SelectedClassDefinitionCode, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayName="{Binding EditClassName, TargetNullValue=Класс не выбран}"
                                                      AutomationIdPrefix="AdminClasses_ClassDefinition"/>
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox Content="Игроку виден только после открытия" IsChecked="{Binding EditClassIsPlayerVisible}" Margin="0,0,16,0"/>
                            <CheckBox Content="Недоступен вне шестиугольника" IsChecked="{Binding EditClassIsLockedOutsideHexagon}" IsEnabled="False"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" AutomationProperties.AutomationId="AdminSkillDefinitionEditor"
                    Visibility="{Binding AdminDefinitionsWorkspaceVisibility}">
                <StackPanel>
                    <TextBlock Text="Определение навыка" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="Название и параметры навыка редактируются как профильные поля; технический код остаётся в расширенных сведениях." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Навык для редактирования"/>
                            <ComboBox ItemsSource="{Binding SkillDefinitionRows}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedSkillDefinitionCode, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="Навык для редактирования"
                                      AutomationProperties.AutomationId="AdminSkillDefinition_Selector"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0,0,0">
                            <Button Content="Открыть"
                                    Command="{Binding OpenSelectedSkillDefinitionCommand}"
                                    AutomationProperties.AutomationId="AdminSkillDefinition_Open_Button"/>
                            <Button Content="Обновить"
                                    Command="{Binding RefreshDefinitionSkillsCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="AdminSkillDefinition_Refresh_Button"/>
                        </WrapPanel>
                    </Grid>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,8"><TextBlock Text="Название"/><TextBox AutomationProperties.AutomationId="AdminSkillDefinition_Name" Text="{Binding EditSkillName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Категория"/><ComboBox AutomationProperties.AutomationId="AdminSkillDefinition_Category" SelectedValuePath="Tag" SelectedValue="{Binding EditSkillCategory, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Общее" Tag="undefined"/><ComboBoxItem Content="Боевая" Tag="combat"/><ComboBoxItem Content="Магическая" Tag="magic"/><ComboBoxItem Content="Социальная" Tag="social"/></ComboBox></StackPanel>
                        <StackPanel Margin="0,0,8,8"><TextBlock Text="Уровень"/><controls:NriIntegerField AutomationProperties.AutomationId="AdminSkillDefinition_Tier" Text="{Binding EditSkillTier, UpdateSourceTrigger=PropertyChanged}" Minimum="1" AccessibleName="Уровень навыка"/></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Максимальный уровень"/><controls:NriIntegerField AutomationProperties.AutomationId="AdminSkillDefinition_MaxLevel" Text="{Binding EditSkillMaxLevel, UpdateSourceTrigger=PropertyChanged}" Minimum="1" AccessibleName="Максимальный уровень"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Описание"/><TextBox AutomationProperties.AutomationId="AdminSkillDefinition_Description" Text="{Binding EditSkillDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"/>
                    <Expander Header="Требования к открытию и использованию" IsExpanded="True" Margin="0,10,0,0"
                              AutomationProperties.AutomationId="AdminRequirementExpression_Editor">
                        <StackPanel>
                            <TextBlock Text="Соберите условия группами. Связи на схеме показывают направление, но не задают логику автоматически."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TreeView ItemsSource="{Binding EditSkillRequirementRoot.Children}"
                                      ItemTemplate="{StaticResource RequirementExpressionNodeTemplate0219}"
                                      Background="Transparent" BorderThickness="0" Margin="0,6,0,0"
                                      AutomationProperties.AutomationId="AdminRequirementExpression_Tree"/>
                            <WrapPanel Margin="0,8,0,0">
                                <ComboBox Width="210" SelectedValuePath="Tag" SelectedValue="{Binding EditSkillRequirementRoot.Kind, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.AutomationId="AdminRequirementExpression_RootOperator">
                                    <ComboBoxItem Content="Требуется всё" Tag="all_of"/><ComboBoxItem Content="Требуется одно из" Tag="any_of"/><ComboBoxItem Content="Минимум N условий" Tag="at_least"/>
                                </ComboBox>
                                <Button Content="Добавить условие" Command="{Binding EditSkillRequirementRoot.AddConditionCommand}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"/>
                                <Button Content="Добавить группу" Command="{Binding EditSkillRequirementRoot.AddGroupCommand}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"/>
                                <Button Content="Проверить" Command="{Binding SaveSkillDefinitionCommand}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"/>
                            </WrapPanel>
                            <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminRequirementExpression_PlayerPreview">
                                <StackPanel>
                                    <TextBlock Text="Предпросмотр для игрока" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="{Binding EditSkillRequirementPreview}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                    <WrapPanel Margin="0,8,0,0"><CheckBox Content="Навык класса" IsChecked="{Binding EditSkillIsClassSkill}" Margin="0,0,16,0"/><ComboBox Width="150" AutomationProperties.AutomationId="AdminSkillDefinition_Status" SelectedValuePath="Tag" SelectedValue="{Binding EditSkillStatus, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Черновик" Tag="draft"/><ComboBoxItem Content="Опубликован" Tag="published"/><ComboBoxItem Content="Архив" Tag="archived"/></ComboBox></WrapPanel>
                    <WrapPanel Margin="0,8,0,0"><Button Content="Сохранить навык" Command="{Binding SaveSkillDefinitionCommand}" AutomationProperties.AutomationId="AdminSkillDefinition_Save_Button"/><Button Content="Архивировать" Style="{StaticResource GhostButtonStyle}" Command="{Binding ArchiveSkillDefinitionCommand}" AutomationProperties.AutomationId="AdminSkillDefinition_Archive_Button" Margin="8,0,0,0"/></WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}"
                    Margin="0,10,0,0"
                    Visibility="{Binding AdminDevelopmentWorkspaceVisibility}"
                    AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_Route">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          Margin="0,0,0,10"
                          AutomationProperties.AutomationId="AdminDevelopmentProduct_Header">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DevelopmentLayoutViewModeText}" Style="{StaticResource TitleTextStyle}"/>
                            <TextBlock Text="Пространственное представление развития. Редактор и player-safe предпросмотр используют одну композицию; полный граф вынесен отдельно."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Обзор" Command="{Binding ResetAdminDevelopmentProductFocusCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"/>
                            <RadioButton Content="Редактор представления" IsChecked="{Binding DevelopmentLayoutCanonicalModeSelected, Mode=TwoWay}" GroupName="DevelopmentProductMode" Margin="0,0,12,0" VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="AdminDevelopmentProduct_PresentationEditorMode"/>
                            <RadioButton Content="Предпросмотр для игрока" IsChecked="{Binding DevelopmentLayoutProductPreviewSelected, Mode=TwoWay}" GroupName="DevelopmentProductMode" Margin="0,0,12,0" VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="AdminDevelopmentProduct_PlayerPreviewMode"/>
                            <RadioButton Content="Полный граф" IsChecked="{Binding DevelopmentLayoutDiagnosticGraphModeSelected, Mode=TwoWay}" GroupName="DevelopmentProductMode" VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="AdminDevelopmentProduct_FullGraphMode"/>
                        </WrapPanel>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding DevelopmentLayoutTechnicalEditorVisibility}">
                        <TextBlock Text="Визуальный редактор шестиугольника развития"
                                   Style="{StaticResource TitleTextStyle}"
                                   AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_Route"/>
                        <TextBlock Text="Перетащите узел мышью, затем сохраните раскладку. Координаты сохраняются в профиле определений и видны PlayerClient после обновления."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8"/>
                        <WrapPanel IsEnabled="{Binding DevelopmentLayoutEditingEnabled}">
                            <ComboBox Width="260"
                                      ItemsSource="{Binding DevelopmentLayoutHexagons}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedDevelopmentLayoutHexagonId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_TreeSelector"
                                      AutomationProperties.Name="Дерево развития"
                                      VerticalAlignment="Top"
                                      Margin="0,0,8,8"
                                      ToolTip="Выберите дерево развития по названию"/>
                            <Button Content="Обновить"
                                    Command="{Binding LoadClassTreeCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_Refresh_Button"
                                    Margin="0,0,8,8"/>
                            <Button Content="Сохранить визуальную раскладку"
                                    Command="{Binding SaveDevelopmentHexagonLayoutCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_SaveLayout"
                                    Margin="0,0,8,8"/>
                            <Button Content="Отменить"
                                    Command="{Binding CancelDevelopmentHexagonLayoutCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_CancelChanges"
                                    Margin="0,0,8,8"/>
                            <Button Content="Проверить"
                                    Command="{Binding ValidateDevelopmentHexagonLayoutCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ValidateLayout"
                                    Margin="0,0,8,8"/>
                            <Button Content="Сбросить"
                                    Command="{Binding ResetDevelopmentHexagonLayoutCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ResetLayout"
                                    Margin="0,0,8,8"/>
                            <Button Content="−"
                                    Command="{Binding ZoomOutDevelopmentHexagonLayoutCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    AutomationProperties.AutomationId="AdminDevelopmentHexagonEditor_ZoomOut"
