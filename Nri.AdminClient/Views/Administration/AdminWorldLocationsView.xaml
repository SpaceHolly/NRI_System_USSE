<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminWorldLocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:worldMap="clr-namespace:Nri.AdminClient.Views.WorldMap"
             xmlns:maps="clr-namespace:Nri.AdminClient.Views.Maps">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="8,8,8,0" Padding="10">
            <StackPanel>
                <TextBlock Text="Мир / страны / локации" Style="{StaticResource SectionTitleTextStyle}"/>
                <TextBlock Text="Карта мира и помещения: базовые инструменты карты мира, помещений и привязок. При выключенных флагах функций раздел показывает управляемое отключённое состояние без падений."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="WorldLocationsTabControl"
                    Grid.Row="1"
                    Margin="8"
                    SelectedIndex="0"
                    AutomationProperties.AutomationId="AdminWorldLocations_TabControl">
            <TabItem x:Name="WorldMapTab"
                     Header="Карта мира"
                     AutomationProperties.AutomationId="AdminWorldMap_Root">
                <worldMap:AdminWorldMapView DataContext="{Binding WorldMap}"/>
            </TabItem>
            <TabItem Header="Помещения / интерьеры">
                <maps:AdminRoomInteriorView DataContext="{Binding RoomInterior}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
