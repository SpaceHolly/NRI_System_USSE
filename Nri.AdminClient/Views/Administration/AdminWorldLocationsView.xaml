<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminWorldLocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:worldMap="clr-namespace:Nri.AdminClient.Views.WorldMap"
             xmlns:maps="clr-namespace:Nri.AdminClient.Views.Maps"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:NriPageHeader Grid.Row="0"
                                Title="Мир, страны и локации"
                                Subtitle="Карты мира, помещения и привязки к пространственным определениям."
                                StatusText="Проверка доступности раздела выполняется по состоянию функций."
                                AutomationProperties.AutomationId="AdminWorld_Header"
                                Margin="8,8,8,0"/>

        <TabControl x:Name="WorldLocationsTabControl"
                    Grid.Row="1"
                    Margin="8"
                    SelectedIndex="0"
                    AutomationProperties.AutomationId="AdminWorldLocations_TabControl">
            <TabItem x:Name="WorldMapTab"
                     Header="Карта мира"
                     AutomationProperties.AutomationId="AdminWorldMap_Root">
                <worldMap:AdminWorldMapView DataContext="{Binding WorldMap}"/>
            </TabItem>
            <TabItem Header="Помещения / интерьеры">
                <maps:AdminRoomInteriorView DataContext="{Binding RoomInterior}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
