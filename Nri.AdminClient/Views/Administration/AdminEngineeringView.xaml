<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminEngineeringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Инженерный конструктор / чертежи" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Платформы" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="Физическая база: размер, слоты, питание. Назначение задаётся модулями." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}" DisplayMemberPath="Summary" Margin="0,8,0,8"/>
                    <StackPanel Grid.Row="2">
                        <TextBox Text="{Binding NewPlatformName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название платформы"/>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Width="130" Text="{Binding NewPlatformKind, UpdateSourceTrigger=PropertyChanged}" ToolTip="ground_vehicle / aircraft / spacecraft"/>
                            <TextBox Width="100" Text="{Binding NewPlatformSizeClass, UpdateSourceTrigger=PropertyChanged}" ToolTip="size class" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Width="70" Text="{Binding NewPlatformSlots, UpdateSourceTrigger=PropertyChanged}" ToolTip="Слоты"/>
                            <TextBox Width="90" Text="{Binding NewPlatformHardpoints, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hardpoints" Margin="6,0,0,0"/>
                            <TextBox Width="90" Text="{Binding NewPlatformPowerOutput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Питание" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <CheckBox Content="Видна игрокам" IsChecked="{Binding NewPlatformVisible}" Margin="0,6,0,0"/>
                        <Button Content="Создать платформу" Command="{Binding CreatePlatformCommand}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Модули" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="Модули определяют роль конструкции. Dice expression хранится как граница, без изменения боёвки." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}" DisplayMemberPath="Summary" Margin="0,8,0,8"/>
                    <StackPanel Grid.Row="2">
                        <TextBox Text="{Binding NewModuleName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название модуля"/>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Width="110" Text="{Binding NewModuleCategory, UpdateSourceTrigger=PropertyChanged}" ToolTip="Категория"/>
                            <TextBox Width="100" Text="{Binding NewModuleSlotType, UpdateSourceTrigger=PropertyChanged}" ToolTip="Тип слота" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Width="70" Text="{Binding NewModuleSlotCost, UpdateSourceTrigger=PropertyChanged}" ToolTip="Слоты"/>
                            <TextBox Width="70" Text="{Binding NewModuleHardpointCost, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hardpoints" Margin="6,0,0,0"/>
                            <TextBox Width="80" Text="{Binding NewModulePowerLoad, UpdateSourceTrigger=PropertyChanged}" ToolTip="Потребление" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <TextBox Text="{Binding NewModuleDiceExpression, UpdateSourceTrigger=PropertyChanged}" ToolTip="Dice expression, например 2d10+4" Margin="0,6,0,0"/>
                        <CheckBox Content="Виден игрокам" IsChecked="{Binding NewModuleVisible}" Margin="0,6,0,0"/>
                        <Button Content="Создать модуль" Command="{Binding CreateModuleCommand}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Проектирование и чертёж" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="Результат этапа — blueprint/reference. Производство, фабрики и выдача техники не выполняются." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TabControl Grid.Row="1" Margin="0,8,0,8">
                        <TabItem Header="Проекты">
                            <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" DisplayMemberPath="Summary"/>
                        </TabItem>
                        <TabItem Header="Проверка">
                            <ListBox ItemsSource="{Binding ValidationRows}"/>
                        </TabItem>
                        <TabItem Header="Пресеты">
                            <ListBox ItemsSource="{Binding Presets}" DisplayMemberPath="Summary"/>
                        </TabItem>
                    </TabControl>
                    <StackPanel Grid.Row="2">
                        <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название проекта"/>
                        <TextBox Text="{Binding ProjectPlatformId, UpdateSourceTrigger=PropertyChanged}" ToolTip="PlatformId" Margin="0,6,0,0"/>
                        <TextBox Text="{Binding ProjectModuleIds, UpdateSourceTrigger=PropertyChanged}" ToolTip="ModuleIds через запятую" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Width="145" Text="{Binding ProjectOwnerUserId, UpdateSourceTrigger=PropertyChanged}" ToolTip="OwnerUserId"/>
                            <TextBox Width="145" Text="{Binding ProjectActorEntityId, UpdateSourceTrigger=PropertyChanged}" ToolTip="ID персонажа или действующего лица" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <TextBox Text="{Binding ProjectIntendedRole, UpdateSourceTrigger=PropertyChanged}" ToolTip="Назначение / роль" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Проверить" Command="{Binding ValidateDesignCommand}"/>
                            <Button Content="Создать проект" Command="{Binding CreateProjectCommand}" Margin="6,0,0,0"/>
                            <Button Content="Создать пресет" Command="{Binding CreatePresetCommand}" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Старт" Command="{Binding StartProjectCommand}"/>
                            <TextBox Width="60" Text="{Binding ProgressAmount, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0"/>
                            <Button Content="+ прогресс" Command="{Binding AddProgressCommand}" Margin="6,0,0,0"/>
                            <Button Content="Завершить" Command="{Binding CompleteProjectCommand}" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Подготовить чертёж" Command="{Binding PrepareBlueprintCommand}"/>
                            <Button Content="Принять чертёж" Command="{Binding AcceptBlueprintCommand}" Margin="6,0,0,0"/>
                            <Button Content="Отмена" Command="{Binding CancelProjectCommand}" Margin="6,0,0,0"/>
                            <Button Content="Провал" Command="{Binding FailProjectCommand}" Margin="6,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
