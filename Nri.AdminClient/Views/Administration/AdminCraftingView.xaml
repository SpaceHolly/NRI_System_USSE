<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminCraftingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nri="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             Background="{StaticResource NriApplicationBackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             AutomationProperties.AutomationId="AdminCraftProject_Route">
    <patterns:NriOperationalWorkspaceHost Margin="10">
        <patterns:NriOperationalWorkspaceHost.Header>
            <nri:NriPageHeader Breadcrumbs="Администрирование · Проекты"
                               Title="Единые проекты"
                               Subtitle="Изготовление, исследования, обратная инженерия, создание и ремонт прототипов: требования, резерв, стадии и результат."
                               StatusText="{Binding StatusMessage}">
                <nri:NriPageHeader.PrimaryAction>
                    <Button Content="Обновить"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="AdminCraftProject_Refresh"/>
                </nri:NriPageHeader.PrimaryAction>
            </nri:NriPageHeader>
        </patterns:NriOperationalWorkspaceHost.Header>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="1.65*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Очередь проектов" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="Тип проекта" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <ComboBox ItemsSource="{Binding ProjectKinds}"
                                  SelectedItem="{Binding SelectedProjectKind, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.AutomationId="AdminUnifiedProject_TypeSelector"/>
                        <TextBlock Text="Выберите проект, чтобы открыть условия и ход работы."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8"/>
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             AutomationProperties.AutomationId="AdminCraftProject_List">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding QueueSummary}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OwnerDisplayName}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding OwnerCharacterDisplayName}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedProject.Name, TargetNullValue=Проект не выбран}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       AutomationProperties.AutomationId="AdminCraftProject_Title"/>
                            <ScrollViewer MaxHeight="150"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,4,0,0">
                                <TextBlock Text="{Binding SelectedProject.RuntimeSummary}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SelectedProject.StatusLabel}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedProject.ProgressSummary}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="1" Margin="0,12,0,12"
                                AutomationProperties.AutomationId="AdminCraftProject_Details">
                        <TabItem Header="Условия">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox ItemsSource="{Binding Requirements}"
                                         SelectedItem="{Binding SelectedRequirement, Mode=TwoWay}"
                                         DisplayMemberPath="Display"
                                         VirtualizingStackPanel.IsVirtualizing="False"
                                         AutomationProperties.AutomationId="AdminCraftProject_Requirements">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name"
                                                    Value="{Binding Display}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <Button Grid.Row="1"
                                        Content="Подтвердить выбранное условие"
                                        Command="{Binding ConfirmRequirementCommand}"
                                        IsEnabled="{Binding CanConfirmSelectedRequirement}"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        AutomationProperties.AutomationId="AdminCraftProject_ConfirmRequirement"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Ресурсы">
                            <ListBox ItemsSource="{Binding Resources}" DisplayMemberPath="Display"/>
                        </TabItem>
                        <TabItem Header="Стадии">
                            <ListBox ItemsSource="{Binding Stages}"
                                     DisplayMemberPath="Display"
                                     AutomationProperties.AutomationId="AdminCraftProject_Stages">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="История">
                            <ListBox ItemsSource="{Binding Audit}"
                                     DisplayMemberPath="Display"
                                     AutomationProperties.AutomationId="AdminCraftProject_Audit">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="Строительство"
                                 Visibility="{Binding IsAssetConstructionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8"
                                            AutomationProperties.AutomationId="AdminAssetConstruction_Details">
                                    <TextBlock Text="{Binding SelectedProject.BlueprintName, StringFormat=Чертёж: {0}}"
                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedProject.ConstructionAssetKindLabel, StringFormat=Тип актива: {0}}"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedProject.ConstructionLocationName, StringFormat=Место строительства: {0}}"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedProject.ConstructionMethod, StringFormat=Метод: {0}}"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedProject.ConstructionConfigurationSummary}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding SelectedProject.ConstructionSiteStatusLabel, StringFormat=Площадка: {0}}"
                                               FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <ProgressBar Minimum="0" Maximum="100"
                                                 Value="{Binding SelectedProject.ProgressPercent, Mode=OneWay}"
                                                 Height="10" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding SelectedProject.ResultName, StringFormat=Готовый актив: {0}}"
                                               Foreground="{StaticResource NriSuccessBrush}"
                                               FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedProject.MaintenanceSummary, StringFormat=Обслуживание: {0}}"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedProject.ConstructionWarning}"
                                               Foreground="{StaticResource NriWarningBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Эксплуатация актива"
                                 Visibility="{Binding IsAssetMaintenanceMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="8" AutomationProperties.AutomationId="AdminAssetOperation_Workspace">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Крупные активы" FontWeight="SemiBold"/>
                                    <ListBox ItemsSource="{Binding AdminAssetOperations0198}"
                                             SelectedItem="{Binding SelectedAdminAssetOperation0198, Mode=TwoWay}"
                                             DisplayMemberPath="Summary" MaxHeight="180" Margin="0,6,8,0"
                                             AutomationProperties.AutomationId="AdminAssetOperation_AssetList"/>
                                    <TextBlock Text="{Binding SelectedAdminAssetOperation0198.Details}"
                                               TextWrapping="Wrap" Margin="0,8,8,0"/>
                                    <WrapPanel Margin="0,10,8,0">
                                        <Button Content="Ввести в эксплуатацию"
                                                Command="{Binding ActivateAssetOperationCommand0198}"
                                                AutomationProperties.AutomationId="AdminAssetOperation_Activate"/>
                                        <Button Content="Отметить срок обслуживания" Margin="8,0,0,0"
                                                Style="{StaticResource NriSecondaryButtonStyle}"
                                                Command="{Binding MarkAssetMaintenanceDueCommand0198}"
                                                AutomationProperties.AutomationId="AdminAssetMaintenance_MarkDue"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Условия эксплуатации и канонические связи" FontWeight="SemiBold"/>
                                        <TextBlock Text="Специалист и документ проверяются сервером в рамках кампании и владельца актива."
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,6"/>
                                        <ComboBox ItemsSource="{Binding AdminAssetSpecialists0198}"
                                                  SelectedItem="{Binding SelectedAdminAssetSpecialist0198, Mode=TwoWay}"
                                                  DisplayMemberPath="Display"
                                                  AutomationProperties.Name="Ключевой специалист"
                                                  AutomationProperties.AutomationId="AdminAssetOperation_SpecialistPicker"/>
                                        <ComboBox ItemsSource="{Binding AdminAssetLicenses0198}"
                                                  SelectedItem="{Binding SelectedAdminAssetLicense0198, Mode=TwoWay}"
                                                  DisplayMemberPath="Display" Margin="0,6,0,0"
                                                  AutomationProperties.Name="Действующий документ"
                                                  AutomationProperties.AutomationId="AdminAssetOperation_LicensePicker"/>
                                        <Button Content="Назначить связи" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                Command="{Binding SaveAssetOperationReferencesCommand0198}"
                                                AutomationProperties.AutomationId="AdminAssetOperation_SaveReferences"/>
                                    </StackPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding AdminAssetOperationRequirements0198}"
                                             SelectedItem="{Binding SelectedAdminAssetRequirement0198, Mode=TwoWay}"
                                             DisplayMemberPath="Display" Margin="0,6,0,0"
                                             AutomationProperties.AutomationId="AdminAssetOperation_Requirements"/>
                                    <Button Grid.Row="2" Content="Подтвердить ручное условие"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Command="{Binding ConfirmAssetOperationRequirementCommand0198}"
                                            AutomationProperties.AutomationId="AdminAssetOperation_ConfirmRequirement"/>
                                    <Expander Grid.Row="3" Header="История обслуживания" Margin="0,10,0,0">
                                        <ListBox ItemsSource="{Binding AdminAssetServiceHistory0198}" MaxHeight="120"/>
                                    </Expander>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Испытания"
                                 Visibility="{Binding IsPrototypeActionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox ItemsSource="{Binding TestHistory}"
                                     DisplayMemberPath="Display"
                                     AutomationProperties.AutomationId="AdminPrototypeRepair_TestHistory"/>
                        </TabItem>
                    </TabControl>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding SelectedProject.ResultName, StringFormat=Результат: {0}}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="Одобрить" Command="{Binding ApproveCommand}"
                                    AutomationProperties.AutomationId="AdminCraftProject_Approve"/>
                            <Button Content="Отклонить" Command="{Binding RejectCommand}"
                                    Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0"/>
                            <Button Content="Резерв ресурсов" Command="{Binding ReserveCommand}" Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="AdminCraftProject_Reserve"/>
                            <Button Content="Начать работу" Command="{Binding StartCommand}" Margin="8,0,0,0"/>
                            <Button Content="Завершить стадию" Command="{Binding CompleteStageCommand}" Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="AdminCraftProject_CompleteStage"/>
                            <Button Content="Провести испытание"
                                    Command="{Binding ExecuteTestCommand}"
                                    Visibility="{Binding IsPrototypeMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="AdminPrototypeProject_ExecuteTest"/>
                            <Button Content="Провести повторное испытание"
                                    Command="{Binding ExecuteRetestCommand}"
                                    Visibility="{Binding CanExecuteRetest, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="AdminPrototypeRepair_ExecuteRetest"/>
                            <Button Content="Допустить к ограниченному производству"
                                    Command="{Binding ApproveLimitedProductionCommand}"
                                    Visibility="{Binding CanApproveLimitedProduction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="AdminPrototypeRepair_ApproveLimitedProduction"/>
                            <Button Content="Завершить проект" Command="{Binding CompleteCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding CanShowCompleteProject, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="AdminCraftProject_Complete"/>
                            <Button Content="Отменить" Command="{Binding CancelCommand}"
                                    Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0"/>
                            <Button Content="Завершить неудачей" Command="{Binding FailCommand}"
                                    Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <patterns:NriOperationalWorkspaceHost.Status>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Скрыть ошибку"
                        Command="{Binding ClearErrorCommand}"
                        Style="{StaticResource NriSecondaryButtonStyle}"
                        Margin="8,0,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="AdminCraftProject_Error"/>
            </DockPanel>
        </patterns:NriOperationalWorkspaceHost.Status>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
