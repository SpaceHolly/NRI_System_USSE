<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminEconomyMarketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="AdminEconomy_Route">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:NriPageHeader Grid.Row="0"
                                Title="Экономика и рынки"
                                Subtitle="Справочник экономики и рынков"
                                StatusText="Недоступно в текущем профиле сервера"
                                AutomationProperties.AutomationId="AdminEconomy_Header"
                                Margin="8,8,8,0"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" Margin="8" Padding="22">
                <StackPanel>
                    <TextBlock Text="Экономика и рынки" Style="{StaticResource SectionTitleTextStyle}" FontSize="22"/>
        <controls:NriRouteStateHost State="{Binding EconomyRouteState, Mode=OneWay}" ActiveStates="unavailable" Panel.ZIndex="10" AutomationProperties.AutomationId="AdminEconomy_StateHost">
                        <controls:NriRouteStatePresenter State="{Binding EconomyRouteState}" VisibleFor="unavailable">
                    <TextBlock AutomationProperties.AutomationId="AdminEconomy_UnavailableState"
                               Visibility="Visible"
                               Text="{Binding EconomyUnavailableStateMessage}"
                               Style="{StaticResource TitleTextStyle}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>
                        </controls:NriRouteStatePresenter>
                    </controls:NriRouteStateHost>
                    <TextBlock AutomationProperties.AutomationId="AdminEconomy_UnavailableExplanation"
                               Text="Редактор появится после подключения зарегистрированного серверного профиля. Кошелёк персонажа остаётся отдельным разделом."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
