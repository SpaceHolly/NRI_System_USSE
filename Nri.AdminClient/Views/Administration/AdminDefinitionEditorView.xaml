<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminDefinitionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.AdminClient.ViewModels"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="AdminDefinitionEditor_Route">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseReferencePickerCommand}"/>
    </UserControl.InputBindings>
        <Grid Margin="8">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

                <controls:NriRouteStateHost Grid.Row="1" State="{Binding RouteState, Mode=OneWay}" ActiveStates="loading,empty,no-results,no-selection,error,permission" Panel.ZIndex="10" AutomationProperties.AutomationId="AdminDefinitionEditor_StateHost">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="loading"><controls:NriLoadingOverlay IsLoading="True" ProgressText="Загрузка справочников…" AutomationProperties.AutomationId="AdminDefinitionEditor_Loading"/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="empty"><controls:NriEmptyState AutomationProperties.AutomationId="AdminDefinitionEditor_EmptyState" Title="Записей пока нет" Message="Выберите категорию или создайте запись."/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="no-results"><controls:NriEmptyState AutomationProperties.AutomationId="AdminDefinitionEditor_NoResults" Title="Ничего не найдено" Message="Измените запрос или фильтры."/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="no-selection"><TextBlock Text="Запись не выбрана." AutomationProperties.AutomationId="AdminDefinitionEditor_NoSelection"/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="permission"><controls:NriPermissionState AutomationProperties.AutomationId="AdminDefinitionEditor_Permission" Explanation="{Binding PermissionState}"/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="error"><TextBlock AutomationProperties.AutomationId="AdminDefinitionEditor_Error" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/></controls:NriRouteStatePresenter>
            </StackPanel>
        </controls:NriRouteStateHost>

        <controls:NriPageHeader Grid.Row="0"
                                Title="Справочники"
                                Subtitle="Создание и настройка игровых определений"
                                StatusText="{Binding StatusMessage}"
                                AutomationProperties.AutomationId="AdminDefinitionEditor_Header"
                                VerticalAlignment="Top"
                                MaxHeight="112"
                                Margin="0,0,0,8">
            <controls:NriPageHeader.PrimaryAction>
                <Button AutomationProperties.AutomationId="AdminDefinitionEditor_Create"
                        Content="Создать запись"
                        Command="{Binding CreateCommand}"/>
            </controls:NriPageHeader.PrimaryAction>
            <controls:NriPageHeader.SecondaryActions>
                <WrapPanel>
                    <controls:NriStatusBadge Text="{Binding UnsavedChangesSummary}"
                                             StatusKind="Warning"
                                             Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.AutomationId="AdminDefinitionEditor_Unsaved"/>
                    <controls:NriStatusBadge Text="{Binding ValidationFeedbackSummary}"
                                             StatusKind="Danger"
                                             Margin="6,0,0,0"
                                             Visibility="{Binding HasValidationIssues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.AutomationId="AdminDefinitionEditor_Validation"/>
                    <controls:NriToastHost Message="{Binding StatusMessage}"
                                           IsOpen="{Binding HasStatusMessage}"
                                           Margin="6,0,0,0"
                                           AutomationProperties.AutomationId="AdminDefinitionEditor_Success"/>
                    <Button AutomationProperties.AutomationId="AdminDefinitionEditor_Refresh" Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButtonStyle}"/>
                    <Button AutomationProperties.AutomationId="AdminDefinitionEditor_Save" Content="Сохранить" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSaveDraft}" Margin="6,0,0,0"/>
                    <Button AutomationProperties.AutomationId="AdminDefinitionEditor_Validate" Content="Проверить" Command="{Binding ValidateCommand}" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"/>
                    <Button AutomationProperties.AutomationId="AdminDefinitionEditor_PlayerPreview" Content="Предпросмотр игрока" Command="{Binding PlayerPreviewCommand}" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"/>
                    <Button AutomationProperties.AutomationId="AdminDefinitionEditor_ToggleInspector" Content="{Binding InspectorButtonText}" Command="{Binding ToggleInspectorCommand}" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"/>
                </WrapPanel>
            </controls:NriPageHeader.SecondaryActions>
        </controls:NriPageHeader>

        <patterns:NriEntityEditorHost Grid.Row="1"
                                      x:Name="AdminDefinitionEditorHost"
                                      AutomationProperties.AutomationId="AdminDefinitionEditor_EditorHost"
                                      HasUnsavedChanges="{Binding HasUnsavedChanges}"
                                      RecordListWidth="340"
                                      IsInspectorOpen="{Binding IsInspectorOpen}">
            <patterns:NriEntityEditorHost.RecordList>
                <controls:NriAutomationAnchor AutomationProperties.AutomationId="AdminDefinitionEditor_RecordList"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch">
                <Grid MinWidth="280" MaxWidth="460" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Поиск и фильтры" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_Search"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Поиск по названию, тегам и категории"
                                     Margin="0,8,0,6"/>
                            <ComboBox AutomationProperties.AutomationId="AdminDefinitionEditor_FamilyTabs"
                                      ItemsSource="{Binding FamilyFilters}"
                                      SelectedItem="{Binding SelectedFamily}"
                                      HorizontalAlignment="Stretch"
                                      MaxDropDownHeight="260"
                                      Margin="0,0,0,6"/>
                            <controls:NriAutomationAnchor AutomationProperties.AutomationId="AdminDefinitionEditor_ProfileSelector"
                                                          HorizontalContentAlignment="Stretch"
                                                          VerticalContentAlignment="Stretch"
                                                          Margin="0,0,0,6">
                                <ComboBox AutomationProperties.AutomationId="AdminDefinitionEditor_TypeFilter"
                                          ItemsSource="{Binding TypeFilters}"
                                          SelectedItem="{Binding SelectedType}"
                                          HorizontalAlignment="Stretch"
                                          MaxDropDownHeight="260"/>
                            </controls:NriAutomationAnchor>
                            <ComboBox AutomationProperties.AutomationId="AdminDefinitionEditor_VisibilityFilter"
                                      ItemsSource="{Binding VisibilityFilters}"
                                      SelectedItem="{Binding SelectedVisibility}"
                                      HorizontalAlignment="Stretch"
                                      MaxDropDownHeight="260"
                                      Margin="0,0,0,6"/>
                            <ComboBox AutomationProperties.AutomationId="AdminDefinitionEditor_PhysiologyFilter"
                                      ItemsSource="{Binding PhysiologyFilters}"
                                      SelectedItem="{Binding SelectedPhysiologyFilter}"
                                      Visibility="{Binding IsRaceFamilySelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ToolTip="Фильтр рас и подвидов по игровой физиологии"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,6"/>
                            <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_RuleSetFilter"
                                     Text="{Binding RuleSetFilter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Фильтр по профилю правил"
                                     Margin="0,0,0,6"/>
                            <CheckBox AutomationProperties.AutomationId="AdminDefinitionEditor_IncludeArchived" Content="Показывать архив" IsChecked="{Binding IncludeArchived}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="1"
                             AutomationProperties.AutomationId="AdminDefinitionEditor_DefinitionList"
                             AutomationProperties.Name="Список справочников"
                             ItemsSource="{Binding FilteredDefinitions}"
                             SelectedItem="{Binding SelectedDefinition}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Margin="0,8,8,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DefinitionRecordRow}">
                                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                        <TextBlock Text="{Binding ListSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="0,8,8,0">
                        <Button AutomationProperties.AutomationId="AdminDefinitionEditor_Clone" Content="Клонировать" Command="{Binding CloneCommand}" Style="{StaticResource GhostButtonStyle}"/>
                        <Button AutomationProperties.AutomationId="AdminDefinitionEditor_Archive" Content="Архивировать" Command="{Binding ArchiveCommand}" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"/>
                        <Button AutomationProperties.AutomationId="AdminDefinitionEditor_Restore" Content="Восстановить" Command="{Binding RestoreCommand}" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"/>
                    </WrapPanel>
                </Grid>
                </controls:NriAutomationAnchor>
            </patterns:NriEntityEditorHost.RecordList>

            <patterns:NriEntityEditorHost.Form>
                <controls:NriAutomationAnchor AutomationProperties.AutomationId="AdminDefinitionEditor_FormHost"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch">
                <Border AutomationProperties.AutomationId="AdminDefinitionEditor_Edit" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,8,0">
                    <ScrollViewer AutomationProperties.AutomationId="AdminDefinitionEditor_EditScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Редактор записи" Style="{StaticResource SectionTitleTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8" AutomationProperties.AutomationId="AdminDefinitionEditor_Status">
                                <TextBlock Text="Статус: " Style="{StaticResource NriMetadataTextStyle}"/>
                                <TextBlock Text="{Binding SelectedDefinition.StatusLabel, TargetNullValue=Не выбрана}" Style="{StaticResource NriMetadataTextStyle}"/>
                            </StackPanel>
                            <TextBlock AutomationProperties.AutomationId="AdminDefinitionEditor_Unsaved_Status" Text="{Binding UnsavedChangesSummary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10"/>

                            <TextBlock Text="Основное" Style="{StaticResource TitleTextStyle}"/>
                            <controls:NriFormField Label="Название" IsRequired="True" HelpText="Название видно GM и игрокам, если запись опубликована.">
                                <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_DisplayName" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                            </controls:NriFormField>
                            <controls:NriFormField Label="Короткий код" HelpText="Человекочитаемый код для поиска и экспорта.">
                                <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_ShortCode" Text="{Binding ShortCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </controls:NriFormField>
                            <controls:NriFormField Label="Видимость" HelpText="Определяет, кому будет доступна запись.">
                                <ComboBox AutomationProperties.AutomationId="AdminDefinitionEditor_VisibilityRule"
                                          ItemsSource="{Binding VisibilityRuleOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding VisibilityRule, UpdateSourceTrigger=PropertyChanged}"/>
                            </controls:NriFormField>
                            <controls:NriFormField Label="Игровые теги" HelpText="Публичные теги для поиска и группировки. Системные теги сохраняются отдельно.">
                                <controls:NriTagEditor AutomationProperties.AutomationId="AdminDefinitionEditor_Tags"
                                                       AccessibleName="Игровые теги"
                                                       Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>
                            </controls:NriFormField>

                            <TextBlock Text="Описание" Style="{StaticResource TitleTextStyle}" Margin="0,14,0,6"/>
                            <controls:NriFormField Label="Описание для игроков" HelpText="Это описание увидят игроки, если запись опубликована.">
                                <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_PublicDescription"
                                         MinHeight="90"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding PublicDescription, UpdateSourceTrigger=PropertyChanged}"/>
                            </controls:NriFormField>
                            <controls:NriFormField Label="Заметки GM" HelpText="Не показываются игрокам.">
                                <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_GmFields"
                                         MinHeight="70"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding GmDescription, UpdateSourceTrigger=PropertyChanged}"/>
                            </controls:NriFormField>

                            <TextBlock AutomationProperties.AutomationId="AdminDefinitionEditor_CustomFieldsHeading"
                                       Text="Правила и свойства"
                                       Style="{StaticResource TitleTextStyle}"
                                       Margin="0,14,0,6"/>
                            <ItemsControl AutomationProperties.AutomationId="AdminDefinitionEditor_CustomFields" ItemsSource="{Binding FieldEditors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DefinitionFieldEditVm}">
                                        <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,8" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RequiredLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="{Binding HelpText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBox AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Text}"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             MinHeight="30"
                                                             Visibility="{Binding IsTextEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBox AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Text}"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             MinHeight="76"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             Visibility="{Binding IsMultilineTextEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBox AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Text}"
                                                             Text="{Binding LoreInformationVersionsDisplayValue, UpdateSourceTrigger=PropertyChanged}"
                                                             MinHeight="118"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             ToolTip="Одна строка на версию. Тип знания выбирается по читаемому названию; внутренний идентификатор формируется автоматически."
                                                             Visibility="{Binding IsLoreInformationVersionsEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBox AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Text}"
                                                             Text="{Binding LawActionRulesDisplayValue, UpdateSourceTrigger=PropertyChanged}"
                                                             MinHeight="148"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             ToolTip="Одна строка на действие. Уровни контроля и лицензии показываются по названиям; внутренние ссылки формируются автоматически."
                                                             Visibility="{Binding IsLawActionRulesEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBox AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Text}"
                                                             Text="{Binding EconomicBandDisplayValue, UpdateSourceTrigger=PropertyChanged}"
                                                             MinHeight="76"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             ToolTip="Одна строка на диапазон. Валюта показывается по названию; внутренняя ссылка формируется автоматически."
                                                             Visibility="{Binding IsEconomicBandEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBox AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_StructuredRows}"
                                                             Text="{Binding TechnologyStructuredRowsDisplayValue, UpdateSourceTrigger=PropertyChanged}"
                                                             MinHeight="118"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             ToolTip="Одна строка на запись. Связанные объекты показываются по читаемым названиям; внутренние ссылки формируются автоматически."
                                                             Visibility="{Binding IsTechnologyStructuredRowsEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriOptionField AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Option}"
                                                                             AccessibleName="{Binding DisplayName}"
                                                                             ItemsSource="{Binding ValueOptions}"
                                                                             SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                             Visibility="{Binding IsOptionEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriSearchableOptionField AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Option}"
                                                                                       AccessibleName="{Binding DisplayName}"
                                                                                       ItemsSource="{Binding ValueOptions}"
                                                                                       SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                       Visibility="{Binding IsSearchableOptionEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriBooleanField AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Boolean}"
                                                                              AccessibleName="{Binding DisplayName}"
                                                                              Content="{Binding ShortLabel}"
                                                                              IsChecked="{Binding BooleanValue, UpdateSourceTrigger=PropertyChanged}"
                                                                              Visibility="{Binding IsBooleanEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriIntegerField AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Numeric}"
                                                                              AccessibleName="{Binding DisplayName}"
                                                                              Value="{Binding IntegerValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Minimum="{Binding IntegerMinimum}"
                                                                              Maximum="{Binding IntegerMaximum}"
                                                                              Step="{Binding IntegerStep}"
                                                                              AllowEmpty="True"
                                                                              HasValidationError="{Binding HasValidationError, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              ValidationMessage="{Binding ControlValidationMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              UnitLabel="{Binding UnitLabel}"
                                                                              Visibility="{Binding IsIntegerEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriDecimalField AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Numeric}"
                                                                              AccessibleName="{Binding DisplayName}"
                                                                              Value="{Binding DecimalValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Minimum="{Binding Minimum}"
                                                                              Maximum="{Binding Maximum}"
                                                                              Step="{Binding Step}"
                                                                              AllowEmpty="True"
                                                                              HasValidationError="{Binding HasValidationError, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              ValidationMessage="{Binding ControlValidationMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              UnitLabel="{Binding UnitLabel}"
                                                                              Visibility="{Binding IsDecimalEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriBoundedNumberField AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Numeric}"
                                                                                    AccessibleName="{Binding DisplayName}"
                                                                                    Value="{Binding DecimalValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                    Minimum="{Binding Minimum}"
                                                                                    Maximum="{Binding Maximum}"
                                                                                    Step="{Binding Step}"
                                                                                    AllowEmpty="True"
                                                                                    HasValidationError="{Binding HasValidationError, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                    ValidationMessage="{Binding ControlValidationMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                    UnitLabel="{Binding UnitLabel}"
                                                                                    Visibility="{Binding IsBoundedNumberEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriDateField AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Date}"
                                                                           AccessibleName="{Binding DisplayName}"
                                                                           SelectedDate="{Binding DateValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           Visibility="{Binding IsDateEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriDateTimeField AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_DateTime}"
                                                                               AccessibleName="{Binding DisplayName}"
                                                                               Value="{Binding DateTimeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               HasValidationError="{Binding HasValidationError, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               ValidationMessage="{Binding ControlValidationMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               Visibility="{Binding IsDateTimeEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriDurationField AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Duration}"
                                                                               AccessibleName="{Binding DisplayName}"
                                                                               Value="{Binding DurationValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               MinimumMinutes="{Binding MinimumMinutes}"
                                                                               MaximumMinutes="{Binding MaximumMinutes}"
                                                                               HasValidationError="{Binding HasValidationError, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               ValidationMessage="{Binding ControlValidationMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               UnitLabel="{Binding UnitLabel}"
                                                                               Visibility="{Binding IsDurationEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriReferencePicker AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Reference_Open}"
                                                                                 AutomationIdPrefix="{Binding AutomationId, StringFormat={}{0}_Reference}"
                                                                                 DisplayName="{Binding ReferenceDisplayName}"
                                                                                 SelectedId="{Binding Value, Mode=OneWay}"
                                                                                 StatusText="{Binding ReferenceStatusText}"
                                                                                 ValidationMessage="{Binding ReferencePickerValidation}"
                                                                                 SearchCommand="{Binding ReferenceSearchCommand}"
                                                                                 SearchText="{Binding ReferenceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Options="{Binding ReferenceOptions}"
                                                                                 SelectedOption="{Binding SelectedReferenceOption, Mode=TwoWay}"
                                                                                 SelectCommand="{Binding AddReferenceCommand}"
                                                                                 ClearCommand="{Binding ClearReferenceCommand}"
                                                                                 Visibility="{Binding IsReferenceEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriMultiReferencePicker AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_MultiReference_Open}"
                                                                                      AutomationIdPrefix="{Binding AutomationId, StringFormat={}{0}_MultiReference}"
                                                                                      DisplayName="{Binding ReferenceDisplayName}"
                                                                                      SelectedId="{Binding Value, Mode=OneWay}"
                                                                                      StatusText="{Binding ReferenceStatusText}"
                                                                                      SelectedReferences="{Binding ReferenceChips}"
                                                                                      ValidationMessage="{Binding ReferencePickerValidation}"
                                                                                      SearchCommand="{Binding ReferenceSearchCommand}"
                                                                                      SearchText="{Binding ReferenceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Options="{Binding ReferenceOptions}"
                                                                                      SelectedOption="{Binding SelectedReferenceOption, Mode=TwoWay}"
                                                                                      AddCommand="{Binding AddReferenceCommand}"
                                                                                      RemoveCommand="{Binding RemoveReferenceCommand}"
                                                                                      ClearAllCommand="{Binding ClearReferenceCommand}"
                                                                                      Visibility="{Binding IsMultiReferenceEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriTagEditor AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Tag}"
                                                                           AutomationIdPrefix="{Binding AutomationId, StringFormat={}{0}_Tag}"
                                                                           AccessibleName="{Binding DisplayName}"
                                                                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                           Visibility="{Binding IsTagsEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriGeneratedIdentifierField AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Generated}"
                                                                                          AccessibleName="{Binding DisplayName}"
                                                                                          Text="{Binding Value, Mode=OneWay}"
                                                                                          Visibility="{Binding IsGeneratedIdentifierEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <controls:NriUnknownValueState AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_LegacyWarning}"
                                                                                   IsOpen="{Binding HasUnknownLegacyValue}"
                                                                                   Message="{Binding UnknownLegacyWarning}"
                                                                                   Value="{Binding UnknownLegacyValue}"/>
                                                    <controls:NriFieldValidationPresenter AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Validation}"
                                                                                         Message="{Binding ValidationHint}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding VisibilityLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border AutomationProperties.AutomationId="AdminResolutionProfile_ProbabilityPreview"
                                    Style="{StaticResource SubtleCardStyle}"
                                    Margin="0,6,0,8"
                                    Visibility="{Binding IsResolutionBalancePreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Ожидаемая вероятность" Style="{StaticResource TitleTextStyle}"/>
                                    <TextBlock Text="Контрольный пример для выбранного профиля" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6"/>
                                    <TextBlock AutomationProperties.AutomationId="AdminResolutionProfile_ProbabilityPreviewText"
                                               Text="{Binding ResolutionBalancePreviewText, Mode=OneWay}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Связи" Style="{StaticResource TitleTextStyle}" Margin="0,14,0,6"/>
                            <controls:NriReferencePicker AutomationProperties.AutomationId="AdminDefinitionEditor_ReferencePicker"
                                                         SelectedOption="{Binding SelectedReferenceOption, Mode=TwoWay}"
                                                         DisplayName="{Binding SelectedReferenceDisplayName}"
                                                         StatusText="{Binding ReferencePickerStatus}"
                                                         ValidationMessage="{Binding ReferencePickerValidation}"
                                                         SearchCommand="{Binding ReferenceSearchCommand}"
                                                         ClearCommand="{Binding ClearReferenceCommand}"/>
                            <TextBlock Text="{Binding ReferenceTargetLabel, StringFormat=Допустимый тип: {0}}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,5,0,0"/>
                            <Border AutomationProperties.AutomationId="AdminDefinitionEditor_ReferencePickerPanel"
                                    Style="{StaticResource SubtleCardStyle}"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsReferencePickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_ReferenceSearch"
                                         Text="{Binding ReferenceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Найдите запись по названию или тегу"/>
                                <Button Grid.Column="1" AutomationProperties.AutomationId="AdminDefinitionEditor_ReferenceSearchButton" Content="Найти" Command="{Binding ReferenceSearchCommand}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"/>
                            </Grid>
                            <CheckBox AutomationProperties.AutomationId="AdminDefinitionEditor_ReferenceIncludeArchived"
                                      Content="Показывать архивные записи"
                                      IsChecked="{Binding IncludeArchivedReferences}"
                                      Margin="0,8,0,0"/>
                            <ListBox AutomationProperties.AutomationId="AdminDefinitionEditor_ReferenceOptions"
                                     ItemsSource="{Binding ReferenceOptions}"
                                     SelectedItem="{Binding SelectedReferenceOption}"
                                     MaxHeight="130"
                                     Margin="0,8,0,0"
                                     DisplayMemberPath="DisplayName">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Button AutomationProperties.AutomationId="AdminDefinitionEditor_AddReference" Content="Добавить связь" Command="{Binding AddReferenceCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                            </Border>
                            <ListBox AutomationProperties.AutomationId="AdminDefinitionEditor_SelectedReferences"
                                     ItemsSource="{Binding SelectedReferences}"
                                     SelectedItem="{Binding SelectedLinkedReference}"
                                     DisplayMemberPath="DisplayName"
                                     MaxHeight="110"
                                     Margin="0,8,0,0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <WrapPanel Margin="0,6,0,0">
                                <Button AutomationProperties.AutomationId="AdminDefinitionEditor_RemoveReference" Content="Убрать связь" Command="{Binding RemoveReferenceCommand}" Style="{StaticResource GhostButtonStyle}"/>
                                <Button AutomationProperties.AutomationId="AdminDefinitionEditor_OpenReference" Content="Открыть запись" Command="{Binding OpenRelatedRecordCommand}" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"/>
                            </WrapPanel>

                            <Border AutomationProperties.AutomationId="AdminDefinitionEditor_AdvancedPanel"
                                    Style="{StaticResource SubtleCardStyle}"
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <Button AutomationProperties.AutomationId="AdminDefinitionEditor_ToggleAdvanced" Content="{Binding AdvancedButtonText}" Command="{Binding ToggleAdvancedCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"/>
                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsAdvancedOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Технические сведения" Style="{StaticResource TitleTextStyle}"/>
                                        <TextBlock Text="Нормальный сценарий не требует ручного редактирования этих полей." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <controls:NriFormField Label="Системный ID" HelpText="Автоматически предлагается до первого сохранения.">
                                            <controls:NriGeneratedIdentifierField AutomationProperties.AutomationId="AdminDefinitionEditor_Name"
                                                                                  AccessibleName="Системный ID"
                                                                                  Text="{Binding Name, Mode=OneWay}"/>
                                        </controls:NriFormField>
                                        <controls:NriFormField Label="Системные теги" HelpText="Технические маршрутизационные теги. Только для просмотра.">
                                            <controls:NriTagEditor AutomationProperties.AutomationId="AdminDefinitionEditor_SystemTags"
                                                                   AccessibleName="Системные теги"
                                                                   Text="{Binding SystemTags, Mode=OneWay}"
                                                                   IsReadOnly="True"/>
                                        </controls:NriFormField>
                                        <controls:NriFormField Label="Данные только для мастера" HelpText="Только для явной диагностики. Игрокам не показываются.">
                                            <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_ServerOnlyFields"
                                                     MinHeight="50"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Text="{Binding AuditText, Mode=OneWay}" IsReadOnly="True"/>
                                        </controls:NriFormField>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </controls:NriAutomationAnchor>
            </patterns:NriEntityEditorHost.Form>

            <patterns:NriEntityEditorHost.Inspector>
                <Grid AutomationProperties.AutomationId="AdminDefinitionEditor_Inspector">
                <Border Style="{StaticResource CardStyle}" Width="360">
                    <ScrollViewer x:Name="AdminDefinitionEditorInspectorScrollViewer" AutomationProperties.AutomationId="AdminDefinitionEditor_InspectorScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="Аудит" AutomationProperties.AutomationId="AdminDefinitionEditor_Audit" Command="{Binding LoadAuditCommand}" Style="{StaticResource GhostButtonStyle}"/>
                                <Button Content="Проверить связи" AutomationProperties.AutomationId="AdminDefinitionEditor_References" Command="{Binding CheckBrokenReferencesCommand}" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"/>
                            </WrapPanel>
                            <Border AutomationProperties.AutomationId="AdminDefinitionEditor_PlayerPreviewPanel"
                                    Style="{StaticResource SubtleCardStyle}"
                                    Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Что увидит игрок" Style="{StaticResource TitleTextStyle}"/>
                                    <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_PlayerPreviewText"
                                             Text="{Binding PlayerPreviewText, Mode=OneWay}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             MinHeight="130"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Проверка" Style="{StaticResource TitleTextStyle}"/>
                                    <TextBlock AutomationProperties.AutomationId="AdminDefinitionEditor_ValidationSummary"
                                               Text="{Binding ValidationSummary}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,6,0,6"/>
                                    <ItemsControl AutomationProperties.AutomationId="AdminDefinitionEditor_ValidationIssues"
                                                  ItemsSource="{Binding ValidationIssues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SubtleCardStyle}" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding FieldDisplayName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                        <TextBlock Text="{Binding UserMessage}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding SourceRuleLabel, StringFormat=Источник проверки: {0}}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"/>
                                                        <Expander Header="Технические сведения" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding TechnicalDetails}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Что видит GM" Style="{StaticResource TitleTextStyle}"/>
                                    <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_GmPreview"
                                             Text="{Binding GmPreviewText, Mode=OneWay}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             MinHeight="100"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Аудит" Style="{StaticResource TitleTextStyle}"/>
                                    <TextBox AutomationProperties.AutomationId="AdminDefinitionEditor_AuditText"
                                             Text="{Binding AuditText, Mode=OneWay}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             MinHeight="120"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>
            </patterns:NriEntityEditorHost.Inspector>
        </patterns:NriEntityEditorHost>

        <controls:NriConfirmationDialog AutomationProperties.AutomationId="AdminDefinitionEditor_ConfirmationDialog"
                                        IsOpen="{Binding IsConfirmationOpen}"
                                        Title="{Binding ConfirmationTitle}"
                                        Message="{Binding ConfirmationMessage}"
                                        TargetName="{Binding ConfirmationTarget}"
                                        ConfirmCommand="{Binding ConfirmActionCommand}"
                                        CancelCommand="{Binding CancelConfirmationCommand}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
    </Grid>
</UserControl>
