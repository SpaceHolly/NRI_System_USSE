<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminRacesLanguagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="AdminRaces_Route">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:NriPageHeader Grid.Row="0"
                                Title="Расы и языки"
                                Subtitle="Создание и настройка рас, подвидов, гибридов, расовых свойств и языков."
                                StatusText="Открывается через редактор справочников"
                                AutomationProperties.AutomationId="AdminRaces_Header"
                                Margin="8,8,8,0"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" Margin="8" Padding="22">
                <StackPanel>
                    <TextBlock Text="Расы и языки" Style="{StaticResource SectionTitleTextStyle}" FontSize="22"/>
                    <TextBlock Text="Выберите раздел. Каждая запись редактируется в общей читаемой форме со связями, проверкой и предпросмотром для игрока."
                               Style="{StaticResource TitleTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="Расы" Command="{Binding OpenDefinitionPresetCommand}" CommandParameter="races" AutomationProperties.AutomationId="AdminRaces_OpenDefinitions"/>
                        <Button Content="Языки" Command="{Binding OpenDefinitionPresetCommand}" CommandParameter="languages" Margin="8,0,0,0" AutomationProperties.AutomationId="AdminLanguages_OpenDefinitions"/>
                        <Button Content="Письменности" Command="{Binding OpenDefinitionPresetCommand}" CommandParameter="languageScripts" Margin="8,0,0,0" AutomationProperties.AutomationId="AdminLanguageScripts_OpenDefinitions"/>
                        <Button Content="Языковые семьи" Command="{Binding OpenDefinitionPresetCommand}" CommandParameter="languageFamilies" Margin="8,0,0,0" AutomationProperties.AutomationId="AdminLanguageFamilies_OpenDefinitions"/>
                        <Button Content="Предания о происхождении" Command="{Binding OpenDefinitionPresetCommand}" CommandParameter="languageOrigins" Margin="8,0,0,0" AutomationProperties.AutomationId="AdminLanguageOrigins_OpenDefinitions"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
