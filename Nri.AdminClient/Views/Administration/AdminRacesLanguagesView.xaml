<UserControl x:Class="Nri.AdminClient.Views.Administration.AdminRacesLanguagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource CardStyle}" Margin="8" Padding="22">
            <StackPanel>
                <TextBlock Text="Расы / языки" Style="{StaticResource SectionTitleTextStyle}" FontSize="22"/>
                <TextBlock Text="Статус: черновой справочник / controlled disabled" Style="{StaticResource TitleTextStyle}" Margin="0,12,0,0"/>
                <TextBlock Text="Раздел показывает границу будущего справочника происхождения. Полноценный редактор рас, подвидов, гибридов, расовых свойств и языков ещё не принят, поэтому fake CRUD скрыт."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                <UniformGrid Columns="3" Margin="0,18,0,0">
                    <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Что будет здесь" Style="{StaticResource TitleTextStyle}"/>
                            <TextBlock Text="Расы, языки, свойства происхождения и гибридные варианты." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Целевой этап" Style="{StaticResource TitleTextStyle}"/>
                            <TextBlock Text="после закрытия Character v2 / definitions editor" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SubtleCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Действия" Style="{StaticResource TitleTextStyle}"/>
                            <TextBlock Text="Редактирование отключено до полноценного справочника." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
