<UserControl x:Class="Nri.AdminClient.Views.WorldMap.AdminWorldMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.AdminClient.ViewModels"
             AutomationProperties.AutomationId="AdminWorldMap_Route">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Карты мира и вселенной" Style="{StaticResource SectionTitleTextStyle}" FontSize="22"
                           AutomationProperties.AutomationId="AdminWorldMap_Title"/>
                <TextBlock Text="Иерархия мира, семантическая география и безопасная генерация." Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}"
                    AutomationProperties.AutomationId="AdminWorldMap_Refresh"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="6" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Обзор мира" Command="{Binding ShowOverviewCommand}" AutomationProperties.AutomationId="AdminWorldMap_Mode_Overview"/>
                <Button Content="Редактор карты" Margin="6,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ShowEditorCommand}" AutomationProperties.AutomationId="AdminWorldMap_Mode_Editor"/>
                <Button Content="Генератор" Margin="6,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ShowGeneratorCommand}" AutomationProperties.AutomationId="AdminWorldMap_Mode_Generator"/>
                <Button Content="Импорт и экспорт" Margin="6,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ShowPortabilityCommand}" AutomationProperties.AutomationId="AdminWorldMap_Mode_Portability"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Иерархия мира" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="От масштаба мира до локального помещения" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" Margin="0,10,0,10" ItemsSource="{Binding Hierarchy}" DisplayMemberPath="Label"
                             AutomationProperties.AutomationId="AdminWorldMap_Hierarchy"/>
                    <StackPanel Grid.Row="2">
                        <Button Content="Открыть Северную долину" Command="{Binding OpenFantasyCommand}" AutomationProperties.AutomationId="AdminWorldMap_OpenFantasy"/>
                        <Button Content="Открыть Грейхейвен" Margin="0,6,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenSettlementCommand}" AutomationProperties.AutomationId="AdminWorldMap_OpenSettlement"/>
                        <Button Content="Открыть Подземный архив" Margin="0,6,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenDungeonCommand}" AutomationProperties.AutomationId="AdminWorldMap_OpenDungeon"/>
                        <Button Content="Открыть сектор K-12" Margin="0,6,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenSciFiCommand}" AutomationProperties.AutomationId="AdminWorldMap_OpenSciFi"/>
                        <Button Content="Открыть систему Гелиос" Margin="0,6,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenSystemCommand}" AutomationProperties.AutomationId="AdminWorldMap_OpenSystem"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding MapTitle}" FontWeight="Bold" FontSize="18" AutomationProperties.AutomationId="AdminWorldMap_MapTitle"/>
                            <TextBlock Text="{Binding MapSubtitle}" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.AutomationId="AdminWorldMap_MapSubtitle"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" Padding="10,5" CornerRadius="4">
                            <TextBlock Text="{Binding CoordinateNotice}" Foreground="#4ADE80"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource PanelAltBrush}" Padding="7" Margin="0,8,0,0" CornerRadius="4"
                            Visibility="{Binding IsEditor, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="AdminWorldMap_EditorToolbar">
                        <WrapPanel>
                            <Button Content="Выбор" Command="{Binding SelectCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_Select"/>
                            <Button Content="Панорама" Margin="5,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding PanCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_Pan"/>
                            <Button Content="Вписать" Margin="5,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding FitCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_Fit"/>
                            <Separator Margin="8,0"/>
                            <Button Content="Точка" Command="{Binding CreatePointCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_CreatePoint"/>
                            <Button Content="Линия" Margin="5,0,0,0" Command="{Binding CreatePolylineCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_CreatePolyline"/>
                            <Button Content="Область" Margin="5,0,0,0" Command="{Binding CreatePolygonCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_CreatePolygon"/>
                            <Button Content="Подпись" Margin="5,0,0,0" Command="{Binding CreateLabelCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_CreateLabel"/>
                            <Button Content="Переход" Margin="5,0,0,0" Command="{Binding NewPortalCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_NewPortal"/>
                            <Separator Margin="8,0"/>
                            <Button Content="Отменить" Command="{Binding UndoCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_Undo"/>
                            <Button Content="Повторить" Margin="5,0,0,0" Command="{Binding RedoCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_Redo"/>
                            <Button Content="Проверить" Margin="5,0,0,0" Command="{Binding ValidateCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_Validate"/>
                            <Button Content="Как увидит игрок" Margin="5,0,0,0" Command="{Binding PlayerPreviewCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_PlayerPreview"/>
                            <Button Content="Сохранить" Margin="5,0,0,0" Command="{Binding SaveEditorCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_Save"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="820" Height="540" ClipToBounds="True"
                                 AutomationProperties.AutomationId="AdminWorldMap_SpatialCanvas">
                            <Canvas.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#0C1829">
                                            <GeometryDrawing.Pen><Pen Brush="#182A40" Thickness="0.6"/></GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,40,40"/></GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Canvas.Background>
                            <ItemsControl ItemsSource="{Binding HexCells}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                                            <Polygon Points="{Binding Points}" Fill="#162942" Stroke="#4C7896" StrokeThickness="1.5"/>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8FB6CC" FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Areas}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MapVisualFeature0218}">
                                        <Button Width="{Binding Width}" Height="{Binding Height}" Background="{Binding Fill}" BorderBrush="#7CC9A7" BorderThickness="1" Opacity="0.78"
                                                Command="{Binding DataContext.SelectFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Name}">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="11"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Lines}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MapVisualFeature0218}"><Line X1="{Binding X}" Y1="{Binding Y}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding Fill}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Points}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MapVisualFeature0218}">
                                        <Button MinWidth="92" Height="34" Background="{Binding Fill}" BorderBrush="#D5F5E3" BorderThickness="1"
                                                Command="{Binding DataContext.SelectFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Description}">
                                            <TextBlock Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Canvas.Left="18" Canvas.Top="486" Background="#CC13233A" Padding="10,6" CornerRadius="4">
                            <TextBlock Text="Дороги и границы представлены объектами карты, а не пикселями." Foreground="#B7C8DC"/>
                            </Border>
                            <Border Canvas.Left="160" Canvas.Top="18" Width="500" Background="#E64B2E18" BorderBrush="#F2B84B" BorderThickness="1" Padding="10,7" CornerRadius="4"
                                    Visibility="{Binding IsSchematicMap, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Схематическая карта — расстояния на экране не являются физическим масштабом." Foreground="#FFE3A3" TextWrapping="Wrap"/>
                            </Border>
                        </Canvas>
                        </Viewbox>

                        <Border Background="#EE101C2D" Padding="18" Visibility="{Binding IsGenerator, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AdminWorldMap_GeneratorPanel">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                <TextBlock Text="Детерминированная генерация" FontWeight="Bold" FontSize="18"/>
                                <TextBlock Text="Сначала проверьте семантический предпросмотр. Карта изменится только после принятия." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,14"/>
                                <TextBlock Text="Область генерации" FontWeight="Bold"/>
                                    <ComboBox SelectedValue="{Binding GenerationScope}" SelectedValuePath="Tag" Margin="0,4,0,10" AutomationProperties.AutomationId="AdminWorldMap_GenerationScope">
                                    <ComboBoxItem Content="Регион" Tag="region"/><ComboBoxItem Content="Поселение" Tag="settlement"/><ComboBoxItem Content="Подземелье" Tag="dungeon"/><ComboBoxItem Content="Сектор" Tag="sector"/><ComboBoxItem Content="Система" Tag="system"/><ComboBoxItem Content="Планета" Tag="planet"/>
                                    </ComboBox>
                                <TextBlock Text="Ключ воспроизводимости" FontWeight="Bold"/>
                                    <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.AutomationId="AdminWorldMap_Seed"/>
                                <Button Content="Построить предпросмотр" Command="{Binding GeneratePreviewCommand}" AutomationProperties.AutomationId="AdminWorldMap_GeneratePreview"/>
                                <Button Content="Принять результат" Margin="0,8,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding AcceptGenerationCommand}" AutomationProperties.AutomationId="AdminWorldMap_GenerateAccept"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Text="Изменения" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding GenerationSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" AutomationProperties.AutomationId="AdminWorldMap_GenerationSummary"/>
                                    <ItemsControl ItemsSource="{Binding PreviewFeatures}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><Border Background="{Binding Fill}" Padding="9,6" Margin="0,0,6,6" CornerRadius="4"><StackPanel><TextBlock Text="{Binding Name}" Foreground="White"/><TextBlock Text="{Binding Badge}" Foreground="#D8E8F7" FontSize="11"/></StackPanel></Border></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#EE101C2D" Padding="18" Visibility="{Binding IsPortability, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AdminWorldMap_PortabilityPanel">
                            <StackPanel MaxWidth="650" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Пакеты карт" FontWeight="Bold" FontSize="20"/>
                                <TextBlock Text="Пакет .nrimap содержит карту, семантические слои, объекты и переходы. Dry-run не вносит записи в базу." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,16"/>
                                <WrapPanel>
                                    <Button Content="Экспортировать выбранную карту" Command="{Binding ExportCommand}" AutomationProperties.AutomationId="AdminWorldMap_Export"/>
                                    <Button Content="Выбрать пакет" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding PickImportPackageCommand}" AutomationProperties.AutomationId="AdminWorldMap_ImportPick"/>
                                    <Button Content="Проверить без записи" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding DryRunImportCommand}" AutomationProperties.AutomationId="AdminWorldMap_ImportDryRun"/>
                                </WrapPanel>
                                <Border Background="{StaticResource PanelAltBrush}" Padding="12" Margin="0,14,0,0" CornerRadius="4">
                                    <TextBlock Text="{Binding PackageSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminWorldMap_PackageSummary"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Сведения карты" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{Binding SelectedFeatureTitle}" FontWeight="Bold" FontSize="17" Margin="0,12,0,2" AutomationProperties.AutomationId="AdminWorldMap_SelectedFeatureTitle"/>
                        <TextBlock Text="{Binding SelectedFeatureDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.AutomationId="AdminWorldMap_SelectedFeatureDescription"/>
                        <StackPanel Visibility="{Binding IsEditor, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,12,0,0"
                                    AutomationProperties.AutomationId="AdminWorldMap_EditorInspector">
                            <TextBlock Text="Редактор объекта" FontWeight="Bold"/>
                            <TextBlock Text="Объекты карты" Margin="0,8,0,3"/>
                            <ListBox ItemsSource="{Binding EditorFeatures}" MaxHeight="112" AutomationProperties.AutomationId="AdminWorldMap_Editor_FeatureList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" HorizontalContentAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding DataContext.SelectFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Название" Margin="0,8,0,3"/>
                            <TextBox Text="{Binding EditorFeatureName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminWorldMap_Editor_FeatureName"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Применить название" Command="{Binding ApplyFeatureNameCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_ApplyName"/>
                                <Button Content="Сместить" Margin="6,0,0,0" Command="{Binding MoveSelectedCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_Move"/>
                            </WrapPanel>
                            <TextBlock Text="Слой" Margin="0,10,0,3"/>
                            <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" DisplayMemberPath="Label"
                                      AutomationProperties.AutomationId="AdminWorldMap_Editor_LayerPicker"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Видимость" Command="{Binding ToggleLayerVisibilityCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_LayerVisibility"/>
                                <Button Content="Блокировка" Margin="6,0,0,0" Command="{Binding ToggleLayerLockCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_LayerLock"/>
                            </WrapPanel>
                            <Separator Margin="0,12"/>
                            <TextBlock Text="Переход" FontWeight="Bold"/>
                            <ComboBox ItemsSource="{Binding Portals}" SelectedItem="{Binding SelectedPortal}" DisplayMemberPath="Label" Margin="0,6,0,0"
                                      AutomationProperties.AutomationId="AdminWorldMap_Editor_PortalPicker"/>
                            <TextBox Text="{Binding PortalName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminWorldMap_Editor_PortalName"/>
                            <ComboBox ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedPortalTarget}" DisplayMemberPath="Name" Margin="0,6,0,0"
                                      AutomationProperties.AutomationId="AdminWorldMap_Editor_PortalTarget"/>
                            <Button Content="Сохранить переход" Margin="0,6,0,0" Command="{Binding SavePortalCommand}" AutomationProperties.AutomationId="AdminWorldMap_Editor_SavePortal"/>
                            <Border Background="{StaticResource PanelAltBrush}" Padding="8" Margin="0,12,0,0" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding EditorSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminWorldMap_Editor_Summary"/>
                                    <TextBlock Text="{Binding PlayerPreviewSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Separator Margin="0,14"/>
                        <TextBlock Text="Слои" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding Layers}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Margin="0,3" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Separator Margin="0,14"/>
                        <TextBlock Text="Переходы по иерархии" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding Portals}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelAltBrush}" Padding="8" Margin="0,0,0,6" CornerRadius="4"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Separator Margin="0,14"/>
                        <TextBlock Text="Правила генерации" FontWeight="Bold"/>
                        <TextBlock Text="Ручные объекты и изменённые результаты сохраняются по происхождению. Повторная генерация показывает различия." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.AutomationId="AdminWorldMap_Status"/>
        </Border>
    </Grid>
</UserControl>
