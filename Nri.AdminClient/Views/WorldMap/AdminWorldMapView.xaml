<UserControl x:Class="Nri.AdminClient.Views.WorldMap.AdminWorldMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.AdminClient.ViewModels"
             AutomationProperties.AutomationId="AdminWorldMap_Root">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Карта мира" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="AdminWorldMap_Title"/>
                <TextBox Grid.Column="1" Margin="8,0,0,0"
                         Text="{Binding CampaignId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="CampaignId"
                         AutomationProperties.AutomationId="AdminWorldMap_CampaignId"/>
                <TextBox Grid.Column="2" Margin="8,0,0,0"
                         Text="{Binding RuleSetId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="RuleSetId"
                         AutomationProperties.AutomationId="AdminWorldMap_RuleSetId"/>
                <WrapPanel Grid.Column="3" Margin="8,0,0,0">
                    <Button Content="Обновить" Command="{Binding RefreshMapsCommand}" IsEnabled="{Binding CanLoadMaps}"
                            AutomationProperties.AutomationId="AdminWorldMap_Refresh_Button"/>
                    <Button Content="Подготовить MVP" Margin="8,0,0,0" Command="{Binding SeedMvpCommand}" IsEnabled="{Binding IsIdle}"
                            AutomationProperties.AutomationId="AdminWorldMap_Seed_Button"/>
                    <Button Content="Создать карту" Margin="8,0,0,0" Command="{Binding CreateMapCommand}" IsEnabled="{Binding CanCreateMap}"
                            AutomationProperties.AutomationId="AdminWorldMap_Create_Button"/>
                    <Button Content="Открыть" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding LoadSelectedMapCommand}" IsEnabled="{Binding CanEditMap}"
                            AutomationProperties.AutomationId="AdminWorldMap_Open_Button"/>
                    <Button Content="Настройки" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding SaveMapSettingsCommand}" IsEnabled="{Binding CanEditMap}"
                            AutomationProperties.AutomationId="AdminWorldMap_SaveSettings_Button"/>
                    <Button Content="Архивировать" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ArchiveMapCommand}" IsEnabled="{Binding CanEditMap}"
                            AutomationProperties.AutomationId="AdminWorldMap_Archive_Button"/>
                </WrapPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastRefreshText}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CanvasScaleLabel}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"
                               AutomationProperties.AutomationId="AdminWorldMap_ScaleText"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Карты кампании" Style="{StaticResource SectionTitleTextStyle}"/>
                    <ListBox Grid.Row="1" Margin="0,8,0,8"
                             ItemsSource="{Binding Maps}"
                             SelectedItem="{Binding SelectedMap, Mode=TwoWay}"
                             DisplayMemberPath="Label"
                             AutomationProperties.AutomationId="AdminWorldMap_MapList"/>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Новая/обновляемая карта" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewMapName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название"
                                 AutomationProperties.AutomationId="AdminWorldMap_NewMapName"/>
                        <TextBox Margin="0,4,0,0" Text="{Binding NewMapDescription, UpdateSourceTrigger=PropertyChanged}" ToolTip="Описание"
                                 AutomationProperties.AutomationId="AdminWorldMap_NewMapDescription"/>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBox Width="70" Text="{Binding NewMapWidthCells, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ширина (cells)"
                                     AutomationProperties.AutomationId="AdminWorldMap_NewMapWidth"/>
                            <TextBox Width="70" Margin="6,0,0,0" Text="{Binding NewMapHeightCells, UpdateSourceTrigger=PropertyChanged}" ToolTip="Высота (cells)"
                                     AutomationProperties.AutomationId="AdminWorldMap_NewMapHeight"/>
                            <TextBox Width="80" Margin="6,0,0,0" Text="{Binding NewMapCellSizeKm, UpdateSourceTrigger=PropertyChanged}" ToolTip="Км на клетку"
                                     AutomationProperties.AutomationId="AdminWorldMap_NewMapCellSizeKm"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="Слой" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                            <ComboBox Width="150" ItemsSource="{Binding LayerTypeOptions}" SelectedItem="{Binding SelectedLayerType}"
                                      AutomationProperties.AutomationId="AdminWorldMap_LayerSelector"/>
                            <TextBlock Text="Кисть" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,4,0"/>
                            <ComboBox Width="110" ItemsSource="{Binding BrushShapeOptions}" SelectedItem="{Binding SelectedBrushShape}"
                                      AutomationProperties.AutomationId="AdminWorldMap_BrushShape"/>
                            <TextBlock Text="Режим" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,4,0"/>
                            <ComboBox Width="95" ItemsSource="{Binding BrushModeOptions}" SelectedItem="{Binding SelectedBrushMode}"
                                      AutomationProperties.AutomationId="AdminWorldMap_BrushMode"/>
                        </WrapPanel>

                        <TextBlock Text="World map canvas"
                                   Width="1"
                                   Height="1"
                                   Opacity="0.01"
                                   IsHitTestVisible="False"
                                   AutomationProperties.AutomationId="AdminWorldMap_Canvas"/>
                        <ContentControl>
                            <Canvas Width="{Binding CanvasWidth}"
                                    Height="{Binding CanvasHeight}"
                                    Background="{StaticResource PanelAltBrush}"
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="MapCanvas_OnMouseLeftButtonDown">
                            <ItemsControl ItemsSource="{Binding PaintedCells}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WorldMapCellUiItem}">
                                        <Rectangle Width="{Binding Width}"
                                                   Height="{Binding Height}"
                                                   Fill="{Binding FillHex}"
                                                   Stroke="#33222A35"
                                                   StrokeThickness="0.25"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding GridLines}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MapGridLineUiItem}">
                                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                              Stroke="#223B4556" StrokeThickness="0.5"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Markers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding PixelX}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding PixelY}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WorldMapMarkerUiItem}">
                                        <Button Width="20" Height="20" Padding="0"
                                                Content="●"
                                                Tag="{Binding}"
                                                Click="MarkerCanvasButton_OnClick"
                                                ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Canvas>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Слой и кисть" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{Binding SelectedCellSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AdminWorldMap_SelectedCellSummary"/>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Width="54" Text="{Binding BrushX, UpdateSourceTrigger=PropertyChanged}" ToolTip="X"
                                     AutomationProperties.AutomationId="AdminWorldMap_BrushX"/>
                            <TextBox Width="54" Margin="6,0,0,0" Text="{Binding BrushY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Y"
                                     AutomationProperties.AutomationId="AdminWorldMap_BrushY"/>
                            <TextBox Width="54" Margin="6,0,0,0" Text="{Binding BrushWidth, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ширина"
                                     AutomationProperties.AutomationId="AdminWorldMap_BrushWidth"/>
                            <TextBox Width="54" Margin="6,0,0,0" Text="{Binding BrushHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="Высота"
                                     AutomationProperties.AutomationId="AdminWorldMap_BrushHeight"/>
                            <TextBox Width="54" Margin="6,0,0,0" Text="{Binding BrushRadius, UpdateSourceTrigger=PropertyChanged}" ToolTip="Радиус"
                                     AutomationProperties.AutomationId="AdminWorldMap_BrushRadius"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Width="130" Text="{Binding SelectedLayerValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="Значение слоя"
                                     AutomationProperties.AutomationId="AdminWorldMap_LayerValue"/>
                            <TextBox Width="160" Margin="6,0,0,0" Text="{Binding SelectedLayerLabel, UpdateSourceTrigger=PropertyChanged}" ToolTip="Подпись"
                                     AutomationProperties.AutomationId="AdminWorldMap_LayerLabel"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Покрасить" Command="{Binding PaintLayerCommand}" IsEnabled="{Binding CanPaintCurrentLayer}"
                                    AutomationProperties.AutomationId="AdminWorldMap_Paint_Button"/>
                            <Button Content="Клетка: set" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding PaintSelectedCellCommand}" IsEnabled="{Binding CanPaintCurrentLayer}"
                                    AutomationProperties.AutomationId="AdminWorldMap_PaintCell_Button"/>
                            <Button Content="Клетка: clear" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearSelectedCellCommand}" IsEnabled="{Binding CanPaintCurrentLayer}"
                                    AutomationProperties.AutomationId="AdminWorldMap_ClearCell_Button"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Очистить слой" Command="{Binding ClearLayerCommand}" IsEnabled="{Binding CanPaintCurrentLayer}"
                                    AutomationProperties.AutomationId="AdminWorldMap_ClearLayer_Button"/>
                            <CheckBox Content="Слой виден игрокам" Margin="8,2,0,0" IsChecked="{Binding SelectedLayerVisibleToPlayers, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.AutomationId="AdminWorldMap_LayerVisibleToPlayers"/>
                            <Button Content="Видимость слоя" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding SaveLayerVisibilityCommand}" IsEnabled="{Binding CanPaintLayers}"
                                    AutomationProperties.AutomationId="AdminWorldMap_LayerVisibility_Button"/>
                        </WrapPanel>

                        <TextBlock Text="Легенда" Style="{StaticResource TitleTextStyle}" Margin="0,10,0,0"/>
                        <ListBox ItemsSource="{Binding LegendEntries}" DisplayMemberPath="Display" Height="80"
                                 AutomationProperties.AutomationId="AdminWorldMap_Legend"/>

                        <TextBlock Text="Маркеры" Style="{StaticResource TitleTextStyle}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MarkerSummaryText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AdminWorldMap_MarkerSummary"/>
                        <DataGrid ItemsSource="{Binding Markers}" SelectedItem="{Binding SelectedMarker, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Height="115"
                                  AutomationProperties.AutomationId="AdminWorldMap_Markers">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="1.2*"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding MarkerTypeDisplay}" Width="1*"/>
                                <DataGridTextColumn Header="Привязка" Binding="{Binding BindingDisplayText}" Width="1.3*"/>
                                <DataGridTextColumn Header="Коорд." Binding="{Binding CoordinatesText}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Width="130" Text="{Binding MarkerName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Имя"
                                     AutomationProperties.AutomationId="AdminWorldMap_MarkerName"/>
                            <TextBox Width="110" Margin="6,0,0,0" Text="{Binding MarkerType, UpdateSourceTrigger=PropertyChanged}" ToolTip="Тип"
                                     AutomationProperties.AutomationId="AdminWorldMap_MarkerType"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Width="60" Text="{Binding MarkerCellX, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cell X"
                                     AutomationProperties.AutomationId="AdminWorldMap_MarkerCellX"/>
                            <TextBox Width="60" Margin="6,0,0,0" Text="{Binding MarkerCellY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cell Y"
                                     AutomationProperties.AutomationId="AdminWorldMap_MarkerCellY"/>
                            <TextBox Width="80" Margin="6,0,0,0" Text="{Binding MarkerXNormalized, UpdateSourceTrigger=PropertyChanged}" ToolTip="X normalized"
                                     AutomationProperties.AutomationId="AdminWorldMap_MarkerXNormalized"/>
                            <TextBox Width="80" Margin="6,0,0,0" Text="{Binding MarkerYNormalized, UpdateSourceTrigger=PropertyChanged}" ToolTip="Y normalized"
                                     AutomationProperties.AutomationId="AdminWorldMap_MarkerYNormalized"/>
                        </WrapPanel>
                        <TextBlock Text="Привязка" Style="{StaticResource TitleTextStyle}" Margin="0,8,0,0"/>
                        <ComboBox ItemsSource="{Binding MarkerBindingTypeOptions}" SelectedItem="{Binding MarkerLinkedEntityType}" Margin="0,4,0,0"
                                  AutomationProperties.AutomationId="AdminWorldMap_MarkerLinkedEntityType"/>
                        <TextBox Margin="0,6,0,0" Text="{Binding MarkerLinkedEntityId, UpdateSourceTrigger=PropertyChanged}" ToolTip="EntityId"
                                 AutomationProperties.AutomationId="AdminWorldMap_MarkerLinkedEntityId"/>
                        <TextBox Margin="0,6,0,0" Text="{Binding MarkerLinkedEntityDisplayName, UpdateSourceTrigger=PropertyChanged}" ToolTip="DisplayName"
                                 AutomationProperties.AutomationId="AdminWorldMap_MarkerLinkedEntityDisplayName"/>
                        <TextBox Margin="0,6,0,0" Text="{Binding MarkerLinkedEntityPublicLabel, UpdateSourceTrigger=PropertyChanged}" ToolTip="Публичная метка привязки"
                                 AutomationProperties.AutomationId="AdminWorldMap_MarkerPublicLabel"/>
                        <TextBox Margin="0,6,0,0" Text="{Binding MarkerPublicNotes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Публичное описание"
                                 AutomationProperties.AutomationId="AdminWorldMap_MarkerPublicNotes"/>
                        <TextBox Margin="0,6,0,0" Text="{Binding MarkerGmNotes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Заметки GM"
                                 AutomationProperties.AutomationId="AdminWorldMap_MarkerGmNotes"/>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Content="Видно игрокам" IsChecked="{Binding MarkerPlayerVisible}" Margin="0,2,0,0"
                                      AutomationProperties.AutomationId="AdminWorldMap_MarkerVisible"/>
                            <TextBox Width="105" Margin="8,0,0,0" Text="{Binding MarkerVisibilityMode, UpdateSourceTrigger=PropertyChanged}" ToolTip="VisibilityMode"
                                     AutomationProperties.AutomationId="AdminWorldMap_MarkerVisibilityMode"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Добавить" Command="{Binding AddMarkerCommand}" IsEnabled="{Binding CanEditMarkers}"
                                    AutomationProperties.AutomationId="AdminWorldMap_AddMarker_Button"/>
                            <Button Content="Переместить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding MoveMarkerCommand}" IsEnabled="{Binding CanEditMarkers}"
                                    AutomationProperties.AutomationId="AdminWorldMap_MoveMarker_Button"/>
                            <Button Content="Сохранить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding SaveMarkerCommand}" IsEnabled="{Binding CanEditMarkers}"
                                    AutomationProperties.AutomationId="AdminWorldMap_SaveMarker_Button"/>
                            <Button Content="Удалить" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RemoveMarkerCommand}" IsEnabled="{Binding CanEditMarkers}"
                                    AutomationProperties.AutomationId="AdminWorldMap_RemoveMarker_Button"/>
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding CanvasHints}" Margin="0,8,0,0"
                                      AutomationProperties.AutomationId="AdminWorldMap_CanvasHints"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                           AutomationProperties.AutomationId="AdminWorldMap_StatusText"/>
                <TextBlock Text="{Binding WarningMessage}" Foreground="#FFF59E0B"
                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.AutomationId="AdminWorldMap_WarningText"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFEF4444"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.AutomationId="AdminWorldMap_ErrorText"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
