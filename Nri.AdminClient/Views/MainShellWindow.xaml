                    <TabItem Header="Блокировки" Tag="locks.active">
                        <Border Style="{StaticResource CardStyle}" Margin="8">
                            <StackPanel>
                                <TextBlock Text="Активные блокировки" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="Список активных lock-записей. Принудительное снятие доступно Admin/SuperAdmin." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                                <TextBox Text="{Binding LocksSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по имени, ID или владельцу" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding FilteredLockRows}" SelectedValuePath="Id" SelectedValue="{Binding SelectedLockId, UpdateSourceTrigger=PropertyChanged}" MinHeight="320" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Id блокировки" Binding="{Binding Id}" Width="2*"/>
                                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="1.4*"/>
