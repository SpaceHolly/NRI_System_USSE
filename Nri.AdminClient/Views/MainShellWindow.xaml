                    <TabItem Header="Музыка" Tag="placeholder.audio" AutomationProperties.AutomationId="AdminAudio_Tab">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Музыка сессии" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock AutomationProperties.AutomationId="AdminAudio_CurrentState_Text" Text="{Binding AudioStateText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button AutomationProperties.AutomationId="AdminAudio_Refresh_Button" Style="{StaticResource GhostButtonStyle}" Content="Обновить" Command="{Binding AudioRefreshCommand}" IsEnabled="{Binding CanControlAudio}"/>
                                        <Button AutomationProperties.AutomationId="AdminAudio_Resync_Button" Style="{StaticResource GhostButtonStyle}" Content="Синхронизировать" Command="{Binding AudioResyncCommand}" IsEnabled="{Binding CanControlAudio}"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="Треки" Style="{StaticResource SectionTitleTextStyle}"/>
                                            <ComboBox DockPanel.Dock="Right" AutomationProperties.AutomationId="AdminAudio_CategoryFilter" Width="140" ItemsSource="{Binding AudioCategoryOptions}" SelectedItem="{Binding AudioCategoryInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                        <DataGrid Grid.Row="1" AutomationProperties.AutomationId="AdminAudio_TrackList" ItemsSource="{Binding AudioTrackRows}" SelectedItem="{Binding SelectedAudioTrackRow, Mode=TwoWay}" AutoGenerateColumns="False" MinHeight="300">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="160"/>
                                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100"/>
                                                <DataGridTextColumn Header="Видимость" Binding="{Binding State}" Width="120"/>
                                                <DataGridTextColumn Header="Статус" Binding="{Binding Extra}" Width="180"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Текущий трек" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock AutomationProperties.AutomationId="AdminAudio_SelectedTrack_Title" Text="{Binding AudioSelectedTrackTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="Состояние" Margin="0,10,0,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AudioCurrentTrackTitle}" TextWrapping="Wrap"/>
                                        <TextBlock AutomationProperties.AutomationId="AdminAudio_CurrentCategory" Text="{Binding AudioCurrentCategory, StringFormat=Категория: {0}}" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding AudioPlaybackStateText, StringFormat=Статус: {0}}" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="ID трека" Margin="0,10,0,0"/>
                                        <TextBox AutomationProperties.AutomationId="AdminAudio_SelectedTrackId" Text="{Binding AudioSelectedTrackId, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Режим повтора" Margin="0,8,0,0"/>
                                        <ComboBox AutomationProperties.AutomationId="AdminAudio_LoopMode" ItemsSource="{Binding AudioLoopModeOptions}" SelectedItem="{Binding AudioLoopModeInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Плавное переключение, сек." Margin="0,8,0,0"/>
                                        <TextBox AutomationProperties.AutomationId="AdminAudio_FadeSeconds" Text="{Binding AudioFadeSecondsInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button AutomationProperties.AutomationId="AdminAudio_Play_Button" Content="Воспроизвести" Command="{Binding AudioSelectTrackCommand}" IsEnabled="{Binding CanControlAudio}"/>
                                            <Button AutomationProperties.AutomationId="AdminAudio_Pause_Button" Content="Пауза" Command="{Binding AudioPauseCommand}" IsEnabled="{Binding CanControlAudio}"/>
                                            <Button AutomationProperties.AutomationId="AdminAudio_Stop_Button" Content="Стоп" Command="{Binding AudioStopCommand}" IsEnabled="{Binding CanControlAudio}"/>
                                            <Button AutomationProperties.AutomationId="AdminAudio_Next_Button" Content="Следующий" Command="{Binding AudioNextTrackCommand}" IsEnabled="{Binding CanControlAudio}"/>
                                        </WrapPanel>
                                        <Button Content="Сохранить настройки" Command="{Binding AudioSetModeCommand}" IsEnabled="{Binding CanControlAudio}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2" AutomationProperties.AutomationId="AdminAudio_StatusText" Text="{Binding AudioStatusText}" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Popup IsOpen="{Binding IsConnectionPopupOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=ServerButton}" StaysOpen="False">
                    <Border Style="{StaticResource CardStyle}" Width="420" Padding="12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Подключение к серверу" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="&#1054;&#1090;&#1082;&#1088;&#1099;&#1090;&#1100;" Width="34" Padding="0" Command="{Binding OpenConnectionPopupCommand}"/>
                            </DockPanel>
                            <TextBlock Text="Адрес сервера" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding ServerHostInput, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Порт" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding ServerPortInput, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding ConnectionStatusDetail}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding LastServerHost, StringFormat=Последний host: {0}}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding LastServerPort, StringFormat=Последний port: {0}}"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button AutomationProperties.AutomationId="Admin_Connect_Button" Content="Подключиться" Command="{Binding ConnectToServerCommand}" IsEnabled="{Binding CanInitiateConnection}"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Content="Применить" Command="{Binding ApplyConnectionSettingsCommand}" IsEnabled="{Binding CanInitiateConnection}"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Content="Сбросить" Command="{Binding ResetConnectionDefaultsCommand}" IsEnabled="{Binding CanInitiateConnection}"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Content="Сохранить" Command="{Binding UseSavedConnectionSettingsCommand}" IsEnabled="{Binding CanInitiateConnection}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup IsOpen="{Binding IsAuthPopupOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=AuthButton}" StaysOpen="False">
                    <Border Style="{StaticResource CardStyle}" Width="360" Padding="12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Характеристики" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="&#1054;&#1090;&#1082;&#1088;&#1099;&#1090;&#1100;" Width="34" Padding="0" Command="{Binding ToggleAuthPopupCommand}"/>
                            </DockPanel>
                            <TextBlock Text="Логин" Margin="0,10,0,0"/>
                            <TextBox AutomationProperties.AutomationId="Admin_Login_Text" Text="{Binding LoginText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Пароль" Margin="0,8,0,0"/>
                            <PasswordBox x:Name="AdminPasswordBox" AutomationProperties.AutomationId="Admin_Password_Box" PasswordChanged="OnAdminPasswordChanged"/>
                            <TextBox AutomationProperties.AutomationId="Admin_Password_Automation_Text"
                                     Text="{Binding PasswordText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="1"
                                     Height="1"
                                     Opacity="0.01"
                                     IsTabStop="False"
                                     Margin="0"/>
                            <TextBlock Text="Старый пароль" Margin="0,8,0,0"/>
                            <PasswordBox x:Name="AdminOldPasswordBox" PasswordChanged="OnAdminOldPasswordChanged"/>
                            <TextBlock Text="Новый пароль" Margin="0,8,0,0"/>
                            <PasswordBox x:Name="AdminNewPasswordBox" PasswordChanged="OnAdminNewPasswordChanged"/>
                            <TextBlock AutomationProperties.AutomationId="Admin_Auth_LoginState_Text" Text="{Binding LoginState}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding LastErrorMessage}" Foreground="{StaticResource DangerBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel Margin="0,12,0,0"><Button AutomationProperties.AutomationId="Admin_Login_Button" Content="Войти" Command="{Binding LoginCommand}" HorizontalAlignment="Left" IsEnabled="{Binding CanInitiateConnection}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Сменить пароль" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding ArePrivilegedSectionsEnabled}"/></WrapPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Grid>
</Window>






