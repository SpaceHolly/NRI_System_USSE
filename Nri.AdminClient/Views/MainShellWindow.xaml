                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding SelectedLockSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Обновить" Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshPeopleSectionCommand}" IsEnabled="{Binding IsIdle}"/>
