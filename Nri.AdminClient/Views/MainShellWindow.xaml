                                            <TextBox MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding RequestComment, UpdateSourceTrigger=PropertyChanged}" ToolTip="Комментарий для игрока" AutomationProperties.AutomationId="AdminRequests_DecisionPlayerComment" Margin="0,8,0,0"/>
                                            <TextBox MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding RequestGMOnlyComment, UpdateSourceTrigger=PropertyChanged}" ToolTip="Заметка GM" AutomationProperties.AutomationId="AdminRequests_DecisionGMComment" Margin="0,8,0,0"/>
                                            <TextBox Visibility="Collapsed" Text="{Binding RequestGMOnlyComment}" AutomationProperties.AutomationId="AdminRequests_AdminNotes"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="На рассмотрение" Command="{Binding MarkInReviewRequestCommand}" IsEnabled="{Binding ArePrivilegedSectionsEnabled}" AutomationProperties.AutomationId="AdminRequests_MarkInReview_Button"/>
                                                <Button Content="Одобрить" Command="{Binding ApproveRequestCommand}" IsEnabled="{Binding ArePrivilegedSectionsEnabled}" Margin="8,0,0,0" AutomationProperties.AutomationId="AdminRequests_Approve_Button"/>
                                                <Button Content="Отклонить" Command="{Binding RejectRequestCommand}" IsEnabled="{Binding ArePrivilegedSectionsEnabled}" Margin="8,0,0,0" AutomationProperties.AutomationId="AdminRequests_Reject_Button"/>
                                                <Button Content="Нужны уточнения" Command="{Binding RequestChangesCommand}" IsEnabled="{Binding ArePrivilegedSectionsEnabled}" Margin="8,0,0,0" AutomationProperties.AutomationId="AdminRequests_RequestChanges_Button"/>
                                                <Button Content="Архив" Style="{StaticResource GhostButtonStyle}" Command="{Binding ArchiveRequestCommand}" IsEnabled="{Binding ArePrivilegedSectionsEnabled}" Margin="8,0,0,0" AutomationProperties.AutomationId="AdminRequests_Archive_Button"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminRequests_StatusText"/>
