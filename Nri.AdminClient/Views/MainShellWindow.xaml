<Window x:Class="Nri.AdminClient.Views.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nri.AdminClient.ViewModels"
        xmlns:pages="clr-namespace:Nri.AdminClient.Views.Pages"
        xmlns:conduct="clr-namespace:Nri.AdminClient.Views.Conduct"
        xmlns:sessions="clr-namespace:Nri.AdminClient.Views.Sessions"
        xmlns:groups="clr-namespace:Nri.AdminClient.Views.Groups"
        xmlns:calendar="clr-namespace:Nri.AdminClient.Views.Calendar"
        xmlns:notes="clr-namespace:Nri.AdminClient.Views.Notes"
        xmlns:journal="clr-namespace:Nri.AdminClient.Views.Journal"
        xmlns:proposals="clr-namespace:Nri.AdminClient.Views.Proposals"
        xmlns:characters="clr-namespace:Nri.AdminClient.Views.Characters"
        xmlns:converters="clr-namespace:Nri.AdminClient.Converters"
        xmlns:administration="clr-namespace:Nri.AdminClient.Views.Administration"
        xmlns:dashboard="clr-namespace:Nri.AdminClient.Views.Dashboard"
        xmlns:systemTools="clr-namespace:Nri.AdminClient.Views.SystemTools"
        xmlns:fate="clr-namespace:Nri.AdminClient.Views.Fate"
        Title="NRI System USSE — Панель Гейм-мастера"
        Height="920"
        Width="1540"
        MinHeight="760"
        MinWidth="1240" Background="#FF111827">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:AdminNavigationIconPathConverter x:Key="AdminNavigationIconPathConverter"/>

        <Style x:Key="SectionHostTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Visibility="Collapsed"/>
                            <Border Grid.Row="1"
                                    Background="Transparent">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                                  KeyboardNavigation.TabIndex="2"
                                                  KeyboardNavigation.TabNavigation="Local"
                                                  KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShellNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#263B82F6"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter Property="Opacity" Value="0.82"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="RequestsTemplate" DataType="{x:Type vm:WorkspacePanelDescriptor}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Заявки игроков" Style="{StaticResource SectionTitleTextStyle}"/><Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="Закрепить панель" Command="{Binding DataContext.AttachWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Requests"/></DockPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding DataContext.PendingRequests, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValuePath="Id" SelectedValue="{Binding DataContext.SelectedPendingRequestId, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"><DataGrid.Columns><DataGridTextColumn Header="№" Binding="{Binding DisplayId}" Width="0.6*"/><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="1.1*"/><DataGridTextColumn Header="Статус" Binding="{Binding State}" Width="1*"/><DataGridTextColumn Header="Детали" Binding="{Binding Extra}" Width="2*"/></DataGrid.Columns></DataGrid>
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0"><Button Content="Одобрить" Command="{Binding DataContext.ApproveRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanModerateSelectedRequest, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Отклонить" Command="{Binding DataContext.RejectRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanModerateSelectedRequest, RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox Width="260" Text="{Binding DataContext.RequestComment, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" ToolTip="Комментарий GM"/></WrapPanel>
                    </Grid>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Карточка заявки" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="{Binding DataContext.SelectedRequestSummary, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding DataContext.SelectedPlayerSummary, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding DataContext.SelectedCharacterSummary, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,0,0" TextWrapping="Wrap"/><Border Style="{StaticResource SubtleCardStyle}" Margin="0,10,0,0"><StackPanel><TextBlock Text="История заявки" Style="{StaticResource TitleTextStyle}"/><ListBox ItemsSource="{Binding DataContext.RequestHistoryRows, RelativeSource={RelativeSource AncestorType=Window}}" MinHeight="220"/></StackPanel></Border></StackPanel></Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DiceFeedTemplate" DataType="{x:Type vm:WorkspacePanelDescriptor}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Лента бросков" Style="{StaticResource SectionTitleTextStyle}"/><Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="Закрепить панель" Command="{Binding DataContext.AttachWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="DiceFeed"/></DockPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
                    <ListBox ItemsSource="{Binding DataContext.DiceFeedRows, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CombatTrackerTemplate" DataType="{x:Type vm:WorkspacePanelDescriptor}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Трекер боя" Style="{StaticResource SectionTitleTextStyle}"/><Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="Закрепить панель" Command="{Binding DataContext.AttachWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="CombatTracker"/></DockPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Управление боем" Style="{StaticResource SectionTitleTextStyle}"/><WrapPanel Margin="0,8,0,0"><TextBox Width="150" Text="{Binding DataContext.CombatSessionId, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Начать" Command="{Binding DataContext.CombatStartCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlCombat, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Завершить" Command="{Binding DataContext.CombatEndCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlCombat, RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel><WrapPanel Margin="0,8,0,0"><Button Style="{StaticResource GhostButtonStyle}" Content="Следующий ход" Command="{Binding DataContext.CombatNextTurnCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlCombat, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Предыдущий ход" Command="{Binding DataContext.CombatPrevTurnCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlCombat, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Следующий раунд" Command="{Binding DataContext.CombatNextRoundCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlCombat, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Пропустить" Command="{Binding DataContext.CombatSkipTurnCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlCombat, RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Участники" Style="{StaticResource SectionTitleTextStyle}"/><WrapPanel Margin="0,8,0,0"><TextBox Width="130" Text="{Binding DataContext.NewParticipantName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="90" Text="{Binding DataContext.NewParticipantKind, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Добавить" Command="{Binding DataContext.CombatAddParticipantCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlCombat, RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel><WrapPanel Margin="0,8,0,0"><TextBox Width="210" Text="{Binding DataContext.SelectedCombatParticipantId, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Удалить" Command="{Binding DataContext.CombatRemoveParticipantCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanManageCombatSelection, RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel><ListBox ItemsSource="{Binding DataContext.CombatRows, RelativeSource={RelativeSource AncestorType=Window}}" MinHeight="220" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="История боя" Style="{StaticResource SectionTitleTextStyle}"/><ListBox ItemsSource="{Binding DataContext.CombatHistoryRows, RelativeSource={RelativeSource AncestorType=Window}}" MinHeight="320"/></StackPanel></Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NotesManagementTemplate" DataType="{x:Type vm:WorkspacePanelDescriptor}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Заметки GM" Style="{StaticResource SectionTitleTextStyle}"/><Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="Закрепить панель" Command="{Binding DataContext.AttachWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="NotesManagement"/></DockPanel>
                <notes:AdminGMNotesView Grid.Row="1" DataContext="{Binding DataContext.GMNotes, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SessionChatTemplate" DataType="{x:Type vm:WorkspacePanelDescriptor}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Чат сессии" Style="{StaticResource SectionTitleTextStyle}"/><Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="Закрепить панель" Command="{Binding DataContext.AttachWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="SessionChat"/></DockPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><ListBox ItemsSource="{Binding DataContext.MergedSessionFeedRows, RelativeSource={RelativeSource AncestorType=Window}}"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:ChatMessageRowVm}"><Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,6"><StackPanel><TextBlock TextWrapping="Wrap"><Run Text="{Binding Sender}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Text}"/></TextBlock><TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Модерация чата" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="Пользователь" Margin="0,8,0,2"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding DataContext.ChatModerationUserId, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Выберите пользователя" Tag=""/><ComboBoxItem Content="Ввести ID вручную" Tag="manual"/></ComboBox><TextBlock Text="Причина" Margin="0,6,0,2"/><TextBox Text="{Binding DataContext.ChatModerationReason, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/><WrapPanel Margin="0,8,0,0"><Button Style="{StaticResource GhostButtonStyle}" Content="Заглушить" Command="{Binding DataContext.ChatMuteUserCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanModerateChatUser, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Снять мут" Command="{Binding DataContext.ChatUnmuteUserCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanModerateChatUser, RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel><TextBlock Text="Slow mode, секунды" Margin="0,8,0,2"/><WrapPanel><TextBox Width="58" Text="{Binding DataContext.ChatSlowPublicSeconds, RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox Width="58" Text="{Binding DataContext.ChatSlowHiddenSeconds, RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox Width="58" Text="{Binding DataContext.ChatSlowAdminOnlySeconds, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Сохранить ограничения" Command="{Binding DataContext.ChatSetSlowModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanManageChatControls, RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel><ListBox Margin="0,8,0,0" ItemsSource="{Binding DataContext.ChatRestrictionRows, RelativeSource={RelativeSource AncestorType=Window}}" MinHeight="180"/></StackPanel></Border>
                </Grid>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><WrapPanel><ComboBox Width="150" SelectedValuePath="Tag" SelectedValue="{Binding DataContext.ChatSessionId, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Сессия: текущая" Tag="default"/></ComboBox><ComboBox Width="170" ItemsSource="{Binding DataContext.ChatMessageTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.ChatMessageType, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Обновить" Command="{Binding DataContext.ChatRefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox Margin="0,0,8,0" Text="{Binding DataContext.ChatMessageText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Отправить" Command="{Binding DataContext.ChatSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanSendChat, RelativeSource={RelativeSource AncestorType=Window}}"/></Grid></Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SessionAudioTemplate" DataType="{x:Type vm:WorkspacePanelDescriptor}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Аудио сессии" Style="{StaticResource SectionTitleTextStyle}"/><Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="Закрепить панель" Command="{Binding DataContext.AttachWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="SessionAudio"/></DockPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}"><StackPanel><WrapPanel><ComboBox Width="150" SelectedValuePath="Tag" SelectedValue="{Binding DataContext.AudioSessionId, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Сессия: текущая" Tag="default"/></ComboBox><ComboBox Width="160" Text="{Binding DataContext.AudioModeInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"><ComboBoxItem Content="ambient"/><ComboBoxItem Content="combat"/><ComboBoxItem Content="dialog"/></ComboBox><TextBox Width="160" Text="{Binding DataContext.AudioCategoryInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Обновить" Command="{Binding DataContext.AudioRefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="Установить режим" Command="{Binding DataContext.AudioSetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlAudio, RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel><WrapPanel Margin="0,8,0,0"><TextBox Width="220" Text="{Binding DataContext.AudioSelectedTrackId, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Выбрать трек" Command="{Binding DataContext.AudioSelectTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlAudio, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Следующий" Command="{Binding DataContext.AudioNextTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlAudio, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Сбросить переопределение" Command="{Binding DataContext.AudioClearOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlAudio, RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel></StackPanel></Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,8,0,0"><StackPanel><DockPanel><TextBlock Text="Библиотека аудио" Style="{StaticResource SectionTitleTextStyle}"/><Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="Перезагрузить" Command="{Binding DataContext.AudioReloadLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanControlAudio, RelativeSource={RelativeSource AncestorType=Window}}"/></DockPanel><DataGrid ItemsSource="{Binding DataContext.AudioLibraryRows, RelativeSource={RelativeSource AncestorType=Window}}" MinHeight="260"/></StackPanel></Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CombatReadOnlyTemplate" DataType="{x:Type vm:WorkspacePanelDescriptor}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Бой" Style="{StaticResource SectionTitleTextStyle}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="Закрепить панель" Command="{Binding DataContext.AttachWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="CombatReadOnly"/>
                </DockPanel>
                <conduct:AdminCombatReadOnlyView Grid.Row="1" DataContext="{Binding DataContext.CombatReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DefinitionsBrowserTemplate" DataType="{x:Type vm:WorkspacePanelDescriptor}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Характеристики" Style="{StaticResource SectionTitleTextStyle}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="Закрепить панель" Command="{Binding DataContext.AttachWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="DefinitionsBrowser"/>
                </DockPanel>
                <administration:AdminDefinitionsBrowserView Grid.Row="1" DataContext="{Binding DataContext.DefinitionsBrowser, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Активная кампания" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding ActiveCampaignSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Активная сессия" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding ActiveSessionTopBarSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource StatusBadgeStyle}" VerticalAlignment="Center" Height="30" Padding="12,4">
                    <TextBlock Text="{Binding ConnectionState}" Foreground="#FFF8FAFC" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="3" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="Поиск GM" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ShellSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по открытому рабочему пространству."
                             MinWidth="220"/>
                    <DockPanel>
                        <TextBlock Text="{Binding ShellSearchHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource GhostButtonStyle}"
                                Content="Открыть"
                                Command="{Binding OpenFirstShellSearchResultCommand}"
                                ToolTip="Открыть первый результат"
                                Padding="6,1"
                                Margin="8,2,0,0"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding NotificationSummary}" Style="{StaticResource GhostButtonStyle}" IsEnabled="False" VerticalAlignment="Center" MinHeight="30"/>
                    <TextBox AutomationProperties.AutomationId="Admin_SelectedSection_Input"
                             Width="1"
                             Height="1"
                             Opacity="0"
                             Padding="0"
                             Margin="0"
                             BorderThickness="0"
                             ToolTip="Открытый раздел"
                             Text="{Binding SelectedSection, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>
                    <Button AutomationProperties.AutomationId="Admin_OpenCharacters_Button" Style="{StaticResource GhostButtonStyle}" Content="Персонажи" Click="OnOpenCharactersRouteClick" VerticalAlignment="Center" MinHeight="30"/>
                    <Button AutomationProperties.AutomationId="Admin_OpenClasses_Button" Style="{StaticResource GhostButtonStyle}" Content="Классы" Click="OnOpenClassesRouteClick" VerticalAlignment="Center" MinHeight="30"/>
                    <Button x:Name="ServerButton" AutomationProperties.AutomationId="Admin_Server_Button" Style="{StaticResource GhostButtonStyle}" Content="Сервер" Command="{Binding OpenConnectionPopupCommand}" VerticalAlignment="Center" MinHeight="30"/>
                    <Button x:Name="AuthButton" AutomationProperties.AutomationId="Admin_Auth_Button" Style="{StaticResource GhostButtonStyle}" Content="{Binding LoginSummary}" Command="{Binding ToggleAuthPopupCommand}" VerticalAlignment="Center" MinHeight="30"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,8,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,2">
                            <TextBlock Text="Панель Гейм-мастера" Style="{StaticResource HeaderTitleTextStyle}"/>
                        </StackPanel>
                        <TextBlock Text="GM-пульт кампании" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBlock AutomationProperties.AutomationId="Admin_LoginState_Text" Text="{Binding LoginState}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding NavigationGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AdminNavigationGroup}">
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="2,4,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AdminNavigationItem}">
                                                     <Button Style="{StaticResource ShellNavigationButtonStyle}"
                                                             AutomationProperties.AutomationId="{Binding AutomationId}"
                                                             AutomationProperties.Name="{Binding Title}"
                                                             Click="OnShellNavigationButtonClick"
                                                             IsEnabled="{Binding IsEnabled}"
                                                             Visibility="{Binding IsSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
