                <TextBlock Text="{Binding AuthenticationStatusMessage}" Foreground="{StaticResource NriDangerBrush}" TextWrapping="Wrap"/>
                <Expander Header="Дополнительно" Margin="0,10,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Старый пароль"/>
                        <PasswordBox x:Name="AdminOldPasswordBox" PasswordChanged="OnAdminOldPasswordChanged"/>
                        <TextBlock Text="Новый пароль" Margin="0,8,0,0"/>
                        <PasswordBox x:Name="AdminNewPasswordBox" PasswordChanged="OnAdminNewPasswordChanged"/>
                        <Button Style="{StaticResource NriSecondaryButtonStyle}" Content="Сменить пароль" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding ArePrivilegedSectionsEnabled}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Expander>
                <Button AutomationProperties.AutomationId="Admin_Login_Button" Content="Войти" Command="{Binding LoginCommand}" HorizontalAlignment="Right" IsEnabled="{Binding CanInitiateConnection}" Margin="0,16,0,0"/>
            </StackPanel>
        </nri:NriLoginDialog>

        <Border Grid.RowSpan="3" Panel.ZIndex="90" Background="{StaticResource NriOverlayBrush}"
                Visibility="{Binding IsWorkspacePanelManagerOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="Admin_Workspace_Manager_Overlay">
            <Border Width="680" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource NriElevatedSurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Панели проведения" Style="{StaticResource NriPageTitleTextStyle}"/>
                            <TextBlock Text="Закрепляйте панели в рабочей области или выносите их в отдельные окна." Style="{StaticResource NriSecondaryTextStyle}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Закрыть" Command="{Binding ToggleWorkspacePanelManagerCommand}" Style="{StaticResource NriSecondaryButtonStyle}" AutomationProperties.AutomationId="Admin_Workspace_Manager_Close"/>
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding WorkspacePanels}" AutomationProperties.AutomationId="Admin_Workspace_Manager_List">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorkspacePanelDescriptor}">
                                <Border Background="{StaticResource NriSecondarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PanelState}" Style="{StaticResource NriMetadataTextStyle}"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1">
                                            <Button Content="Закрепить" Style="{StaticResource NriSecondaryButtonStyle}" Command="{Binding DataContext.AttachWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PanelId}"/>
                                            <Button Content="В отдельное окно" Style="{StaticResource NriSecondaryButtonStyle}" Command="{Binding DataContext.DetachWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PanelId}" IsEnabled="{Binding CanDetach}"/>
                                            <Button Content="Показать" Style="{StaticResource NriSecondaryButtonStyle}" Command="{Binding DataContext.ShowWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PanelId}"/>
                                            <Button Content="Скрыть" Style="{StaticResource NriSecondaryButtonStyle}" Command="{Binding DataContext.HideWorkspacePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PanelId}"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>






