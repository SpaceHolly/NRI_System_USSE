                    <TabItem Header="Глобальный поиск" Tag="global.search" AutomationProperties.AutomationId="AdminGlobalSearch_Tab">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource CardStyle}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             AutomationProperties.AutomationId="AdminGlobalSearch_Query"
                                             Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Введите текст для серверного поиска"/>
                                    <ComboBox Grid.Column="1"
                                              AutomationProperties.AutomationId="AdminGlobalSearch_CategoryFilter"
                                              ItemsSource="{Binding GlobalSearchCategories}"
                                              SelectedItem="{Binding GlobalSearchCategoryFilter, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="8,0,0,0"/>
                                    <CheckBox Grid.Column="2"
                                              AutomationProperties.AutomationId="AdminGlobalSearch_IncludeArchived"
                                              Content="Архив"
                                              IsChecked="{Binding GlobalSearchIncludeArchived}"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"/>
                                    <CheckBox Grid.Column="3"
                                              AutomationProperties.AutomationId="AdminGlobalSearch_IncludeHidden"
                                              Content="Скрытое"
                                              IsChecked="{Binding GlobalSearchIncludeHidden}"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"/>
                                    <Button Grid.Column="4"
                                            AutomationProperties.AutomationId="AdminGlobalSearch_Button"
                                            Content="Искать"
                                            Command="{Binding GlobalSearchCommand}"
                                            Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <DataGrid Grid.Column="0"
                                          AutomationProperties.AutomationId="AdminGlobalSearch_Results"
                                          ItemsSource="{Binding GlobalSearchResults}"
                                          SelectedItem="{Binding SelectedGlobalSearchResult}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MinHeight="360">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Название" Binding="{Binding DisplayTitle}" Width="2*"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding DisplayType}" Width="1.2*"/>
                                        <DataGridTextColumn Header="Фрагмент" Binding="{Binding Snippet}" Width="3*"/>
                                        <DataGridTextColumn Header="Источник" Binding="{Binding SourceCollection}" Width="1.2*"/>
                                        <DataGridTextColumn Header="Маршрут" Binding="{Binding RouteKey}" Width="1.4*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock AutomationProperties.AutomationId="AdminGlobalSearch_Result_Title"
                                                   Text="{Binding SelectedGlobalSearchTitle}"
                                                   Style="{StaticResource SectionTitleTextStyle}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock AutomationProperties.AutomationId="AdminGlobalSearch_Result_EntityType"
                                                   Text="{Binding SelectedGlobalSearchType}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock AutomationProperties.AutomationId="AdminGlobalSearch_Result_Snippet"
                                                   Text="{Binding SelectedGlobalSearchSnippet}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,0"/>
                                        <TextBlock Text="{Binding SelectedGlobalSearchRoute}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,0"/>
                                        <Button AutomationProperties.AutomationId="AdminGlobalSearch_Open_Button"
                                                Content="Открыть"
                                                Command="{Binding GlobalSearchOpenCommand}"
                                                Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       AutomationProperties.AutomationId="AdminGlobalSearch_StatusText"
                                       Text="{Binding GlobalSearchStatusText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="4,8,0,0"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Системные инструменты" Tag="system.tools">
                        <systemTools:SystemToolsView DataContext="{Binding SystemTools}"/>
