<UserControl x:Class="Nri.AdminClient.Views.SystemViews.AdminGlobalSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="AdminGlobalSearch_Route">
    <patterns:NriCollectionBrowserHost AutomationProperties.AutomationId="AdminGlobalSearch_BrowserHost"
                                       IsInspectorOpen="True">
        <patterns:NriCollectionBrowserHost.Header>
            <StackPanel Margin="8,8,8,12">
                <TextBlock Text="Глобальный поиск" Style="{StaticResource SectionTitleTextStyle}"/>
                <TextBlock Text="Поиск по доступным данным с переходом к рабочему маршруту."
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </patterns:NriCollectionBrowserHost.Header>
        <patterns:NriCollectionBrowserHost.Toolbar>
            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Название, ключевые слова или описание"
                         AutomationProperties.AutomationId="AdminGlobalSearch_Query"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding GlobalSearchCategories}"
                          SelectedItem="{Binding GlobalSearchCategoryFilter, UpdateSourceTrigger=PropertyChanged}"
                          Margin="8,0,0,0"
                          AutomationProperties.AutomationId="AdminGlobalSearch_CategoryFilter"/>
                <CheckBox Grid.Column="2" Content="Архив" IsChecked="{Binding GlobalSearchIncludeArchived}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <CheckBox Grid.Column="3" Content="Скрытое" IsChecked="{Binding GlobalSearchIncludeHidden}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Grid.Column="4"
                        Content="Искать"
                        Command="{Binding GlobalSearchCommand}"
                        Margin="12,0,0,0"
                        AutomationProperties.AutomationId="AdminGlobalSearch_Button"/>
            </Grid>
        </patterns:NriCollectionBrowserHost.Toolbar>
        <patterns:NriCollectionBrowserHost.Collection>
            <DataGrid ItemsSource="{Binding GlobalSearchResults}"
                      SelectedItem="{Binding SelectedGlobalSearchResult}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      AutomationProperties.AutomationId="AdminGlobalSearch_Results">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding DisplayTitle}" Width="2*"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding DisplayType}" Width="1.2*"/>
                    <DataGridTextColumn Header="Фрагмент" Binding="{Binding Snippet}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </patterns:NriCollectionBrowserHost.Collection>
        <patterns:NriCollectionBrowserHost.Inspector>
            <StackPanel>
                <TextBlock Text="{Binding SelectedGlobalSearchTitle}" Style="{StaticResource SectionTitleTextStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedGlobalSearchType}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SelectedGlobalSearchSnippet}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding SelectedGlobalSearchRoute}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <Button Content="Открыть"
                        Command="{Binding GlobalSearchOpenCommand}"
                        Margin="0,16,0,0"
                        AutomationProperties.AutomationId="AdminGlobalSearch_Open_Button"/>
                <Expander Header="Технические сведения" Margin="0,14,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding SelectedGlobalSearchResult.SourceCollection}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </patterns:NriCollectionBrowserHost.Inspector>
    </patterns:NriCollectionBrowserHost>
</UserControl>
