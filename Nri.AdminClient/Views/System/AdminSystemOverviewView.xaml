<UserControl x:Class="Nri.AdminClient.Views.SystemViews.AdminSystemOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="AdminSystemOverview_Route">
    <patterns:NriOperationalWorkspaceHost AutomationProperties.AutomationId="AdminSystemOverview_OperationalHost">
        <patterns:NriOperationalWorkspaceHost.Header>
            <DockPanel Margin="8,8,8,12">
                <StackPanel>
                    <TextBlock Text="Состояние системы" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="Краткий обзор подключения и служебных подсистем."
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                 <Button DockPanel.Dock="Right"
                         Content="Обновить"
                         Command="{Binding RefreshSystemSectionCommand}"
                         IsEnabled="{Binding CanRefreshSystem}"
                         AutomationProperties.AutomationId="AdminSystemOverview_Refresh"/>
            </DockPanel>
        </patterns:NriOperationalWorkspaceHost.Header>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource SummaryMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Соединение" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="{Binding ConnectionStatusDetail}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AdminSystemOverview_Connection"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Резервные копии" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="{Binding BackupSummary}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AdminSystemOverview_Backup"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Диагностика" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="{Binding DiagnosticsSummary}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AdminSystemOverview_Diagnostics"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Требуется ли действие" Style="{StaticResource SectionTitleTextStyle}"/>
                     <TextBlock Text="{Binding LastStatusMessage}"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,6,0,0"
                                AutomationProperties.AutomationId="AdminSystemOverview_Status"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Проверить подключение" Command="{Binding ConnectToServerCommand}" IsEnabled="{Binding CanInitiateConnection}"/>
                        <Button Content="Открыть окно подключения" Style="{StaticResource GhostButtonStyle}" Command="{Binding ShowConnectionPopupCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Expander Grid.Row="2"
                      Header="Дополнительные параметры подключения"
                      VerticalAlignment="Top"
                      Margin="0,12,0,0">
                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Адрес сервера"/>
                            <TextBox Text="{Binding ServerHostInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Порт"/>
                            <TextBox Text="{Binding ServerPortInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="2" Margin="12,20,0,0">
                            <Button Content="Применить" Command="{Binding ApplyConnectionSettingsCommand}" IsEnabled="{Binding CanInitiateConnection}"/>
                            <Button Content="Сбросить" Style="{StaticResource GhostButtonStyle}" Command="{Binding ResetConnectionDefaultsCommand}" IsEnabled="{Binding CanInitiateConnection}"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Expander>
        </Grid>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
