<UserControl x:Class="Nri.AdminClient.Views.SystemTools.SystemToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf">
    <UserControl.Resources>
        <Style x:Key="SystemToolsRouteOnlyTabItemStyle" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border Width="0" Height="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <patterns:NriOperationalWorkspaceHost AutomationProperties.AutomationId="AdminSystemTools_OperationalHost">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Система / диагностика" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="Системные инструменты администратора: функции и модули, проверки, диагностика, журналы, резервные копии и состояние сервера."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF87171" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Обновить всё" Command="{Binding RefreshAllCommand}" IsEnabled="{Binding CanRun}"/>
                    <Button Content="Очистить ошибку" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearErrorCommand}"/>
                    <TextBlock Text="{Binding LastRunText, StringFormat=Последний запуск: {0}}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    ItemContainerStyle="{StaticResource SystemToolsRouteOnlyTabItemStyle}">
            <TabItem Header="Диагностика">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Обзор системных инструментов" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Button DockPanel.Dock="Right" Content="Обновить" Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshAllCommand}" IsEnabled="{Binding CanRun}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding OverviewCards}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding State}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Безопасный режим" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="Функции и модули доступны только администраторам. Резервные копии поддерживают список, создание, проверку и защищённое восстановление. Пакеты справочников проверяются dry-run. Диагностика инвентаря не выполняет repair/merge/fix. Серверная механика не меняется." TextWrapping="Wrap"/>
                            <Separator Margin="0,12,0,12"/>
                            <TextBlock Text="Состояние клиента" Style="{StaticResource TitleTextStyle}"/>
                            <TextBlock Text="{Binding ClientStatusSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="Подключение и вход управляются в верхней панели AdminClient." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Функции и модули">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Функции и модули" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="Здесь включаются и отключаются функции системы, экспериментальные модули и защитные режимы. Технический ключ показан вторично для диагностики." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBox Width="260" Text="{Binding FeatureFlagSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по названию, группе, источнику или описанию"/>
                                    <TextBlock Text="{Binding SelectedFeatureFlagSummary}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="Обновить" Command="{Binding LoadFeatureFlagsCommand}" IsEnabled="{Binding CanRun}"/>
                                <Button Content="{Binding SelectedFeatureFlagToggleText}" Command="{Binding ToggleFeatureFlagCommand}" IsEnabled="{Binding CanModifySelectedFeatureFlag}"/>
                                <Button Content="Сбросить переопределение" Style="{StaticResource GhostButtonStyle}" Command="{Binding ResetFeatureFlagCommand}" IsEnabled="{Binding CanClearSelectedFeatureFlag}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FeatureFlags}"
                              SelectedItem="{Binding SelectedFeatureFlag, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinColumnWidth="110">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding DisplayName}" Width="1.7*"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding CategoryDisplay}" Width="1*"/>
                            <DataGridCheckBoxColumn Header="По умолчанию" Binding="{Binding DefaultValue}" Width="0.8*"/>
                            <DataGridCheckBoxColumn Header="Сейчас" Binding="{Binding EffectiveValue}" Width="0.7*"/>
                            <DataGridCheckBoxColumn Header="Переопределено" Binding="{Binding HasOverride}" Width="0.8*"/>
                            <DataGridTextColumn Header="Источник" Binding="{Binding SourceDisplay}" Width="1.1*"/>
                            <DataGridTextColumn Header="Ключ" Binding="{Binding Name}" Width="1.6*"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding DescriptionDisplay}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Проверки">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Проверка боя" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="Запускается только вручную и только если серверные combat smoke flags включены." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Технический ключ кампании" Margin="0,10,0,2"/>
                            <TextBox Text="{Binding CombatSmokeCampaignId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Технический ключ сессии" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding CombatSmokeSessionId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Технический ключ набора правил" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding CombatSmokeRuleSetId, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Запустить проверку с записью (явно)" IsChecked="{Binding CombatSmokeRunWrite}" Margin="0,10,0,0"/>
                            <Button Content="Запустить проверку боя" Command="{Binding RunCombatSmokeCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding CombatSmokeSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding CombatSmokeSteps}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Шаг" Binding="{Binding StepName}" Width="1.4*"/>
                                <DataGridCheckBoxColumn Header="Успешно" Binding="{Binding Success}" Width="90"/>
                                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="2*"/>
                                <DataGridTextColumn Header="Ошибки" Binding="{Binding Errors}" Width="1.4*"/>
                                <DataGridTextColumn Header="Предупреждения" Binding="{Binding Warnings}" Width="1.4*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding CombatSmokeIssues}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Важность" Binding="{Binding Severity}" Width="110"/>
                                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="160"/>
                                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Логи">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Журнал клиента" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding LogsStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Обновить журнал" Command="{Binding RefreshLogsCommand}" IsEnabled="{Binding CanRun}"/>
                        </DockPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ClientLogLines}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Binding="{Binding Timestamp}" Width="170"/>
                            <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="90"/>
                            <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Резервные копии" AutomationProperties.AutomationId="AdminSystem_Backups_Tab">
                <Grid Margin="8" AutomationProperties.AutomationId="AdminBackupRestore_Root">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                            <TextBlock Text="Резервные копии / восстановление" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.AutomationId="AdminBackup_Title"/>
                                <TextBlock Text="{Binding BackupStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminBackup_Status"/>
                                <TextBlock Text="Восстановление выполняется только по зарегистрированной резервной копии, после предпросмотра, режима обслуживания и точной фразы подтверждения." Foreground="#FFF59E0B" TextWrapping="Wrap"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BackupLabel, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminBackup_Label_Input"/>
                                    <TextBox Grid.Column="1" Text="{Binding BackupDescription, UpdateSourceTrigger=PropertyChanged}" MinWidth="220" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminBackup_Description_Input"/>
                                    <Button Grid.Column="2" Content="Создать резервную копию" Command="{Binding CreateBackupCommand}" IsEnabled="{Binding CanRun}" AutomationProperties.AutomationId="AdminBackup_Create_Button"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Режим обслуживания" FontWeight="SemiBold"/>
                                <CheckBox Content="Включён" IsChecked="{Binding BackupMaintenanceEnabled}" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminBackup_Maintenance_Check"/>
                                <TextBox Text="{Binding BackupMaintenanceReason, UpdateSourceTrigger=PropertyChanged}" MinWidth="220" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminBackup_MaintenanceReason_Input"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Применить" Command="{Binding SetBackupMaintenanceCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminBackup_MaintenanceApply_Button"/>
                                    <Button Content="Обновить" Command="{Binding RefreshBackupMaintenanceCommand}" IsEnabled="{Binding CanRun}" AutomationProperties.AutomationId="AdminBackup_MaintenanceRefresh_Button"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Обновить список" Command="{Binding RefreshBackupsCommand}" IsEnabled="{Binding CanRun}" VerticalAlignment="Top" Margin="12,0,0,0" AutomationProperties.AutomationId="AdminBackup_RefreshList_Button"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="AdminBackup_List_Table">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Label}" Width="1.4*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="Проверка" Binding="{Binding VerificationLabel}" Width="120"/>
                                <DataGridTextColumn Header="Коллекции" Binding="{Binding CollectionCount}" Width="90"/>
                                <DataGridTextColumn Header="Документы" Binding="{Binding DocumentCount}" Width="100"/>
                                <DataGridTextColumn Header="Размер" Binding="{Binding SizeLabel}" Width="90"/>
                                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedUtc}" Width="150"/>
                                <DataGridTextColumn Header="Автор" Binding="{Binding CreatedBy}" Width="130"/>
                                    <DataGridTextColumn Header="Технический ID" Binding="{Binding BackupId}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                            <TextBlock Text="Защита восстановления" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="Выбранная резервная копия:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding SelectedBackupId}" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminBackup_SelectedBackupId_Text"/>
                                <TextBlock Text="Причина восстановления" Margin="0,10,0,2"/>
                                <TextBox Text="{Binding RestoreReason, UpdateSourceTrigger=PropertyChanged}" MinHeight="52" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.AutomationId="AdminBackup_RestoreReason_Input"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Проверить резервную копию" Command="{Binding VerifyBackupCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminBackup_Verify_Button"/>
                            <Button Content="Предпросмотр восстановления" Command="{Binding PreviewRestoreCommand}" IsEnabled="{Binding CanRun}" AutomationProperties.AutomationId="AdminBackup_RestorePreview_Button"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RestorePreviewStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminBackup_RestorePreview_Status"/>
                                <TextBlock Text="Для выполнения введите точную фразу:" Margin="0,12,0,2"/>
                                <TextBlock Text="{Binding RestoreConfirmationPhrase}" FontFamily="Consolas" Foreground="#FFF59E0B" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminBackup_RestoreConfirmationPhrase_Text"/>
                                <TextBox Text="{Binding RestoreConfirmation, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminBackup_RestoreConfirmation_Input"/>
                            <Button Content="Выполнить восстановление" Command="{Binding ExecuteRestoreCommand}" IsEnabled="{Binding CanRun}" Margin="0,10,0,0" AutomationProperties.AutomationId="AdminBackup_RestoreExecute_Button"/>
                                <TextBlock Text="{Binding RestoreOperationStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminBackup_RestoreOperation_Status"/>
                                <TextBlock Text="Экспорт и восстановление по файловому пути отключены. Клиент не передаёт путь к файлам резервных копий." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Импорт / экспорт" AutomationProperties.AutomationId="AdminDataPortability_Tab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Dev Access + импорт / экспорт" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="Известные dev-аккаунты и переносимые пакеты доступны только администраторам. PlayerClient не показывает эти команды, пути пакетов и серверные файлы." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Обновить историю" Command="{Binding RefreshImportExportHistoryCommand}" IsEnabled="{Binding CanRun}" Margin="12,0,0,0"/>
                        </DockPanel>
                    </Border>
                    <TabControl Grid.Row="1">
                        <TabItem Header="Dev Access" AutomationProperties.AutomationId="AdminDevAccess_Tab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Известные dev-аккаунты" Style="{StaticResource SectionTitleTextStyle}"/>
                                            <TextBlock Text="{Binding DevAccessStatusText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="AdminDevAccess_StatusText"/>
                                            <WrapPanel Margin="0,10,0,8">
                                                <Button Content="Статус" Command="{Binding LoadDevAccessCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0"/>
                                                <Button Content="Сбросить dev-пароли" Command="{Binding ResetKnownAccountsCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminDevAccess_ResetKnownAccounts_Button"/>
                                                <Button Content="Показать учётные данные" Command="{Binding PrintKnownCredentialsCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminDevAccess_PrintCredentials_Button"/>
                                                <Button Content="Проверить вход" Command="{Binding VerifyKnownLoginCommand}" IsEnabled="{Binding CanRun}" AutomationProperties.AutomationId="AdminDevAccess_VerifyLogin_Button"/>
                                            </WrapPanel>
                                            <DataGrid ItemsSource="{Binding DevAccessAccounts}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220" AutomationProperties.AutomationId="AdminDevAccess_Status_List">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="1.1*"/>
                                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                                                    <DataGridTextColumn Header="Роли" Binding="{Binding Roles}" Width="1.2*"/>
                                                    <DataGridCheckBoxColumn Header="Есть" Binding="{Binding Exists}" Width="80"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Вывод учётных данных" Style="{StaticResource SectionTitleTextStyle}"/>
                                            <TextBlock Text="Показывается только после явного действия в тестовом режиме. Пароли не хранятся в базе данных открытым текстом." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding DevAccessCredentialsText, Mode=OneWay}" MinHeight="220" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Экспорт справочников" AutomationProperties.AutomationId="AdminExportDefinitions_Tab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Style="{StaticResource CardStyle}" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Экспорт справочников" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock Text="Экспортируются только справочники и конфигурационные коллекции. Аккаунты, хэши паролей и пользовательское runtime-состояние исключены." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Имя пакета" Margin="0,12,0,2"/>
                                        <TextBox Text="{Binding ExportDefinitionsPackageName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminExportDefinitions_PackageName"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Экспортировать справочники" Command="{Binding ExportDefinitionsCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminExportDefinitions_Button"/>
                                            <Button Content="Проверить пакет" Command="{Binding ValidateDefinitionsPackageCommand}" IsEnabled="{Binding CanRun}" AutomationProperties.AutomationId="AdminExportDefinitions_Verify_Button"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ExportDefinitionsStatusText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="AdminExportDefinitions_StatusText"/>
                                        <TextBox Text="{Binding ExportDefinitionsManifestPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="180" Margin="0,10,0,0" FontFamily="Consolas" AutomationProperties.AutomationId="AdminExportDefinitions_ManifestPreview"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Импорт справочников" AutomationProperties.AutomationId="AdminImportDefinitions_Tab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Style="{StaticResource CardStyle}" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Импорт справочников" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock Text="Validate/dry-run/merge импорт для справочников. Разрушительные операции не входят в этот MVP." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Путь к пакету" Margin="0,12,0,2"/>
                                        <TextBox Text="{Binding ImportDefinitionsPackagePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminImportDefinitions_PackagePath"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="Режим" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="120" Text="{Binding ImportDefinitionsMode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminImportDefinitions_Mode"/>
                                            <TextBlock Text="Подтверждение" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                            <TextBox Width="140" Text="{Binding ImportDefinitionsConfirmation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminImportDefinitions_Confirmation"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Проверить" Command="{Binding ValidateDefinitionsPackageCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminImportDefinitions_Validate_Button"/>
                                            <Button Content="Сухой прогон" Command="{Binding DryRunDefinitionsImportCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminImportDefinitions_DryRun_Button"/>
                                            <Button Content="Импортировать" Command="{Binding ImportDefinitionsCommand}" IsEnabled="{Binding CanRun}" AutomationProperties.AutomationId="AdminImportDefinitions_Import_Button"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ImportDefinitionsStatusText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="AdminImportDefinitions_StatusText"/>
                                        <TextBox Text="{Binding ImportDefinitionsPlannedChanges, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="220" Margin="0,10,0,0" FontFamily="Consolas" AutomationProperties.AutomationId="AdminImportDefinitions_PlannedChanges"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Экспорт данных кампании" AutomationProperties.AutomationId="AdminExportCampaign_Tab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Style="{StaticResource CardStyle}" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Экспорт данных кампании" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock Text="По умолчанию хэши и соли паролей аккаунтов редактируются. Пароли открытым текстом никогда не экспортируются." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Имя пакета" Margin="0,12,0,2"/>
                                        <TextBox Text="{Binding ExportCampaignPackageName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminExportCampaign_PackageName"/>
                                        <CheckBox Content="Явно включить чувствительные поля" IsChecked="{Binding ExportCampaignIncludeSensitive}" Margin="0,10,0,0" AutomationProperties.AutomationId="AdminExportCampaign_IncludeSensitive"/>
                                        <Button Content="Экспортировать данные кампании" Command="{Binding ExportCampaignDataCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0" AutomationProperties.AutomationId="AdminExportCampaign_Button"/>
                                        <TextBlock Text="{Binding ExportCampaignStatusText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="AdminExportCampaign_StatusText"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Импорт данных кампании" AutomationProperties.AutomationId="AdminImportCampaign_Tab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Style="{StaticResource CardStyle}" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Импорт данных кампании" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock Text="Merge-импорт ограничен явно разрешёнными безопасными коллекциями. Replace-режим заблокирован." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Путь к пакету" Margin="0,12,0,2"/>
                                        <TextBox Text="{Binding ImportCampaignPackagePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminImportCampaign_PackagePath"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="Режим" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="120" Text="{Binding ImportCampaignMode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminImportCampaign_Mode"/>
                                            <TextBlock Text="Подтверждение" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                            <TextBox Width="140" Text="{Binding ImportCampaignConfirmation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminImportCampaign_Confirmation"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Проверить" Command="{Binding ValidateCampaignPackageCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminImportCampaign_Validate_Button"/>
                                            <Button Content="Сухой прогон" Command="{Binding DryRunCampaignImportCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminImportCampaign_DryRun_Button"/>
                                            <Button Content="Импортировать" Command="{Binding ImportCampaignDataCommand}" IsEnabled="{Binding CanRun}" AutomationProperties.AutomationId="AdminImportCampaign_Import_Button"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ImportCampaignSafetyBackupId, StringFormat=Страховочная резервная копия: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" AutomationProperties.AutomationId="AdminImportCampaign_SafetyBackupId"/>
                                        <TextBlock Text="{Binding ImportCampaignStatusText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminImportCampaign_StatusText"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="История" AutomationProperties.AutomationId="AdminImportExportHistory_Tab">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>
                                <DataGrid ItemsSource="{Binding ExportRecords}" SelectedItem="{Binding SelectedExportRecord}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="AdminExportRecords_List">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Пакет" Binding="{Binding PackageName}" Width="1.4*"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid Grid.Column="1" ItemsSource="{Binding ImportRecords}" SelectedItem="{Binding SelectedImportRecord}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8,0,0,0" AutomationProperties.AutomationId="AdminImportRecords_List">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Пакет" Binding="{Binding PackageName}" Width="1.4*"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Детали выбранной записи" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBox Text="{Binding SelectedImportExportDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="360" FontFamily="Consolas" AutomationProperties.AutomationId="AdminImportExport_SelectedDetails"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Состояние сервера">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel>
                            <TextBlock Text="Состояние сервера" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshServerStatusCommand}" IsEnabled="{Binding CanRun}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding ServerStatusSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <DataGrid ItemsSource="{Binding ServerMetrics}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Показатель" Binding="{Binding Name}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="1*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Подключение и авторизация" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="{Binding ClientStatusSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="Подключение и авторизация управляются в верхней панели AdminClient. Этот экран не хранит и не показывает пароли или токены." TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Проверка справочников" AutomationProperties.AutomationId="AdminReferencePack_Tab">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Эталонный пакет" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding ReferencePackDisplayName}" FontWeight="SemiBold" Margin="0,8,0,0"
                                           AutomationProperties.AutomationId="AdminReferencePack_Name"/>
                                <TextBlock Text="{Binding ReferencePackVersion, StringFormat=Версия {0}}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="Связанный набор демонстрационных записей для справочников с безопасным повторным применением."
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                <Button Content="Предварительная проверка"
                                        Command="{Binding PreviewReferencePackCommand}"
                                        IsEnabled="{Binding CanRun}"
                                        Margin="0,14,0,0"
                                        AutomationProperties.AutomationId="AdminReferencePack_Preview_Button"/>
                                <Button Content="Обновить состояние"
                                        Command="{Binding RefreshReferencePackStatusCommand}"
                                        IsEnabled="{Binding CanRun}"
                                        Margin="0,6,0,0"
                                        AutomationProperties.AutomationId="AdminReferencePack_Status_Button"/>
                                <CheckBox Content="Я проверил план и подтверждаю применение"
                                          IsChecked="{Binding ReferencePackApplyConfirmed}"
                                          Margin="0,14,0,0"
                                          AutomationProperties.AutomationId="AdminReferencePack_ApplyConfirmation"/>
                                <Button Content="Применить пакет"
                                        Command="{Binding ApplyReferencePackCommand}"
                                        IsEnabled="{Binding CanRun}"
                                        Margin="0,6,0,0"
                                        AutomationProperties.AutomationId="AdminReferencePack_Apply_Button"/>

                                <TextBlock Text="{Binding ReferencePackValidation}" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0"
                                           AutomationProperties.AutomationId="AdminReferencePack_Validation"/>
                                <TextBlock Text="{Binding ReferencePackSummary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           AutomationProperties.AutomationId="AdminReferencePack_Summary"/>

                                <Expander Header="Техническая проверка локального пакета" Margin="0,18,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="Дополнительный режим только для разработчика. Записи не изменяются."
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding DefinitionPackPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,8,0,0"/>
                                        <Button Content="Проверить локальный пакет"
                                                Command="{Binding RunDefinitionDryRunCommand}"
                                                IsEnabled="{Binding CanRun}"
                                                Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding DefinitionDryRunSummary}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid ItemsSource="{Binding ReferencePackRecords}"
                                  SelectedItem="{Binding SelectedReferencePackRecord}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  AutomationProperties.AutomationId="AdminReferencePack_RecordsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Запись" Binding="{Binding DisplayName}" Width="1.5*"/>
                                <DataGridTextColumn Header="Раздел" Binding="{Binding Category}" Width="1.1*"/>
                                <DataGridTextColumn Header="Результат" Binding="{Binding Classification}" Width="1.2*"/>
                                <DataGridTextColumn Header="Связи" Binding="{Binding ReferenceCount}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Связи выбранной записи" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="{Binding SelectedReferencePackRecordSummary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               AutomationProperties.AutomationId="AdminReferencePack_SelectedReferences"/>
                                    <TextBlock Text="{Binding SelectedReferencePackRecord.Findings}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="Замечания проверки" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <ItemsControl ItemsSource="{Binding ReferencePackIssues}" Margin="0,8,0,0"
                                                  AutomationProperties.AutomationId="AdminReferencePack_Issues">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Диагностика инвентаря">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Диагностика инвентаря" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="Только чтение: раздел не выполняет исправление, ремонт, слияние и не меняет инвентарь." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="ID персонажа" Margin="0,10,0,2"/>
                            <TextBox Text="{Binding InventoryCharacterId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="ID набора правил" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding InventoryRuleSetId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="ID кампании" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding InventoryCampaignId, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Проверить инвентарь" Command="{Binding RunInventoryDiagnosticsCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding InventoryDiagnosticsSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.3*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding InventoryDiagnosticsSections}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Раздел" Binding="{Binding Name}" Width="1.4*"/>
                                <DataGridCheckBoxColumn Header="Корректно" Binding="{Binding IsValid}" Width="90"/>
                                <DataGridTextColumn Header="Ошибки" Binding="{Binding ErrorCount}" Width="90"/>
                                <DataGridTextColumn Header="Предупреждения" Binding="{Binding WarningCount}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryDiagnosticsIssues}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Важность" Binding="{Binding Severity}" Width="120"/>
                                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="160"/>
                                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Производительность" AutomationProperties.AutomationId="AdminPerformance_Tab">
                <Grid Margin="8" AutomationProperties.AutomationId="AdminPerformance_Root">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Производительность и стабильность" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding PerformanceSummary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="AdminPerformance_Summary"/>
                                <TextBlock Text="{Binding PerformanceWarnings}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           AutomationProperties.AutomationId="AdminPerformance_Warnings"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                <Button Content="Обновить" Command="{Binding RefreshPerformanceCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="AdminPerformance_Refresh_Button"/>
                                <Button Content="Экспортировать снимок" Command="{Binding ExportPerformanceSnapshotCommand}" IsEnabled="{Binding CanRun}"
                                        AutomationProperties.AutomationId="AdminPerformance_Export_Button"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding PerformanceServerMetrics}" AutoGenerateColumns="False" IsReadOnly="True"
                                  AutomationProperties.AutomationId="AdminPerformance_ServerMetrics">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Сервер" Binding="{Binding Name}" Width="1.2*"/>
                                <DataGridTextColumn Header="Сейчас" Binding="{Binding Value}" Width="1*"/>
                                <DataGridTextColumn Header="Пиковое значение" Binding="{Binding State}" Width="1.1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="1" ItemsSource="{Binding PerformanceClients}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8,0,0,0"
                                  AutomationProperties.AutomationId="AdminPerformance_ClientMetrics">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientType}" Width="1.1*"/>
                                <DataGridTextColumn Header="Подключено" Binding="{Binding Connected}" Width="85"/>
                                <DataGridTextColumn Header="Память" Binding="{Binding Memory}" Width="95"/>
                                <DataGridTextColumn Header="Пик" Binding="{Binding PeakMemory}" Width="95"/>
                                <DataGridTextColumn Header="CPU %" Binding="{Binding Cpu, StringFormat={}{0:0.##}}" Width="70"/>
                                <DataGridTextColumn Header="UI p95, мс" Binding="{Binding UiLagP95, StringFormat={}{0:0.##}}" Width="90"/>
                                <DataGridTextColumn Header="UI max, мс" Binding="{Binding UiLagMax, StringFormat={}{0:0.##}}" Width="90"/>
                                <DataGridTextColumn Header="Циклы" Binding="{Binding Pollers}" Width="65"/>
                                <DataGridTextColumn Header="Reconnect" Binding="{Binding ReconnectLoops}" Width="75"/>
                                <DataGridTextColumn Header="Refresh" Binding="{Binding InFlightRefreshes}" Width="65"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding PerformanceCommands}" AutoGenerateColumns="False" IsReadOnly="True"
                              AutomationProperties.AutomationId="AdminPerformance_CommandMetrics">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Команда" Binding="{Binding Command}" Width="1.8*"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="1*"/>
                            <DataGridTextColumn Header="Вызовы" Binding="{Binding Count}" Width="70"/>
                            <DataGridTextColumn Header="Ошибки" Binding="{Binding Errors}" Width="70"/>
                            <DataGridTextColumn Header="p50, мс" Binding="{Binding P50, StringFormat={}{0:0.##}}" Width="75"/>
                            <DataGridTextColumn Header="p95, мс" Binding="{Binding P95, StringFormat={}{0:0.##}}" Width="75"/>
                            <DataGridTextColumn Header="p99, мс" Binding="{Binding P99, StringFormat={}{0:0.##}}" Width="75"/>
                            <DataGridTextColumn Header="Макс., мс" Binding="{Binding Maximum}" Width="80"/>
                            <DataGridTextColumn Header="Запрос" Binding="{Binding LargestRequestText}" Width="85"/>
                            <DataGridTextColumn Header="Ответ" Binding="{Binding LargestResponseText}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
