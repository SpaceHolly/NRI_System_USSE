<UserControl x:Class="Nri.AdminClient.Views.Notes.AdminGMNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.AdminClient.ViewModels"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="AdminGmNotes_Tab">
    <patterns:NriOperationalWorkspaceHost AutomationProperties.AutomationId="AdminGmNotes_OperationalHost">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Margin="8,8,8,6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Заметки GM" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="Закрытое рабочее пространство ведущего. Игроки не получают эти данные." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Expander Header="Дополнительно" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Технический контекст кампании" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="150" AutomationProperties.AutomationId="AdminGmNotes_Advanced_CampaignId" Text="{Binding CampaignId, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Технический ключ кампании"/>
                        </StackPanel>
                    </Expander>
                    <Button Style="{StaticResource GhostButtonStyle}" Content="Проверить доступность" Command="{Binding RefreshFlagsCommand}"/>
                    <Button AutomationProperties.AutomationId="AdminGmNotes_Refresh_Button" Content="Обновить" Command="{Binding RefreshCommand}" Margin="6,0,0,0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="8,0,8,6">
            <StackPanel>
                <TextBlock AutomationProperties.AutomationId="AdminGmNotes_StatusText" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Список заметок" Style="{StaticResource SectionTitleTextStyle}"/>
                    <StackPanel Grid.Row="1" Margin="0,8,0,8">
                        <TextBox AutomationProperties.AutomationId="AdminGmNotes_Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по заметкам GM"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource GhostButtonStyle}" Content="Найти" Command="{Binding SearchCommand}" IsEnabled="{Binding SearchEnabled}"/>
                            <Button Style="{StaticResource GhostButtonStyle}" Content="Список" Command="{Binding RefreshCommand}" Margin="6,0,0,0"/>
                            <CheckBox AutomationProperties.AutomationId="AdminGmNotes_IncludeArchived" Content="Архив" IsChecked="{Binding IncludeArchived}" Margin="10,2,0,0"/>
                            <CheckBox AutomationProperties.AutomationId="AdminGmNotes_QuickOnly" Content="Только быстрые" IsChecked="{Binding QuickOnly}" Margin="10,2,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                    <ListBox AutomationProperties.AutomationId="AdminGmNotes_List" Grid.Row="2" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" DisplayMemberPath="Preview" MinHeight="320"/>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="Папки" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Preview" MinHeight="90" IsEnabled="{Binding FoldersEnabled}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Карточка заметки" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="Заголовок" Margin="0,8,0,2"/>
                        <TextBox AutomationProperties.AutomationId="AdminGmNotes_Title" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Тип"/>
                                <ComboBox ItemsSource="{Binding NoteTypeOptions}" SelectedItem="{Binding NoteType}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Видимость"/>
                                <ComboBox AutomationProperties.AutomationId="AdminGmNotes_Filter_Scope" ItemsSource="{Binding VisibilityOptions}" SelectedItem="{Binding VisibilityMode}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Приоритет" Margin="0,8,0,2"/>
                        <ComboBox AutomationProperties.AutomationId="AdminGmNotes_Priority"
                                  ItemsSource="{Binding PriorityOptions}"
                                  SelectedItem="{Binding Priority}"
                                  Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"/>
                        <Expander Header="Дополнительно: технический контекст" Margin="0,8,0,0">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Сессия"/>
                                    <TextBox AutomationProperties.AutomationId="AdminGmNotes_Advanced_SessionId" Text="{Binding SessionId, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Технический ключ сессии"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Область"/>
                                    <ComboBox AutomationProperties.AutomationId="AdminGmNotes_ScopeType"
                                              ItemsSource="{Binding EntityTypeOptions}"
                                              SelectedItem="{Binding ScopeType}"
                                              Text="{Binding ScopeType, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="Технический ключ объекта"/>
                                    <TextBox AutomationProperties.AutomationId="AdminGmNotes_ScopeId"
                                             Text="{Binding ScopeEntityId, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                    <TextBlock Text="Понятное имя объекта"/>
                                    <TextBox Text="{Binding ScopeDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </Expander>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Expander Header="Техническая папка">
                                <TextBox AutomationProperties.AutomationId="AdminGmNotes_Advanced_FolderId" Text="{Binding FolderId, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Технический ключ папки" Margin="0,4,0,0"/>
                            </Expander>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Теги"/>
                                <TextBox AutomationProperties.AutomationId="AdminGmNotes_Tags" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Через запятую"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Краткое описание" Margin="0,8,0,2"/>
                        <TextBox Text="{Binding PublicSummary, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                        <TextBlock Text="Текст заметки" Margin="0,8,0,2"/>
                        <TextBox AutomationProperties.AutomationId="AdminGmNotes_Body" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" VerticalScrollBarVisibility="Auto"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Добавить быструю" Command="{Binding CreateQuickCommand}" IsEnabled="{Binding QuickEnabled}"/>
                            <Button AutomationProperties.AutomationId="AdminGmNotes_Create_Button" Content="Создать" Command="{Binding CreateCommand}" Margin="6,0,0,0"/>
                            <Button AutomationProperties.AutomationId="AdminGmNotes_Save_Button" Content="Сохранить" Command="{Binding SaveCommand}" Margin="6,0,0,0"/>
                            <Button AutomationProperties.AutomationId="AdminGmNotes_Pin_Button" Style="{StaticResource GhostButtonStyle}" Content="Закрепить" Command="{Binding PinCommand}" Margin="6,0,0,0"/>
                            <Button AutomationProperties.AutomationId="AdminGmNotes_Unpin_Button" Style="{StaticResource GhostButtonStyle}" Content="Снять" Command="{Binding UnpinCommand}" Margin="6,0,0,0"/>
                            <Button AutomationProperties.AutomationId="AdminGmNotes_Archive_Button" Style="{StaticResource GhostButtonStyle}" Content="Архив" Command="{Binding ArchiveCommand}" Margin="6,0,0,0"/>
                            <Button Style="{StaticResource GhostButtonStyle}" Content="Восстановить" Command="{Binding RestoreCommand}" Margin="6,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Папки и привязки" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="Папка" FontWeight="SemiBold" Margin="0,8,0,2"/>
                        <TextBox Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название папки" IsEnabled="{Binding FoldersEnabled}"/>
                        <TextBox Text="{Binding FolderDescription, UpdateSourceTrigger=PropertyChanged}" ToolTip="Описание папки" Margin="0,4,0,0" IsEnabled="{Binding FoldersEnabled}"/>
                        <Expander Header="Дополнительно: родительская папка" Margin="0,4,0,0">
                            <TextBox AutomationProperties.AutomationId="AdminGmNotes_Advanced_ParentFolderId" Text="{Binding FolderParentId, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Технический ключ родительской папки"
                                     Margin="0,4,0,0"
                                     IsEnabled="{Binding FoldersEnabled}"/>
                        </Expander>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource GhostButtonStyle}" Content="Создать папку" Command="{Binding FolderCreateCommand}" IsEnabled="{Binding FoldersEnabled}"/>
                            <Button Style="{StaticResource GhostButtonStyle}" Content="Сохранить папку" Command="{Binding FolderUpdateCommand}" Margin="6,0,0,0" IsEnabled="{Binding FoldersEnabled}"/>
                            <Button Style="{StaticResource GhostButtonStyle}" Content="Архив папки" Command="{Binding FolderArchiveCommand}" Margin="6,0,0,0" IsEnabled="{Binding FoldersEnabled}"/>
                        </WrapPanel>

                        <Expander Header="Дополнительно: ручные привязки" Margin="0,12,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding EntityTypeOptions}" SelectedItem="{Binding LinkEntityType}" IsEnabled="{Binding LinksEnabled}"/>
                                <TextBox AutomationProperties.AutomationId="AdminGmNotes_Advanced_LinkEntityId" Text="{Binding LinkEntityId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Технический ключ объекта" Margin="0,4,0,0" IsEnabled="{Binding LinksEnabled}"/>
                                <TextBox Text="{Binding LinkDisplayName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Понятное имя объекта" Margin="0,4,0,0" IsEnabled="{Binding LinksEnabled}"/>
                                <ComboBox ItemsSource="{Binding LinkRoleOptions}" SelectedItem="{Binding LinkRole}" Margin="0,4,0,0" IsEnabled="{Binding LinksEnabled}"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource GhostButtonStyle}" Content="Добавить привязку" Command="{Binding LinkAddCommand}" IsEnabled="{Binding LinksEnabled}"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Content="Убрать" Command="{Binding LinkRemoveCommand}" Margin="6,0,0,0" IsEnabled="{Binding LinksEnabled}"/>
                                </WrapPanel>
                                <ListBox ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}" DisplayMemberPath="Preview" MinHeight="100" Margin="0,6,0,0" IsEnabled="{Binding LinksEnabled}"/>
                            </StackPanel>
                        </Expander>

                        <Separator Margin="0,12,0,8"/>
                        <DockPanel>
                            <TextBlock Text="Аудит" FontWeight="SemiBold"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="Обновить" Command="{Binding AuditRefreshCommand}" IsEnabled="{Binding AuditEnabled}"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding AuditRows}" DisplayMemberPath="Preview" MinHeight="110" Margin="0,6,0,0" IsEnabled="{Binding AuditEnabled}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="Player Notes остаются локальными в карточке персонажа. GM Notes не отправляются в PlayerClient." Margin="12,0,12,8" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
