<UserControl x:Class="Nri.AdminClient.Views.Dashboard.AdminFunctionalDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#FF172033" BorderBrush="#334C6A88" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Пульт Гейм-мастера" Foreground="#FFF8FAFC" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#FF9CA3AF" TextWrapping="Wrap" Margin="0,4,0,0"
                                   AutomationProperties.AutomationId="AdminDashboard_Status"/>
                        <TextBlock Text="{Binding LastRefreshText, StringFormat=Обновлено: {0}}" Foreground="#FF9CA3AF" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" MinWidth="110" Padding="12,6"
                            AutomationProperties.AutomationId="AdminDashboard_Refresh"/>
                </Grid>
            </Border>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Metrics}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF1F2937" BorderBrush="#334C6A88" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="#FFCBD5E1" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Value}" Foreground="#FFF8FAFC" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Hint}" Foreground="#FF9CA3AF" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#FF172033" BorderBrush="#334C6A88" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Активные процессы" Foreground="#FFF8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding ActiveProcesses}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF111827" BorderBrush="#263B82F6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Type}" Foreground="#FF93C5FD" FontWeight="SemiBold"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}" Foreground="#FFF8FAFC" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#FFF8FAFC" FontSize="15" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#FFCBD5E1"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="#FF9CA3AF" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="#FF172033" BorderBrush="#334C6A88" BorderThickness="1" CornerRadius="6" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Следующие действия" Foreground="#FFF8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#FFFBBF24" TextWrapping="Wrap" FontSize="11"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding NextActions}" Background="Transparent" BorderThickness="0"
                                 AutomationProperties.AutomationId="AdminDashboard_NextActions">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF111827" BorderBrush="#334C6A88" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#FFF8FAFC" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Subject}" Foreground="#FFCBD5E1" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Priority, StringFormat=Приоритет: {0}}" Foreground="#FF9CA3AF"/>
                                            <TextBlock Text="{Binding ActionLabel}" Foreground="#FF93C5FD" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
