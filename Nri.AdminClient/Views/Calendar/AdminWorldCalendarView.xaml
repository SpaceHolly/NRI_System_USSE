<UserControl x:Class="Nri.AdminClient.Views.Calendar.AdminWorldCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             Loaded="OnLoaded"
             Language="ru-RU">
    <Grid Margin="8" AutomationProperties.AutomationId="AdminWorldCalendar_Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
                <controls:NriRouteStateHost Grid.Row="1" State="{Binding RouteState, Mode=OneWay}" ActiveStates="loading,empty,no-results,no-selection,error,permission" Panel.ZIndex="10" AutomationProperties.AutomationId="AdminWorldCalendar_StateHost">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="loading"><controls:NriLoadingOverlay IsLoading="True" ProgressText="Загрузка календаря…" AutomationProperties.AutomationId="AdminWorldCalendar_Loading"/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="empty"><controls:NriEmptyState AutomationProperties.AutomationId="AdminWorldCalendar_EmptyState" Title="Событий пока нет" Message="Создайте первое событие хроники."/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="no-results"><controls:NriEmptyState AutomationProperties.AutomationId="AdminWorldCalendar_NoResults" Title="Ничего не найдено" Message="Измените фильтры хроники."/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="no-selection"><TextBlock Text="Событие не выбрано." AutomationProperties.AutomationId="AdminWorldCalendar_NoSelection"/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="permission"><controls:NriPermissionState AutomationProperties.AutomationId="AdminWorldCalendar_Permission" Explanation="{Binding PermissionState}"/></controls:NriRouteStatePresenter>
                <controls:NriRouteStatePresenter State="{Binding RouteState}" VisibleFor="error"><TextBlock AutomationProperties.AutomationId="AdminWorldCalendar_Error" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/></controls:NriRouteStatePresenter>
            </StackPanel>
        </controls:NriRouteStateHost>

        <controls:NriPageHeader Grid.Row="0"
                                Title="Календарь мира и хроника"
                                Subtitle="Внутриигровое время, события, праздники и заметки мастера."
                                StatusText="{Binding StatusMessage}"
                                AutomationProperties.AutomationId="AdminWorldCalendar_Header"
                                Margin="0,0,0,8">
            <controls:NriPageHeader.PrimaryAction>
                <Button Content="Обновить" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="AdminWorldCalendar_Refresh_Button"/>
            </controls:NriPageHeader.PrimaryAction>
            <controls:NriPageHeader.SecondaryActions>
                <WrapPanel>
                    <controls:NriStatusBadge Text="{Binding UnsavedChangesSummary}"
                                             StatusKind="Warning"
                                             Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.AutomationId="AdminWorldCalendar_Unsaved"/>
                    <controls:NriStatusBadge Text="{Binding ValidationSummary}"
                                             StatusKind="Danger"
                                             Margin="6,0,0,0"
                                             Visibility="{Binding HasValidationIssues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.AutomationId="AdminWorldCalendar_Validation"/>
                    <controls:NriToastHost Message="{Binding StatusMessage}"
                                           IsOpen="{Binding HasStatusMessage}"
                                           Margin="6,0,0,0"
                                           AutomationProperties.AutomationId="AdminWorldCalendar_Success"/>
                    <Button Content="Создать базовый календарь" Style="{StaticResource GhostButtonStyle}" Command="{Binding EnsureCalendarCommand}" AutomationProperties.AutomationId="AdminWorldCalendar_Ensure_Button"/>
                    <Button Content="Обновить функции" Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshFlagsCommand}" Margin="6,0,0,0"/>
                </WrapPanel>
            </controls:NriPageHeader.SecondaryActions>
        </controls:NriPageHeader>

        <TabControl Grid.Row="1" AutomationProperties.AutomationId="AdminWorldCalendar_Tabs">
            <TabItem Header="Текущая дата">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding CalendarName}" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="{Binding CurrentDisplay}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminWorldCalendar_CurrentDisplay"/>
                            <TextBlock Text="{Binding CurrentSeason, StringFormat=Сезон: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding CurrentWeekDay, StringFormat=День недели: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,12"/>
                            <TextBlock Text="Месяцы" FontWeight="SemiBold"/>
                            <ListBox ItemsSource="{Binding Months}" MinHeight="220" Margin="0,6,0,0" AutomationProperties.AutomationId="AdminWorldCalendar_Months_List">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Управление датой" Style="{StaticResource SectionTitleTextStyle}"/>
                            <UniformGrid Columns="6" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Год"/><controls:NriIntegerField Value="{Binding Year, UpdateSourceTrigger=PropertyChanged}" AccessibleName="Год" AutomationProperties.AutomationId="AdminWorldCalendar_Year" Minimum="1"/></StackPanel>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Эра"/><ComboBox ItemsSource="{Binding EraOptions}" SelectedItem="{Binding SelectedEra, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminWorldCalendar_BeforeEra"/></StackPanel>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Месяц"/><ComboBox ItemsSource="{Binding Months}" DisplayMemberPath="Display" SelectedValuePath="Order" SelectedValue="{Binding MonthOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AdminWorldCalendar_Month"/></StackPanel>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="День"/><controls:NriIntegerField Value="{Binding DayOfMonth, UpdateSourceTrigger=PropertyChanged}" AccessibleName="День" AutomationProperties.AutomationId="AdminWorldCalendar_Day" Minimum="1" Maximum="31"/></StackPanel>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Час"/><controls:NriIntegerField Value="{Binding Hour, UpdateSourceTrigger=PropertyChanged}" AccessibleName="Час" AutomationProperties.AutomationId="AdminWorldCalendar_Hour" Minimum="0" Maximum="23"/></StackPanel>
                                <StackPanel><TextBlock Text="Минута"/><controls:NriIntegerField Value="{Binding Minute, UpdateSourceTrigger=PropertyChanged}" AccessibleName="Минута" AutomationProperties.AutomationId="AdminWorldCalendar_Minute" Minimum="0" Maximum="59"/></StackPanel>
                            </UniformGrid>
                            <TextBox Text="{Binding AdvanceReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" ToolTip="Причина изменения"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Установить дату" Command="{Binding SetDateCommand}" AutomationProperties.AutomationId="AdminWorldCalendar_SetDate_Button"/>
                                <Button Content="Продвинуть" Style="{StaticResource GhostButtonStyle}" Command="{Binding AdvanceTimeCommand}" AutomationProperties.AutomationId="AdminWorldCalendar_Advance_Button"/>
                                <controls:NriDurationField Width="150" Amount="{Binding AdvanceDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Unit="days" MinimumMinutes="1" AccessibleName="Длительность" Margin="8,0,0,0" ToolTip="Длительность продвижения"/>
                            </WrapPanel>
                            <Border Style="{StaticResource SubtleCardStyle}" Padding="10" Margin="0,12,0,0">
                                <TextBlock Text="Расписание реальных игр и техработ подключено в соседней вкладке «Расписание игр». Эта вкладка меняет внутриигровое время мира." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Хроника" AutomationProperties.AutomationId="AdminWorldCalendar_Chronicle_Tab">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,8,0">
                        <TextBox DockPanel.Dock="Top"
                                 Text="{Binding EventSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по названию, типу и статусу события"
                                 Margin="0,0,0,8"
                                 AutomationProperties.AutomationId="AdminWorldCalendar_Event_Search"/>
                        <DataGrid ItemsSource="{Binding FilteredEvents}" SelectedItem="{Binding SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="420" AutomationProperties.AutomationId="AdminWorldCalendar_Events_List">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding StartDisplay}" Width="1.4*"/>
                                <DataGridTextColumn Header="Событие" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding EventTypeDisplay}" Width="1*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="1*"/>
                                <DataGridCheckBoxColumn Header="Игрокам" Binding="{Binding IsPlayerVisible}" Width="0.8*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Событие" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBox Text="{Binding EventTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название" AutomationProperties.AutomationId="AdminWorldCalendar_Event_Title"/>
                                <TextBlock Text="{Binding ValidationSummary}"
                                           Foreground="{StaticResource DangerBrush}"
                                           Visibility="{Binding HasValidationIssues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           TextWrapping="Wrap"/>
                                <TextBox Text="{Binding EventSummary, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6,0,0" ToolTip="Публичное описание" AutomationProperties.AutomationId="AdminWorldCalendar_Event_PublicSummary"/>
                                <TextBox Text="{Binding EventGmSummary, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6,0,0" ToolTip="Заметка GM" AutomationProperties.AutomationId="AdminWorldCalendar_Event_GmSummary"/>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <ComboBox ItemsSource="{Binding EventTypeOptions}" SelectedItem="{Binding EventType}" AutomationProperties.AutomationId="AdminWorldCalendar_Event_Type"/>
                                    <ComboBox ItemsSource="{Binding EventStatusOptions}" SelectedItem="{Binding EventStatus}" AutomationProperties.AutomationId="AdminWorldCalendar_Event_Status"/>
                                </UniformGrid>
                                <ComboBox ItemsSource="{Binding RevealPolicyOptions}" SelectedItem="{Binding EventRevealPolicy}" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminWorldCalendar_Event_RevealPolicy"/>
                                <controls:NriDurationField Amount="{Binding EventDurationMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Unit="minutes" MinimumMinutes="1" AccessibleName="Длительность события" AutomationProperties.AutomationId="AdminWorldCalendar_Event_Duration" Margin="0,8,0,0"/>
                                <TextBlock Text="Участники" Margin="0,8,0,2"/>
                                <controls:NriMultiReferencePicker AutomationIdPrefix="AdminWorldCalendar_Event_Participants" Options="{Binding ChronicleParticipantOptions}" SelectedId="{Binding SelectedParticipantId, UpdateSourceTrigger=PropertyChanged}" SelectedReferences="{Binding SelectedParticipantReferences}" ToolTip="Выберите участников события по отображаемому имени"/>
                                <TextBlock Text="Локация" Margin="0,8,0,2"/>
                                <controls:NriReferencePicker AutomationIdPrefix="AdminWorldCalendar_Event_Location" AutomationProperties.Name="Локация события" Options="{Binding ChronicleLocationOptions}" SelectedId="{Binding SelectedLocationId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Выберите локацию события по отображаемому имени"/>
                                <TextBlock AutomationProperties.AutomationId="AdminWorldCalendar_Unsaved_Status" Text="{Binding UnsavedChangesSummary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                <CheckBox Content="Видно игрокам" IsChecked="{Binding EventPlayerVisible}" Margin="0,8,0,0" AutomationProperties.AutomationId="AdminWorldCalendar_Event_PlayerVisible"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Создать" Command="{Binding CreateEventCommand}" IsEnabled="{Binding CanSaveEventDraft}" AutomationProperties.AutomationId="AdminWorldCalendar_Event_Create_Button"/>
                                    <Button Content="Сохранить" Style="{StaticResource GhostButtonStyle}" Command="{Binding UpdateEventCommand}" IsEnabled="{Binding CanSaveEventDraft}" AutomationProperties.AutomationId="AdminWorldCalendar_Event_Save_Button"/>
                                    <Button Content="Отменить" Style="{StaticResource GhostButtonStyle}" Command="{Binding CancelEventCommand}" AutomationProperties.AutomationId="AdminWorldCalendar_Event_Cancel_Button"/>
                                    <Button Content="Архив" Style="{StaticResource GhostButtonStyle}" Command="{Binding ArchiveEventCommand}"/>
                                </WrapPanel>
                                <Separator Margin="0,12,0,8"/>
                                <TextBlock Text="Версия события" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding VersionTypeOptions}" SelectedItem="{Binding VersionType}" Margin="0,6,0,0"/>
                                <TextBox Text="{Binding VersionSummary, UpdateSourceTrigger=PropertyChanged}" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6,0,0"/>
                                <CheckBox Content="Версия видна игрокам" IsChecked="{Binding VersionPlayerVisible}" Margin="0,6,0,0"/>
                                <Button Content="Добавить версию" Style="{StaticResource GhostButtonStyle}" Command="{Binding AddVersionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Праздники">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Holidays}" SelectedItem="{Binding SelectedHoliday}" Margin="0,0,8,0" MinHeight="420">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Праздник" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBox Text="{Binding HolidayName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Text="{Binding HolidayDescription, UpdateSourceTrigger=PropertyChanged}" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6,0,0"/>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <ComboBox ItemsSource="{Binding Months}" DisplayMemberPath="Display" SelectedValuePath="Order" SelectedValue="{Binding HolidayMonth, UpdateSourceTrigger=PropertyChanged}" ToolTip="Месяц"/>
                                <controls:NriIntegerField Value="{Binding HolidayDay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="31" AccessibleName="День праздника" ToolTip="День"/>
                            </UniformGrid>
                            <CheckBox Content="Видно игрокам" IsChecked="{Binding HolidayPlayerVisible}" Margin="0,8,0,0"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Создать" Command="{Binding CreateHolidayCommand}"/>
                                <Button Content="Архивировать" Style="{StaticResource GhostButtonStyle}" Command="{Binding ArchiveHolidayCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Напоминания GM">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Reminders}" SelectedItem="{Binding SelectedReminder}" Margin="0,0,8,0" MinHeight="420">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Notes}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Локальная для GM память кампании" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBox Text="{Binding ReminderTitle, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Text="{Binding ReminderNotes, UpdateSourceTrigger=PropertyChanged}" MinHeight="90" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Создать" Command="{Binding CreateReminderCommand}"/>
                                <Button Content="Закрыть" Style="{StaticResource GhostButtonStyle}" Command="{Binding DismissReminderCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Расписание">
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Реальное расписание" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{Binding RealSchedulePlaceholder}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock AutomationProperties.AutomationId="AdminWorldCalendar_Permission_State" Text="{Binding PermissionState}" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>
            <Expander Header="Дополнительные параметры кампании" AutomationProperties.AutomationId="AdminWorldCalendar_AdvancedParameters" IsExpanded="False">
                <Border Style="{StaticResource SubtleCardStyle}" Padding="8" Margin="0,4,0,0">
                    <WrapPanel>
                        <StackPanel Width="190" Margin="0,0,8,0">
                            <TextBlock Text="Кампания" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding CampaignId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Техническая привязка календаря к кампании" AutomationProperties.AutomationId="AdminWorldCalendar_Advanced_CampaignId"/>
                        </StackPanel>
                        <StackPanel Width="190">
                            <TextBlock Text="Профиль правил" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding RuleSetId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Профиль правил для календаря" AutomationProperties.AutomationId="AdminWorldCalendar_Advanced_RuleSetId"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </Expander>
            <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,8,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Очистить ошибку" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearErrorCommand}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
