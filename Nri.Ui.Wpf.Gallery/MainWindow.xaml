<Window x:Class="Nri.Ui.Wpf.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
        xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
        Title="NRI UI Design System Gallery" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" AutomationProperties.AutomationId="NriUiGallery_MainWindow">
    <DockPanel Background="{StaticResource NriApplicationBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{StaticResource NriPrimarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="NRI UI Design System" Style="{StaticResource NriCardTitleTextStyle}"/><TextBlock Text="Human-centered WPF foundation · simulated scale is not an OS DPI test" Style="{StaticResource NriMetadataTextStyle}"/></StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox x:Name="DensitySelector" Width="150" SelectedIndex="0" SelectionChanged="DensitySelector_OnSelectionChanged" AutomationProperties.AutomationId="Gallery_DensitySelector"><ComboBoxItem Content="Admin density"/><ComboBoxItem Content="Player density"/></ComboBox>
                    <ComboBox x:Name="ViewportSelector" Width="155" SelectedIndex="1" SelectionChanged="ViewportSelector_OnSelectionChanged" AutomationProperties.AutomationId="Gallery_ViewportSelector"><ComboBoxItem Content="1366 × 768"/><ComboBoxItem Content="1920 × 1080"/></ComboBox>
                    <ComboBox x:Name="ScaleSelector" Width="160" SelectedIndex="0" SelectionChanged="ScaleSelector_OnSelectionChanged" AutomationProperties.AutomationId="Gallery_ScaleSelector"><ComboBoxItem Content="100% layout"/><ComboBoxItem Content="125% simulated"/><ComboBoxItem Content="150% simulated"/></ComboBox>
                    <CheckBox x:Name="LongTextToggle" Content="Длинный русский текст" VerticalAlignment="Center" Margin="12,0" Checked="LongTextToggle_OnChanged" Unchecked="LongTextToggle_OnChanged" AutomationProperties.AutomationId="Gallery_LongTextToggle"/>
                </WrapPanel>
            </Grid>
        </Border>

        <TabControl x:Name="GalleryTabs" TabStripPlacement="Left" Margin="16" AutomationProperties.AutomationId="Gallery_Navigation">
            <TabItem Header="Tokens" AutomationProperties.AutomationId="Gallery_Tokens_Tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TokensPage" Margin="24" MaxWidth="1180" HorizontalAlignment="Left">
                    <controls:NriPageHeader Breadcrumbs="Design System / Foundation" Title="Design tokens" Subtitle="Semantic colors, spacing and dimensions used by all new WPF screens." StatusText="Foundation"/>
                    <TextBlock Text="Semantic colors" Style="{StaticResource NriSectionTitleTextStyle}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Border Style="{StaticResource GalleryCardStyle}" Width="220"><StackPanel><Border Background="{StaticResource NriApplicationBackgroundBrush}" Height="72"/><TextBlock Text="Application Background" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GalleryCardStyle}" Width="220"><StackPanel><Border Background="{StaticResource NriPrimarySurfaceBrush}" Height="72"/><TextBlock Text="Primary Surface" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GalleryCardStyle}" Width="220"><StackPanel><Border Background="{StaticResource NriAccentBrush}" Height="72"/><TextBlock Text="Accent" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GalleryCardStyle}" Width="220"><StackPanel><Border Background="{StaticResource NriSuccessBrush}" Height="72"/><TextBlock Text="Success" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GalleryCardStyle}" Width="220"><StackPanel><Border Background="{StaticResource NriWarningBrush}" Height="72"/><TextBlock Text="Warning" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource GalleryCardStyle}" Width="220"><StackPanel><Border Background="{StaticResource NriDangerBrush}" Height="72"/><TextBlock Text="Danger" Margin="0,8,0,0"/></StackPanel></Border>
                    </WrapPanel>
                    <TextBlock Text="Spacing and interaction sizes" Style="{StaticResource NriSectionTitleTextStyle}" Margin="0,12,0,12"/>
                    <Border Style="{StaticResource GalleryCardStyle}"><StackPanel><TextBlock Text="Space: 2 · 4 · 8 · 12 · 16 · 24 · 32 · 48"/><TextBlock Text="Controls: 32 · 40 · 48 px" Margin="0,6,0,0"/></StackPanel></Border>
                    <TextBlock Text="Typography preview" Style="{StaticResource NriSectionTitleTextStyle}" Margin="0,12,0,12"/>
                    <Border Style="{StaticResource GalleryCardStyle}" AutomationProperties.AutomationId="Gallery_TokensTypographySample"><StackPanel><TextBlock Text="Заголовок страницы" Style="{StaticResource NriPageTitleTextStyle}"/><TextBlock Text="Заголовок раздела" Style="{StaticResource NriSectionTitleTextStyle}"/><TextBlock Text="Основной и вторичный текст используют стабильную иерархию." Style="{StaticResource NriBodyTextStyle}" Margin="0,8,0,0"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Typography" AutomationProperties.AutomationId="Gallery_Typography_Tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="950" HorizontalAlignment="Left">
                    <controls:NriPageHeader Breadcrumbs="Design System / Foundation" Title="Typography" Subtitle="A restrained hierarchy for dense tools and calm player views."/>
                    <Border Style="{StaticResource GalleryCardStyle}"><StackPanel><TextBlock Text="Заголовок страницы" Style="{StaticResource NriPageTitleTextStyle}"/><TextBlock Text="Заголовок раздела" Style="{StaticResource NriSectionTitleTextStyle}" Margin="0,18,0,0"/><TextBlock Text="Заголовок карточки" Style="{StaticResource NriCardTitleTextStyle}" Margin="0,16,0,0"/><TextBlock x:Name="BodyTextSample" Text="Основной текст объясняет содержание простыми словами и помогает принять решение." Style="{StaticResource NriBodyTextStyle}" Margin="0,12,0,0"/><TextBlock Text="Вторичный текст содержит полезный контекст." Style="{StaticResource NriSecondaryTextStyle}" Margin="0,10,0,0"/><TextBlock Text="Метаданные · изменено сегодня, 21:40" Style="{StaticResource NriMetadataTextStyle}" Margin="0,8,0,0"/><TextBlock Text="Technical information is reserved for diagnostics." Style="{StaticResource NriTechnicalTextStyle}" Margin="0,8,0,0"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Buttons and Commands" AutomationProperties.AutomationId="Gallery_Buttons_Tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="1050" HorizontalAlignment="Left">
                    <controls:NriPageHeader Breadcrumbs="Components / Commands" Title="Buttons and commands" Subtitle="One visible primary action, grouped secondary commands and isolated destructive actions."/>
                    <controls:NriCommandBar AutomationProperties.AutomationId="Gallery_CommandBar"><controls:NriCommandBar.PrimaryActions><StackPanel Orientation="Horizontal"><Button Content="Сохранить" AutomationProperties.AutomationId="Gallery_Save_Button"/><Button Content="Создать" Margin="8,0,0,0"/></StackPanel></controls:NriCommandBar.PrimaryActions><controls:NriCommandBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Content="Клонировать" Style="{StaticResource NriSecondaryButtonStyle}"/><Button Content="Предпросмотр" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="Недоступно" IsEnabled="False" ToolTip="Сначала выберите запись" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></controls:NriCommandBar.SecondaryActions><controls:NriCommandBar.DestructiveActions><Button Content="Архивировать" Style="{StaticResource NriDangerButtonStyle}" Click="ArchiveButton_OnClick" Tag="RequiresConfirmation" AutomationProperties.AutomationId="Gallery_Archive_Button"/></controls:NriCommandBar.DestructiveActions></controls:NriCommandBar>
                    <controls:NriConfirmationDialog x:Name="ConfirmationDialog" IsOpen="False" Title="Архивировать запись?" TargetName="Северный дозор" Message="Запись исчезнет из обычных списков, но её можно будет восстановить." RequiresReason="True" ConfirmCommand="{Binding ConfirmArchiveCommand}" CancelCommand="{Binding CancelArchiveCommand}" Margin="0,18,0,0" AutomationProperties.AutomationId="Gallery_ConfirmationDialog"/>
                    <controls:NriToastHost x:Name="ConfirmationToast" IsOpen="False" Message="Запись отправлена в архив" Margin="0,12,0,0" AutomationProperties.AutomationId="Gallery_ConfirmationToast"/>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Inputs and Form Fields" AutomationProperties.AutomationId="Gallery_Inputs_Tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="850" HorizontalAlignment="Left">
                    <controls:NriPageHeader Breadcrumbs="Components / Forms" Title="Inputs and form fields" Subtitle="Labels, intent and validation remain visible next to the field."/>
                    <controls:NriFormField Label="Название" HelpText="Короткое имя, которое увидят мастер и игроки." IsRequired="True"><TextBox Text="Северный дозор" AutomationProperties.Name="Название записи"/></controls:NriFormField>
                    <controls:NriFormField Label="Категория" HelpText="Используется для группировки в справочнике."><ComboBox SelectedIndex="0"><ComboBoxItem Content="Организация"/><ComboBoxItem Content="Фракция"/><ComboBoxItem Content="Локация"/></ComboBox></controls:NriFormField>
                    <controls:NriFormField Label="Краткое описание" WarningText="Игроки увидят этот текст. Не добавляйте сведения мастера."><TextBox Text="Пограничная стража северных перевалов." AcceptsReturn="True" Height="76"/></controls:NriFormField>
                    <controls:NriFormField Label="Код" ErrorText="Код уже используется другой записью." IsRequired="True"><TextBox Text="north_watch"/></controls:NriFormField>
                    <controls:NriValidationSummary Title="Найдены ошибки" AutomationProperties.AutomationId="Gallery_ValidationSummary"><sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Исправьте уникальный код записи.</sys:String><sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Проверьте видимость связанного объекта.</sys:String></controls:NriValidationSummary>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Semantic Inputs" AutomationProperties.AutomationId="Gallery_SemanticInputs_Tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left">
                    <controls:NriPageHeader Breadcrumbs="Components / Forms" Title="Semantic input controls" Subtitle="Foundation 0.18.2R.1 controls select by field meaning, not by DTO names." StatusText="New"/>
                    <controls:NriFormField Label="Закрытый выбор" HelpText="UI shows labels; payload keeps canonical values." IsRequired="True">
                        <controls:NriOptionField SelectedValue="Playable" AutomationProperties.AutomationId="Gallery_Semantic_Option">
                            <controls:NriOptionItem Value="Playable" DisplayName="Играбельная" DisplayOrder="1"/>
                            <controls:NriOptionItem Value="Hidden" DisplayName="Скрытая" DisplayOrder="2"/>
                        </controls:NriOptionField>
                    </controls:NriFormField>
                    <controls:NriFormField Label="Поисковый выбор">
                        <controls:NriSearchableOptionField SelectedValue="north" AutomationProperties.AutomationId="Gallery_Semantic_SearchableOption">
                            <controls:NriOptionItem Value="north" DisplayName="Север"/>
                            <controls:NriOptionItem Value="south" DisplayName="Юг"/>
                        </controls:NriSearchableOptionField>
                    </controls:NriFormField>
                    <controls:NriFormField Label="Логическое поле"><controls:NriBooleanField Content="Доступно игрокам" IsChecked="True" AutomationProperties.AutomationId="Gallery_Semantic_Boolean"/></controls:NriFormField>
                    <controls:NriFormField Label="Целое число"><controls:NriIntegerField Value="2" Minimum="0" Maximum="20" Step="1" UnitLabel="rank" AutomationProperties.AutomationId="Gallery_Semantic_Integer"/></controls:NriFormField>
                    <controls:NriFormField Label="Дробное число"><controls:NriDecimalField Value="1.5" Minimum="0" Maximum="5" Step="0.5" UnitLabel="mod" AutomationProperties.AutomationId="Gallery_Semantic_Decimal"/></controls:NriFormField>
                    <controls:NriFormField Label="Ограниченное число"><controls:NriBoundedNumberField Value="175" Minimum="120" Maximum="240" Step="1" UnitLabel="см" AutomationProperties.AutomationId="Gallery_Semantic_Bounded"/></controls:NriFormField>
                    <controls:NriFormField Label="Дата"><controls:NriDateField AutomationProperties.AutomationId="Gallery_Semantic_Date"/></controls:NriFormField>
                    <controls:NriFormField Label="Дата и время"><controls:NriDateTimeField SelectedDate="2026-07-20" Hour="21" Minute="0" AutomationProperties.AutomationId="Gallery_Semantic_DateTime"/></controls:NriFormField>
                    <controls:NriFormField Label="Длительность"><controls:NriDurationField Amount="90" Unit="minutes" UnitLabel="мин" AutomationProperties.AutomationId="Gallery_Semantic_Duration"/></controls:NriFormField>
                    <controls:NriFormField Label="Теги"><controls:NriTagEditor Text="public, northern, playable" AutomationProperties.AutomationId="Gallery_Semantic_Tags"/></controls:NriFormField>
                    <controls:NriFormField Label="Связанная запись"><controls:NriReferencePicker DisplayName="Сила" StatusText="attribute · visible" AutomationProperties.AutomationId="Gallery_Semantic_Reference"/></controls:NriFormField>
                    <controls:NriFormField Label="Несколько связей"><controls:NriMultiReferencePicker DisplayName="Сила, Ловкость" StatusText="2 selected" AutomationProperties.AutomationId="Gallery_Semantic_MultiReference"/></controls:NriFormField>
                    <controls:NriFormField Label="Технический ID" HelpText="Generated/read-only; normal flow should not edit it."><controls:NriGeneratedIdentifierField Text="attribute_strength" AutomationProperties.AutomationId="Gallery_Semantic_GeneratedId"/></controls:NriFormField>
                    <controls:NriUnknownValueState IsOpen="True" Message="Неизвестное legacy-значение сохранено без изменения." Value="LegacyCustomMode" AutomationProperties.AutomationId="Gallery_Semantic_UnknownLegacy"/>
                    <controls:NriFieldValidationPresenter Message="Значение выходит за допустимый диапазон." Warning="Выбранное legacy-значение требует явной замены." AutomationProperties.AutomationId="Gallery_Semantic_Validation"/>
                    <controls:NriFormField Label="Disabled state"><controls:NriOptionField IsEnabled="False" SelectedValue="Hidden" AutomationProperties.AutomationId="Gallery_Semantic_Disabled"><controls:NriOptionItem Value="Hidden" DisplayName="Скрытая"/></controls:NriOptionField></controls:NriFormField>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Statuses and Feedback" AutomationProperties.AutomationId="Gallery_Statuses_Tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="950" HorizontalAlignment="Left">
                    <controls:NriPageHeader Breadcrumbs="Components / Feedback" Title="Statuses and feedback" Subtitle="Text and color communicate status together."/>
                    <WrapPanel Margin="0,0,0,18"><controls:NriStatusBadge Text="Черновик" StatusKind="Draft" Margin="0,0,8,8"/><controls:NriStatusBadge Text="Опубликовано" StatusKind="Published" Margin="0,0,8,8"/><controls:NriStatusBadge Text="Скрыто" StatusKind="Hidden" Margin="0,0,8,8"/><controls:NriStatusBadge Text="В архиве" StatusKind="Archived" Margin="0,0,8,8"/><controls:NriStatusBadge Text="Требует внимания" StatusKind="Warning" Margin="0,0,8,8"/></WrapPanel>
                    <StackPanel Width="520" HorizontalAlignment="Left"><controls:NriToastHost Message="Изменения сохранены" FeedbackKind="Success" Margin="0,0,0,8"/><controls:NriToastHost Message="Проверьте видимость связанных записей" FeedbackKind="Warning" Margin="0,0,0,8"/><controls:NriToastHost Message="Не удалось сохранить. Повторите попытку." FeedbackKind="Danger"/></StackPanel>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Loading / Empty / Error" AutomationProperties.AutomationId="Gallery_States_Tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="1000" HorizontalAlignment="Left">
                    <controls:NriPageHeader Breadcrumbs="Components / States" Title="Loading, empty and error states" Subtitle="Every data surface explains what is happening and what the user can do next."/>
                    <WrapPanel Margin="0,0,0,14"><Button Content="Пусто" Click="StateEmpty_OnClick" Style="{StaticResource NriSecondaryButtonStyle}" AutomationProperties.AutomationId="Gallery_State_Empty"/><Button Content="Загрузка" Click="StateLoading_OnClick" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0" AutomationProperties.AutomationId="Gallery_State_Loading"/><Button Content="Ошибка" Click="StateError_OnClick" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0" AutomationProperties.AutomationId="Gallery_State_Error"/><Button Content="Данные" Click="StatePopulated_OnClick" Margin="8,0,0,0" AutomationProperties.AutomationId="Gallery_State_Populated"/></WrapPanel>
                    <Grid Height="360"><controls:NriEmptyState x:Name="StateEmpty" Title="Записей пока нет" Message="Создайте первую запись или импортируйте подготовленный набор." PrimaryAction="{x:Null}"/><controls:NriLoadingOverlay x:Name="StateLoading" IsLoading="True" ProgressText="Загружаем справочник…" Visibility="Collapsed"><Border Style="{StaticResource GalleryCardStyle}"/></controls:NriLoadingOverlay><controls:NriEmptyState x:Name="StateError" Title="Не удалось загрузить данные" Message="Проверьте соединение с сервером и повторите попытку." Visibility="Collapsed"/><Border x:Name="StatePopulated" Style="{StaticResource GalleryCardStyle}" Visibility="Collapsed"><StackPanel><TextBlock Text="Данные загружены" Style="{StaticResource NriSectionTitleTextStyle}"/><TextBlock Text="Найдено 24 записи. Последнее обновление: сегодня, 21:40." Margin="0,8,0,0"/></StackPanel></Border></Grid>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Collection Browser Pattern" AutomationProperties.AutomationId="Gallery_Collection_Tab">
                    <Grid Margin="20"><patterns:NriCollectionBrowserHost x:Name="CollectionPattern" AutomationProperties.AutomationId="Gallery_CollectionPattern"><patterns:NriCollectionBrowserHost.Header><controls:NriPageHeader Breadcrumbs="Справочники / Мир" Title="Локации" Subtitle="Найдите, сгруппируйте или создайте игровую локацию." StatusText="24 записи"><controls:NriPageHeader.PrimaryAction><Button Content="Создать локацию"/></controls:NriPageHeader.PrimaryAction></controls:NriPageHeader></patterns:NriCollectionBrowserHost.Header><patterns:NriCollectionBrowserHost.Toolbar><StackPanel Orientation="Horizontal"><controls:NriSearchBox x:Name="PatternSearch" Text="Север" Placeholder="Поиск локаций" AutomationProperties.AutomationId="Gallery_SearchBox"/><controls:NriFilterBar ActiveSummary="Тип: поселение · Видимость: игрокам" ClearAllCommand="{Binding ClearFiltersCommand}" Margin="12,0,0,0"><ComboBox x:Name="PatternTypeFilter" Width="180" SelectedIndex="0" AutomationProperties.AutomationId="Gallery_TypeFilter"><ComboBoxItem Content="Все типы"/><ComboBoxItem Content="Поселения"/></ComboBox></controls:NriFilterBar></StackPanel></patterns:NriCollectionBrowserHost.Toolbar><patterns:NriCollectionBrowserHost.Navigation><StackPanel><TextBlock Text="Категории" Style="{StaticResource NriCardTitleTextStyle}"/><ListBox Margin="0,10,0,0" SelectedIndex="1"><ListBoxItem Content="Все локации"/><ListBoxItem Content="Поселения"/><ListBoxItem Content="Руины"/><ListBoxItem Content="Подземелья"/></ListBox></StackPanel></patterns:NriCollectionBrowserHost.Navigation><patterns:NriCollectionBrowserHost.Collection><ListBox SelectedIndex="0"><ListBoxItem><StackPanel Margin="8"><TextBlock Text="Северная застава" FontWeight="SemiBold"/><TextBlock Text="Поселение · Видно игрокам" Style="{StaticResource NriMetadataTextStyle}"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Margin="8"><TextBlock Text="Северный перевал" FontWeight="SemiBold"/><TextBlock Text="Регион · Черновик" Style="{StaticResource NriMetadataTextStyle}"/></StackPanel></ListBoxItem></ListBox></patterns:NriCollectionBrowserHost.Collection><patterns:NriCollectionBrowserHost.Inspector><StackPanel><TextBlock Text="Северная застава" Style="{StaticResource NriCardTitleTextStyle}"/><TextBlock Text="Торговое поселение у горного прохода." Margin="0,8,0,0"/><controls:NriStatusBadge Text="Видно игрокам" StatusKind="Published" Margin="0,12,0,0"/></StackPanel></patterns:NriCollectionBrowserHost.Inspector></patterns:NriCollectionBrowserHost></Grid>
            </TabItem>

            <TabItem Header="Entity Editor Pattern" AutomationProperties.AutomationId="Gallery_EntityEditor_Tab">
                <Grid Margin="20"><patterns:NriEntityEditorHost x:Name="EntityPattern" HasUnsavedChanges="True" AutomationProperties.AutomationId="Gallery_EntityEditorPattern"><patterns:NriEntityEditorHost.Header><controls:NriPageHeader Breadcrumbs="Справочники / Организации" Title="Северный дозор" Subtitle="Редактирование организации" StatusText="Черновик"/></patterns:NriEntityEditorHost.Header><patterns:NriEntityEditorHost.CommandBar><controls:NriCommandBar><controls:NriCommandBar.PrimaryActions><Button Content="Сохранить" AutomationProperties.AutomationId="Gallery_Entity_Save"/></controls:NriCommandBar.PrimaryActions><controls:NriCommandBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Content="Предпросмотр игрока" Style="{StaticResource NriSecondaryButtonStyle}" Click="OpenInspector_OnClick"/><Button Content="Проверить" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></controls:NriCommandBar.SecondaryActions></controls:NriCommandBar></patterns:NriEntityEditorHost.CommandBar><patterns:NriEntityEditorHost.RecordList><StackPanel><controls:NriSearchBox Placeholder="Поиск организаций"/><ListBox Margin="0,12,0,0" SelectedIndex="0"><ListBoxItem Content="Северный дозор"/><ListBoxItem Content="Лига картографов"/><ListBoxItem Content="Белая гавань"/></ListBox></StackPanel></patterns:NriEntityEditorHost.RecordList><patterns:NriEntityEditorHost.Form><StackPanel><TextBlock Text="Основное" Style="{StaticResource NriSectionTitleTextStyle}"/><controls:NriFormField Label="Название" IsRequired="True" HelpText="Понятное имя для списков и карточек."><TextBox Text="Северный дозор"/></controls:NriFormField><controls:NriFormField Label="Статус"><ComboBox SelectedIndex="0"><ComboBoxItem Content="Черновик"/><ComboBoxItem Content="Опубликовано"/></ComboBox></controls:NriFormField><controls:NriFormField Label="Описание игрокам" HelpText="Не добавляйте секреты мастера."><TextBox Text="Стража северных перевалов." Height="92" AcceptsReturn="True"/></controls:NriFormField><Expander Header="Дополнительно"><StackPanel Margin="0,10,0,0"><TextBlock Text="Технические сведения доступны только в этом раскрываемом разделе." Style="{StaticResource NriSecondaryTextStyle}"/></StackPanel></Expander></StackPanel></patterns:NriEntityEditorHost.Form><patterns:NriEntityEditorHost.Inspector><TabControl><TabItem Header="Предпросмотр"><StackPanel><TextBlock Text="Северный дозор" Style="{StaticResource NriCardTitleTextStyle}"/><TextBlock Text="Стража северных перевалов." Margin="0,8,0,0"/><controls:NriStatusBadge Text="Черновик" StatusKind="Draft" Margin="0,12,0,0"/></StackPanel></TabItem><TabItem Header="Проверка"><controls:NriValidationSummary><sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Заполните публичное описание.</sys:String></controls:NriValidationSummary></TabItem></TabControl></patterns:NriEntityEditorHost.Inspector></patterns:NriEntityEditorHost></Grid>
            </TabItem>

            <TabItem Header="Player Detail Pattern" AutomationProperties.AutomationId="Gallery_PlayerDetail_Tab">
                <Grid Margin="24"><patterns:NriPlayerDetailHost AutomationProperties.AutomationId="Gallery_PlayerDetailPattern"><patterns:NriPlayerDetailHost.Header><controls:NriPageHeader Breadcrumbs="Энциклопедия / Организации" Title="Северный дозор" Subtitle="Стража северных перевалов" StatusText="Известно"/></patterns:NriPlayerDetailHost.Header><patterns:NriPlayerDetailHost.Summary><StackPanel><TextBlock Text="Надёжная пограничная стража, которая сопровождает караваны и защищает горные поселения." FontSize="16"/><WrapPanel Margin="0,12,0,0"><controls:NriStatusBadge Text="Союзники" StatusKind="Success" Margin="0,0,8,0"/><controls:NriStatusBadge Text="Север" StatusKind="Info"/></WrapPanel></StackPanel></patterns:NriPlayerDetailHost.Summary><patterns:NriPlayerDetailHost.Facts><StackPanel><TextBlock Text="Что известно" Style="{StaticResource NriSectionTitleTextStyle}"/><TextBlock Text="Штаб находится в Северной заставе. Дозор принимает добровольцев и проводников." Margin="0,10,0,0"/><TextBlock Text="Связанные места" Style="{StaticResource NriCardTitleTextStyle}" Margin="0,20,0,8"/><TextBlock Text="Северная застава · Каменный перевал · Белая гавань"/></StackPanel></patterns:NriPlayerDetailHost.Facts><patterns:NriPlayerDetailHost.Actions><StackPanel><TextBlock Text="Действия" Style="{StaticResource NriCardTitleTextStyle}"/><Button Content="Открыть связанную локацию" Margin="0,10,0,0"/><Button Content="Добавить в заметки" Style="{StaticResource NriSecondaryButtonStyle}" Margin="0,8,0,0"/></StackPanel></patterns:NriPlayerDetailHost.Actions><patterns:NriPlayerDetailHost.RelatedContent><StackPanel><TextBlock Text="Последнее событие" Style="{StaticResource NriCardTitleTextStyle}"/><TextBlock Text="Караван прибыл сегодня в 18:30." Margin="0,8,0,0"/></StackPanel></patterns:NriPlayerDetailHost.RelatedContent></patterns:NriPlayerDetailHost></Grid>
            </TabItem>

            <TabItem Header="Dashboard Pattern" AutomationProperties.AutomationId="Gallery_Dashboard_Tab">
                <Grid Margin="24"><patterns:NriDashboardHost AutomationProperties.AutomationId="Gallery_DashboardPattern"><patterns:NriDashboardHost.Header><controls:NriPageHeader Breadcrumbs="Проведение" Title="Сегодня в кампании" Subtitle="Важные задачи, события и быстрые действия без дублирования всей программы."/></patterns:NriDashboardHost.Header><patterns:NriDashboardHost.Tasks><StackPanel><TextBlock Text="Требуют внимания" Style="{StaticResource NriSectionTitleTextStyle}"/><TextBlock Text="3 заявки игроков ожидают решения" Margin="0,10,0,0"/><TextBlock Text="Активная карта сцены не назначена" Margin="0,8,0,0"/></StackPanel></patterns:NriDashboardHost.Tasks><patterns:NriDashboardHost.Exceptions><StackPanel><TextBlock Text="Предупреждения" Style="{StaticResource NriSectionTitleTextStyle}"/><controls:NriStatusBadge Text="1 конфликт видимости" StatusKind="Warning" Margin="0,10,0,0"/></StackPanel></patterns:NriDashboardHost.Exceptions><patterns:NriDashboardHost.Events><StackPanel><TextBlock Text="Последние события" Style="{StaticResource NriSectionTitleTextStyle}"/><TextBlock Text="21:42 · Игрок отправил заявку на исследование" Margin="0,10,0,0"/><TextBlock Text="21:35 · Обновлена карта Северного перевала" Margin="0,8,0,0"/></StackPanel></patterns:NriDashboardHost.Events><patterns:NriDashboardHost.QuickActions><StackPanel><TextBlock Text="Быстрые действия" Style="{StaticResource NriSectionTitleTextStyle}"/><Button Content="Открыть текущую сессию" Margin="0,10,0,0"/><Button Content="Просмотреть заявки" Style="{StaticResource NriSecondaryButtonStyle}" Margin="0,8,0,0"/></StackPanel></patterns:NriDashboardHost.QuickActions></patterns:NriDashboardHost></Grid>
            </TabItem>

            <TabItem Header="Reference Picker" AutomationProperties.AutomationId="Gallery_ReferencePicker_Tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left"><controls:NriPageHeader Breadcrumbs="Components / References" Title="Reference picker" Subtitle="Human-readable selection is primary; technical identifiers stay in diagnostics."/><controls:NriFormField Label="Связанная локация" HelpText="Найдите запись по названию, категории или тегам."><controls:NriReferencePicker DisplayName="Северная застава" StatusText="Опубликовано · видно игрокам" SearchCommand="{Binding ReferenceSearchCommand}" AutomationProperties.AutomationId="Gallery_ReferencePicker"/></controls:NriFormField><controls:NriToastHost x:Name="ReferenceToast" IsOpen="False" Message="Открыт поиск связанных записей" Margin="0,0,0,12" AutomationProperties.AutomationId="Gallery_ReferenceToast"/><controls:NriFormField Label="Связанная организация" WarningText="Выбранная организация скрыта от игроков."><controls:NriReferencePicker DisplayName="Тайный совет" StatusText="Скрыто мастером" ValidationMessage="Публичное поле ссылается на скрытую запись." AutomationProperties.Name="Связанная скрытая организация"/></controls:NriFormField><Border Style="{StaticResource GalleryCardStyle}"><StackPanel><TextBlock Text="Результаты поиска" Style="{StaticResource NriCardTitleTextStyle}"/><ListBox Margin="0,10,0,0" SelectedIndex="0"><ListBoxItem Content="Северная застава · Поселение"/><ListBoxItem Content="Северный перевал · Регион"/><ListBoxItem Content="Северный дозор · Организация"/></ListBox></StackPanel></Border></StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Shell and Navigation" AutomationProperties.AutomationId="Gallery_ShellNavigation_Tab">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:NriShellHeader ProductName="NRI System USSE" ContextTitle="Тестовая кампания" ContextSubtitle="Сессия: Северный перевал" ConnectionText="Онлайн" UserDisplayName="dev_admin" AutomationProperties.AutomationId="Gallery_ShellHeader">
                        <controls:NriShellHeader.Actions><Button Content="Учётная запись" Style="{StaticResource NriSecondaryButtonStyle}"/></controls:NriShellHeader.Actions>
                    </controls:NriShellHeader>
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource GalleryCardStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Рабочий режим" Style="{StaticResource NriCardTitleTextStyle}"/>
                                <controls:NriModeSwitcher SelectedIndex="0" Margin="0,8,0,0" AutomationProperties.AutomationId="Gallery_ModeSwitcher">
                                    <ListBoxItem Content="Проведение"/><ListBoxItem Content="Администрирование"/><ListBoxItem Content="Система"/>
                                </controls:NriModeSwitcher>
                                <TextBlock Text="Разделы" Style="{StaticResource NriCardTitleTextStyle}" Margin="0,14,0,0"/>
                                <controls:NriNavigationRail SelectedIndex="0" Margin="0,8,0,0" AutomationProperties.AutomationId="Gallery_NavigationRail">
                                    <ListBoxItem Content="Обзор сессии"/><ListBoxItem Content="Карта сцены"/><ListBoxItem Content="Заявки игроков"/>
                                </controls:NriNavigationRail>
                            </StackPanel>
                        </Border>
                        <controls:NriRouteHost Grid.Column="1" Breadcrumbs="Проведение / Обзор" RouteTitle="Обзор сессии" RouteSubtitle="Маршрут владеет только своим содержимым." AutomationProperties.AutomationId="Gallery_RouteHost">
                            <Border Style="{StaticResource GalleryCardStyle}"><StackPanel><TextBlock Text="Содержимое текущего маршрута" Style="{StaticResource NriSectionTitleTextStyle}"/><TextBlock Text="Посторонние dashboard-блоки здесь не отображаются." Style="{StaticResource NriSecondaryTextStyle}" Margin="0,8,0,0"/><controls:NriPermissionState Title="Пример controlled state" Explanation="Недоступный маршрут объясняет причину и не показывает пустой экран." Margin="0,16,0,0"/></StackPanel></Border>
                        </controls:NriRouteHost>
                    </Grid>
                    <controls:NriActivityDock Grid.Row="2" Header="Активность" IsOpen="True" AutomationProperties.AutomationId="Gallery_ActivityDock"><TextBlock Text="Чат · события · кубики · заявки" Margin="4"/></controls:NriActivityDock>
                </Grid>
            </TabItem>

            <TabItem Header="Shell Dialogs" AutomationProperties.AutomationId="Gallery_ShellDialogs_Tab">
                <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <controls:NriConnectionDialog IsOpen="True" Title="Подключение к серверу" Message="Адрес сервера находится в дополнительных параметрах." AutomationProperties.AutomationId="Gallery_ConnectionDialog"><StackPanel><TextBlock Text="Сервер доступен"/><Expander Header="Дополнительно" Margin="0,10,0,0"><TextBlock Text="127.0.0.1:4600" Margin="0,8,0,0"/></Expander><Button Content="Подключиться" HorizontalAlignment="Right" Margin="0,14,0,0"/></StackPanel></controls:NriConnectionDialog>
                    <controls:NriLoginDialog Grid.Column="1" IsOpen="True" Title="Вход" Message="Введите учётные данные." AutomationProperties.AutomationId="Gallery_LoginDialog"><StackPanel><TextBlock Text="Логин"/><TextBox Text="dev_player"/><TextBlock Text="Пароль" Margin="0,8,0,0"/><PasswordBox/><Button Content="Войти" HorizontalAlignment="Right" Margin="0,14,0,0"/></StackPanel></controls:NriLoginDialog>
                </Grid>
            </TabItem>

            <TabItem Header="Accessibility / Keyboard" AutomationProperties.AutomationId="Gallery_Accessibility_Tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left"><controls:NriPageHeader Breadcrumbs="Foundation / Accessibility" Title="Accessibility and keyboard" Subtitle="Primary controls have names, visible focus and predictable tab order."/><Border Style="{StaticResource GalleryCardStyle}"><StackPanel KeyboardNavigation.TabNavigation="Cycle"><TextBlock Text="Пройдите основной flow клавишей Tab" Style="{StaticResource NriSectionTitleTextStyle}"/><controls:NriSearchBox Placeholder="Поиск по галерее" Margin="0,14,0,0" AutomationProperties.AutomationId="Gallery_Keyboard_Search"/><ComboBox SelectedIndex="0" Margin="0,10,0,0" AutomationProperties.Name="Выберите статус"><ComboBoxItem Content="Черновик"/><ComboBoxItem Content="Опубликовано"/></ComboBox><Button Content="Проверить" Margin="0,10,0,0" AutomationProperties.AutomationId="Gallery_Keyboard_Primary"/><Button Content="Вторичное действие" Style="{StaticResource NriSecondaryButtonStyle}" Margin="0,8,0,0"/><TextBlock Text="Фокус виден рамкой; кнопки и поля имеют понятные имена для автоматизации и специальных возможностей." Style="{StaticResource NriSecondaryTextStyle}" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

