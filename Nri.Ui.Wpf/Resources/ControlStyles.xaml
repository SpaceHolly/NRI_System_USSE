<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Typography.xaml"/>
        <ResourceDictionary Source="Spacing.xaml"/>
        <ResourceDictionary Source="Dimensions.xaml"/>
        <ResourceDictionary Source="Borders.xaml"/>
        <ResourceDictionary Source="Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource NriApplicationBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NriPrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource NriFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="Background" Value="{StaticResource NriApplicationBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NriPrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource NriFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="TextBlock" BasedOn="{StaticResource NriBodyTextStyle}"/>
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource NriInteractiveHeightDefault}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Foreground" Value="{StaticResource NriPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource NriAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NriAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource NriCornerRadiusDefault}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="{StaticResource NriAccentHoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="{StaticResource NriAccentPressedBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource NriFocusBrush}"/><Setter TargetName="Border" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NriSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource NriSecondarySurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NriBorderBrush}"/>
    </Style>
    <Style x:Key="NriDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource NriDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NriDangerBrush}"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource NriInteractiveHeightDefault}"/>
        <Setter Property="MinWidth" Value="{StaticResource NriInputMinWidth}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{StaticResource NriPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource NriSecondarySurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NriBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource NriFocusBrush}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource NriInteractiveHeightDefault}"/>
        <Setter Property="MinWidth" Value="{StaticResource NriInputMinWidth}"/>
        <Setter Property="Padding" Value="10,7,34,7"/>
        <Setter Property="Foreground" Value="{StaticResource NriPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource NriSecondarySurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NriBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder" Background="{StaticResource NriSecondarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="{StaticResource NriSecondaryTextBrush}" Width="10" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource NriAccentHoverBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource NriFocusBrush}"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{StaticResource NriElevatedSurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource NriFocusBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource NriPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource NriElevatedSurfaceBrush}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource NriAccentPressedBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource NriAccentBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="{x:Type controls:NriOptionField}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style TargetType="{x:Type controls:NriSearchableOptionField}" BasedOn="{StaticResource {x:Type controls:NriOptionField}}">
        <Setter Property="IsTextSearchEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NriSearchableOptionField}">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder" Background="{StaticResource NriSecondarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="{StaticResource NriSecondaryTextBrush}" Width="10" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource NriAccentHoverBrush}"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource NriFocusBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{StaticResource NriElevatedSurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Top"
                                             Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Поиск вариантов"
                                             AutomationProperties.AutomationId="NriSearchableOptionField_Search"
                                             Margin="0,0,0,6"/>
                                    <TextBlock x:Name="NoResults"
                                               Text="{TemplateBinding NoResultsText}"
                                               Foreground="{StaticResource NriSecondaryTextBrush}"
                                               Margin="8"
                                               Visibility="Collapsed"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource NriFocusBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        <Trigger Property="HasNoResults" Value="True"><Setter TargetName="NoResults" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type controls:NriBooleanField}">
        <Setter Property="Foreground" Value="{StaticResource NriPrimaryTextBrush}"/>
        <Setter Property="MinHeight" Value="{StaticResource NriInteractiveHeightDefault}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style TargetType="{x:Type controls:NriIntegerField}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style TargetType="{x:Type controls:NriDecimalField}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style TargetType="{x:Type controls:NriBoundedNumberField}" BasedOn="{StaticResource {x:Type controls:NriDecimalField}}"/>
    <Style TargetType="{x:Type controls:NriDateField}">
        <Setter Property="MinHeight" Value="{StaticResource NriInteractiveHeightDefault}"/>
        <Setter Property="MinWidth" Value="{StaticResource NriInputMinWidth}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style TargetType="{x:Type controls:NriDateTimeField}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NriDateTimeField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                        </Grid.ColumnDefinitions>
                        <controls:NriDateField SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                               AccessibleName="{TemplateBinding AccessibleName}"
                                               AutomationProperties.AutomationId="NriDateTimeField_Date"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Hours, RelativeSource={RelativeSource TemplatedParent}}"
                                  SelectedItem="{Binding Hour, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  AutomationProperties.Name="Часы"
                                  AutomationProperties.AutomationId="NriDateTimeField_Hour"
                                  Margin="8,0,0,0"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding Minutes, RelativeSource={RelativeSource TemplatedParent}}"
                                  SelectedItem="{Binding Minute, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  AutomationProperties.Name="Минуты"
                                  AutomationProperties.AutomationId="NriDateTimeField_Minute"
                                  Margin="8,0,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type controls:NriDurationField}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NriDurationField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <controls:NriIntegerField Value="{Binding Amount, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Minimum="0"
                                                  AllowEmpty="{TemplateBinding AllowEmpty}"
                                                  HasValidationError="{Binding HasValidationError, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ValidationMessage="{Binding ValidationMessage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  AccessibleName="{TemplateBinding AccessibleName}"
                                                  AutomationProperties.AutomationId="NriDurationField_Amount"/>
                        <controls:NriOptionField Grid.Column="1"
                                                 ItemsSource="{Binding Units, RelativeSource={RelativeSource TemplatedParent}}"
                                                 SelectedValue="{Binding Unit, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                 AccessibleName="Единица длительности"
                                                 AutomationProperties.AutomationId="NriDurationField_Unit"
                                                 Margin="8,0,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type controls:NriTagEditor}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NriTagEditor}">
                    <Border Background="{StaticResource NriSecondarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                        <StackPanel>
                            <ItemsControl ItemsSource="{TemplateBinding SelectedTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource NriPrimarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                <Button Content="×"
                                                        Command="{Binding RemoveTagCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:NriTagEditor}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NriSecondaryButtonStyle}"
                                                        Padding="4,0"
                                                        MinWidth="24"
                                                        MinHeight="24"
                                                        Margin="6,0,0,0"
                                                        AutomationProperties.Name="Удалить тег"
                                                        AutomationProperties.AutomationId="{Binding TagRemoveAutomationId, RelativeSource={RelativeSource AncestorType={x:Type controls:NriTagEditor}}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_TagInput"
                                         Text="{Binding InputText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{TemplateBinding Placeholder}"
                                         AutomationProperties.AutomationId="{Binding TagInputAutomationId, RelativeSource={RelativeSource TemplatedParent}}"
                                         MinWidth="160"/>
                                <Button x:Name="PART_TagAdd"
                                        Grid.Column="1"
                                        Content="Добавить"
                                        Command="{TemplateBinding AddTagCommand}"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource NriSecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="{Binding TagAddAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="PART_TagInput" Property="IsEnabled" Value="False"/>
                            <Setter TargetName="PART_TagAdd" Property="IsEnabled" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type controls:NriGeneratedIdentifierField}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource NriPrimarySurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NriPrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NriBorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type controls:NriPageHeader}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriPageHeader}">
            <Grid Margin="0,0,0,20" AutomationProperties.Name="Заголовок страницы">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{TemplateBinding Breadcrumbs}" Style="{StaticResource NriMetadataTextStyle}"/>
                <Grid Grid.Row="1" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{TemplateBinding Title}" Style="{StaticResource NriPageTitleTextStyle}"/><controls:NriStatusBadge Text="{TemplateBinding StatusText}" Margin="12,2,0,0"/></StackPanel><TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource NriSecondaryTextStyle}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"><ContentPresenter Content="{TemplateBinding SecondaryActions}" Margin="0,0,8,0"/><ContentPresenter Content="{TemplateBinding PrimaryAction}"/></StackPanel>
                </Grid>
                <ContentPresenter Grid.Row="2" Content="{TemplateBinding HelpContent}" Margin="0,8,0,0"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriCommandBar}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriCommandBar}">
            <Border Background="{StaticResource NriPrimarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource NriCornerRadiusDefault}" Padding="12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentPresenter Content="{TemplateBinding PrimaryActions}"/><ContentPresenter Grid.Column="1" Content="{TemplateBinding SecondaryActions}" Margin="12,0"/><ContentPresenter Grid.Column="2" Content="{TemplateBinding DestructiveActions}"/>
                </Grid>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriFormField}">
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriFormField}">
            <StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="{TemplateBinding Label}" FontWeight="SemiBold" Foreground="{StaticResource NriPrimaryTextBrush}"/><TextBlock x:Name="Required" Text=" *" Foreground="{StaticResource NriDangerBrush}" Visibility="Collapsed"/></StackPanel>
                <TextBlock Text="{TemplateBinding HelpText}" Style="{StaticResource NriSecondaryTextStyle}" Margin="0,2,0,6"/>
                <ContentPresenter/>
                <TextBlock x:Name="Warning" Text="{TemplateBinding WarningText}" Foreground="{StaticResource NriWarningBrush}" Margin="0,4,0,0"/>
                <TextBlock x:Name="Error" Text="{TemplateBinding ErrorText}" Foreground="{StaticResource NriDangerBrush}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Assertive"/>
            </StackPanel>
            <ControlTemplate.Triggers><Trigger Property="IsRequired" Value="True"><Setter TargetName="Required" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="WarningText" Value=""><Setter TargetName="Warning" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="ErrorText" Value=""><Setter TargetName="Error" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriSearchBox}">
        <Setter Property="MinHeight" Value="40"/><Setter Property="MinWidth" Value="240"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriSearchBox}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{TemplateBinding Placeholder}" AutomationProperties.AutomationId="NriSearchBox_Input" Padding="34,7,10,7"/>
                <Path Data="{StaticResource NriIconSearch}" Stroke="{StaticResource NriMutedTextBrush}" StrokeThickness="1.5" Width="18" Height="18" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                <Button Grid.Column="1" Command="{x:Static controls:NriSearchBox.ClearTextCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource NriSecondaryButtonStyle}" Padding="8" AutomationProperties.Name="Очистить поиск" AutomationProperties.AutomationId="NriSearchBox_Clear"><Path Data="{StaticResource NriIconClose}" Stroke="{StaticResource NriSecondaryTextBrush}" StrokeThickness="1.5" Width="12" Height="12"/></Button>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriFilterBar}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriFilterBar}">
            <WrapPanel><ContentPresenter/><TextBlock Text="{TemplateBinding ActiveSummary}" Style="{StaticResource NriMetadataTextStyle}" VerticalAlignment="Center" Margin="8,0"/><Button Content="Сбросить фильтры" Command="{TemplateBinding ClearAllCommand}" Style="{StaticResource NriSecondaryButtonStyle}" AutomationProperties.Name="Сбросить все фильтры" AutomationProperties.AutomationId="NriFilterBar_ClearAll"/></WrapPanel>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriStatusBadge}">
        <Setter Property="Foreground" Value="{StaticResource NriPrimaryTextBrush}"/><Setter Property="Background" Value="{StaticResource NriElevatedSurfaceBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriStatusBadge}"><Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,3"><TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="SemiBold"/></Border><ControlTemplate.Triggers>
            <Trigger Property="StatusKind" Value="Info"><Setter Property="Background" Value="{StaticResource NriInformationBrush}"/></Trigger><Trigger Property="StatusKind" Value="Success"><Setter Property="Background" Value="{StaticResource NriSuccessBrush}"/></Trigger><Trigger Property="StatusKind" Value="Warning"><Setter Property="Background" Value="{StaticResource NriWarningBrush}"/></Trigger><Trigger Property="StatusKind" Value="Danger"><Setter Property="Background" Value="{StaticResource NriDangerBrush}"/></Trigger><Trigger Property="StatusKind" Value="Archived"><Setter Property="Background" Value="{StaticResource NriMutedTextBrush}"/></Trigger><Trigger Property="StatusKind" Value="Hidden"><Setter Property="Background" Value="{StaticResource NriSecondarySurfaceBrush}"/></Trigger><Trigger Property="StatusKind" Value="Published"><Setter Property="Background" Value="{StaticResource NriSuccessBrush}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriEmptyState}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriEmptyState}"><Border Background="{StaticResource NriPrimarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="32"><StackPanel HorizontalAlignment="Center" MaxWidth="520"><TextBlock Text="{TemplateBinding Title}" Style="{StaticResource NriSectionTitleTextStyle}" TextAlignment="Center"/><TextBlock Text="{TemplateBinding Message}" Style="{StaticResource NriSecondaryTextStyle}" TextAlignment="Center" Margin="0,8,0,16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ContentPresenter Content="{TemplateBinding PrimaryAction}"/><ContentPresenter Content="{TemplateBinding SecondaryAction}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriValidationSummary}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriValidationSummary}"><Border Background="{StaticResource NriPrimarySurfaceBrush}" BorderBrush="{StaticResource NriDangerBrush}" BorderThickness="1" CornerRadius="6" Padding="12"><StackPanel><TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" Foreground="{StaticResource NriDangerBrush}"/><ItemsPresenter Margin="0,6,0,0"/></StackPanel></Border></ControlTemplate></Setter.Value></Setter>
        <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><Button Content="{Binding}" Style="{StaticResource NriSecondaryButtonStyle}" HorizontalContentAlignment="Left" Margin="0,2" Padding="8,5" AutomationProperties.Name="Перейти к полю с ошибкой" AutomationProperties.AutomationId="NriValidationSummary_GoToField"/></DataTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriInspectorDrawer}">
        <Setter Property="Width" Value="{StaticResource NriInspectorDefaultWidth}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriInspectorDrawer}"><Border x:Name="Drawer" Background="{StaticResource NriElevatedSurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1,0,0,0" Padding="16"><DockPanel><Button DockPanel.Dock="Top" HorizontalAlignment="Right" Command="{x:Static controls:NriInspectorDrawer.CloseDrawerCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource NriSecondaryButtonStyle}" Padding="8" AutomationProperties.Name="Закрыть инспектор" AutomationProperties.AutomationId="NriInspectorDrawer_Close"><Path Data="{StaticResource NriIconClose}" Stroke="{StaticResource NriSecondaryTextBrush}" StrokeThickness="1.5" Width="12" Height="12"/></Button><TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}" Style="{StaticResource NriSectionTitleTextStyle}" Margin="0,0,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ContentPresenter/></ScrollViewer></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsOpen" Value="False"><Setter TargetName="Drawer" Property="Visibility" Value="Collapsed"/><Setter Property="Width" Value="0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriLoadingOverlay}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriLoadingOverlay}"><Grid><ContentPresenter/><Border x:Name="Overlay" Background="{StaticResource NriOverlayBrush}" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="220" Height="8"/><TextBlock Text="{TemplateBinding ProgressText}" Foreground="{StaticResource NriPrimaryTextBrush}" Margin="0,12,0,0" TextAlignment="Center"/></StackPanel></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsLoading" Value="True"><Setter TargetName="Overlay" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriToastHost}">
        <Setter Property="Background" Value="{StaticResource NriSuccessBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriToastHost}"><Border x:Name="Toast" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,10"><TextBlock Text="{TemplateBinding Message}" Foreground="{StaticResource NriPrimaryTextBrush}"/></Border><ControlTemplate.Triggers><Trigger Property="FeedbackKind" Value="Info"><Setter Property="Background" Value="{StaticResource NriInformationBrush}"/></Trigger><Trigger Property="FeedbackKind" Value="Warning"><Setter Property="Background" Value="{StaticResource NriWarningBrush}"/></Trigger><Trigger Property="FeedbackKind" Value="Danger"><Setter Property="Background" Value="{StaticResource NriDangerBrush}"/></Trigger><Trigger Property="IsOpen" Value="False"><Setter TargetName="Toast" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriConfirmationDialog}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:NriConfirmationDialog}"><Border x:Name="Dialog" Background="{StaticResource NriElevatedSurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20" MaxWidth="520" Visibility="Collapsed"><StackPanel><TextBlock Text="{TemplateBinding Title}" Style="{StaticResource NriSectionTitleTextStyle}"/><TextBlock Text="{TemplateBinding TargetName}" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{TemplateBinding Message}" Margin="0,6,0,14"/><TextBox x:Name="Reason" Text="{Binding Reason, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Причина" AutomationProperties.AutomationId="NriConfirmationDialog_Reason" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Отмена" Command="{TemplateBinding CancelCommand}" Style="{StaticResource NriSecondaryButtonStyle}" AutomationProperties.AutomationId="NriConfirmationDialog_Cancel"/><Button Content="Подтвердить" Command="{TemplateBinding ConfirmCommand}" Style="{StaticResource NriDangerButtonStyle}" Margin="8,0,0,0" AutomationProperties.AutomationId="NriConfirmationDialog_Confirm"/></StackPanel></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsOpen" Value="True"><Setter TargetName="Dialog" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="RequiresReason" Value="True"><Setter TargetName="Reason" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriReferencePicker}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NriReferencePicker}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource NriSecondarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding DisplayName}" Foreground="{StaticResource NriPrimaryTextBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{TemplateBinding StatusText}" Style="{StaticResource NriMetadataTextStyle}"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Content="Выбрать" Command="{TemplateBinding SearchCommand}" Margin="8,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Найти связанную запись" AutomationProperties.AutomationId="{Binding ReferenceOpenAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Button Grid.Column="2" Content="Открыть" Command="{TemplateBinding OpenCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Открыть связанную запись" AutomationProperties.AutomationId="{Binding ReferenceOpenLinkedAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Button Grid.Column="3" Content="Очистить" Command="{TemplateBinding ClearCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Очистить выбранную связь" AutomationProperties.AutomationId="{Binding ReferenceClearAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Поиск связанной записи"
                                     AutomationProperties.AutomationId="{Binding ReferenceSearchAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Button Grid.Column="1" Content="Найти" Command="{TemplateBinding SearchCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0" AutomationProperties.AutomationId="{Binding ReferenceSearchButtonAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <TextBlock x:Name="LoadingText" Text="Загрузка..." Style="{StaticResource NriMetadataTextStyle}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        <ListBox ItemsSource="{TemplateBinding Options}"
                                 SelectedItem="{Binding SelectedOption, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                 MaxHeight="120"
                                 Margin="0,6,0,0"
                                 AutomationProperties.AutomationId="{Binding ReferenceResultsAutomationId, RelativeSource={RelativeSource TemplatedParent}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource NriMetadataTextStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Применить выбор" Command="{TemplateBinding SelectCommand}" CommandParameter="{Binding SelectedOption, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="0,6,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="{Binding ReferenceSelectAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <TextBlock Text="{TemplateBinding ValidationMessage}" Foreground="{StaticResource NriDangerBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLoading" Value="True"><Setter TargetName="LoadingText" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type controls:NriMultiReferencePicker}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NriMultiReferencePicker}">
                    <StackPanel>
                        <Border Background="{StaticResource NriSecondarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                            <TextBox IsReadOnly="True"
             Text="{Binding DataContext.ReferenceChipSummary, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type controls:NriMultiReferencePicker}}}"
                                     AutomationProperties.AutomationId="{Binding ReferenceChipsAutomationId, RelativeSource={RelativeSource TemplatedParent}}"
                                     AutomationProperties.Name="Выбранные связи"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     TextWrapping="Wrap"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding DataContext.ReferenceChips, RelativeSource={RelativeSource AncestorType={x:Type controls:NriMultiReferencePicker}}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource NriSecondarySurfaceBrush}" BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            <Button Content="?"
                                                    Command="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:NriMultiReferencePicker}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource NriSecondaryButtonStyle}"
                                                    Padding="4,0"
                                                    MinWidth="24"
                                                    MinHeight="24"
                                                    Margin="6,0,0,0"
                                                    AutomationProperties.Name="Удалить связь"
                                                    AutomationProperties.AutomationId="{Binding ReferenceRemoveAutomationId, RelativeSource={RelativeSource AncestorType={x:Type controls:NriMultiReferencePicker}}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск связанной записи" AutomationProperties.AutomationId="{Binding ReferenceSearchAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Button Grid.Column="1" Content="Найти" Command="{TemplateBinding SearchCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0" AutomationProperties.AutomationId="{Binding ReferenceSearchButtonAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Button Grid.Column="2" Content="Очистить" Command="{TemplateBinding ClearAllCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0" AutomationProperties.AutomationId="{Binding ReferenceClearAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <ListBox ItemsSource="{TemplateBinding Options}"
                                 SelectedItem="{Binding SelectedOption, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                 MaxHeight="120"
                                 Margin="0,6,0,0"
                                 AutomationProperties.AutomationId="{Binding ReferenceResultsAutomationId, RelativeSource={RelativeSource TemplatedParent}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource NriMetadataTextStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Добавить связь" Command="{TemplateBinding AddCommand}" CommandParameter="{Binding SelectedOption, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="0,6,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="{Binding ReferenceSelectAutomationId, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <TextBlock Text="{TemplateBinding ValidationMessage}" Foreground="{StaticResource NriDangerBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type controls:NriUnknownValueState}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NriUnknownValueState}">
                    <Border x:Name="UnknownValue" Background="{StaticResource NriPrimarySurfaceBrush}" BorderBrush="{StaticResource NriWarningBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Message}" Foreground="{StaticResource NriWarningBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{TemplateBinding Value}" Foreground="{StaticResource NriPrimaryTextBrush}" FontFamily="Consolas" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="False"><Setter TargetName="UnknownValue" Property="Visibility" Value="Collapsed"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:NriFieldValidationPresenter}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NriFieldValidationPresenter}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock x:Name="ErrorText" Text="{TemplateBinding Message}" Foreground="{StaticResource NriDangerBrush}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="WarningText" Text="{TemplateBinding Warning}" Foreground="{StaticResource NriWarningBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Message" Value=""><Setter TargetName="ErrorText" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="Warning" Value=""><Setter TargetName="WarningText" Property="Visibility" Value="Collapsed"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

