<UserControl x:Class="Nri.PlayerClient.Views.World.PlayerWeatherTravelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             AutomationProperties.AutomationId="PlayerWeatherTravel_Root">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshWeatherTravel0217Command}" AutomationProperties.AutomationId="PlayerWeatherTravel_Refresh"/>
            <StackPanel>
                <TextBlock Text="Погода и путешествия" Style="{StaticResource NriPageTitleTextStyle}"/>
                <TextBlock Text="Наблюдаемая обстановка, ваши измерения и личное воздействие среды." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <TabControl Grid.Row="1" AutomationProperties.AutomationId="PlayerWeatherTravel_Tabs">
            <TabItem Header="Сейчас" AutomationProperties.AutomationId="PlayerWeatherTravel_NowTab">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <Border Style="{StaticResource CardStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Северная долина" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Weather0217Pattern}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" AutomationProperties.AutomationId="PlayerWeatherTravel_Pattern"/>
                                    <TextBlock Text="{Binding Weather0217Summary}" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Separator Margin="0,16,0,12"/>
                                    <TextBlock Text="{Binding Weather0217Conditions}" TextWrapping="Wrap" AutomationProperties.AutomationId="PlayerWeatherTravel_QualitativeObservation"/>
                                    <TextBlock Text="{Binding Weather0217Environment}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Измерить" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="Прибор не раскрывает истину автоматически: выполните отдельное измерение." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                    <WrapPanel>
                                        <Button Content="Температура" Command="{Binding MeasureTemperature0217BCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="PlayerWeather_MeasureTemperature"/>
                                        <Button Content="Скорость ветра" Command="{Binding MeasureWindSpeed0217BCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="PlayerWeather_MeasureWindSpeed"/>
                                        <Button Content="Направление ветра" Command="{Binding MeasureWindDirection0217BCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="PlayerWeather_MeasureWindDirection"/>
                                        <Button Content="Оценить расстояние" Command="{Binding EstimateDistance0217BCommand}" Margin="0,0,0,8" AutomationProperties.AutomationId="PlayerWeather_EstimateDistance"/>
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding WeatherObservations0217B}" Margin="0,8,0,0" AutomationProperties.AutomationId="PlayerWeather_ObservationHistory">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Value}" FontSize="15"/><TextBlock Text="{Binding Source}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Freshness}" Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Для вас" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="{Binding Weather0217Assessment}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.AutomationId="PlayerWeather_PersonalAssessment"/>
                            <TextBlock Text="{Binding Weather0217Protection}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" AutomationProperties.AutomationId="PlayerWeather_Protection"/>
                            <Separator Margin="0,16,0,12"/>
                            <TextBlock Text="Воздействие" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Weather0217Exposure}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="PlayerWeatherTravel_ExposureWarning"/>
                            <TextBlock Text="{Binding Weather0217AppliedEffects}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Прогноз" AutomationProperties.AutomationId="PlayerWeatherTravel_ForecastTab">
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="8" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel><TextBlock Text="Известный прогноз" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="{Binding Weather0217Forecast}" FontSize="18" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding Weather0217ForecastReliability}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/><TextBlock Text="Прогноз принадлежит знаниям активного персонажа и со временем устаревает." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Путешествие" AutomationProperties.AutomationId="PlayerWeatherTravel_TravelTab">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{Binding Weather0217TravelTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Weather0217TravelProgress}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding WeatherTravelSegments0217}" Margin="0,14,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="0,0,0,1" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Route}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Margin="16,0,0,0" Foreground="{StaticResource AccentBrush}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="Оценка пути" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="{Binding Weather0217TravelEta}" TextWrapping="Wrap" FontSize="17" Margin="0,10,0,0"/><TextBlock Text="Мировое время меняет только мастер при подтверждении участка." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding Weather0217Status}" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,8,0,0" AutomationProperties.AutomationId="PlayerWeatherTravel_Status"/>
    </Grid>
</UserControl>
