<UserControl x:Class="Nri.PlayerClient.Views.Maps.PlayerWorldMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.PlayerClient.ViewModels"
             AutomationProperties.AutomationId="PlayerWorldMap_Root">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Карта мира" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="PlayerWorldMap_Title"/>
                <WrapPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button Content="Обновить список" Command="{Binding RefreshMapsCommand}"
                            AutomationProperties.AutomationId="PlayerWorldMap_RefreshList_Button"/>
                    <Button Content="Открыть карту" Margin="8,0,0,0" Command="{Binding OpenSelectedMapCommand}"
                            AutomationProperties.AutomationId="PlayerWorldMap_OpenSelected_Button"/>
                    <Button Content="Обновить карту" Margin="8,0,0,0" Style="{DynamicResource GhostButtonStyle}"
                            Command="{Binding RefreshMapCommand}"
                            AutomationProperties.AutomationId="PlayerWorldMap_Refresh_Button"/>
                    <CheckBox Content="Ручной ввод MapId" Margin="12,4,0,0" IsChecked="{Binding AdvancedMapIdMode}"
                              AutomationProperties.AutomationId="PlayerWorldMap_AdvancedMapId_Toggle"/>
                    <TextBlock Text="{Binding MapMetaText}" Margin="12,4,0,0" Foreground="{StaticResource MutedBrush}"
                               AutomationProperties.AutomationId="PlayerWorldMap_MetaText"/>
                </WrapPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastRefreshText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ScaleText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                               AutomationProperties.AutomationId="PlayerWorldMap_ScaleText"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CampaignId:" VerticalAlignment="Center"/>
                    <TextBox Width="140" Margin="6,0,0,0"
                             Text="{Binding CampaignId, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="PlayerWorldMap_CampaignId"/>
                    <TextBlock Text="MapId:" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding AdvancedMapIdMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBox Width="180" Margin="6,0,0,0"
                             Text="{Binding MapId, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding AdvancedMapIdMode, Converter={StaticResource BoolToVisibilityConverter}}"
                             AutomationProperties.AutomationId="PlayerWorldMap_MapId"/>
                    <Button Content="Открыть по ID" Margin="8,0,0,0"
                            Command="{Binding OpenMapByIdCommand}"
                            Visibility="{Binding AdvancedMapIdMode, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="PlayerWorldMap_OpenById_Button"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Доступные карты" FontWeight="Bold"/>
                        <ListBox ItemsSource="{Binding AvailableMaps}"
                                 SelectedItem="{Binding SelectedMapItem, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 AutomationProperties.AutomationId="PlayerWorldMap_MapList"/>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding MapName}" FontWeight="Bold" FontSize="14"
                                       AutomationProperties.AutomationId="PlayerWorldMap_MapName"/>
                            <TextBlock Text="{Binding MapDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="PlayerWorldMap_MapDescription"/>
                            <TextBlock Text="World map canvas"
                                       Width="1"
                                       Height="1"
                                       Opacity="0.01"
                                       IsHitTestVisible="False"
                                       AutomationProperties.AutomationId="PlayerWorldMap_Canvas"/>
                            <ContentControl Margin="0,8,0,0">
                                <Canvas Width="{Binding CanvasWidth}"
                                        Height="{Binding CanvasHeight}"
                                        Background="{StaticResource PanelAltBrush}"
                                        ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding LayerCells}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PlayerWorldCellUiItem}">
                                            <Rectangle Width="{Binding Width}"
                                                       Height="{Binding Height}"
                                                       Fill="{Binding FillHex}"
                                                       Stroke="#33222A35"
                                                       StrokeThickness="0.25"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding GridLines}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MapGridLineUiItem}">
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="#223B4556" StrokeThickness="0.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Markers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding PixelX}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding PixelY}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PlayerWorldMarkerUiItem}">
                                            <Button Width="18" Height="18" Padding="0" Content="●"
                                                    Command="{Binding DataContext.SelectLayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="{Binding Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </Canvas>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Слои" FontWeight="Bold"/>
                        <ListBox ItemsSource="{Binding LayerOptions}"
                                 SelectedItem="{Binding SelectedLayerType, Mode=TwoWay}"
                                 Height="86"
                                 AutomationProperties.AutomationId="PlayerWorldMap_LayerSelector"/>
                        <TextBlock Text="Легенда" FontWeight="Bold" Margin="0,8,0,4"/>
                        <ListBox ItemsSource="{Binding LegendEntries}" DisplayMemberPath="Display" Height="88"
                                 AutomationProperties.AutomationId="PlayerWorldMap_Legend"/>
                        <TextBlock Text="Маркеры" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding MarkerSummaryText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="PlayerWorldMap_MarkerSummary"/>
                        <DataGrid ItemsSource="{Binding Markers}" SelectedItem="{Binding SelectedMarker, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Height="120"
                                  HeadersVisibility="Column" RowHeaderWidth="0"
                                  AutomationProperties.AutomationId="PlayerWorldMap_Markers">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Маркер" Binding="{Binding Name}" Width="1.2*"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding MarkerTypeDisplay}" Width="1*"/>
                                <DataGridTextColumn Header="Коорд." Binding="{Binding CoordinatesText}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Padding="8" Margin="0,8,0,0"
                                AutomationProperties.AutomationId="PlayerWorldMap_MarkerCard">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedMarkerTitle}" FontWeight="Bold"
                                           AutomationProperties.AutomationId="PlayerWorldMap_SelectedMarkerTitle"/>
                                <TextBlock Text="{Binding SelectedMarkerType}" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding SelectedMarkerCoords}" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding SelectedMarkerBinding}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedMarkerDescription}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           AutomationProperties.AutomationId="PlayerWorldMap_SelectedMarkerDescription"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                           AutomationProperties.AutomationId="PlayerWorldMap_StatusText"/>
                <TextBlock Text="{Binding WarningMessage}" Foreground="#FFF59E0B"
                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.AutomationId="PlayerWorldMap_WarningText"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFEF4444"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.AutomationId="PlayerWorldMap_ErrorText"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
