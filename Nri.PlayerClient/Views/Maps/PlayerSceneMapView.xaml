<UserControl x:Class="Nri.PlayerClient.Views.Maps.PlayerSceneMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.PlayerClient.ViewModels">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Карта сцены" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Открыть активную карту" Command="{Binding OpenMapCommand}"/>
                    <Button Content="Обновить карту" Margin="8,0,0,0" Style="{DynamicResource GhostButtonStyle}" Command="{Binding RefreshCommand}"/>
                    <CheckBox Content="Ручной ввод MapId" Margin="12,4,0,0" IsChecked="{Binding ManualMapIdMode}"/>
                    <TextBlock Text="{Binding MapMetaText}" Margin="12,4,0,0" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding FogStatusText}" Margin="12,4,0,0" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastRefreshText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CanvasScaleLabel}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CampaignId:" VerticalAlignment="Center"/>
                    <TextBox Width="140" Margin="6,0,0,0" Text="{Binding CampaignId, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="SessionId:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Width="120" Margin="6,0,0,0" Text="{Binding SessionId, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="GroupId:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Width="120" Margin="6,0,0,0" Text="{Binding ActiveGroupId, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="MapId:" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualMapIdMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Width="180" Margin="6,0,0,0" Text="{Binding MapId, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualMapIdMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.3*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding MapName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding MapDescription}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#334155" Background="#0F172A" CornerRadius="4">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="#111827">
                                    <ItemsControl ItemsSource="{Binding GridLines}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MapGridLineUiItem}">
                                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#233A5A" StrokeThickness="1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding FogOverlays}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MapFogOverlayUiItem}">
                                                <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#A6111827"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Markers}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding PixelX}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding PixelY}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PlayerSceneMarkerUiItem}">
                                                <Grid>
                                                    <Ellipse Width="12" Height="12" Fill="#10B981" Stroke="#A7F3D0" StrokeThickness="1"/>
                                                    <TextBlock Margin="10,-4,0,0" Text="{Binding Name}" FontSize="11" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Markers}" SelectedItem="{Binding SelectedMarker, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Маркер" Binding="{Binding Name}" Width="1.2*"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding MarkerTypeDisplay}" Width="1*"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="0.6*"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="0.6*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SelectedMarkerTitle}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedMarkerTypeText}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SelectedMarkerCoordsText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SelectedMarkerBindingText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedMarkerDescription}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding CoordinateHints}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WarningMessage}" Foreground="#F59E0B" Margin="0,4,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" Margin="0,4,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
