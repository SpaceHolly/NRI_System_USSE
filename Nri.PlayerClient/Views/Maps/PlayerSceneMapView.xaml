<UserControl x:Class="Nri.PlayerClient.Views.Maps.PlayerSceneMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.PlayerClient.ViewModels"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="PlayerSceneMap_Route">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Карта сцены" Style="{StaticResource SectionTitleTextStyle}"/>
                <TextBlock Text="{Binding MapName}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding MapMetaText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="Открыть активную" Command="{Binding OpenMapCommand}" AutomationProperties.AutomationId="PlayerSceneMap_OpenActive"/>
                <Button Content="Обновить" Margin="6,0,0,0" Style="{DynamicResource GhostButtonStyle}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="PlayerSceneMap_Refresh"/>
                <Button Content="Восстановить связь" Margin="6,0,0,0" Style="{DynamicResource GhostButtonStyle}" Command="{Binding ReconnectCommand}" AutomationProperties.AutomationId="PlayerSceneMap_Reconnect"/>
                <Button Content="+" Margin="10,0,0,0" Command="{Binding ZoomInCommand}" IsEnabled="{Binding CanZoomIn}" ToolTip="Увеличить" AutomationProperties.AutomationId="MapViewport_ZoomIn"/>
                <Button Content="−" Margin="4,0,0,0" Command="{Binding ZoomOutCommand}" IsEnabled="{Binding CanZoomOut}" ToolTip="Уменьшить" AutomationProperties.AutomationId="MapViewport_ZoomOut"/>
                <Button Content="По размеру" Margin="4,0,0,0" Style="{DynamicResource GhostButtonStyle}" Command="{Binding FitToMapCommand}" AutomationProperties.AutomationId="MapViewport_Fit"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#334155" Background="#0F172A" CornerRadius="4" Margin="0,0,8,0">
                <Grid>
                    <controls:NriAutomationAnchor x:Name="MapViewportHost" ClipToBounds="True" SizeChanged="MapViewportHost_OnSizeChanged"
                                                  AutomationProperties.AutomationId="PlayerSceneMap_Viewport" AutomationProperties.Name="Карта сцены для игрока">
                        <Canvas x:Name="MapCanvas" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="#111827" ClipToBounds="True"
                                MouseDown="MapCanvas_OnMouseDown" MouseUp="MapCanvas_OnMouseUp" MouseMove="MapCanvas_OnMouseMove"
                                MouseWheel="MapCanvas_OnMouseWheel" MouseLeave="MapCanvas_OnMouseLeave">
                            <ItemsControl ItemsSource="{Binding TilePatches}" IsHitTestVisible="False" AutomationProperties.AutomationId="PlayerSceneMap_TileLayer">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelX}"/><Setter Property="Canvas.Top" Value="{Binding PixelY}"/><Setter Property="Panel.ZIndex" Value="{Binding VisualZIndex}"/></Style></ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:PlayerSceneTilePatchUiItem}"><Border Width="{Binding PixelWidth}" Height="{Binding PixelHeight}" Background="{Binding FillBrush}" BorderBrush="{Binding StrokeBrush}" BorderThickness="0.5" Opacity="{Binding Opacity}"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding GridLines}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:MapGridLineUiItem}"><Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#64748B" StrokeThickness="{Binding Thickness}" Opacity="{Binding Opacity}"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Shapes}" Visibility="{Binding ShowShapesCategory, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="PlayerSceneMap_ShapeLayer">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelX}"/><Setter Property="Canvas.Top" Value="{Binding PixelY}"/><Setter Property="Panel.ZIndex" Value="{Binding VisualZIndex}"/></Style></ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlayerSceneShapeUiItem}">
                                        <controls:NriAutomationAnchor AutomationProperties.AutomationId="PlayerSceneMap_ObjectAnchor"
                                                                      AutomationProperties.Name="{Binding DisplayName}">
                                            <Grid Width="{Binding PixelWidth}" Height="{Binding PixelHeight}">
                                                <Border Visibility="{Binding AreaVisibility}" Background="{Binding VisualFillBrush}" BorderBrush="{Binding VisualStrokeBrush}" BorderThickness="{Binding EffectiveStrokeThickness}" CornerRadius="4" Opacity="{Binding EffectiveVisualOpacity}"/>
                                                <Path Visibility="{Binding PathVisibility}" Data="{Binding PathGeometry}" Stroke="{Binding VisualStrokeBrush}" StrokeThickness="{Binding EffectiveStrokeThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <TextBlock Text="{Binding AssetGlyph}" Foreground="{Binding AssetGlyphBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </controls:NriAutomationAnchor>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding AssetInstances}" Visibility="{Binding ShowAssetsCategory, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="PlayerSceneMap_AssetLayer">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelX}"/><Setter Property="Canvas.Top" Value="{Binding PixelY}"/><Setter Property="Panel.ZIndex" Value="{Binding VisualZIndex}"/></Style></ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:PlayerSceneAssetInstanceUiItem}"><controls:NriAutomationAnchor AutomationProperties.AutomationId="PlayerSceneMap_ObjectAnchor" AutomationProperties.Name="{Binding DisplayName}"><Border Width="{Binding PixelWidth}" Height="{Binding PixelHeight}" Background="{Binding FillBrush}" BorderBrush="{Binding StrokeBrush}" BorderThickness="1" CornerRadius="3"><TextBlock Text="{Binding AssetGlyph}" Foreground="{Binding GlyphBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></controls:NriAutomationAnchor></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Markers}" Visibility="{Binding ShowMarkersCategory, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="PlayerSceneMap_MarkerLayer">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelX}"/><Setter Property="Canvas.Top" Value="{Binding PixelY}"/></Style></ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:PlayerSceneMarkerUiItem}"><controls:NriAutomationAnchor AutomationProperties.AutomationId="PlayerSceneMap_ObjectAnchor" AutomationProperties.Name="{Binding DisplayName}"><Ellipse Width="14" Height="14" Fill="#10B981" Stroke="#D1FAE5" StrokeThickness="1.5" Margin="-7,-7,0,0"/></controls:NriAutomationAnchor></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Tokens}" Visibility="{Binding ShowTokensCategory, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="PlayerSceneMap_TokenLayer">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelX}"/><Setter Property="Canvas.Top" Value="{Binding PixelY}"/></Style></ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:PlayerSceneTokenUiItem}"><controls:NriAutomationAnchor AutomationProperties.AutomationId="PlayerSceneMap_ObjectAnchor" AutomationProperties.Name="{Binding DisplayName}"><Ellipse Width="18" Height="18" Fill="#2563EB" Stroke="#DBEAFE" StrokeThickness="1.5" Margin="-9,-9,0,0"/></controls:NriAutomationAnchor></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <controls:NriAutomationAnchor Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" IsHitTestVisible="False"
                                                          AutomationProperties.AutomationId="PlayerSceneMap_LabelLayer"
                                                          AutomationProperties.Name="Читаемые подписи объектов карты">
                                <ItemsControl ItemsSource="{Binding Labels}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PixelX}"/><Setter Property="Canvas.Top" Value="{Binding PixelY}"/><Setter Property="Panel.ZIndex" Value="850"/></Style></ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PlayerMapLabelUiItem0204}">
                                            <Border Width="{Binding Width}" Background="#DC0F172A" BorderBrush="#64748B" BorderThickness="1" CornerRadius="3" Padding="5,2">
                                                <TextBlock Text="{Binding Text}" Foreground="#F8FAFC" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </controls:NriAutomationAnchor>

                            <ItemsControl ItemsSource="{Binding FogOverlays}" IsHitTestVisible="False" AutomationProperties.AutomationId="PlayerSceneMap_FogLayer">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/><Setter Property="Panel.ZIndex" Value="900"/></Style></ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:MapFogOverlayUiItem}"><Border Width="{Binding Width}" Height="{Binding Height}" Background="#E6111827"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </controls:NriAutomationAnchor>

                    <Border Background="#CC0F172A" CornerRadius="4" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="1000">
                        <TextBlock Text="Загружаем безопасную карту…" Foreground="#F8FAFC"/>
                    </Border>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Panel.ZIndex="950">
                        <TextBlock Text="{Binding CoordinateIndicator}" Foreground="#CBD5E1"/>
                        <TextBlock Text="{Binding GridStepLabel}" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <controls:NriAutomationAnchor Grid.Column="1" AutomationProperties.AutomationId="PlayerSceneMap_PresentationPanel"
                                          AutomationProperties.Name="Легенда и безопасные детали карты">
                <Border Style="{StaticResource CardStyle}" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding ConnectionStateText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding WarningMessage}" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <Expander Header="Легенда" IsExpanded="True" Margin="0,12,0,0" AutomationProperties.AutomationId="PlayerSceneMap_Legend">
                            <ItemsControl ItemsSource="{Binding LegendEntries}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlayerMapLegendUiItem0204}">
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Summary}"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander Header="Детали" IsExpanded="True" Margin="0,12,0,0" AutomationProperties.AutomationId="PlayerSceneMap_SafeDetails">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding SelectedObjectTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedObjectType}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding SelectedObjectCoordinates}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding SelectedObjectReference}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedObjectDescription}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>

                        <Separator Margin="0,12,0,8"/>
                        <TextBlock Text="{Binding FogStatusText}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding LastRefreshText, StringFormat=Обновлено: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </controls:NriAutomationAnchor>
        </Grid>
    </Grid>
</UserControl>
