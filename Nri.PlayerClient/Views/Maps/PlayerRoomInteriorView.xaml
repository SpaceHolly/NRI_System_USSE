<UserControl x:Class="Nri.PlayerClient.Views.Maps.PlayerRoomInteriorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.PlayerClient.ViewModels"
             AutomationProperties.AutomationId="PlayerRoomInterior_Route">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Помещения" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Обновить список" Command="{Binding RefreshRoomsCommand}"/>
                    <Button Content="Открыть помещение" Margin="8,0,0,0" Command="{Binding OpenSelectedRoomCommand}" IsEnabled="{Binding CanOpenSelectedRoom}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Доступные помещения" FontWeight="Bold"/>
                    <ListBox Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom, Mode=TwoWay}" DisplayMemberPath="Label"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Padding="10"
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="PlayerRoomInterior_Viewer">
                <StackPanel>
                    <TextBlock Text="{Binding RoomName}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding RoomMeta}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding RoomDescription}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding RoomPublicNotes}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Маркеры" FontWeight="Bold" Margin="0,10,0,0"/>
                    <DataGrid Margin="0,6,0,0" ItemsSource="{Binding Markers}" SelectedItem="{Binding SelectedMarker, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="1.2*"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding MarkerTypeDisplay}" Width="1*"/>
                            <DataGridTextColumn Header="Коорд." Binding="{Binding Coordinates}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <StackPanel>
                    <TextBlock Text="Карточка маркера" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedMarkerTitle}" Margin="0,6,0,0" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedMarkerMeta}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding SelectedMarkerDescription}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WarningMessage}" Foreground="#F59E0B" Margin="0,4,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" Margin="0,4,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
