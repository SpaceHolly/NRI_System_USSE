<UserControl x:Class="Nri.PlayerClient.Views.Proposals.PlayerProposalCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12" CornerRadius="8" Background="#1F2937" BorderBrush="#374151" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" Padding="12,6"/>
                <StackPanel>
                    <TextBlock Text="Центр предложений" FontSize="18" FontWeight="SemiBold" Foreground="#F9FAFB"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="12" CornerRadius="8" Background="#111827" BorderBrush="#374151" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Тип предложения" Foreground="#F9FAFB" FontWeight="SemiBold"/>
                        <TextBlock Text="Выберите структурированный сценарий вместо свободной заявки GM." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" DisplayMemberPath="Display"/>
                    <Button Grid.Row="2" Content="Новый черновик" Command="{Binding NewDraftCommand}" Margin="0,10,0,0" Padding="12,6"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="12" CornerRadius="8" Background="#111827" BorderBrush="#374151" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Черновик" Foreground="#F9FAFB" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TitleInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название предложения" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Краткое описание" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="58" Margin="0,8,0,0"/>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Приоритет" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding PriorityInput}" Width="140"/>
                        </DockPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding DisplayLabel}" Foreground="#E5E7EB" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Hint}" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="32"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <TextBox Text="{Binding PlayerCommentInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Комментарий игрока для GM" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="54"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Сохранить черновик" Command="{Binding SaveDraftCommand}" Padding="10,6"/>
                            <Button Content="Проверить" Command="{Binding ValidateDraftCommand}" Margin="6,0,0,0" Padding="10,6"/>
                            <Button Content="Предпросмотр" Command="{Binding PreviewDraftCommand}" Margin="6,0,0,0" Padding="10,6"/>
                            <Button Content="Отправить GM" Command="{Binding SubmitDraftCommand}" Margin="6,0,0,0" Padding="10,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="12" CornerRadius="8" Background="#111827" BorderBrush="#374151" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Мои предложения" Foreground="#F9FAFB" FontWeight="SemiBold"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Drafts}" SelectedItem="{Binding SelectedDraft, Mode=TwoWay}" DisplayMemberPath="Display" Margin="0,8,0,8"/>
                    <WrapPanel Grid.Row="2">
                        <Button Content="Открыть" Command="{Binding LoadDraftCommand}" Padding="10,6"/>
                        <Button Content="Отменить" Command="{Binding CancelDraftCommand}" Margin="6,0,0,0" Padding="10,6"/>
                    </WrapPanel>
                    <TabControl Grid.Row="3" Margin="0,8,0,0">
                        <TabItem Header="Проверка">
                            <ListBox ItemsSource="{Binding ValidationRows}"/>
                        </TabItem>
                        <TabItem Header="Предпросмотр">
                            <ScrollViewer>
                                <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Foreground="#E5E7EB" Margin="8"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="10" CornerRadius="8" Background="#3F1D1D" BorderBrush="#7F1D1D" BorderThickness="1" Margin="0,10,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
