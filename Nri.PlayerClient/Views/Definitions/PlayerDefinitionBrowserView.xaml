<UserControl x:Class="Nri.PlayerClient.Views.Definitions.PlayerDefinitionBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.PlayerClient.ViewModels"
             xmlns:controls="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             AutomationProperties.AutomationId="PlayerDefinitionBrowser_Route">
    <patterns:NriOperationalWorkspaceHost AutomationProperties.AutomationId="PlayerDefinitionBrowser_Workspace">
      <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Справочник мира и игровых правил" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="Доступные игроку сведения о мире, местах, языках, знаниях, снаряжении и магии." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock AutomationProperties.AutomationId="PlayerDefinitionBrowser_Status"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox AutomationProperties.AutomationId="PlayerDefinitionBrowser_FamilyTabs"
                              Width="150"
                              ItemsSource="{Binding FamilyFilters}"
                              SelectedItem="{Binding SelectedFamily}"/>
                    <ComboBox AutomationProperties.AutomationId="PlayerDefinitionBrowser_CategoryList"
                              Width="170"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding CategoryOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedCategory}"/>
                    <TextBox AutomationProperties.AutomationId="PlayerDefinitionBrowser_Search"
                             Width="220"
                             Margin="8,0,0,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по видимым справочникам"/>
                    <Button AutomationProperties.AutomationId="PlayerDefinitionBrowser_SearchButton"
                            Content="Найти"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="8,0,0,0"/>
                    <Button AutomationProperties.AutomationId="PlayerDefinitionBrowser_Refresh"
                            Content="Обновить"
                            Command="{Binding RefreshCommand}"
                            Margin="6,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Доступные записи" Style="{StaticResource SectionTitleTextStyle}"/>
                    <ListBox Grid.Row="1"
                             AutomationProperties.AutomationId="PlayerDefinitionBrowser_DefinitionList"
                             AutomationProperties.Name="Список доступных записей"
                             ItemsSource="{Binding FilteredDefinitions}"
                             SelectedItem="{Binding SelectedDefinition}"
                             Margin="0,8,0,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlayerDefinitionRow}">
                                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding PublicDescription}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="44"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:NriEmptyState Title="Нет доступных записей"
                                            Message="Справочник пока не загружен."
                                            Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <controls:NriEmptyState Title="Ничего не найдено"
                                            Message="Измените запрос или сбросьте фильтры."
                                            Visibility="{Binding IsNoResultsState, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <controls:NriEmptyState Title="Запись недоступна"
                                            Message="Не удалось загрузить справочник. Повторите попытку позже."
                                            Visibility="{Binding IsUnavailableState, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Детали" Style="{StaticResource SectionTitleTextStyle}"/>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="PlayerDefinitionBrowser_DetailsScroll">
                            <StackPanel Visibility="{Binding HasSelectedDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock AutomationProperties.AutomationId="PlayerDefinitionBrowser_Details"
                                           Text="{Binding SelectedDetail.DisplayName}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedDetail.CategoryLabel}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="Описание" Style="{StaticResource TitleTextStyle}" Margin="0,14,0,4"/>
                                <TextBlock Text="{Binding SelectedDetail.PublicDescription}" TextWrapping="Wrap"/>
                                <TextBlock Text="Сведения" Style="{StaticResource TitleTextStyle}" Margin="0,14,0,4"
                                           AutomationProperties.AutomationId="PlayerDefinitionBrowser_PublicFacts"/>
                                <ItemsControl ItemsSource="{Binding DetailFacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock
                                   Text="Выберите запись, чтобы открыть описание."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasNoSelectedDetail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <TextBlock Grid.Row="2"
                               AutomationProperties.AutomationId="PlayerDefinitionBrowser_State"
                               Text="{Binding SummaryText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>
      </Grid>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
