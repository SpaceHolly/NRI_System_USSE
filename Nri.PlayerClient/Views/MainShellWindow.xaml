<Window x:Class="Nri.PlayerClient.Views.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Nri.PlayerClient.Views.Controls"
        xmlns:groups="clr-namespace:Nri.PlayerClient.Views.Groups"
        xmlns:journal="clr-namespace:Nri.PlayerClient.Views.Journal"
        xmlns:shops="clr-namespace:Nri.PlayerClient.Views.Shops"
        xmlns:rest="clr-namespace:Nri.PlayerClient.Views.Rest"
        xmlns:calendar="clr-namespace:Nri.PlayerClient.Views.Calendar"
        xmlns:engineering="clr-namespace:Nri.PlayerClient.Views.Engineering"
        xmlns:production="clr-namespace:Nri.PlayerClient.Views.Production"
        xmlns:proposals="clr-namespace:Nri.PlayerClient.Views.Proposals"
        xmlns:maps="clr-namespace:Nri.PlayerClient.Views.Maps"
        xmlns:definitions="clr-namespace:Nri.PlayerClient.Views.Definitions"
        xmlns:pages="clr-namespace:Nri.PlayerClient.Views.Pages"
        xmlns:sessions="clr-namespace:Nri.PlayerClient.Views.Sessions"
        xmlns:dashboard="clr-namespace:Nri.PlayerClient.Views.Dashboard"
        xmlns:gameplay="clr-namespace:Nri.PlayerClient.Views.Gameplay"
        xmlns:world="clr-namespace:Nri.PlayerClient.Views.World"
        xmlns:vm="clr-namespace:Nri.PlayerClient.ViewModels"
        xmlns:nri="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="NRI System USSE — Игрок"
        Height="900"
        Width="1440"
        MinHeight="740"
        MinWidth="1080"
        Background="{StaticResource NriApplicationBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="PlayerRouteHostTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Visibility="Collapsed"/>
                            <Border Grid.Row="1" Background="Transparent">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                                  KeyboardNavigation.TabIndex="2"
                                                  KeyboardNavigation.TabNavigation="Local"
                                                  KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource NriApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <nri:NriShellHeader Grid.Row="0"
                            ProductName="NRI System USSE"
                            ContextTitle="{Binding ActiveCharacterShellTitle}"
                            ContextSubtitle="{Binding ApplicationContextStatusText}"
                            ConnectionText="{Binding ConnectionState}"
                            UserDisplayName="{Binding PlayerDisplayName}"
                            AutomationProperties.Name="{Binding ActiveCharacterShellTitle}"
                            AutomationProperties.AutomationId="Player_Shell_Header">
            <nri:NriShellHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock AutomationProperties.AutomationId="Player_DisplayName_Text" Text="{Binding PlayerDisplayName}" Width="1" Height="1" Opacity="0.01" IsHitTestVisible="False" Focusable="False"/>
                    <nri:NriOptionField Width="160" ItemsSource="{Binding GameCampaignOptions}" SelectedValue="{Binding SelectedGameCampaignId, UpdateSourceTrigger=PropertyChanged}" AccessibleName="Кампания" AutomationProperties.AutomationId="Player_GameContext_Campaign_Selector"/>
                    <Button Content="Выбрать" Command="{Binding SelectGameCampaignCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="6,0,0,0" AutomationProperties.AutomationId="Player_GameContext_Campaign_Select"/>
                    <TextBlock Text="{Binding ActiveCampaignRoleSummary}" VerticalAlignment="Center" Margin="10,0,0,0"
                               AutomationProperties.AutomationId="Player_GameContext_Campaign_Role"/>
                    <nri:NriOptionField Width="170" ItemsSource="{Binding GameSessionOptions}" SelectedValue="{Binding SelectedGameSessionId, UpdateSourceTrigger=PropertyChanged}" AccessibleName="Сессия" Margin="8,0,0,0" AutomationProperties.AutomationId="Player_GameContext_Session_Selector"/>
                    <Button Content="Открыть" Command="{Binding SelectGameSessionCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="6,0,0,0" AutomationProperties.AutomationId="Player_GameContext_Session_Select"/>
                    <Button AutomationProperties.AutomationId="Player_Global_Refresh_Button" Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource NriSecondaryButtonStyle}"/>
                    <Button AutomationProperties.AutomationId="Player_Server_Button" Content="Подключение" Command="{Binding ToggleConnectionPopupCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0"/>
                    <Button AutomationProperties.AutomationId="Player_Auth_Button" Content="Учётная запись" Command="{Binding ToggleAuthPopupCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0"/>
                </StackPanel>
            </nri:NriShellHeader.Actions>
        </nri:NriShellHeader>

        <Border Grid.Row="1" Margin="12,8,12,0" Padding="12,8"
                Background="{StaticResource NriSecondarySurfaceBrush}"
                BorderBrush="{StaticResource NriWarningBrush}" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding IsConnectionStaleReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="Player_Reconnect_Banner">
            <StackPanel>
                <TextBlock Text="{Binding ReconnectStatusText}" FontWeight="SemiBold"/>
                <TextBlock Text="Соединение восстанавливается. Показанные данные доступны только для чтения; отправка действий временно приостановлена."
                           Style="{StaticResource NriSecondaryTextStyle}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="12,10,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding PlayerNavigationWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Область" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NriCardTitleTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Margin="12,0,0,0" Content="⇤" Command="{Binding ToggleNavigationCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Padding="8" MinWidth="40" AutomationProperties.AutomationId="Player_Navigation_Toggle" AutomationProperties.Name="Свернуть или развернуть навигацию"/>
                    </Grid>
                    <nri:NriModeSwitcher Grid.Row="1" ItemsSource="{Binding PlayerAreas}" SelectedValuePath="Id" SelectedValue="{Binding SelectedPlayerAreaId, Mode=TwoWay}" AutomationProperties.Name="Области игрока" AutomationProperties.AutomationId="Player_Area_Switcher">
                        <nri:NriModeSwitcher.Style>
                            <Style TargetType="nri:NriModeSwitcher" BasedOn="{StaticResource {x:Type nri:NriModeSwitcher}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </nri:NriModeSwitcher.Style>
                        <nri:NriModeSwitcher.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
                            </Style>
                        </nri:NriModeSwitcher.ItemContainerStyle>
                        <nri:NriModeSwitcher.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlayerShellArea}">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </nri:NriModeSwitcher.ItemTemplate>
                    </nri:NriModeSwitcher>
                    <nri:NriNavigationRail Grid.Row="2" Margin="0,10,0,0" Header="Разделы"
                                           ItemsSource="{Binding VisiblePlayerRoutes}"
                                           SelectedValuePath="RouteKey"
                                           SelectedValue="{Binding SelectedPlayerRouteKey, Mode=TwoWay}"
                                           IsCollapsed="{Binding IsNavigationCollapsed}"
                                           AutomationProperties.Name="Разделы игрока"
                                           AutomationProperties.AutomationId="Player_Route_Navigation">
                        <nri:NriNavigationRail.Style>
                            <Style TargetType="nri:NriNavigationRail" BasedOn="{StaticResource {x:Type nri:NriNavigationRail}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </nri:NriNavigationRail.Style>
                        <nri:NriNavigationRail.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
                            </Style>
                        </nri:NriNavigationRail.ItemContainerStyle>
                        <nri:NriNavigationRail.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlayerShellRoute}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DisplayDescription}" Style="{StaticResource NriMetadataTextStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </nri:NriNavigationRail.ItemTemplate>
                    </nri:NriNavigationRail>
                </Grid>
            </Border>
            <nri:NriRouteHost Grid.Column="1"
                              IsHitTestVisible="{Binding AreServerMutationsEnabled}"
                              Breadcrumbs="{Binding SelectedPlayerBreadcrumb}"
                              RouteTitle="{Binding SelectedPlayerRouteTitle}"
                              RouteSubtitle="{Binding SelectedPlayerRouteDescription}"
                              HeaderVisibility="{Binding SelectedPlayerRouteHeaderVisibility}"
                              AutomationProperties.AutomationId="Player_Route_Host">
                <TabControl Style="{StaticResource PlayerRouteHostTabControlStyle}" SelectedValuePath="Tag" SelectedValue="{Binding SelectedMainTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TabItem Header="Игровой центр" Tag="gameCenter" AutomationProperties.AutomationId="PlayerGameCenter_Tab">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <dashboard:PlayerFunctionalDashboardView DataContext="{Binding FunctionalDashboard}"/>
                                <Border Style="{StaticResource CardStyle}" Margin="8,8,8,0">
                                    <sessions:PlayerCurrentSessionView DataContext="{Binding CurrentSession}"/>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="8,8,8,0">
                                    <groups:PlayerActiveGroupView DataContext="{Binding ActiveGroup}"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Поиск" Tag="search" AutomationProperties.AutomationId="PlayerGlobalSearch_Tab">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource CardStyle}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             AutomationProperties.AutomationId="PlayerGlobalSearch_Query"
                                             Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Введите текст для поиска"/>
                                    <ComboBox Grid.Column="1"
                                              AutomationProperties.AutomationId="PlayerGlobalSearch_CategoryFilter"
                                              ItemsSource="{Binding GlobalSearchCategories}"
                                              SelectedItem="{Binding GlobalSearchCategoryFilter, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="8,0,0,0"/>
                                    <Button Grid.Column="2"
                                            AutomationProperties.AutomationId="PlayerGlobalSearch_Button"
                                            Content="Искать"
                                            Command="{Binding GlobalSearchCommand}"
                                            Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <DataGrid Grid.Column="0"
                                          AutomationProperties.AutomationId="PlayerGlobalSearch_Results"
                                          ItemsSource="{Binding GlobalSearchResults}"
                                          SelectedItem="{Binding SelectedGlobalSearchResult}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MinHeight="320">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Название" Binding="{Binding DisplayTitle}" Width="2*"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding DisplayType}" Width="1.2*"/>
                                        <DataGridTextColumn Header="Фрагмент" Binding="{Binding Snippet}" Width="3*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock AutomationProperties.AutomationId="PlayerGlobalSearch_Result_Title"
                                                   Text="{Binding SelectedGlobalSearchTitle}"
                                                   Style="{StaticResource SectionTitleTextStyle}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock AutomationProperties.AutomationId="PlayerGlobalSearch_Result_EntityType"
                                                   Text="{Binding SelectedGlobalSearchType}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock AutomationProperties.AutomationId="PlayerGlobalSearch_Result_Snippet"
                                                   Text="{Binding SelectedGlobalSearchSnippet}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,0"/>
                                        <TextBlock Text="{Binding SelectedGlobalSearchRoute}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,0"/>
                                        <Button AutomationProperties.AutomationId="PlayerGlobalSearch_Open_Button"
                                                Content="Открыть"
                                                Command="{Binding GlobalSearchOpenCommand}"
                                                Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       AutomationProperties.AutomationId="PlayerGlobalSearch_StatusText"
                                       Text="{Binding GlobalSearchStatusText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="4,8,0,0"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Персонажи" Tag="MyCharacters" AutomationProperties.AutomationId="PlayerNav_Characters_Tab">
                        <pages:PlayerCharacterSelectionView/>
                    </TabItem>

                    <TabItem Header="Создать персонажа" Tag="characterCreation" AutomationProperties.AutomationId="PlayerNav_CharacterCreation_Tab">
                        <pages:PlayerCharacterCreationView DataContext="{Binding CharacterCreation}"/>
                    </TabItem>

                    <TabItem Header="Карточка" Tag="character" AutomationProperties.AutomationId="PlayerNav_CharacterCard_Tab">
                        <pages:ActiveCharacterView/>
                    </TabItem>
                    <TabItem Header="Состояние" Tag="liveState" AutomationProperties.AutomationId="PlayerNav_LiveState_Tab">
                        <pages:PlayerLiveActorStateView/>
                    </TabItem>
                    <TabItem Header="Развитие" Tag="development" AutomationProperties.AutomationId="PlayerNav_Development_Tab">
                        <pages:PlayerDevelopmentView/>
                    </TabItem>
                    <TabItem Header="Бой" Tag="combat" AutomationProperties.AutomationId="PlayerNav_Combat_Tab">
                        <pages:CombatView/>
                    </TabItem>
                    <TabItem Header="Чат / кубики" Tag="communication" AutomationProperties.AutomationId="PlayerNav_Communication_Tab">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Чат" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="Откройте отдельное окно чата для сообщений партии." Margin="0,6,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                        <Button Content="Открыть чат"
                                                Click="OpenChatWindow"
                                                Height="34"
                                                AutomationProperties.AutomationId="PlayerCommunication_OpenChat"/>
                                        <TextBlock Margin="0,8,0,0" Text="{Binding ChatSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Быстрый бросок" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="Создайте бросок кубиков от имени активного персонажа." Margin="0,4,0,6" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <TextBlock Text="Режим" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <ComboBox Width="100" ItemsSource="{Binding DiceModeOptions}" SelectedItem="{Binding DiceModeInput}"/>
                                            <TextBlock Text="Кубики" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                            <TextBox Width="36" Text="{Binding DiceCount, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="d" VerticalAlignment="Center"/>
                                            <TextBox Width="46" Text="{Binding DiceFaces, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Width="56" Margin="6,0,0,0" Text="{Binding DiceModifier, UpdateSourceTrigger=PropertyChanged}" ToolTip="Модификатор"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Text="Видимость" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <ComboBox Width="130" ItemsSource="{Binding DiceVisibilityOptions}" SelectedItem="{Binding DiceVisibilityInput}"/>
                                            <Button Margin="6,0,0,0" Content="Бросить" Command="{Binding CreateDiceRequestCommand}"/>
                                        </WrapPanel>
                                        <TextBox Margin="0,6,0,0" Text="{Binding DiceDescriptionInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Комментарий к броску"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Мои броски" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="Показываются только ваши броски." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                                    <ListBox ItemsSource="{Binding DiceFeedRows}" MinHeight="520"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Заявки и предложения" Tag="requests" AutomationProperties.AutomationId="PlayerRequests_Tab">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Мои заявки и предложения" FontWeight="Bold" FontSize="16"/>
                                        <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshRequestsCommand}" AutomationProperties.AutomationId="PlayerRequests_Refresh_Button"/>
                                    </DockPanel>
                                    <TextBlock Text="Здесь отображаются только ваши заявки, предложения и решения GM, видимые игроку." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="Статус" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Width="170" ItemsSource="{Binding PlayerRequestStatusFilterOptions}" SelectedItem="{Binding PlayerRequestStatusFilterInput}" AutomationProperties.AutomationId="PlayerRequests_Filter_Status"/>
                                    </WrapPanel>
                                    <ListBox ItemsSource="{Binding RequestRows}" SelectedItem="{Binding SelectedRequestRow, UpdateSourceTrigger=PropertyChanged}" MinHeight="420" AutomationProperties.AutomationId="PlayerRequests_List"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Новая заявка или предложение" FontWeight="Bold" FontSize="16"/>
                                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Тип заявки" Foreground="{StaticResource MutedBrush}"/>
                                                    <ComboBox ItemsSource="{Binding PlayerRequestTypeOptions}" SelectedItem="{Binding PlayerRequestTypeInput}" MinWidth="180" AutomationProperties.AutomationId="PlayerRequests_Type"/>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Персонаж" Foreground="{StaticResource MutedBrush}"/>
                                                    <ComboBox ItemsSource="{Binding MyCharacters}" SelectedItem="{Binding SelectedMyCharacter}" DisplayMemberPath="Name" MinWidth="180" AutomationProperties.AutomationId="PlayerRequests_Character"/>
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBox Margin="0,8,0,0" Text="{Binding PlayerRequestTitleInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Заголовок" AutomationProperties.AutomationId="PlayerRequests_Title"/>
                                            <TextBox Margin="0,8,0,0" MinHeight="82" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding PlayerRequestDescriptionInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Подробности" AutomationProperties.AutomationId="PlayerRequests_Details"/>
                                            <TextBox Margin="0,8,0,0" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding PlayerRequestReasonInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Причина" AutomationProperties.AutomationId="PlayerRequests_Reason"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="Отправить" Command="{Binding CreatePlayerRequestCommand}" AutomationProperties.AutomationId="PlayerRequests_Submit_Button"/>
                                                <Button Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Content="Отменить" Command="{Binding CancelRequestCommand}" AutomationProperties.AutomationId="PlayerRequests_Cancel_Button"/>
                                                <Button Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Content="Отправить повторно" Command="{Binding ResubmitRequestCommand}" AutomationProperties.AutomationId="PlayerRequests_Resubmit_Button"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Выбранная заявка или предложение" FontWeight="Bold" FontSize="16"/>
                                            <TextBlock Text="{Binding SelectedRequestTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="PlayerRequests_Selected_Title"/>
                                            <TextBlock Text="{Binding SelectedRequestStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" AutomationProperties.AutomationId="PlayerRequests_Selected_Status"/>
                                            <TextBlock Text="{Binding SelectedRequestActors}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PlayerRequests_Selected_Actors"/>
                                            <TextBlock Text="{Binding SelectedRequestDetails}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <TextBlock Text="Решение GM" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                            <TextBlock Text="{Binding SelectedRequestDecision}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" AutomationProperties.AutomationId="PlayerRequests_Selected_Decision"/>
                                            <TextBlock Text="Игрок видит только свои заявки, предложения и открытые комментарии GM." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PlayerRequests_StatusText"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Инженерия" Tag="engineering">
                        <engineering:PlayerEngineeringView DataContext="{Binding Engineering}"/>
                    </TabItem>
                    <TabItem Header="Производство" Tag="production">
                        <production:PlayerProductionView DataContext="{Binding Production}"/>
                    </TabItem>
                    <TabItem Header="Конструкторы активов"
                             Tag="player.asset_configurators"
                             AutomationProperties.AutomationId="PlayerAssetConfigurators_Tab">
                        <engineering:PlayerAssetConfiguratorsView DataContext="{Binding AssetConfigurators}"/>
                    </TabItem>
                    <TabItem Header="Музыка" Tag="audio" AutomationProperties.AutomationId="PlayerAudio_Tab">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Музыка сессии" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock AutomationProperties.AutomationId="PlayerAudio_CurrentTrack_Title" Text="{Binding AudioCurrentTrackTitle}" TextWrapping="Wrap"/>
                                        <TextBlock AutomationProperties.AutomationId="PlayerAudio_CurrentCategory" Text="{Binding AudioCurrentCategory, StringFormat=Категория: {0}}" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock AutomationProperties.AutomationId="PlayerAudio_PlaybackState" Text="{Binding AudioPlaybackStateText, StringFormat=Состояние: {0}}" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" AutomationProperties.AutomationId="PlayerAudio_Refresh_Button" Content="Обновить" Command="{Binding AudioRefreshCommand}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Текущий статус" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding AudioStateText}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                                        <TextBlock Text="Видимые треки" FontWeight="Bold"/>
                                        <ItemsControl ItemsSource="{Binding AudioVisibleTrackRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Margin="0,3,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Локальные настройки" FontWeight="Bold"/>
                                        <TextBlock Text="Громкость" Margin="0,8,0,0"/>
                                        <Slider AutomationProperties.AutomationId="PlayerAudio_LocalVolume" Minimum="0" Maximum="1" Value="{Binding LocalVolume, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox AutomationProperties.AutomationId="PlayerAudio_Mute_Toggle" Content="Без звука" IsChecked="{Binding LocalMuted}" Margin="0,8,0,0"/>
                                        <Button AutomationProperties.AutomationId="PlayerAudio_SaveLocalSettings_Button" Content="Сохранить" Command="{Binding AudioApplyLocalSettingsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2" AutomationProperties.AutomationId="PlayerAudio_StatusText" Text="{Binding AudioStatusText}" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Журнал событий" Tag="journal" AutomationProperties.AutomationId="PlayerNav_EventJournal_Tab">
                        <journal:PlayerEventJournalView DataContext="{Binding EventJournal}"/>
                    </TabItem>
                    <TabItem Header="Игровой цикл" Tag="gameplay" AutomationProperties.AutomationId="PlayerGameplay_Route">
                        <gameplay:PlayerGameplayView DataContext="{Binding Gameplay}"/>
                    </TabItem>
                    <TabItem Header="Задачи" Tag="quests" AutomationProperties.AutomationId="PlayerQuestJournal_Route">
                        <journal:PlayerQuestJournalView DataContext="{Binding QuestJournal}"/>
                    </TabItem>
                    <TabItem Header="Магазины" Tag="shops" AutomationProperties.AutomationId="PlayerShop_Tab">
                        <shops:PlayerShopView DataContext="{Binding Shops}"/>
                    </TabItem>
                    <TabItem Header="Отдых" Tag="rest" AutomationProperties.AutomationId="PlayerRest_Tab">
                        <rest:PlayerRestView DataContext="{Binding Rest}"/>
                    </TabItem>
                    <TabItem Header="Календарь" Tag="calendar" AutomationProperties.AutomationId="PlayerNav_Calendar_Tab">
                        <TabControl>
                            <TabItem Header="Мир">
                                <calendar:PlayerWorldCalendarView DataContext="{Binding WorldCalendar}"/>
                            </TabItem>
                            <TabItem Header="Расписание">
                                <calendar:PlayerRealScheduleView DataContext="{Binding RealSchedule}"/>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="Карта сцены" Tag="sceneMap" AutomationProperties.AutomationId="PlayerNav_SceneMap_Tab">
                        <maps:PlayerSceneMapView DataContext="{Binding SceneMap}"/>
                    </TabItem>
                    <TabItem Header="Карта мира" Tag="worldMap" AutomationProperties.AutomationId="PlayerNav_WorldMap_Tab">
                        <maps:PlayerWorldMapView DataContext="{Binding WorldMap}"/>
                    </TabItem>
                    <TabItem Header="Погода и путешествия" Tag="weatherTravel" AutomationProperties.AutomationId="PlayerNav_WeatherTravel_Tab">
                        <world:PlayerWeatherTravelView/>
                    </TabItem>
                    <TabItem Header="Справочник" Tag="definitions" AutomationProperties.AutomationId="PlayerDefinitionBrowser_Tab">
                        <definitions:PlayerDefinitionBrowserView DataContext="{Binding DefinitionBrowser}"/>
                    </TabItem>
                    <TabItem Header="Помещения" Tag="rooms">
                        <maps:PlayerRoomInteriorView DataContext="{Binding RoomInterior}"/>
                    </TabItem>
                </TabControl>
            </nri:NriRouteHost>
        </Grid>

        <nri:NriActivityDock Grid.Row="3" Margin="12,0,12,4"
                             Header="Активность: чат, события, кубики и заявки"
                             IsOpen="{Binding IsActivityDockOpen}"
                             CompactWhenClosed="True"
                             ToggleCommand="{Binding ToggleActivityDockCommand}"
                             AutomationProperties.AutomationId="Player_Activity_Dock">
            <TabControl MaxHeight="230" AutomationProperties.AutomationId="Player_Activity_Tabs">
                <TabItem Header="Чат">
                    <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ChatSummary}" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Открыть чат" Click="OpenChatWindow" Margin="12,0,0,0"/></Grid>
                </TabItem>
                <TabItem Header="События">
                    <ListBox ItemsSource="{Binding SessionStateRows}" Margin="8" MinHeight="80"/>
                </TabItem>
                <TabItem Header="Кубики">
                    <ListBox ItemsSource="{Binding DiceFeedRows}" Margin="8" MinHeight="80"/>
                </TabItem>
                <TabItem Header="Заявки">
                    <ListBox ItemsSource="{Binding RequestRows}" Margin="8" MinHeight="80"/>
                </TabItem>
            </TabControl>
        </nri:NriActivityDock>

        <nri:NriConnectionDialog Grid.RowSpan="4"
                                 IsOpen="{Binding IsConnectionPopupOpen, Mode=TwoWay}"
                                 CloseCommand="{Binding ToggleConnectionPopupCommand}"
                                 Title="Подключение к серверу"
                                 Message="Подключитесь к серверу кампании. Адрес доступен только в дополнительных параметрах."
                                 AutomationProperties.AutomationId="Player_Connection_Dialog">
            <StackPanel>
                <TextBlock AutomationProperties.AutomationId="Player_ConnectionPopup_State" Text="{Binding ConnectionState}" FontWeight="SemiBold"/>
                <TextBlock AutomationProperties.AutomationId="Player_ConnectionPopup_Detail" Text="{Binding ConnectionStatusDetail}" Style="{StaticResource NriSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Expander Header="Дополнительно" Margin="0,12,0,0" AutomationProperties.AutomationId="Player_Connection_Advanced">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Адрес сервера"/>
                        <TextBox AutomationProperties.AutomationId="Player_ServerHost_Input" Text="{Binding ServerHostInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Порт" Margin="0,8,0,0"/>
                        <TextBox AutomationProperties.AutomationId="Player_ServerPort_Input" Text="{Binding ServerPortInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding LastServerHost, StringFormat=Последний адрес: {0}}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding LastServerPort, StringFormat=Последний порт: {0}}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button AutomationProperties.AutomationId="Player_Connection_Apply" Content="Применить" Command="{Binding ApplyConnectionSettingsCommand}" Style="{StaticResource NriSecondaryButtonStyle}"/>
                            <Button Content="Сбросить" Command="{Binding ResetConnectionDefaultsCommand}" Style="{StaticResource NriSecondaryButtonStyle}"/>
                            <Button Content="Использовать последнее" Command="{Binding UseLastConnectionCommand}" Style="{StaticResource NriSecondaryButtonStyle}"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>
                <Button AutomationProperties.AutomationId="Player_Connect_Button" Content="Подключиться" Command="{Binding ConnectToServerCommand}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
            </StackPanel>
        </nri:NriConnectionDialog>

        <nri:NriLoginDialog Grid.RowSpan="4"
                            IsOpen="{Binding IsAuthPopupOpen, Mode=TwoWay}"
                            Title="Вход"
                            Message="Войдите в учётную запись игрока, чтобы открыть кампанию и активного персонажа."
                            AutomationProperties.AutomationId="Player_Login_Dialog">
            <StackPanel>
                <TextBlock Text="Логин"/>
                <TextBox AutomationProperties.AutomationId="Player_Login_Text" Text="{Binding LoginText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Пароль" Margin="0,8,0,0"/>
                <PasswordBox x:Name="AuthPasswordBox" AutomationProperties.AutomationId="Player_Password_Box" PasswordChanged="OnAuthPasswordChanged"/>
                <TextBox AutomationProperties.AutomationId="Player_Password_Automation_Text" Text="{Binding PasswordText, UpdateSourceTrigger=PropertyChanged}" Width="1" Height="1" Opacity="0.01" IsTabStop="False" Margin="0"/>
                <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Регистрация" Command="{Binding RegisterCommand}" Style="{StaticResource NriSecondaryButtonStyle}"/>
                    <Button AutomationProperties.AutomationId="Player_Login_Button" Content="Войти" Command="{Binding LoginCommand}"/>
                </WrapPanel>
                <Expander Header="Дополнительно" Margin="0,10,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Старый пароль"/>
                        <PasswordBox x:Name="OldPasswordBox" PasswordChanged="OnOldPasswordChanged"/>
                        <TextBlock Text="Новый пароль" Margin="0,8,0,0"/>
                        <PasswordBox x:Name="NewPasswordBox" PasswordChanged="OnNewPasswordChanged"/>
                        <Button Content="Сменить пароль" Command="{Binding ChangePasswordCommand}" Style="{StaticResource NriSecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </nri:NriLoginDialog>
    </Grid>
</Window>
