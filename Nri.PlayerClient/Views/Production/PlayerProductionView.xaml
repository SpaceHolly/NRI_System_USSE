<UserControl x:Class="Nri.PlayerClient.Views.Production.PlayerProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nri="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             Background="{StaticResource NriApplicationBackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             AutomationProperties.AutomationId="PlayerProduction_Route">
    <patterns:NriOperationalWorkspaceHost Margin="10"
                                          AutomationProperties.AutomationId="PlayerProduction_Workspace">
        <patterns:NriOperationalWorkspaceHost.Header>
            <nri:NriPageHeader Breadcrumbs="Персонаж"
                               Title="Производство"
                               Subtitle="Оценки, заказы и видимые производственные проекты."
                               StatusText="{Binding StatusMessage}">
                <nri:NriPageHeader.PrimaryAction>
                    <Button Content="Обновить"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="PlayerProduction_Refresh"/>
                </nri:NriPageHeader.PrimaryAction>
            </nri:NriPageHeader>
        </patterns:NriOperationalWorkspaceHost.Header>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <TabControl AutomationProperties.AutomationId="PlayerProduction_Lists">
                    <TabItem Header="Мощности">
                        <ListBox ItemsSource="{Binding Facilities}"
                                 SelectedItem="{Binding SelectedFacility, Mode=TwoWay}"
                                 HorizontalContentAlignment="Stretch"
                                 AutomationProperties.AutomationId="PlayerProduction_FacilityList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Оценки">
                        <ListBox ItemsSource="{Binding Quotes}"
                                 SelectedItem="{Binding SelectedQuote, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Secondary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Заказы">
                        <ListBox ItemsSource="{Binding Orders}"
                                 SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                 DisplayMemberPath="Summary"/>
                    </TabItem>
                    <TabItem Header="Проекты">
                        <ListBox ItemsSource="{Binding ManufacturingProjects}"
                                 SelectedItem="{Binding SelectedManufacturingProject, Mode=TwoWay}"
                                 DisplayMemberPath="Summary"/>
                    </TabItem>
                    <TabItem Header="Изготовление">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Мои проекты изготовления"
                                       FontWeight="SemiBold"
                                       Margin="4,4,4,8"/>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding CraftProjects0191}"
                                     SelectedItem="{Binding SelectedCraftProject0191, Mode=TwoWay}"
                                     HorizontalContentAlignment="Stretch"
                                     AutomationProperties.AutomationId="PlayerCraftProject_List">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding RecipeName}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Ограниченные партии">
                        <ListBox ItemsSource="{Binding LimitedProjects0196}"
                                 SelectedItem="{Binding SelectedLimitedProject0196, Mode=TwoWay}"
                                 HorizontalContentAlignment="Stretch"
                                 AutomationProperties.AutomationId="PlayerLimitedProduction_ProjectList">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="4"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Строительство">
                        <ListBox ItemsSource="{Binding ConstructionProjects0197}"
                                 SelectedItem="{Binding SelectedConstructionProject0197, Mode=TwoWay}"
                                 HorizontalContentAlignment="Stretch"
                                 AutomationProperties.AutomationId="PlayerAssetConstruction_ProjectList">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding LocationName}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Готовые активы">
                        <ListBox ItemsSource="{Binding Assets}" DisplayMemberPath="Summary"/>
                    </TabItem>
                    <TabItem Header="Эксплуатация активов">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding AssetOperations0198}"
                                     SelectedItem="{Binding SelectedAssetOperation0198, Mode=TwoWay}"
                                     DisplayMemberPath="Summary"
                                     AutomationProperties.AutomationId="PlayerAssetOperation_AssetList"/>
                            <ListBox Grid.Row="1" Margin="0,8,0,0"
                                     ItemsSource="{Binding AssetMaintenanceProjects0198}"
                                     SelectedItem="{Binding SelectedAssetMaintenanceProject0198, Mode=TwoWay}"
                                     DisplayMemberPath="Summary"
                                     AutomationProperties.AutomationId="PlayerAssetMaintenance_ProjectList"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <TabControl>
                    <TabItem Header="Новая заявка">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <TextBlock Text="Что требуется *" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding RequestSummary, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Кратко опишите, что нужно оценить или заказать."
                                         AutomationProperties.AutomationId="PlayerProduction_RequestSummary"/>
                                <TextBlock Text="Подробности" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding RequestDetails, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="70"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         ToolTip="Комментарий для GM"
                                         AutomationProperties.AutomationId="PlayerProduction_RequestDetails"/>

                                <TextBlock Text="Производственная мощность" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                <ComboBox ItemsSource="{Binding Facilities}"
                                          SelectedItem="{Binding SelectedFacility, Mode=TwoWay}"
                                          ToolTip="Выберите доступную производственную мощность."
                                          AutomationProperties.AutomationId="PlayerProduction_FacilitySelector">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Type}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Secondary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Чертёж" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <ComboBox ItemsSource="{Binding AvailableBlueprints}"
                                          SelectedItem="{Binding SelectedBlueprint, Mode=TwoWay}"
                                          ToolTip="Выберите доступный чертёж."
                                          AutomationProperties.AutomationId="PlayerProduction_BlueprintSelector">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DisplayMeta}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Готовый вариант" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <ComboBox ItemsSource="{Binding AvailablePresets}"
                                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                          ToolTip="Выберите готовую конфигурацию, если она подходит."
                                          AutomationProperties.AutomationId="PlayerProduction_PresetSelector">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DisplayMeta}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border Background="{StaticResource NriSecondarySurfaceBrush}"
                                        BorderBrush="{StaticResource NriBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Резюме заявки" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding RequestDraftSummary}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   AutomationProperties.AutomationId="PlayerProduction_RequestDraftSummary"/>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Очистить выбор"
                                            Command="{Binding ClearRequestSelectionCommand}"
                                            Style="{StaticResource NriSecondaryButtonStyle}"
                                            AutomationProperties.AutomationId="PlayerProduction_ClearSelection"/>
                                    <Button Content="Проверить заявку"
                                            Command="{Binding PreviewRequestCommand}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.AutomationId="PlayerProduction_PreviewRequest"/>
                                    <Button Content="Запросить оценку"
                                            Command="{Binding RequestQuoteCommand}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.AutomationId="PlayerProduction_RequestQuote"/>
                                    <Button Content="Запросить заказ"
                                            Command="{Binding RequestOrderCommand}"
                                            Margin="8,0,0,0"/>
                                    <Button Content="Принять оценку"
                                            Command="{Binding AcceptQuoteCommand}"
                                            Margin="8,0,0,0"/>
                                    <Button Content="Отклонить оценку"
                                            Command="{Binding RejectQuoteCommand}"
                                            Margin="8,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Ход производства">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TabControl>
                                <TabItem Header="Стадии"><ListBox ItemsSource="{Binding Stages}" DisplayMemberPath="Summary"/></TabItem>
                                <TabItem Header="Ресурсы"><ListBox ItemsSource="{Binding Resources}" DisplayMemberPath="Summary"/></TabItem>
                                <TabItem Header="Платежи"><ListBox ItemsSource="{Binding Payments}" DisplayMemberPath="Summary"/></TabItem>
                                <TabItem Header="Испытания"><ListBox ItemsSource="{Binding Tests}" DisplayMemberPath="Summary"/></TabItem>
                                <TabItem Header="Замечания"><ListBox ItemsSource="{Binding Defects}" DisplayMemberPath="Summary"/></TabItem>
                            </TabControl>
                            <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                                <Button Content="Запросить прогресс" Command="{Binding RequestManufacturingProgressCommand}"/>
                                <Button Content="Запросить приёмку" Command="{Binding RequestAcceptanceCommand}" Margin="8,0,0,0"/>
                                <Button Content="Запросить передачу техники" Command="{Binding RequestTransferCommand}" Margin="8,0,0,0"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Проект изготовления">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <TextBlock Text="Доступный рецепт *" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding CraftRecipes0191}"
                                          SelectedItem="{Binding SelectedCraftRecipe0191, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch"
                                          AutomationProperties.AutomationId="PlayerCraftProject_RecipeSelector">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding OutputName, StringFormat=Результат: {0}}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Название проекта *" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding CraftProjectName0191, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Понятное название, которое увидят вы и GM."
                                         AutomationProperties.AutomationId="PlayerCraftProject_Name"/>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Проверить условия"
                                            Command="{Binding PreviewCraftCommand0191}"
                                            AutomationProperties.AutomationId="PlayerCraftProject_Preview"/>
                                    <Button Content="Создать черновик"
                                            Command="{Binding CreateCraftCommand0191}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.AutomationId="PlayerCraftProject_Create"/>
                                    <Button Content="Отправить GM"
                                            Command="{Binding SubmitCraftCommand0191}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.AutomationId="PlayerCraftProject_Submit"/>
                                    <Button Content="Отменить проект"
                                            Command="{Binding CancelCraftCommand0191}"
                                            Style="{StaticResource NriSecondaryButtonStyle}"
                                            Margin="8,0,0,0"/>
                                    <Button Content="Обновить"
                                            Command="{Binding RefreshCraftCommand0191}"
                                            Style="{StaticResource NriSecondaryButtonStyle}"
                                            Margin="8,0,0,0"/>
                                </WrapPanel>

                                <Border Background="{StaticResource NriSecondarySurfaceBrush}"
                                        BorderBrush="{StaticResource NriBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CraftState0191}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CraftExpectedDuration0191}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding SelectedCraftProject0191.CurrentStageName, StringFormat=Текущая стадия: {0}}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding SelectedCraftProject0191.ProgressPercent, StringFormat=Готовность: {0}%}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CraftResult0191, StringFormat=Создано: {0}}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TabControl Margin="0,12,0,0" MinHeight="190"
                                            AutomationProperties.AutomationId="PlayerCraftProject_Details">
                                    <TabItem Header="Условия">
                                        <ListBox ItemsSource="{Binding CraftRequirements0191}" DisplayMemberPath="Summary"/>
                                    </TabItem>
                                    <TabItem Header="Материалы">
                                        <ListBox ItemsSource="{Binding CraftResources0191}" DisplayMemberPath="Summary"/>
                                    </TabItem>
                                    <TabItem Header="Стадии">
                                        <ListBox ItemsSource="{Binding CraftStages0191}" DisplayMemberPath="Summary"/>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Ограниченная партия">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4"
                                        AutomationProperties.AutomationId="PlayerLimitedProduction_Form">
                                <TextBlock Text="Допущенный прототип *"
                                           FontWeight="SemiBold"/>
                                <ListBox ItemsSource="{Binding LimitedCandidates0196}"
                                         SelectedItem="{Binding SelectedLimitedCandidate0196, Mode=TwoWay}"
                                         HorizontalContentAlignment="Stretch"
                                         MinHeight="72"
                                         MaxHeight="156"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Допущенные прототипы"
                                         AutomationProperties.AutomationId="PlayerLimitedProduction_PrototypeSelector">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding BlueprintName}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding RemainingUnits, StringFormat=Доступно по допуску: {0}}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding SelectedLimitedCandidate0196.Summary}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="PlayerLimitedProduction_PrototypeSelector_SelectedName"/>

                                <TextBlock Text="Размер партии *"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,0"/>
                                <ComboBox ItemsSource="{Binding LimitedBatchSizes0196}"
                                          SelectedItem="{Binding LimitedBatchSize0196, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="PlayerLimitedProduction_BatchSize"/>

                                <TextBlock Text="Название проекта *"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,0"/>
                                <TextBox Text="{Binding LimitedProjectName0196, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Понятное название партии для вас и GM."
                                         AutomationProperties.AutomationId="PlayerLimitedProduction_Name"/>

                                <Border Background="{StaticResource NriSecondarySurfaceBrush}"
                                        BorderBrush="{StaticResource NriBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LimitedDraftSummary0196}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Ограниченная партия не является серийным производством."
                                                   Foreground="{StaticResource NriWarningBrush}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Проверить партию"
                                            Command="{Binding PreviewLimitedProductionCommand0196}"
                                            AutomationProperties.AutomationId="PlayerLimitedProduction_Preview"/>
                                    <Button Content="Создать черновик"
                                            Command="{Binding CreateLimitedProductionCommand0196}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.AutomationId="PlayerLimitedProduction_Create"/>
                                    <Button Content="Отправить GM"
                                            Command="{Binding SubmitLimitedProductionCommand0196}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.AutomationId="PlayerLimitedProduction_Submit"/>
                                    <Button Content="Отменить"
                                            Command="{Binding CancelLimitedProductionCommand0196}"
                                            Style="{StaticResource NriSecondaryButtonStyle}"
                                            Margin="8,0,0,0"/>
                                    <Button Content="Обновить"
                                            Command="{Binding RefreshLimitedProductionCommand0196}"
                                            Style="{StaticResource NriSecondaryButtonStyle}"
                                            Margin="8,0,0,0"/>
                                </WrapPanel>

                                <TextBlock Text="{Binding LimitedState0196}"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedLimitedProject0196.CurrentStageName, StringFormat=Текущая стадия: {0}}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedLimitedProject0196.ResultSummary}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NriSuccessBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="PlayerLimitedProduction_Result"/>
                                <TabControl Margin="0,12,0,0"
                                            MinHeight="190"
                                            AutomationProperties.AutomationId="PlayerLimitedProduction_Details">
                                    <TabItem Header="Условия">
                                        <ListBox ItemsSource="{Binding LimitedRequirements0196}"
                                                 DisplayMemberPath="Summary"/>
                                    </TabItem>
                                    <TabItem Header="Материалы"
                                             AutomationProperties.AutomationId="PlayerLimitedProduction_MaterialsTab">
                                        <ListBox ItemsSource="{Binding LimitedResources0196}"
                                                 DisplayMemberPath="Summary"
                                                 AutomationProperties.AutomationId="PlayerLimitedProduction_Resources"/>
                                    </TabItem>
                                    <TabItem Header="Стадии">
                                        <ListBox ItemsSource="{Binding LimitedStages0196}"
                                                 DisplayMemberPath="Summary"
                                                 AutomationProperties.AutomationId="PlayerLimitedProduction_Stages">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Строительство">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="PlayerAssetConstruction_Form">
                            <StackPanel Margin="4">
                                <TextBlock Text="Опубликованный чертёж здания *" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding ConstructionBlueprints0197}"
                                          SelectedItem="{Binding SelectedConstructionBlueprint0197, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch"
                                          AutomationProperties.AutomationId="PlayerAssetConstruction_BlueprintSelector">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DisplaySummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Место строительства *" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <ComboBox ItemsSource="{Binding ConstructionLocations0197}"
                                          SelectedItem="{Binding SelectedConstructionLocation0197, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch"
                                          AutomationProperties.AutomationId="PlayerAssetConstruction_LocationSelector">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DisplaySummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Название проекта *" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding ConstructionProjectName0197, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Понятное название для вас и GM."
                                         AutomationProperties.AutomationId="PlayerAssetConstruction_Name"/>

                                <TextBlock Text="{Binding ConstructionSelectionSummary0197}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                                <TextBlock Text="Это крупный актив, а не предмет инвентаря."
                                           Foreground="{StaticResource NriWarningBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Проверить требования"
                                            Command="{Binding PreviewConstructionCommand0197}"
                                            AutomationProperties.AutomationId="PlayerAssetConstruction_Preview"/>
                                    <Button Content="Создать черновик"
                                            Command="{Binding CreateConstructionCommand0197}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.AutomationId="PlayerAssetConstruction_Create"/>
                                    <Button Content="Отправить GM"
                                            Command="{Binding SubmitConstructionCommand0197}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.AutomationId="PlayerAssetConstruction_Submit"/>
                                    <Button Content="Отменить"
                                            Command="{Binding CancelConstructionCommand0197}"
                                            Style="{StaticResource NriSecondaryButtonStyle}"
                                            Margin="8,0,0,0"/>
                                    <Button Content="Обновить"
                                            Command="{Binding RefreshConstructionCommand0197}"
                                            Style="{StaticResource NriSecondaryButtonStyle}"
                                            Margin="8,0,0,0"/>
                                </WrapPanel>

                                <TextBlock Text="{Binding ConstructionState0197}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"
                                           AutomationProperties.AutomationId="PlayerAssetConstruction_Status"/>
                                <TextBlock Text="{Binding ConstructionPreviewSummary0197}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedConstructionProject0197.CurrentStageName, StringFormat=Текущая стадия: {0}}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{Binding SelectedConstructionProject0197.ProgressPercent, Mode=OneWay}"
                                             Height="10" Margin="0,8,0,0"/>

                                <TabControl Margin="0,12,0,0" MinHeight="190"
                                            AutomationProperties.AutomationId="PlayerAssetConstruction_Details">
                                    <TabItem Header="Условия">
                                        <ListBox ItemsSource="{Binding ConstructionRequirements0197}" DisplayMemberPath="Summary"/>
                                    </TabItem>
                                    <TabItem Header="Материалы по стадиям">
                                        <ListBox ItemsSource="{Binding ConstructionResources0197}" DisplayMemberPath="Summary"/>
                                    </TabItem>
                                    <TabItem Header="Стадии">
                                        <ListBox ItemsSource="{Binding ConstructionStages0197}" DisplayMemberPath="Summary"/>
                                    </TabItem>
                                    <TabItem Header="Готовое здание">
                                        <TextBlock Text="{Binding ConstructionAssetSummary0197}"
                                                   TextWrapping="Wrap"
                                                   Margin="8"
                                                   AutomationProperties.AutomationId="PlayerAssetConstruction_CompletedAsset"/>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Эксплуатация активов">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="PlayerAssetOperation_Workspace">
                            <StackPanel Margin="4">
                                <TextBlock Text="Эксплуатация и обслуживание крупного актива"
                                           FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Готовность, обязательные условия и история обслуживания без внутренних идентификаторов."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,12"/>
                                <TextBlock Text="{Binding AssetOperationSummary0198}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="PlayerAssetOperation_Summary"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Запросить ввод в эксплуатацию"
                                            Command="{Binding RequestAssetActivationCommand0198}"
                                            AutomationProperties.AutomationId="PlayerAssetOperation_RequestActivation"/>
                                    <Button Content="Обновить" Margin="8,0,0,0"
                                            Style="{StaticResource NriSecondaryButtonStyle}"
                                            Command="{Binding RefreshAssetMaintenanceCommand0198}"/>
                                </WrapPanel>
                                <TextBlock Text="Условия эксплуатации" FontWeight="SemiBold" Margin="0,16,0,6"/>
                                <ListBox ItemsSource="{Binding AssetOperationRequirements0198}" MaxHeight="150"
                                         AutomationProperties.AutomationId="PlayerAssetOperation_Requirements"/>
                                <TextBlock Text="Подготовить обслуживание" FontWeight="SemiBold" Margin="0,16,0,6"/>
                                <TextBox Text="{Binding AssetMaintenanceProjectName0198, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Понятное название проекта для вас и GM."
                                         AutomationProperties.AutomationId="PlayerAssetMaintenance_Name"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Создать черновик" Command="{Binding CreateAssetMaintenanceCommand0198}"
                                            AutomationProperties.AutomationId="PlayerAssetMaintenance_Create"/>
                                    <Button Content="Отправить GM" Margin="8,0,0,0" Command="{Binding SubmitAssetMaintenanceCommand0198}"
                                            AutomationProperties.AutomationId="PlayerAssetMaintenance_Submit"/>
                                    <Button Content="Отменить" Margin="8,0,0,0" Style="{StaticResource NriSecondaryButtonStyle}"
                                            Command="{Binding CancelAssetMaintenanceCommand0198}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding AssetMaintenanceState0198}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           AutomationProperties.AutomationId="PlayerAssetMaintenance_Status"/>
                                <ProgressBar Minimum="0" Maximum="100" Height="10" Margin="0,8,0,0"
                                             Value="{Binding SelectedAssetMaintenanceProject0198.ProgressPercent}"/>
                                <TabControl Margin="0,12,0,0" MinHeight="170">
                                    <TabItem Header="Условия"><ListBox ItemsSource="{Binding AssetMaintenanceRequirements0198}"/></TabItem>
                                    <TabItem Header="Ресурсы"><ListBox ItemsSource="{Binding AssetMaintenanceResources0198}"/></TabItem>
                                    <TabItem Header="Стадии"><ListBox ItemsSource="{Binding AssetMaintenanceStages0198}"/></TabItem>
                                    <TabItem Header="История"><ListBox ItemsSource="{Binding AssetServiceHistory0198}"/></TabItem>
                                </TabControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <patterns:NriOperationalWorkspaceHost.Status>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Скрыть ошибку"
                        Command="{Binding ClearErrorCommand}"
                        Margin="8,0,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="PlayerProduction_Error"/>
            </DockPanel>
        </patterns:NriOperationalWorkspaceHost.Status>
    </patterns:NriOperationalWorkspaceHost>
</UserControl>
