<UserControl x:Class="Nri.PlayerClient.Views.Pages.PlayerCharacterSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nri="clr-namespace:Nri.Ui.Wpf.Controls;assembly=Nri.Ui.Wpf"
             xmlns:patterns="clr-namespace:Nri.Ui.Wpf.Patterns;assembly=Nri.Ui.Wpf"
             Background="{StaticResource NriApplicationBackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             AutomationProperties.AutomationId="PlayerCharacters_Route">
    <patterns:NriCollectionBrowserHost ContentState="{Binding CharacterSelectionContentState}"
                                       IsInspectorOpen="True"
                                       AutomationProperties.AutomationId="PlayerCharacters_CollectionHost">
        <patterns:NriCollectionBrowserHost.Header>
            <nri:NriPageHeader Breadcrumbs="Персонаж"
                               Title="Мои персонажи"
                               Subtitle="Выберите героя для текущей игровой сессии."
                               StatusText="{Binding CharacterSelectionStatusText}">
                <nri:NriPageHeader.PrimaryAction>
                    <Button Content="Обновить"
                            Command="{Binding RefreshCharactersCommand}"
                            AutomationProperties.AutomationId="PlayerCharacters_Refresh"/>
                </nri:NriPageHeader.PrimaryAction>
            </nri:NriPageHeader>
        </patterns:NriCollectionBrowserHost.Header>

        <patterns:NriCollectionBrowserHost.Collection>
            <ListBox x:Name="MyCharactersList"
                     ItemsSource="{Binding MyCharacters}"
                     SelectedItem="{Binding SelectedMyCharacter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="PlayerCharacters_List"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,8"
                                Padding="14"
                                AutomationProperties.Name="{Binding AccessibleSummary}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold"
                                               FontSize="17"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTitleDisplay}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"
                                               AutomationProperties.AutomationId="PlayerCharacters_ListCardTitle"/>
                                    <TextBlock Text="{Binding CharacterKindDisplay}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <nri:NriStatusBadge Grid.Column="1"
                                                    Text="{Binding ActivityText}"
                                                    StatusKind="{Binding ActivityStatusKind}"
                                                    Margin="12,0,0,0"/>

                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding PublicSummary}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>

                                <WrapPanel Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Race, StringFormat=Раса: {0}}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding CharacterStatusDisplay, StringFormat=Состояние: {0}}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding AvailabilityText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </patterns:NriCollectionBrowserHost.Collection>

        <patterns:NriCollectionBrowserHost.Inspector>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel AutomationProperties.AutomationId="PlayerCharacters_SelectedCard">
                    <TextBlock Text="Выбранный персонаж"
                               Style="{StaticResource NriSectionTitleTextStyle}"/>
                    <TextBlock Text="{Binding SelectedMyCharacter.Name, TargetNullValue=Персонаж не выбран}"
                               FontSize="20"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding SelectedMyCharacter.CharacterKindDisplay}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>

                    <Border Style="{StaticResource CardStyle}"
                            Background="{StaticResource PanelAltBrush}"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedMyCharacter.AvailabilityText}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedMyCharacter.PublicSummary}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding SelectedMyCharacter.GroupDisplay, StringFormat=Группа: {0}}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding SelectedMyCharacter.SelectedTitleDisplay, StringFormat=Титул: {0}}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       AutomationProperties.AutomationId="PlayerCharacters_SelectedTitle"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Выбрать активным"
                            Command="{Binding SetActiveCharacterCommand}"
                            IsEnabled="{Binding CanSetActiveCharacter}"
                            Margin="0,16,0,0"
                            AutomationProperties.AutomationId="PlayerCharacters_SetActive"/>
                    <Button Content="Открыть карточку"
                            Command="{Binding OpenSelectedCharacterCommand}"
                            IsEnabled="{Binding CanOpenSelectedCharacter}"
                            Margin="0,8,0,0"
                            AutomationProperties.AutomationId="PlayerCharacters_OpenCard"/>

                    <TextBlock Text="{Binding CharacterSelectionFeedbackText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0"
                               AutomationProperties.AutomationId="PlayerCharacters_Feedback"/>
                </StackPanel>
            </ScrollViewer>
        </patterns:NriCollectionBrowserHost.Inspector>
    </patterns:NriCollectionBrowserHost>
</UserControl>
