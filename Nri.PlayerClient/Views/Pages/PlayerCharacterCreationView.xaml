<UserControl x:Class="Nri.PlayerClient.Views.Pages.PlayerCharacterCreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.PlayerClient.ViewModels"
             AutomationProperties.AutomationId="PlayerCharacterCreation_Route">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Создание персонажа" Style="{StaticResource NriPageTitleTextStyle}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="Кампания: " Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CampaignDisplay}" FontWeight="SemiBold"/>
                        <TextBlock Text="  ·  Статус: " Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="PlayerCharacterCreation_DraftStatus"/>
                    </WrapPanel>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox Width="250" ItemsSource="{Binding Drafts}" SelectedItem="{Binding SelectedDraft}" DisplayMemberPath="Summary"
                              AutomationProperties.Name="Сохранённые черновики"
                              AutomationProperties.AutomationId="PlayerCharacterCreation_Drafts"/>
                    <Button Content="Открыть" Command="{Binding OpenDraftCommand}" Margin="8,0,0,0" Style="{StaticResource NriSecondaryButtonStyle}" AutomationProperties.AutomationId="PlayerCharacterCreation_OpenDraft"/>
                    <Button Content="Новый" Command="{Binding NewDraftCommand}" Margin="8,0,0,0" Style="{StaticResource NriSecondaryButtonStyle}" AutomationProperties.AutomationId="PlayerCharacterCreation_NewDraft"/>
                    <Button Content="Обновить" Command="{Binding LoadCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="PlayerCharacterCreation_Refresh"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" MinWidth="620"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="PlayerCharacterCreation_FormScroll">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="Основные сведения" Style="{StaticResource NriSectionTitleTextStyle}"/>
                        <TextBlock Text="Имя персонажа *" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                                 AutomationProperties.AutomationId="PlayerCharacterCreation_Name" AutomationProperties.Name="Имя персонажа"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Родитель 1 / основная линия *" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ParentOrigins}" SelectedItem="{Binding Parent1}" DisplayMemberPath="DisplayName"
                                          AutomationProperties.AutomationId="PlayerCharacterCreation_Parent1" AutomationProperties.Name="Основная линия происхождения"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Родитель 2 *" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ParentOrigins}" SelectedItem="{Binding Parent2}" DisplayMemberPath="DisplayName"
                                          AutomationProperties.AutomationId="PlayerCharacterCreation_Parent2" AutomationProperties.Name="Вторая линия происхождения"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Подвид" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableSubtypes}" SelectedItem="{Binding Subtype}" DisplayMemberPath="DisplayName"
                                          AutomationProperties.AutomationId="PlayerCharacterCreation_Subtype" AutomationProperties.Name="Подвид происхождения"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Рост, см *" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding HeightCm, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="PlayerCharacterCreation_Height"/>
                                <TextBlock Text="{Binding HeightRange}" Style="{StaticResource NriMetadataTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Возраст *" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding AgeYears, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="PlayerCharacterCreation_Age"/>
                                <TextBlock Text="{Binding AgeRange}" Style="{StaticResource NriMetadataTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Характеристики" Style="{StaticResource NriSectionTitleTextStyle}" Margin="0,18,0,6"/>
                        <TextBlock Text="Распределите набор +2, +1, 0, 0, −1, −2. Бонус происхождения рассчитывает сервер."
                                   Style="{StaticResource NriMetadataTextStyle}" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Attributes}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                  MinHeight="205" Margin="0,8,0,0" AutomationProperties.AutomationId="PlayerCharacterCreation_Attributes">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Характеристика" Binding="{Binding DisplayName}" IsReadOnly="True" Width="2*"/>
                                <DataGridTemplateColumn Header="Распределено" Width="120">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.AttributeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Allocated, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Происхождение" Binding="{Binding Origin, StringFormat={}{0:+0;-0;0}}" IsReadOnly="True" Width="120"/>
                                <DataGridTextColumn Header="Итого" Binding="{Binding Effective, StringFormat={}{0:+0;-0;0}}" IsReadOnly="True" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Expander Header="Подхарактеристики" IsExpanded="True" Margin="0,14,0,0" AutomationProperties.AutomationId="PlayerCharacterCreation_SubAttributes">
                            <DataGrid ItemsSource="{Binding SubAttributes}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="190">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Характеристика → подхарактеристика" Binding="{Binding DisplayLabel}" IsReadOnly="True" Width="2*"/>
                                    <DataGridTemplateColumn Header="Специализация" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.AttributeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Allocated, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Происхождение" Binding="{Binding Origin, StringFormat={}{0:+0;-0;0}}" IsReadOnly="True" Width="120"/>
                                    <DataGridTextColumn Header="Итого" Binding="{Binding Effective, StringFormat={}{0:+0;-0;0}}" IsReadOnly="True" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>

                        <Expander Header="Стартовые языки" IsExpanded="False" Margin="0,14,0,0" AutomationProperties.AutomationId="PlayerCharacterCreation_Languages">
                            <StackPanel>
                                <TextBlock Text="Языковая среда происхождения" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding LanguageGrantProfiles}" SelectedItem="{Binding SelectedLanguageGrantProfile, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="PlayerCharacterCreation_LanguageGrantProfile"/>
                                <TextBlock Text="Укажите только изученные языки. Уровень 0 означает, что язык не выбран; обязательные сочетания проверяет сервер."
                                           Style="{StaticResource NriMetadataTextStyle}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                <Border BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Выбранные языки" Style="{StaticResource NriSectionTitleTextStyle}"/>
                                        <TextBlock Text="{Binding LanguageAllocationSummary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   AutomationProperties.AutomationId="PlayerCharacterCreation_LanguageSummary"/>
                                    </StackPanel>
                                </Border>
                                <DataGrid ItemsSource="{Binding LanguageAllocation}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="220" MaxHeight="280">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Язык" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                                        <DataGridTextColumn Header="Назначение" Binding="{Binding Roles}" IsReadOnly="True" Width="2*"/>
                                        <DataGridTemplateColumn Header="Уровень" Width="105">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.LanguageLevelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="Предыстория" Style="{StaticResource NriSectionTitleTextStyle}" Margin="0,18,0,6"/>
                        <TextBox Text="{Binding Backstory, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="PlayerCharacterCreation_Backstory" AutomationProperties.Name="Предыстория персонажа"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14" AutomationProperties.AutomationId="PlayerCharacterCreation_OriginInspector">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Происхождение" Style="{StaticResource NriSectionTitleTextStyle}"/>
                        <TextBlock Text="{Binding ResolvedOrigin}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" AutomationProperties.AutomationId="PlayerCharacterCreation_ResolvedOrigin"/>
                        <TextBlock Text="{Binding OriginDescription}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="10"
                                AutomationProperties.AutomationId="PlayerCharacterCreation_PhysiologySummary">
                            <StackPanel>
                                <TextBlock Text="Физиология" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding HeightRange}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding LifespanSummary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding ProtectionSummary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding EquipmentFitWarning}" Foreground="{StaticResource NriWarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding HasEquipmentFitWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding HasStrongSides, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Сильные стороны" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <ItemsControl ItemsSource="{Binding StrongSides}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasWeakSides, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Слабые стороны" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <ItemsControl ItemsSource="{Binding WeakSides}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasTraits, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Наследственные свойства" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <ItemsControl ItemsSource="{Binding Traits}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasOriginBonuses, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="PlayerCharacterCreation_OriginBonuses">
                            <TextBlock Text="Бонусы происхождения" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <ItemsControl ItemsSource="{Binding OriginBonusExplanations}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasLanguages, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Языки" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <ItemsControl ItemsSource="{Binding Languages}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasSpecialSenses, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Особые чувства" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <ItemsControl ItemsSource="{Binding SpecialSenses}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasMovementAbilities, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Особое движение" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <ItemsControl ItemsSource="{Binding MovementAbilities}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" AutomationProperties.AutomationId="PlayerCharacterCreation_Validation">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ReturnComment, StringFormat=Комментарий GM: {0}}" Foreground="{StaticResource NriWarningBrush}" TextWrapping="Wrap" Visibility="{Binding HasReturnComment, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Проверить" Command="{Binding PreviewCommand}" Style="{StaticResource NriSecondaryButtonStyle}"
                            AutomationProperties.AutomationId="PlayerCharacterCreation_Preview"/>
                    <Button Content="Сохранить черновик" Command="{Binding SaveDraftCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="PlayerCharacterCreation_SaveDraft"/>
                    <Button Content="Отправить GM" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" Margin="8,0,0,0" AutomationProperties.AutomationId="PlayerCharacterCreation_Submit"/>
                    <Button Content="Отменить" Command="{Binding CancelCommand}" Style="{StaticResource NriSecondaryButtonStyle}" Margin="8,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
