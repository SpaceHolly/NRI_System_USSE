<UserControl x:Class="Nri.PlayerClient.Views.Pages.PlayerLiveActorStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="PlayerLiveState_Root">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshLiveActorStateCommand}" AutomationProperties.AutomationId="PlayerLiveState_Refresh"/>
                <StackPanel>
                    <TextBlock Text="{Binding LiveActorName}" Style="{StaticResource NriPageTitleTextStyle}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding LiveActorLifeState}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="  •  " Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LiveActorActionEconomyText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding LiveActorWarningText}" Foreground="{StaticResource NriWarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="PlayerLiveState_ReconciliationWarning">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding LiveActorWarningText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl Grid.Row="1" AutomationProperties.AutomationId="PlayerLiveState_Tabs">
            <TabItem Header="Обзор" AutomationProperties.AutomationId="PlayerLiveState_OverviewTab">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding LiveActorResources}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8" Padding="12"><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontWeight="Bold"/></DockPanel><ProgressBar Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Current}" Height="8" Margin="0,10,0,6"/><TextBlock Text="{Binding DetailText}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Активные эффекты" Style="{StaticResource SectionTitleTextStyle}"/><ItemsControl ItemsSource="{Binding LiveActorEffects}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding DurationText}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Нет видимых эффектов." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LiveActorEffects.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Separator Margin="0,16,0,12"/><TextBlock Text="Спутники" Style="{StaticResource SectionTitleTextStyle}"/><ItemsControl ItemsSource="{Binding LiveActorCompanions}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Нет доступных спутников." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LiveActorCompanions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></ScrollViewer></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Возможности и эффекты" AutomationProperties.AutomationId="PlayerLiveState_CapabilitiesTab">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding LiveActorCapabilities}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="PlayerLiveState_Capabilities"><DataGrid.Columns><DataGridTextColumn Header="Характеристика / навык" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="База" Binding="{Binding Base}" Width="80"/><DataGridTextColumn Header="Эффективно" Binding="{Binding Effective}" Width="100"/><DataGridTextColumn Header="Расчёт" Binding="{Binding Breakdown}" Width="2.5*"/></DataGrid.Columns></DataGrid>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14" Margin="10,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Действующие эффекты" Style="{StaticResource SectionTitleTextStyle}"/><ItemsControl ItemsSource="{Binding LiveActorEffects}" Margin="0,10,0,0" AutomationProperties.AutomationId="PlayerLiveState_CapabilityEffects"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding DurationText}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Нет видимых эффектов." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LiveActorEffects.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Действия" AutomationProperties.AutomationId="PlayerLiveState_ActionsTab">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding LiveActorActions}" SelectedItem="{Binding SelectedLiveAction}" AutomationProperties.AutomationId="PlayerLiveState_Actions"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding AvailabilityText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding Charges, StringFormat='Заряды: {0}'}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Выбранное действие" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="{Binding SelectedLiveAction.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedLiveAction.AvailabilityText}" TextWrapping="Wrap" Margin="0,6,0,0"/><Button Content="Выполнить" Command="{Binding ExecuteLiveActionCommand}" Margin="0,16,0,0" AutomationProperties.AutomationId="PlayerLiveState_ExecuteAction"/><Separator Margin="0,18,0,12"/><TextBlock Text="Выполняется и поддерживается" Style="{StaticResource SectionTitleTextStyle}"/><ItemsControl ItemsSource="{Binding LiveActorExecutions}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource NriBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Нет выполняемых действий." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LiveActorExecutions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></ScrollViewer></Border></Grid>
            </TabItem>
            <TabItem Header="Снаряжение и боеприпасы" AutomationProperties.AutomationId="PlayerLiveState_LoadoutTab">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding LiveActorWeapons}" SelectedItem="{Binding SelectedLiveWeapon}" AutomationProperties.AutomationId="PlayerLiveState_Weapons"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding AmmoText}"/><TextBlock Text="{Binding ConditionText}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="14"><StackPanel><TextBlock Text="Активное оружие" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="{Binding SelectedLiveWeapon.AmmoText}" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedLiveWeapon.FireMode, StringFormat='Режим огня: {0}'}" Margin="0,6,0,0"/><Button Content="Перезарядить" Command="{Binding ReloadLiveWeaponCommand}" Margin="0,16,0,0" AutomationProperties.AutomationId="PlayerLiveState_Reload"/></StackPanel></Border></Grid>
            </TabItem>
            <TabItem Header="История" AutomationProperties.AutomationId="PlayerLiveState_HistoryTab"><ListBox ItemsSource="{Binding LiveActorHistory}" Margin="8"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Text}" FontWeight="SemiBold"/><TextBlock Text="{Binding Change}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding LiveActorStatusText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,8,0,0" AutomationProperties.AutomationId="PlayerLiveState_Status"/>
    </Grid>
</UserControl>
