                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Навыки компаньона" FontWeight="Bold" FontSize="16"/>
                                                                <TextBlock Text="Известные навыки и развитие компаньона." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                                            </StackPanel>
