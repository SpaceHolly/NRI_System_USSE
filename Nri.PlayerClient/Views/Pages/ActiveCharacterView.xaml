                                                        <DataGridTextColumn Header="Навык" Binding="{Binding DisplayName}" Width="1.4*"/>
                                                        <DataGridTextColumn Header="Код" Binding="{Binding SkillCode}" Width="1*"/>
                                                        <DataGridTextColumn Header="Ранг" Binding="{Binding Rank}" Width="70"/>
                                                        <DataGridTextColumn Header="Бонус" Binding="{Binding TotalBonus}" Width="80"/>
                                                        <DataGridTextColumn Header="Разбор" Binding="{Binding Breakdown}" Width="2*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
