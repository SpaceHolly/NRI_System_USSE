                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Компаньоны">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ListBox x:Name="CompanionList"
                                                 AutomationProperties.AutomationId="PlayerCharacter_Companions_Table"
                                                 ItemsSource="{Binding Companions}"
                                                 SelectedItem="{Binding SelectedCompanion, Mode=TwoWay}"
                                                 DisplayMemberPath="NameDisplay">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <TabControl Grid.Column="1" Margin="8,0,0,0" DataContext="{Binding SelectedCompanion}">
                                            <TabItem Header="Обзор">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <Grid Margin="4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding NameDisplay}" FontSize="22" FontWeight="Bold"/>
                                                                    <TextBlock Text="{Binding SpeciesDisplay, StringFormat=Тип: {0}}" Foreground="{StaticResource MutedBrush}"/>
                                                                    <TextBlock Text="{Binding StatusLabel, StringFormat=Статус: {0}}" Foreground="{StaticResource MutedBrush}"/>
                                                                    <TextBlock Text="{Binding OwnerCharacterId, StringFormat=Владелец: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="Описание" FontWeight="Bold"/>
                                                                    <TextBlock Text="{Binding Description, TargetNullValue=Описание отсутствует}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="Заметки" FontWeight="Bold"/>
                                                                    <TextBlock Text="{Binding NotesDisplay}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="Показатели" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                                                        <StackPanel>
                                                                            <TextBlock Text="Витальные" FontWeight="Bold" Margin="0,0,0,6"/>
                                                                            <ItemsControl ItemsSource="{Binding CoreStatRows}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <DockPanel Margin="0,2,0,2">
                                                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Left"/>
                                                                                            <TextBlock Text="{Binding Value}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                                                        </DockPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                                                        <StackPanel>
                                                                            <TextBlock Text="Характеристики" FontWeight="Bold" Margin="0,0,0,6"/>
                                                                            <TextBlock Text="Таблица характеристик"
                                                                                       FontSize="1"
                                                                                       Opacity="0.01"
                                                                                       Height="1"
                                                                                       AutomationProperties.AutomationId="PlayerCharacter_Attributes_Table"/>
                                                                            <ItemsControl ItemsSource="{Binding AttributeStatRows}"
                                                                                          AutomationProperties.AutomationId="PlayerCharacter_Attributes_Table">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel Margin="0,2,0,4"
                                                                                                    AutomationProperties.AutomationId="{Binding AttributeGroupAutomationId}">
                                                                                            <DockPanel>
                                                                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Left"/>
                                                                                                <TextBlock Text="{Binding Value}"
                                                                                                           AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                                                           FontWeight="Bold"
                                                                                                           HorizontalAlignment="Right"/>
                                                                                            </DockPanel>
                                                                                            <ItemsControl ItemsSource="{Binding SubAttributes}" Margin="18,2,0,0">
                                                                                                <ItemsControl.ItemTemplate>
                                                                                                    <DataTemplate>
                                                                                                        <DockPanel Margin="0,1,0,1">
                                                                                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Left"/>
                                                                                                            <TextBlock Text="{Binding Value}"
                                                                                                                       AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                                                                       FontSize="11"
                                                                                                                       FontWeight="SemiBold"
                                                                                                                       HorizontalAlignment="Right"/>
                                                                                                        </DockPanel>
                                                                                                    </DataTemplate>
                                                                                                </ItemsControl.ItemTemplate>
                                                                                            </ItemsControl>
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="Инвентарь" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                                                                <TextBlock Text="Предметы и снаряжение компаньона." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                                                <ListBox ItemsSource="{Binding InventoryRows}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="Владения">
                                                <Grid Margin="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Владения компаньона" FontWeight="Bold" FontSize="16"/>
                                                                <TextBlock Text="Имущество и активы, связанные с компаньоном." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
