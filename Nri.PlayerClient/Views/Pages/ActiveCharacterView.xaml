                                                        AutomationProperties.AutomationId="PlayerCharacter_SkillCheck_Button"
                                                        Content="Проверка навыка"
                                                        Command="{Binding SkillCheckRollCommand}"/>
                                                <TextBlock Margin="0,8,0,0" Text="{Binding SelectedSkillSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>

