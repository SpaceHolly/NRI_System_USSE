<UserControl x:Class="Nri.PlayerClient.Views.Pages.ActiveCharacterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nri.PlayerClient.Views.Controls"
             Background="{StaticResource BgBrush}"
             Foreground="{StaticResource TextBrush}">
                        <Grid Margin="8" Background="{StaticResource BgBrush}">
                            <TabControl>
                                <TabItem Header="Обзор">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <Grid Margin="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="0,0,0,8">
                                                <StackPanel AutomationProperties.AutomationId="PlayerCharacter_OwnerGroupStatus_Section">
                                                    <TextBlock Text="{Binding ActiveCharacterStatusText}" FontWeight="SemiBold"/>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <TextBlock AutomationProperties.AutomationId="PlayerCharacter_Owner_Display"
                                                                   Text="{Binding CharacterOwnerDisplay, StringFormat=Владелец: {0}}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Margin="0,0,12,0"/>
                                                        <TextBlock AutomationProperties.AutomationId="PlayerCharacter_Group_Display"
                                                                   Text="{Binding CharacterGroupDisplay, StringFormat=Группа: {0}}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Margin="0,0,12,0"/>
                                                        <TextBlock AutomationProperties.AutomationId="PlayerCharacter_Kind_Display"
                                                                   Text="{Binding CharacterKindDisplay, StringFormat=Тип: {0}}"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                    </WrapPanel>
                                                    <TextBox AutomationProperties.AutomationId="PlayerCharacter_OwnerGroupStatus_Probe"
                                                             Text="{Binding CharacterOwnershipReadOnlySummary, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Foreground="{StaticResource MutedBrush}"
                                                             Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CharacterNameDisplay}" FontSize="22" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding CharacterRaceDisplay, StringFormat=Раса: {0}}" Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding CharacterAgeDisplay, StringFormat=Возраст: {0}}" Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding CharacterHeightDisplay, StringFormat=Рост: {0}}" Foreground="{StaticResource MutedBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" AutomationProperties.AutomationId="PlayerCharacter_Backstory_Section" AutomationProperties.Name="Предыстория">
                                                        <TextBlock Text="Предыстория" FontWeight="Bold"/>
                                                        <TextBlock AutomationProperties.AutomationId="PlayerCharacter_Backstory_Text"
                                                                   Text="{Binding CharacterBackstoryDisplay}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Показатели" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                                            <StackPanel>
                                                                <TextBlock Text="Витальные" FontWeight="Bold" Margin="0,0,0,6"/>
                                                                <TextBlock Text="Таблица витальных показателей"
                                                                           FontSize="1"
                                                                           Opacity="0.01"
                                                                           Height="1"
                                                                           AutomationProperties.AutomationId="PlayerCharacter_Vitals_Table"/>
                                                                <ItemsControl ItemsSource="{Binding CoreStatRows}"
                                                                              AutomationProperties.AutomationId="PlayerCharacter_Vitals_Table">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Margin="0,2,0,4"
                                                                                        AutomationProperties.AutomationId="{Binding AttributeGroupAutomationId}">
                                                                                <DockPanel>
                                                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Left"/>
                                                                                    <TextBlock Text="{Binding Value}"
                                                                                               AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                                               FontWeight="Bold"
                                                                                               HorizontalAlignment="Right"/>
                                                                                </DockPanel>
                                                                                <ItemsControl ItemsSource="{Binding SubAttributes}" Margin="18,2,0,0">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <DockPanel Margin="0,1,0,1">
                                                                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Left"/>
                                                                                                <TextBlock Text="{Binding Value}"
                                                                                                           AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                                                           FontSize="11"
                                                                                                           FontWeight="SemiBold"
                                                                                                           HorizontalAlignment="Right"/>
                                                                                            </DockPanel>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                                            <StackPanel>
                                                                <TextBlock Text="Характеристики" FontWeight="Bold" Margin="0,0,0,6"/>
                                                                <TextBlock Text="Таблица характеристик"
                                                                           FontSize="1"
                                                                           Opacity="0.01"
                                                                           Height="1"
                                                                           AutomationProperties.AutomationId="PlayerCharacter_Attributes_Table"/>
                                                                <ItemsControl ItemsSource="{Binding AttributeStatRows}"
                                                                              AutomationProperties.AutomationId="PlayerCharacter_Attributes_Table">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Margin="0,2,0,4"
                                                                                        AutomationProperties.AutomationId="{Binding AttributeGroupAutomationId}">
                                                                                <DockPanel>
                                                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Left"/>
                                                                                    <TextBlock Text="{Binding Value}"
                                                                                               AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                                               FontWeight="Bold"
                                                                                               HorizontalAlignment="Right"/>
                                                                                </DockPanel>
                                                                                <ItemsControl ItemsSource="{Binding SubAttributes}" Margin="18,2,0,0">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <DockPanel Margin="0,1,0,1">
                                                                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="11" DockPanel.Dock="Left"/>
                                                                                                <TextBlock Text="{Binding Value}"
                                                                                                           AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                                                           FontSize="11"
                                                                                                           HorizontalAlignment="Right"/>
                                                                                            </DockPanel>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="0,8,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="Производные параметры" FontWeight="Bold" Margin="0,0,0,6"/>
                                                            <TextBlock Text="Рассчитывается сервером. Если данных нет, значения не подменяются подхарактеристиками."
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       Margin="0,0,0,6"/>
                                                            <TextBlock Text="Таблица производных параметров"
                                                                       FontSize="1"
                                                                       Opacity="0.01"
                                                                       Height="1"
                                                                       AutomationProperties.AutomationId="PlayerCharacter_DerivedStats_Table"/>
                                                            <ItemsControl ItemsSource="{Binding DerivedStatRows}"
                                                                          AutomationProperties.AutomationId="PlayerCharacter_DerivedStats_Table">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <DockPanel Margin="0,2,0,2">
                                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Left"/>
                                                                            <TextBlock Text="{Binding Value}"
                                                                                       AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                                       FontWeight="Bold"
                                                                                       HorizontalAlignment="Right"/>
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Деньги" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                                                        <ItemsControl ItemsSource="{Binding MoneyRows}"
                                                                      AutomationProperties.AutomationId="PlayerCharacter_Currencies_Table">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="4"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Ellipse Width="12" Height="12" Fill="{Binding Color}" Margin="0,0,6,0"/>
                                                                            <TextBlock Text="{Binding Name}" Width="95"/>
                                                                            <TextBlock Text="{Binding AmountDisplay}"
                                                                                       AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                                       FontWeight="SemiBold"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="8,0,0,0">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Монеты опыта" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                                                            <TextBlock Text="{Binding ExperienceCoinsDisplay}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Инвентарь" FontWeight="Bold"/>
                                                        <TextBlock Text="Таблица инвентаря"
                                                                   FontSize="1"
                                                                   Opacity="0.01"
                                                                   Height="1"
                                                                   AutomationProperties.AutomationId="PlayerCharacter_Inventory_Table"/>
                                                        <ItemsControl ItemsSource="{Binding InventoryItems}"
                                                                      AutomationProperties.AutomationId="PlayerCharacter_Inventory_Table">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="0,3,0,3">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           AutomationProperties.AutomationId="{Binding ItemAutomationId}"
                                                                                           FontWeight="SemiBold"
                                                                                           TextWrapping="Wrap"/>
                                                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                                                <TextBlock Text="{Binding Slot, StringFormat=Слот: {0}}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding QuantityDisplay, StringFormat=x{0}}"
                                                                                       AutomationProperties.AutomationId="{Binding QuantityAutomationId}"
                                                                                       Margin="8,0,0,0"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding IsEquipped, StringFormat=Экип.: {0}}"
                                                                                       AutomationProperties.AutomationId="{Binding EquippedAutomationId}"
                                                                                       Margin="8,0,0,0"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Владения" FontWeight="Bold"/>
                                                        <ItemsControl ItemsSource="{Binding HoldingsRows}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Компаньоны" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding CharacterVisibilityDisplay}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6"/>
                                                        <ItemsControl ItemsSource="{Binding Companions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="Инвентарь" AutomationProperties.AutomationId="PlayerCharacter_Inventory_Tab">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Инвентарь" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="Предметы и экипировка персонажа." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <ListView Grid.Row="1"
                                                          AutomationProperties.AutomationId="PlayerCharacter_Inventory_Table"
                                                          x:Name="InventoryList"
                                                          ItemsSource="{Binding InventoryItems}"
                                                          SelectedItem="{Binding SelectedInventoryItem, Mode=TwoWay}">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="Имя" Width="180">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock AutomationProperties.AutomationId="{Binding ItemAutomationId}" Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Кол-во" Width="68">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock AutomationProperties.AutomationId="{Binding QuantityAutomationId}" Text="{Binding QuantityDisplay}"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Экип." Width="82">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock AutomationProperties.AutomationId="{Binding EquippedAutomationId}" Text="{Binding IsEquipped}"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Прочность" Width="86" DisplayMemberBinding="{Binding Durability}"/>
                                                            <GridViewColumn Header="Категория" Width="120" DisplayMemberBinding="{Binding Category}"/>
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="8,0,0,0">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="Карточка предмета" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="{Binding SelectedInventoryItem.Name, TargetNullValue=Предмет не выбран}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                    <TextBlock Text="Описание" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding SelectedInventoryItem.Description, TargetNullValue=Описание отсутствует}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="Категория" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                    <Border Style="{StaticResource CardStyle}" Background="#FF223452">
                                                        <TextBlock Text="{Binding SelectedInventoryItem.Category, StringFormat=Категория: {0}, TargetNullValue=Категория не выбрана}" TextWrapping="Wrap"/>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Владения">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Владения" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="Имущество, связи и активы персонажа." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <ListView Grid.Row="1"
                                                          x:Name="HoldingsList"
                                                          AutomationProperties.AutomationId="PlayerCharacter_Holdings_Table"
                                                          ItemsSource="{Binding HoldingsItems}"
                                                          SelectedItem="{Binding SelectedHoldingItem, Mode=TwoWay}">
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="{x:Type ListViewItem}">
                                                            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="Название" Width="170" DisplayMemberBinding="{Binding Name}"/>
                                                            <GridViewColumn Header="Тип" Width="120" DisplayMemberBinding="{Binding Type}"/>
                                                            <GridViewColumn Header="Статус" Width="90" DisplayMemberBinding="{Binding StatusLabel}"/>
                                                            <GridViewColumn Header="Описание" Width="260" DisplayMemberBinding="{Binding Preview}"/>
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="8,0,0,0">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="Карточка владения" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="{Binding SelectedHoldingItem.Name, TargetNullValue=Владение не выбрано}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                    <TextBlock Text="Тип" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding SelectedHoldingItem.Type, StringFormat=Тип: {0}, TargetNullValue=Тип не указан}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SelectedHoldingItem.OwnersDisplay, StringFormat=Владельцы: {0}, TargetNullValue=Владельцы: —}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SelectedHoldingItem.StatusLabel, StringFormat=Статус: {0}, TargetNullValue=Статус: —}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="Описание" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding SelectedHoldingItem.Description, TargetNullValue=Описание отсутствует}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="Заметки" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding SelectedHoldingItem.Notes, TargetNullValue=Заметок нет}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Репутация">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                            <StackPanel>
                                                <TextBlock Text="Репутация" FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="Отношения с фракциями, локациями и группами." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                                                <ListBox x:Name="ReputationList" AutomationProperties.AutomationId="PlayerCharacter_Reputation_Table" ItemsSource="{Binding ReputationRows}">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="{x:Type ListBoxItem}">
                                                            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource CardStyle}" Background="#FF223452" Margin="0,0,0,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding TargetTypeLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                                        <TextBlock Text="{Binding RelationshipLabel}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Карточка репутации" FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="{Binding ElementName=ReputationList, Path=SelectedItem.Label, TargetNullValue=Репутация не выбрана}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding ElementName=ReputationList, Path=SelectedItem.TargetTypeLabel, StringFormat=Тип цели: {0}, TargetNullValue=Тип цели: —}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding ElementName=ReputationList, Path=SelectedItem.ScopeTypeLabel, StringFormat=Область: {0}, TargetNullValue=Область: —}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding ElementName=ReputationList, Path=SelectedItem.StatusLabel, StringFormat=Статус: {0}, TargetNullValue=Статус: —}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding ElementName=ReputationList, Path=SelectedItem.RelationshipLabel, StringFormat=Отношение: {0}, TargetNullValue=Отношение: —}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding ElementName=ReputationList, Path=SelectedItem.NotesPreview, TargetNullValue=Заметок нет}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                <Border Style="{StaticResource CardStyle}" Background="#FF223452" Margin="0,10,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ElementName=ReputationList, Path=SelectedItem.ValueText, TargetNullValue=—}" FontWeight="SemiBold"/>
                                                        <ProgressBar Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding ElementName=ReputationList, Path=SelectedItem.Percent}"
                                                                     Foreground="{Binding ElementName=ReputationList, Path=SelectedItem.BarBrush}"
                                                                     Background="{StaticResource PanelBrush}"
                                                                     Height="16"
                                                                     Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Знания">
                                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Знания персонажа" FontWeight="Bold" FontSize="16"/>
