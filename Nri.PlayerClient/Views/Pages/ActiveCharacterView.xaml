                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <StackPanel>
                                                                <TextBlock Text="Карточка навыка" FontWeight="Bold" FontSize="16"/>
                                                                <TextBlock Text="{Binding ElementName=CompanionSkillsList, Path=SelectedItem, TargetNullValue=Навык не выбран}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                                <TextBlock Text="Тип" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                                <TextBlock Text="Уровень / ранг / источник"/>
                                                                <TextBlock Text="Описание" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                                <TextBlock Text="Выберите навык, чтобы увидеть подробности." TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Grid>
                                            </TabItem>
                                            <TabItem Header="Знания">
                                                <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Знания компаньона" FontWeight="Bold" FontSize="16"/>
                                                        <TextBlock Text="Языки, локации, технологии и сведения компаньона." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                                        <ListBox ItemsSource="{Binding KnowledgeRows}" MinHeight="240"/>
                                                    </StackPanel>
                                                </Border>
                                            </TabItem>
                                            <TabItem Header="Исследования">
                                                <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Исследования компаньона" FontWeight="Bold" FontSize="16"/>
                                                        <TextBlock Text="Исследования компаньона пока отсутствуют." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                                        <ListBox ItemsSource="{Binding ResearchRows}" MinHeight="240"/>
                                                    </StackPanel>
                                                </Border>
                                            </TabItem>
                                            <TabItem Header="Крафт">
                                                <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="Крафт компаньона" FontWeight="Bold" FontSize="16"/>
                                                        <TextBlock Text="Крафт компаньона будет добавлен позже." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                                        <ListBox ItemsSource="{Binding CraftingRows}" MinHeight="240"/>
                                                    </StackPanel>
                                                </Border>
                                            </TabItem>
                                            <TabItem Header="Развитие">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                                            <StackPanel>
                                                                <TextBlock Text="Направления развития компаньона." Foreground="{StaticResource MutedBrush}"/>
                                                                <controls:ClassHexDirectionView Height="280" Margin="8"
                                                                                            DirectionSelectCommand="{Binding DataContext.AcquireClassNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.1*"/>
                                                                <ColumnDefinition Width="1.1*"/>
                                                                <ColumnDefinition Width="1.4*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                    </Grid.RowDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Направления" FontWeight="Bold" FontSize="16"/>
                                                                        <TextBlock Text="{Binding DataContext.SelectedClassDirectionDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                                                                    </StackPanel>
                                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                                        <ListBox ItemsSource="{Binding DataContext.ClassBranches, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             SelectedItem="{Binding DataContext.SelectedClassBranch, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Style="{StaticResource CardStyle}" Background="#FF223452">
                                                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold"
                                                                       AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                       AutomationProperties.Name="{Binding Title}"/>
                                                                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>
                                                                    </ScrollViewer>
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="8,0,0,0">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                    </Grid.RowDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Ветки" FontWeight="Bold" FontSize="16"/>
                                                                        <TextBlock Text="{Binding DataContext.SelectedClassBranchTitle, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                                                                    </StackPanel>
                                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
