                                                <TextBlock AutomationProperties.AutomationId="{Binding SelectedSkillRow.SkillCode, StringFormat=PlayerCharacter_Skill_{0}_Breakdown}" Text="{Binding SelectedSkillRow.Breakdown, TargetNullValue=—}" TextWrapping="Wrap"/>
