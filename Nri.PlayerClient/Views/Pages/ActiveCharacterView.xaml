                                            <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}"
                                                    AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_TreeSelector">
                                                <StackPanel>
                                                    <TextBlock Text="Шестиугольники развития" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="Выберите основной путь или магию. Покупка классов доступна только через узлы развития." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                    <ListBox ItemsSource="{Binding DevelopmentHexagons}"
                                                             SelectedValue="{Binding SelectedDevelopmentHexagonId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             SelectedValuePath="HexagonId"
                                                             AutomationProperties.AutomationId="PlayerDevelopment_Hexagon_List"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="{x:Type ListBoxItem}">
                                                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource CardStyle}" Background="#FF223452" MinWidth="180">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,0,0" Background="{StaticResource PanelAltBrush}"
                                                    AutomationProperties.AutomationId="PlayerDevelopment_Hexagon_View">
                                                <StackPanel>
                                                    <TextBlock Text="Направление развития"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_Route"/>
                                                    <TextBlock Text="{Binding SelectedDevelopmentHexagonDisplay}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                    <TextBlock Text="Выберите направление и доступный узел развития персонажа." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                    <WrapPanel Margin="0,0,0,8">
                                                        <Button Content="Вписать"
                                                                Command="{Binding FitToViewDevelopmentHexagonCommand}"
                                                                Click="PlayerDevelopmentHexagonViewer_FitToView_Click"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_FitToView"
                                                                Margin="0,0,6,6"/>
                                                        <TextBox Width="220"
                                                                 Text="{Binding DevelopmentViewerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Поиск по узлам развития"
                                                                 AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_SearchBox"
                                                                 Margin="0,0,6,6"/>
                                                        <Button Content="Очистить"
                                                                Command="{Binding DevelopmentViewerSearchClearCommand}"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Margin="0,0,6,6"/>
                                                        <TextBlock Text="{Binding DevelopmentViewerSearchResultCountText}"
                                                                   AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_SearchResultCount"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,6"/>
                                                        <Button Content="←"
                                                                Command="{Binding DevelopmentViewerSearchPreviousCommand}"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Margin="0,0,4,6"/>
                                                        <Button Content="→"
                                                                Command="{Binding DevelopmentViewerSearchNextCommand}"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Margin="0,0,10,6"/>
                                                        <TextBlock Text="{Binding DevelopmentViewerZoomText}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,6"/>
                                                        <TextBlock Text="{Binding DevelopmentViewerModeText}"
                                                                   AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_CanonicalHexMode"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,6"/>
                                                        <ComboBox Width="210"
                                                                  ItemsSource="{Binding DevelopmentViewerCanonicalDirections}"
                                                                  SelectedValue="{Binding DevelopmentViewerFocusedDirectionKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="DirectionId"
                                                                  DisplayMemberPath="FullDisplayName"
                                                                  AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_DirectionFocusSelector"
                                                                  Margin="0,0,8,6"/>
                                                        <CheckBox Content="Легенда"
                                                                  IsChecked="{Binding DevelopmentViewerShowLegend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,0,6"/>
                                                    </WrapPanel>
                                                    <Border Background="#FF142033"
                                                            BorderBrush="#FF2F4265"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8"
                                                            Margin="0,0,0,8"
                                                            Visibility="{Binding DevelopmentViewerLegendVisibility}"
                                                            AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_LegendPanel_Container">
                                                        <StackPanel>
                                                            <TextBlock Text="Легенда"
                                                                       AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_LegendPanel"
                                                                       FontWeight="Bold"/>
                                                            <TextBlock Text="Связь идёт от требования к узлу, который она открывает. Скрытые GM-узлы игроку не передаются."
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_LinkDirectionText"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="Канва развития"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_Canvas"
                                                               Margin="0,0,0,4"/>
                                                    <Border Background="#FF142033"
                                                            BorderBrush="#FF2F4265"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8"
                                                            Margin="0,0,0,8"
                                                            AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_TreeModeOverlay_Container">
                                                        <TextBlock Text="{Binding DevelopmentTreeModeOverlayText}"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_TreeModeOverlay"/>
                                                    </Border>
                                                    <Border Background="#FF101827"
                                                            BorderBrush="#FF2F4265"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8"
                                                            Margin="0,0,0,10">
                                                        <ScrollViewer x:Name="PlayerDevelopmentLayoutScrollViewer"
                                                                      HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      MaxHeight="420"
                                                                      AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_NodeList">
                                                            <Grid Width="{Binding DevelopmentViewerWorkspaceWidth}"
                                                                  Height="{Binding DevelopmentViewerWorkspaceHeight}">
                                                                <Grid.LayoutTransform>
                                                                    <ScaleTransform ScaleX="{Binding DevelopmentViewerZoom}" ScaleY="{Binding DevelopmentViewerZoom}"/>
                                                                </Grid.LayoutTransform>
                                                                <Grid.RenderTransform>
                                                                    <TranslateTransform X="{Binding DevelopmentViewerViewportTranslateX}"
                                                                                        Y="{Binding DevelopmentViewerViewportTranslateY}"/>
                                                                </Grid.RenderTransform>
                                                                <Border Width="{Binding DevelopmentViewerWorkspaceWidth}"
                                                                        Height="{Binding DevelopmentViewerWorkspaceHeight}"
                                                                        Background="Transparent"
                                                                        IsHitTestVisible="False"
                                                                        AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_LinkLayer">
                                                                    <ItemsControl ItemsSource="{Binding DevelopmentCanvasLinks}"
                                                                                  IsHitTestVisible="False">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <Canvas Background="Transparent" ClipToBounds="True"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Canvas>
                                                                                    <Line X1="{Binding X1}"
                                                                                          Y1="{Binding Y1}"
                                                                                          X2="{Binding X2}"
                                                                                          Y2="{Binding Y2}"
                                                                                          StrokeThickness="3"
                                                                                          Stroke="#FF8BC5FF"
                                                                                          Opacity="0.7"/>
                                                                                    <Polygon Points="{Binding ArrowPoints}"
                                                                                             Fill="#FF8BC5FF"
                                                                                             Opacity="0.9"/>
                                                                                </Canvas>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                                <ItemsControl ItemsSource="{Binding DevelopmentViewerCanonicalLanes}"
                                                                              Visibility="{Binding DevelopmentViewerCanonicalLayerVisibility}"
                                                                              IsHitTestVisible="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas Background="Transparent" ClipToBounds="True"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Line X1="{Binding X1}"
                                                                                  Y1="{Binding Y1}"
                                                                                  X2="{Binding X2}"
                                                                                  Y2="{Binding Y2}"
                                                                                  Stroke="{Binding StrokeBrush}"
                                                                                  StrokeThickness="{Binding StrokeThickness}"
                                                                                  Opacity="{Binding Opacity}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <ItemsControl Width="{Binding DevelopmentViewerWorkspaceWidth}"
                                                                              Height="{Binding DevelopmentViewerWorkspaceHeight}"
                                                                              ItemsSource="{Binding VisibleDevelopmentCanvasNodes}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <Canvas Background="Transparent" ClipToBounds="True"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="{x:Type ContentPresenter}">
                                                                        <Setter Property="Canvas.Left" Value="{Binding PositionX}"/>
                                                                        <Setter Property="Canvas.Top" Value="{Binding PositionY}"/>
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Width="{Binding NodeWidth}"
                                                                                Height="{Binding NodeHeight}"
                                                                                Opacity="{Binding VisualOpacity}"
                                                                                Visibility="{Binding VisualVisibility}"
                                                                                Command="{Binding DataContext.AcquireClassNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding NodeId}"
                                                                                AutomationProperties.AutomationId="{Binding NodeId, StringFormat=PlayerDevelopmentHexagonViewer_Node_{0}}"
                                                                                AutomationProperties.Name="{Binding AccessibleTitle}">
                                                                            <Button.Style>
                                                                                <Style TargetType="{x:Type Button}">
                                                                                    <Setter Property="Background" Value="#FF1D3153"/>
                                                                                    <Setter Property="BorderBrush" Value="#FF4A6FA8"/>
                                                                                    <Setter Property="Foreground" Value="#FFE7F0FF"/>
                                                                                    <Setter Property="Padding" Value="6"/>
                                                                                    <Setter Property="Margin" Value="0"/>
                                                                                </Style>
                                                                            </Button.Style>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="34"/>
                                                                                <WrapPanel Margin="0,3,0,0">
                                                                                    <TextBlock Text="{Binding DisplayTypeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,6,0"/>
                                                                                    <TextBlock Text="{Binding DisplayState}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                                                                </WrapPanel>
                                                                                <TextBlock Text="{Binding CostText}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding SearchBadgeText}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <ItemsControl ItemsSource="{Binding DevelopmentViewerCanonicalDirections}"
                                                                              Visibility="{Binding DevelopmentViewerCanonicalLayerVisibility}"
                                                                              IsHitTestVisible="False"
                                                                              AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_DirectionLabels">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas Background="Transparent" ClipToBounds="True"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="{x:Type ContentPresenter}">
                                                                            <Setter Property="Canvas.Left" Value="{Binding AnchorX}"/>
                                                                            <Setter Property="Canvas.Top" Value="{Binding AnchorY}"/>
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Width="{Binding AnchorWidth}"
                                                                                    Height="{Binding AnchorHeight}"
                                                                                    Opacity="{Binding VisualOpacity}"
                                                                                    Padding="0"
                                                                                    BorderThickness="0"
                                                                                    Background="Transparent"
                                                                                    Focusable="False"
                                                                                    IsHitTestVisible="False"
                                                                                    AutomationProperties.AutomationId="{Binding PlayerAnchorAutomationId}"
                                                                                    AutomationProperties.Name="{Binding FullDisplayName}">
                                                                                <Grid>
                                                                                    <Polygon Points="{Binding AnchorHexPoints}"
                                                                                             Fill="#DD1B3556"
                                                                                             Stroke="#FF9ED8FF"
                                                                                             StrokeThickness="2.4"/>
                                                                                    <StackPanel VerticalAlignment="Center"
                                                                                                HorizontalAlignment="Center"
                                                                                                Margin="10,0">
                                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="#FFEAF6FF"
                                                                                                   TextAlignment="Center"/>
                                                                                        <TextBlock Text="{Binding AtmosphericName}"
                                                                                                   Foreground="{StaticResource MutedBrush}"
                                                                                                   FontSize="11"
                                                                                                   TextAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <ItemsControl ItemsSource="{Binding DevelopmentViewerCanonicalRoots}"
                                                                              Visibility="{Binding DevelopmentViewerCanonicalLayerVisibility}"
                                                                              IsHitTestVisible="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas Background="Transparent" ClipToBounds="True"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="{x:Type ContentPresenter}">
                                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Width="{Binding Width}"
                                                                                    Height="{Binding Height}"
                                                                                    Padding="0"
                                                                                    BorderThickness="0"
                                                                                    Background="Transparent"
                                                                                    Focusable="False"
                                                                                    IsHitTestVisible="False"
                                                                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                                    AutomationProperties.Name="{Binding Label}">
                                                                                <Grid>
                                                                                    <Polygon Points="{Binding HexPoints}"
                                                                                             Fill="#EE214C45"
                                                                                             Stroke="{StaticResource SuccessBrush}"
                                                                                             StrokeThickness="4"/>
                                                                                    <TextBlock Text="{Binding Label}"
                                                                                               FontSize="24"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="#FFFFFFFF"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"
                                                                                               TextAlignment="Center"
                                                                                               TextWrapping="Wrap"
                                                                                               Margin="22,0"/>
                                                                                </Grid>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </ScrollViewer>
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding ClassDirections}"
                                                                  AutomationProperties.AutomationId="PlayerDevelopment_Hexagon">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Label}"
                                                                        Command="{Binding DataContext.AcquireClassNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding Key}"
                                                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                        Margin="0,0,8,8"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="Купить узел"
                                                                AutomationProperties.AutomationId="PlayerDevelopment_BuyNode_Button"
                                                                Command="{Binding BuySelectedClassNodeCommand}"
                                                                IsEnabled="{Binding CanBuySelectedClassNode}"/>
                                                        <Button Content="Запросить открытие"
                                                                Margin="8,0,0,0"
                                                                AutomationProperties.AutomationId="PlayerDevelopment_RequestUnlock_Button"
                                                                Command="{Binding RequestUnlockNodeCommand}"
                                                                IsEnabled="{Binding CanRequestSelectedClassNode}"/>
                                                    </StackPanel>
                                                    <TextBox AutomationProperties.AutomationId="PlayerDevelopment_Status"
                                                             Text="{Binding DevelopmentStatusText}"
                                                             IsReadOnly="True"
                                                             IsTabStop="False"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Foreground="{StaticResource MutedBrush}"
                                                             TextWrapping="Wrap"
                                                             Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding DevelopmentViewerPurchaseExplanation}"
                                                               AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_PurchaseExplanation"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Ветки развития" FontWeight="Bold" FontSize="16"/>
                                                            <TextBlock Text="{Binding SelectedClassDirectionDisplay}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                                                        </StackPanel>
                                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                            <ListBox ItemsSource="{Binding ClassBranches}" SelectedItem="{Binding SelectedClassBranch, Mode=TwoWay}">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource CardStyle}" Background="#FF223452"
                                                                                AutomationProperties.AutomationId="{Binding AutomationId}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                                                <TextBlock Text="{Binding DisplayStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="8,0,0,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Узлы ветки" FontWeight="Bold" FontSize="16"/>
                                                            <TextBlock Text="{Binding SelectedClassBranchTitle}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                                                        </StackPanel>
                                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                            <ListBox ItemsSource="{Binding ClassEntries}" SelectedItem="{Binding SelectedClassEntry, Mode=TwoWay}">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource CardStyle}" Background="#FF223452"
                                                                                AutomationProperties.AutomationId="{Binding AutomationId}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"/>
                                                                                <TextBlock Text="{Binding DisplayStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                                                                <TextBlock Text="{Binding FriendlyMetaText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="8,0,0,0"
                                                        AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_SelectedNodePanel">
                                                    <StackPanel>
                                                        <TextBlock Text="Карточка развития" FontWeight="Bold" FontSize="16"/>
                                                        <TextBlock AutomationProperties.AutomationId="PlayerDevelopment_SelectedNode_Title"
                                                                   Text="{Binding SelectedClassEntryTitle}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                        <TextBlock Text="{Binding SelectedClassEntrySummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <Border Style="{StaticResource CardStyle}" Background="#FF223452" Margin="0,10,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="Направление" Foreground="{StaticResource MutedBrush}"/>
                                                                <TextBlock Text="{Binding SelectedClassDirectionDisplay}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="Ветка" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                                <TextBlock Text="{Binding SelectedClassBranchTitle}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="Стоимость" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                                <TextBlock AutomationProperties.AutomationId="PlayerDevelopment_SelectedNode_Cost"
                                                                           Text="{Binding SelectedClassEntryCost}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="Тип и доступ" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                                <TextBlock Text="{Binding SelectedClassEntryMeta}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="Открывает" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                                <TextBlock Text="{Binding SelectedClassEntryUnlock}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="Статус" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                                                <TextBlock AutomationProperties.AutomationId="PlayerDevelopment_SelectedNode_State"
                                                                           Text="{Binding SelectedClassEntryState}" FontWeight="SemiBold"/>
                                                                <TextBlock AutomationProperties.AutomationId="PlayerDevelopment_SelectedNode_Requirements"
                                                                           Text="{Binding SelectedClassEntryRequirements}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                                <TextBlock AutomationProperties.AutomationId="PlayerDevelopment_SelectedNode_Position"
                                                                           Text="{Binding SelectedClassEntryPosition}" FontSize="1" Height="1" Opacity="0.01"/>
                                                                <TextBlock AutomationProperties.AutomationId="PlayerDevelopment_SelectedNode_Direction"
                                                                           Text="{Binding SelectedClassEntryDirection}" FontSize="1" Height="1" Opacity="0.01"/>
                                                                <TextBlock AutomationProperties.AutomationId="PlayerDevelopment_SelectedNode_RequiredNodeIds"
                                                                           Text="{Binding SelectedClassEntryRequiredNodeIds}" FontSize="1" Height="1" Opacity="0.01"/>
                                                                <TextBlock AutomationProperties.AutomationId="PlayerDevelopment_SelectedNode_LayoutVersion"
                                                                           Text="{Binding SelectedClassEntryLayoutVersion}" FontSize="1" Height="1" Opacity="0.01"/>
                                                                <TextBlock Text="{Binding SelectedClassEntryReward}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                          <Button Content="Купить узел"
                                                                  AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_PurchaseNode"
                                                                  Command="{Binding BuySelectedClassNodeCommand}"
                                                                  IsEnabled="{Binding CanBuySelectedClassNode}"/>
                                                            <Button Content="Запросить открытие"
                                                                    Margin="8,0,0,0"
                                                                    AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_RequestUnlock"
                                                                    Command="{Binding RequestUnlockNodeCommand}"
                                                                    IsEnabled="{Binding CanRequestSelectedClassNode}"/>
                                                        </StackPanel>
                                                        <TextBox AutomationProperties.AutomationId="PlayerDevelopmentHexagonViewer_StatusText"
                                                                 Text="{Binding DevelopmentStatusText}"
                                                                 IsReadOnly="True"
                                                                 IsTabStop="False"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 Foreground="{StaticResource MutedBrush}"
                                                                 TextWrapping="Wrap"
                                                                 Margin="0,10,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
</UserControl>

