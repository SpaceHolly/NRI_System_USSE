<UserControl x:Class="Nri.PlayerClient.Views.Pages.CombatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Бой" Style="{StaticResource HeaderTitleTextStyle}"/>
                <TextBlock Text="Статус: Недоступно / Отложено" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Text="Причина: player-safe боевые действия ещё не доведены до рабочего MVP." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                <TextBlock Text="Target: 0.15" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
