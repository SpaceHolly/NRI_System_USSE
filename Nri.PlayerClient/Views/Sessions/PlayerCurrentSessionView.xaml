<UserControl x:Class="Nri.PlayerClient.Views.Sessions.PlayerCurrentSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.PlayerClient.ViewModels">
    <Grid Margin="8" AutomationProperties.AutomationId="PlayerCurrentSession_Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Текущая сессия" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Проверить доступность" Style="{DynamicResource GhostButtonStyle}" Command="{Binding RefreshFlagsCommand}"/>
                    <Button Content="Обновить" Margin="8,0,0,0" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SessionName}" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="{Binding GMDisplay, StringFormat=GM: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="0,0,8,8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Статус" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="0,0,0,8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Режим" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding ModeDisplay}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="0,0,8,8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Сцена" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding SceneDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="0,0,0,8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Бой" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding CombatDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Margin="0,4,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Публичные заметки" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding NotesDisplay}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Активные материалы" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding SceneMapDisplay, StringFormat=Карта сцены: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding WorldMapDisplay, StringFormat=Карта мира: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding RoomDisplay, StringFormat=Помещение: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding QuickLinks}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionQuickLinkVm}">
                                <Border Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StateText}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="12,0,0,0"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LastRefreshText}" Foreground="{StaticResource MutedBrush}"/>
                <StackPanel>
                    <TextBlock Text="{Binding WarningMessage}" Foreground="#FFFBBF24" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFCA5A5" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
