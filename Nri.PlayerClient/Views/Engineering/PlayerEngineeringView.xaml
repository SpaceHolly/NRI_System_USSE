<UserControl x:Class="Nri.PlayerClient.Views.Engineering.PlayerEngineeringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Инженерия / предложения конструкций" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <TabControl>
                    <TabItem Header="Платформы">
                        <ListBox ItemsSource="{Binding Platforms}"/>
                    </TabItem>
                    <TabItem Header="Модули">
                        <ListBox ItemsSource="{Binding Modules}"/>
                    </TabItem>
                    <TabItem Header="Пресеты">
                        <ListBox ItemsSource="{Binding Presets}"/>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Мои черновики" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="Черновик можно отправить GM как заявку на инженерный проект." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TabControl Grid.Row="1" Margin="0,8,0,8">
                        <TabItem Header="Черновики">
                            <ListBox ItemsSource="{Binding Drafts}" SelectedItem="{Binding SelectedDraft, Mode=TwoWay}" DisplayMemberPath="Summary"/>
                        </TabItem>
                        <TabItem Header="Проверка">
                            <ListBox ItemsSource="{Binding ValidationRows}"/>
                        </TabItem>
                    </TabControl>
                    <StackPanel Grid.Row="2">
                        <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название предложения"/>
                        <TextBox Text="{Binding DraftPlatformId, UpdateSourceTrigger=PropertyChanged}" ToolTip="PlatformId" Margin="0,6,0,0"/>
                        <TextBox Text="{Binding DraftModuleIds, UpdateSourceTrigger=PropertyChanged}" ToolTip="ModuleIds через запятую" Margin="0,6,0,0"/>
                        <TextBox Text="{Binding DraftRole, UpdateSourceTrigger=PropertyChanged}" ToolTip="Назначение / роль" Margin="0,6,0,0"/>
                        <TextBox Text="{Binding DraftNotes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Комментарий для GM" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Создать черновик" Command="{Binding CreateDraftCommand}"/>
                            <Button Content="Проверить" Command="{Binding ValidateDraftCommand}" Margin="6,0,0,0"/>
                            <Button Content="Отправить GM" Command="{Binding SubmitDraftCommand}" Margin="6,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <TabControl>
                    <TabItem Header="Проекты">
                        <ListBox ItemsSource="{Binding Projects}"/>
                    </TabItem>
                    <TabItem Header="Чертежи">
                        <ListBox ItemsSource="{Binding Blueprints}"/>
                    </TabItem>
                    <TabItem Header="Граница">
                        <TextBlock Margin="8" Text="Здесь отображаются только player-safe данные. GM notes, hidden modules и ServerOnlyData не запрашиваются и не показываются. Производство техники будет отдельным этапом." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
