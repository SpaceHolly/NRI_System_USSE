<UserControl x:Class="Nri.PlayerClient.Views.Journal.PlayerEventJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nri.PlayerClient.ViewModels"
             AutomationProperties.AutomationId="PlayerEventJournal_Tab">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Журнал событий" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Только события, открытые игрокам. Внутренние GM-детали не отображаются."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button AutomationProperties.AutomationId="PlayerEventJournal_CheckFlags_Button" Content="Проверить доступность" Command="{Binding RefreshFlagsCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"/>
                    <Button AutomationProperties.AutomationId="PlayerEventJournal_Refresh_Button" Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
                    <Button AutomationProperties.AutomationId="PlayerEventJournal_Search_Button" Content="Поиск" Command="{Binding SearchCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Width="150" Margin="0,0,8,0">
                            <TextBlock Text="Кампания" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding CampaignId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,8,0">
                            <TextBlock Text="Сессия" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding SessionId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="170" Margin="0,0,8,0">
                            <TextBlock Text="Категория" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox AutomationProperties.AutomationId="PlayerEventJournal_Filter_Type" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}"/>
                        </StackPanel>
                        <StackPanel Width="260">
                            <TextBlock Text="Поиск" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox AutomationProperties.AutomationId="PlayerEventJournal_Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </WrapPanel>

                    <DataGrid AutomationProperties.AutomationId="PlayerEventJournal_List"
                              Grid.Row="1"
                              ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding SelectedEntry}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Binding="{Binding OccurredText}" Width="130"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="Важность" Binding="{Binding Severity}" Width="110"/>
                            <DataGridTextColumn Header="Событие" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Контекст" Binding="{Binding ContextText}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10">
                <TabControl>
                    <TabItem Header="Событие">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <TextBlock AutomationProperties.AutomationId="PlayerEventJournal_Selected_Title" Text="{Binding SelectedEntry.Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedEntry.ContextText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Описание" FontWeight="SemiBold"/>
                                <TextBlock AutomationProperties.AutomationId="PlayerEventJournal_Selected_Summary" Text="{Binding SelectedEntry.Summary}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                <TextBlock AutomationProperties.AutomationId="PlayerEventJournal_Selected_Text" Text="{Binding SelectedEntry.Summary}" Visibility="Collapsed"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Категория" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SelectedEntry.Category}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Важность" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SelectedEntry.Severity}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Когда" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SelectedEntry.OccurredText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Мировое время" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SelectedEntry.WorldDateTimeSnapshot}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Связи">
                        <ListBox ItemsSource="{Binding Links}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EventJournalPlayerLinkRow}">
                                    <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LinkRole}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <TabItem Header="Комментарии">
                        <ListBox ItemsSource="{Binding Annotations}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EventJournalPlayerAnnotationRow}">
                                    <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding AuthorDisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock AutomationProperties.AutomationId="PlayerEventJournal_StatusText" Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" DockPanel.Dock="Right" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
